{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/linkedin-share-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/course-change-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; case \"$f\" in *app/code/local/MMD/MagentoCaptcha/*|*app/code/local/MMD/Leads/*|*recaptcha/contacts/form.phtml) .claude/hooks/verify-leads-capture.sh ;; esac"
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; case \"$f\" in *app/code/local/MMD/Marketing/Helper/*|*app/code/local/MMD/Marketing/Model/Cron/*|*template/marketing/templates/*) .claude/hooks/verify-newsletter-flyer.sh ;; esac"
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/lint-php-on-edit.sh \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/registration-gate-on-edit.sh \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/mobileapi-nonwsq-on-edit.sh \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/verify-web-health.sh \"$f\""
          }
        ]
      }
    ]
  }
}
