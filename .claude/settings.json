{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/git-push-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; case \"$f\" in *app/code/local/MMD/MagentoCaptcha/*|*app/code/local/MMD/Leads/*|*recaptcha/contacts/form.phtml) .claude/hooks/verify-leads-capture.sh ;; esac"
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/lint-php-on-edit.sh \"$f\""
          },
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; .claude/hooks/verify-web-health.sh \"$f\""
          }
        ]
      }
    ]
  }
}
