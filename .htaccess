############################################
## Per-host sitemap routing
## Maps /sitemap.xml on each country domain to that store's generated file.
## Per-store files come from Magento's sitemap cron (Admin: Catalog → Google Sitemap,
## rows seeded by migrations/163-per-store-sitemaps.sql).
RewriteCond %{HTTP_HOST} ^(www\.)?tertiarycourses\.com\.sg$ [NC]
RewriteRule ^sitemap\.xml$ /sitemap_singapore.xml [L]

RewriteCond %{HTTP_HOST} ^(www\.)?tertiarycourses\.com\.my$ [NC]
RewriteRule ^sitemap\.xml$ /sitemap_malaysia.xml [L]

RewriteCond %{HTTP_HOST} ^(www\.)?tertiarycourses\.com\.gh$ [NC]
RewriteRule ^sitemap\.xml$ /sitemap_ghana.xml [L]

RewriteCond %{HTTP_HOST} ^(www\.)?tertiarycourses\.com\.ng$ [NC]
RewriteRule ^sitemap\.xml$ /sitemap_nigeria.xml [L]

RewriteCond %{HTTP_HOST} ^(www\.)?tertiaryinfotech\.edu\.sg$ [NC]
RewriteRule ^sitemap\.xml$ /sitemap_infotech.xml [L]

