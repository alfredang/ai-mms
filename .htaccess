#RewriteRule ^(.*)$ https://www.tertiarycourses.com.sg/$1 [R=301,L]


# HSTS (Strict-Transport-Security). Soft deployment — `max-age=31536000`
# (one year) on this exact host only. Deliberately omits `includeSubDomains`
# and `preload`:
#   - `includeSubDomains` would lock e.g. mail.tertiarycourses.com.sg to
#     HTTPS too; not every subdomain has TLS, so this could brick mail / dev
#     subdomains for everyone who has hit the apex.
#   - `preload` is a one-way submission to Chrome's hardcoded list — leave
#     until we've run with bare HSTS for ≥3 months with no incidents.
# All five primary hosts (tertiaryinfotech.edu.sg + tertiarycourses.com.{sg,my,gh,ng})
# already serve HTTPS cleanly — verified 2026-05-26.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>


############################################
## Domain to Store View mapping
## tertiaryinfotech.edu.sg → Infotech store view
SetEnvIf Host ^(www\.)?tertiaryinfotech\.edu\.sg$ MAGE_RUN_CODE=infotech
SetEnvIf Host ^(www\.)?tertiaryinfotech\.edu\.sg$ MAGE_RUN_TYPE=store

## Redirect non-www to www for tertiaryinfotech.edu.sg
RewriteCond %{HTTP_HOST} ^tertiaryinfotech\.edu\.sg$ [NC]
RewriteRule ^(.*)$ https://www.tertiaryinfotech.edu.sg/$1 [L,R=301]

## tertiarycourses.com.ng → Nigeria store view
SetEnvIf Host ^(www\.)?tertiarycourses\.com\.ng$ MAGE_RUN_CODE=nigeria
SetEnvIf Host ^(www\.)?tertiarycourses\.com\.ng$ MAGE_RUN_TYPE=store

## Redirect non-www to www for tertiarycourses.com.ng
RewriteCond %{HTTP_HOST} ^tertiarycourses\.com\.ng$ [NC]
RewriteRule ^(.*)$ https://www.tertiarycourses.com.ng/$1 [L,R=301]

## tertiarycourses.com.gh → Ghana store view
