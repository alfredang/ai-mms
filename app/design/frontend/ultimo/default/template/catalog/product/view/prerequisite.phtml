<?php $_product = $this->getProduct(); $prerequisite = $_product->getPrerequisite(); ?>
<?php
/* Drop retired boilerplate sections from the per-course Course Info blob at
   render time (the blob is 800 hand-edited rows, so a SQL rewrite is fragile).
   A section = an <h2> plus everything up to the next <h2>; it is removed only
   when its markup is self-contained (balanced <div>s), else left untouched.
   On SG every funding/appeal section is also dropped: funded courses (TGS-:
   WSQ, CASL, IBF) get the standard set from course_info_funding.phtml
   instead, and non-WSQ courses carry no funding at all. */
$_isSg = (Mage::app()->getStore()->getCode() === 'singapore');
$_sku = (string) $_product->getSku();
$_isSgFunded = $_isSg && stripos($_sku, 'TGS-') === 0
    && !in_array($_sku, array('TGS-2020504243'), true); // no-funding list, mirrors view.phtml
if ($prerequisite) {
    $_retired = $_isSg
        ? '/promotion code|progressive wage model|\(pwm\)|funding elig|skills ?future (credit )?claim|level-?up|utap|^\s*note:?\s*$|appeal|psea|\bsfec\b|enterprise credit|free ai|training grant|sponsored individuals|hrdf|course fee funding|funding validity/i'
        : '/promotion code|progressive wage model|\(pwm\)/i';
    $_parts = preg_split('#(<h2\b[^>]*>.*?</h2>)#is', $prerequisite, -1, PREG_SPLIT_DELIM_CAPTURE);
    $_out = $_parts[0];
    for ($_i = 1; $_i < count($_parts); $_i += 2) {
        $_section = $_parts[$_i] . (isset($_parts[$_i + 1]) ? $_parts[$_i + 1] : '');
        $_title = html_entity_decode(strip_tags($_parts[$_i]), ENT_QUOTES, 'UTF-8');
        $_balanced = preg_match_all('#<div\b#i', $_section) === preg_match_all('#</div>#i', $_section);
        if (!(preg_match($_retired, $_title) && $_balanced)) {
            $_out .= $_section;
        }
    }
    $prerequisite = $_out;
}
if ($_isSgFunded) {
    $prerequisite .= $this->getLayout()->createBlock('core/template')
        ->setTemplate('catalog/product/view/course_info_funding.phtml')
        ->setProduct($_product)
        ->toHtml();
}
?>
<?php if (trim(strip_tags($prerequisite)) !== ''){ ?>
    <div class="std course-info-std">
        <?php echo $prerequisite; ?>
    </div>
    <script type="text/javascript">
    /* Course Info — convert flat <h2>section + content runs into a stacked
       accordion. Each <h2> becomes a clickable header; everything between
       that <h2> and the next <h2> becomes the collapsible body. All
       collapsed by default so the panel reads as a clean section index
       rather than a wall of nested headings/tables. */
    (function () {
        var s = document.currentScript;
        var root = s ? s.previousElementSibling : null;
        if (!root || !root.classList || !root.classList.contains('course-info-std')) {
            root = document.querySelector('#acctab-prerequisite + .panel .course-info-std');
        }
        if (!root) { return; }
        var headings = Array.prototype.slice.call(root.children).filter(function (n) {
            return n.tagName === 'H2';
        });
        if (!headings.length) { return; }
        headings.forEach(function (h2, idx) {
            var item = document.createElement('div');
            item.className = 'course-info-acc__item';
            var header = document.createElement('button');
            header.type = 'button';
            header.className = 'course-info-acc__header';
            header.setAttribute('aria-expanded', 'false');
            header.innerHTML = '<span class="course-info-acc__title">' + h2.innerHTML +
                '</span><span class="course-info-acc__chevron" aria-hidden="true"></span>';
            var body = document.createElement('div');
            body.className = 'course-info-acc__body';
            root.insertBefore(item, h2);
            item.appendChild(header);
            item.appendChild(body);
            h2.parentNode.removeChild(h2);
            var sib = item.nextSibling;
            while (sib && !(sib.nodeType === 1 && sib.tagName === 'H2'
                            && !sib.classList.contains('course-info-acc__header'))) {
                var next = sib.nextSibling;
                if (sib.nodeType === 1 && sib.classList && sib.classList.contains('course-info-acc__item')) break;
                body.appendChild(sib);
                sib = next;
            }
            header.addEventListener('click', function () {
                var open = item.classList.toggle('is-open');
                header.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        });
    })();
    </script>
<?php } ?>
