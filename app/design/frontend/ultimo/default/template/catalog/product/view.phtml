			<script>
			(function () {
				var btn = document.getElementById('course-like');
				if (!btn) return;
				var liked = false;
				btn.addEventListener('click', function () {
					if (liked) return;
					liked = true;
					btn.classList.add('is-liked');
					// Still record the like server-side; the displayed count
					// stays the page-view total, so no count update here.
					var xhr = new XMLHttpRequest();
					xhr.open('POST', btn.getAttribute('data-url'), true);
					xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
					xhr.send('product_id=' + btn.getAttribute('data-product'));
				});
			})();
			(function () {
				var copy = document.getElementById('course-share-copy');
				if (!copy) return;
				copy.addEventListener('click', function () {
					var url = copy.getAttribute('data-url');
					var done = function () { copy.classList.add('is-copied'); setTimeout(function () { copy.classList.remove('is-copied'); }, 1500); };
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(url).then(done, done);
					} else {
						var t = document.createElement('textarea'); t.value = url; document.body.appendChild(t); t.select();
						try { document.execCommand('copy'); } catch (e) {}
						document.body.removeChild(t); done();
					}
				});
			})();
			</script>

