<?php
	$_helper = $this->helper('catalog/output');
	$_product = $this->getProduct();
    $_storeId = $_product->getStoreId();
	$productType = $_product->getTypeId(); 
	$theme = $this->helper('ultimo');
	$helperThis = $this->helper('ultimo/template_catalog_product_view');
	$helperSnippets = $this->helper('ultimo/rsnippets');
    $attributeSetId = $_product->getAttributeSetId();

	//CSS classes based on product type
	$productTypeId = $_product->getTypeId();
	$productTypeClasses = '';
	if ($productTypeId === 'grouped') {
		$productTypeClasses .= ' is-type-grouped';
	}

	//
	$shortDescription = $_helper->productAttribute($_product, $_product->getShortDescription(), 'short_description');

	// ---------------------------------------------------------------------
	// Carve dynamic sections out of $shortDescription so they can render as
	// their own styled cards in the left column. Order matters: extract WSQ
	// first (it wraps SFC/UTAP/PSEA in a rounded <div>), then Certification.
	//
	// Primary source for each section is a per-course Magento cms/block with
	// identifier `course_<sku>_<section>`. Editable via Course Edit dashboard
	// or CMS → Static Blocks. Regex extraction from short_description is
	// kept as a permanent fallback (belt and braces — if a course's block
	// is empty, we still render whatever was in short_description, so
	// nothing ever disappears silently).
	// ---------------------------------------------------------------------
	$_WS = '(?:\s|&nbsp;|\x{00A0}|\x{2007}|\x{202F})';
	$_courseSku = (string) $_product->getSku();
	$_noFundingCourseSkus = array('TGS-2020504243');
	$_isNoFundingCourse = in_array($_courseSku, $_noFundingCourseSkus, true);
	$_cmsBlockHtml = function (string $id): string {
		static $cmsBlockHtmlCache = array();
		if (!array_key_exists($id, $cmsBlockHtmlCache)) {
			$cmsBlockHtmlCache[$id] = trim(Mage::app()->getLayout()->createBlock('cms/block')->setBlockId($id)->toHtml());
		}
		return $cmsBlockHtmlCache[$id];
	};
	$_courseSectionHtml = function (string $code) use ($_courseSku, $_cmsBlockHtml): string {
		if ($_courseSku === '') return '';
		$id = 'course_' . $_courseSku . '_' . $code;
		return $_cmsBlockHtml($id);
	};

	// (1) WSQ Funding wrapper — raw inner HTML of the SFC/UTAP/PSEA narrative.
	// Per-course cms/block is primary; if empty, fall back to regex extract
	// (the legacy <div style="border-radius:25px"> wrapper, or an
	// <h2>WSQ Funding</h2> heading variant). The post-processor below (drop
	// fee table / boilerplate, wrap sub-schemes in .wsq-sub) runs on
	// whichever source produced the inner HTML — it's pipeline-stage and
	// independent of source.
	$_wsqNarrativeHtml = '';
	$_hasWsqFunding    = false;
	// Non-WSQ courses in the SG store use SKU prefix "C" (WSQ courses use
	// "TGS-"). For these, the funding card is informational only — no
	// auto-calculated fee tiles, title renamed to "Funding Options", and any
	// in-narrative "Funding and Grant Applications" heading is suppressed
	// (we just want the no-funding sentence + WSQ link to render).
	$_isNonWsqSgCourse = (strncasecmp((string) $_courseSku, 'C', 1) === 0)
		&& (Mage::app()->getStore()->getCode() === 'singapore');
	$_showFundingOptionsOnly = ($_isNonWsqSgCourse || $_isNoFundingCourse);
	// SG WSQ (TGS-) courses: checkbox-driven (2026-08). The narrative is
	// built from the course's funding badge TAGS — the same tags behind the
	// storefront chips and the Edit Course "Funding and Grant" checkboxes —
	// with every link generated from the course's own SKU. The per-course
	// funding_and_grant cms/block is no longer consulted for these courses.
	$_isSgWsqCourse = (stripos($_courseSku, 'TGS-') === 0)
		&& (Mage::app()->getStore()->getCode() === 'singapore');
	if ($_isSgWsqCourse) {
		$_inner = Mage::helper('mmd_courseimage')->getWsqFundingNarrativeHtml($_product);
	} else {
		$_inner = $_courseSectionHtml('funding_and_grant');
	}
	if ($_inner !== '') {
		$_hasWsqFunding = true;
	}
	if ($shortDescription) {
		$_wsqPattern = '#<div\b[^>]*border-radius\s*:[^>]*>(.*?)</div>#siu';
		// Accept both heading variants: the classic "WSQ Funding" and the
		// Quill-editor-authored "Funding and Grant Applications" (newer
		// courses, e.g. TGS-2026061583), so both get carded instead of
		// rendering as a raw table in the narrative.
		$_wsqHeadingPattern = '#<h[1-6][^>]*>' . $_WS . '*(?:WSQ' . $_WS . '+Funding|Funding' . $_WS . '+and' . $_WS . '+Grant' . $_WS . '+Applications?)' . $_WS . '*</h[1-6]>(.*?)(?=<h[12]\b|\z)#siu';
		$_wsqStripPattern = null;
		if (preg_match_all($_wsqPattern, $shortDescription, $_wsqMatches)) {
			$_wsqStripPattern = $_wsqPattern;
			if (!$_hasWsqFunding && !$_isSgWsqCourse) {
				$_hasWsqFunding = true;
				// Some legacy descriptions contain an empty rounded wrapper
				// immediately before the real funding wrapper. Preserve every
				// non-empty wrapper body for the canonical funding card instead
				// of treating only the first (often empty) wrapper as funding.
				$_inner = trim(implode('', $_wsqMatches[1]));
			}
		} elseif (preg_match($_wsqHeadingPattern, $shortDescription, $_wsqMatch)) {
			$_wsqStripPattern = $_wsqHeadingPattern;
			// TGS- courses never ADOPT description content (badges are the
			// only source, so unticking WSQ truly removes the card) — but the
			// strip below still runs to clean any legacy residue out of the
			// About card.
			if (!$_hasWsqFunding && !$_isSgWsqCourse) { $_hasWsqFunding = true; $_inner = $_wsqMatch[1]; }
		}
		if ($_wsqStripPattern !== null) {
			// Remove every legacy rounded funding wrapper from the About card.
			// Its content has already been retained in $_inner (or in the
			// per-course funding CMS block), so no grey/empty legacy div can
			// leak into the customer-facing description.
			$shortDescription = preg_replace($_wsqStripPattern, '', $shortDescription);
		}
	}
	if ($_hasWsqFunding) {
		{
			$_inner = preg_replace('#<h[1-6][^>]*>' . $_WS . '*WSQ' . $_WS . '+Funding' . $_WS . '*</h[1-6]>#siu', '', $_inner);
			$_inner = preg_replace('#<table\b.*?</table>#siu', '', $_inner);
			$_inner = preg_replace('#<p[^>]*>' . $_WS . '*WSQ' . $_WS . '+funding' . $_WS . '+is' . $_WS . '+only.*?</p>#siu', '', $_inner);
			// Drop redundant tier-explainer / nett-payment lines that the
			// auto-calc tiles already convey.
			$_inner = preg_replace('#<p[^>]*>(?:' . $_WS . '|<[^>]+>)*Baseline\s*:.*?</p>#siu', '', $_inner);
			$_inner = preg_replace('#<p[^>]*>(?:' . $_WS . '|<[^>]+>)*MCES\b.*?</p>#siu', '', $_inner);
			$_inner = preg_replace('#<p[^>]*>(?:' . $_WS . '|<[^>]+>)*Upon\s+registration[^<]*advise[^<]*WSQ.*?</p>#siu', '', $_inner);
			$_inner = preg_replace('#<p[^>]*>(?:' . $_WS . '|<[^>]+>)*You\s+can\s+pay\s+the\s+nett\s+fee.*?</p>#siu', '', $_inner);
			$_inner = preg_replace('#<p[^>]*>' . $_WS . '*</p>#siu', '', $_inner);
			// Drop any <hr> separators inside the narrative — the per-scheme
			// .wsq-sub cards below already supply visual separation.
			$_inner = preg_replace('#<hr\b[^>]*/?>#siu', '', $_inner);

			// Non-WSQ SG courses: strip ALL remaining headings so the
			// preg_replace_callback below doesn't wrap them as .wsq-sub
			// mini-cards (we don't want the "Funding and Grant Applications"
			// pill above the no-funding sentence).
			if ($_showFundingOptionsOnly) {
				$_inner = preg_replace('#<h[1-6][^>]*>.*?</h[1-6]>#siu', '', $_inner);
			}

			// Standardise the PSEA write-up: strip any authored PSEA section
			// (its <h3> heading + body up to the next heading) so the single
			// canonical PSEA card injected below is the ONLY PSEA copy that
			// renders. Historically 267 courses drifted into ~20 wording
			// variants; removing the authored one and letting the fallback
			// re-add a fixed version guarantees identical copy on every WSQ course.
			$_inner = preg_replace(
				'#<h[1-6][^>]*>' . $_WS . '*PSEA\b.*?</h[1-6]>.*?(?=<h[1-6]|\z)#siu',
				'',
				$_inner
			);

			// Fallback — when a course has a scheme badge (pill) but its funding
			// narrative doesn't contain that scheme's section (badge set via tags,
			// narrative is freeform short_description / CMS block, so they drift),
			// inject the canonical <h3> + body so the preg_replace_callback below
			// wraps it into a .wsq-sub--<scheme> card alongside the others. PSEA is
			// always injected (its authored section is stripped just above) so its
			// copy is standardised; UTAP is injected only when missing. SFC / SFEC
			// have no fallback yet — extend the array if needed.
			try {
				$_courseBadges = Mage::helper('mmd_courseimage')->getProductBadges($_product);
			} catch (Exception $_e) {
				$_courseBadges = array();
			}
			// Each fallback declares the HTML to inject AND the heading
			// it should insert BEFORE so the funding stack stays in its
			// canonical order (SFC → UTAP → PSEA → SFEC) — matches how
			// authored courses display. If the anchor heading isn't
			// present, append to the end as a safety net.
			$_fundingFallbacks = array(
				'UTAP' => array(
					'html' => '<h3>UTAP</h3>'
						. '<p>Eligible NTUC members can apply for 50% of the unfunded fee from UTAP, '
						. 'capped up to $250/year and for members aged 40 and above, capped up to $500/year.</p>'
						// Keep in sync with MMD_CourseImage_Helper_Data::getWsqFundingNarrativeHtml().
						. '<p><a class="wsq-portal-btn wsq-portal-btn--utap" href="https://utap.ntuc.org.sg/onlineClaim" target="_blank" '
						. 'style="display: inline-block; padding: 8px 18px; background: #9333ea; color: #ffffff; font-weight: 600; border-radius: 6px; text-decoration: none;">'
						. 'Submit UTAP Claim</a></p>',
					'before' => 'PSEA',
				),
				// PSEA is STANDARDISED across every WSQ course: any authored PSEA
				// section is stripped above so this single canonical copy always
				// renders (267 courses had drifted into 20 wording variants). The
				// SkillsFuture eligibility link is course-specific — for WSQ
				// courses the SKU IS the course reference number, so build it from
				// getSku(). Fires on every TGS- course (all carry the PSEA badge
				// via migration 655).
				'PSEA' => array(
					'html' => '<h3>PSEA</h3>'
						. '<p>Eligible Singapore Citizens can use their PSEA funds to offset course fee payable after funding.</p>'
						// Current SSG deep-link format (the legacy portal
						// .../course-detail.html?courseReferenceNumber= URL
						// 301s here). Keep in sync with
						// MMD_CourseImage_Helper_Data::getWsqFundingNarrativeHtml().
						. '<p><a class="wsq-portal-btn wsq-portal-btn--psea" href="https://courses.myskillsfuture.gov.sg/courses/' . rawurlencode((string) $_courseSku) . '" title="Check PSEA Eligibility (course code: ' . $this->escapeHtml($_courseSku) . ')" target="_blank" '
						. 'style="display: inline-block; padding: 8px 18px; background: #16a34a; color: #ffffff; font-weight: 600; border-radius: 6px; text-decoration: none;">'
						. 'Check PSEA Eligibility</a></p>'
						. '<ul>'
						. '<li>Scroll down to &ldquo;Keyword Tags&rdquo; to verify for PSEA eligibility.</li>'
						. '<li>If there is &ldquo;PSEA&rdquo; under keyword tags, the course is eligible for PSEA.</li>'
						. '</ul>'
						. '<p>Once you are eligible for PSEA, please download and fill up the PSEA Withdrawal Form, then submit the completed form to us:</p>'
						. '<p><a class="wsq-portal-btn wsq-portal-btn--psea-outline" href="https://www.moe.gov.sg/api/media/94b3eeb8-ceed-47e3-9f58-921b33970c9a/psea-ad-hoc-withdrawal-form.pdf" target="_blank" '
						. 'style="display: inline-block; padding: 6px 16px; background: #ffffff; color: #16a34a; font-weight: 600; border-radius: 6px; text-decoration: none; border: 2px solid #16a34a; margin-right: 8px;">'
						. 'PSEA Withdrawal Form</a>'
						. '<a class="wsq-portal-btn wsq-portal-btn--psea" href="' . $this->escapeHtml(Mage::getUrl('mmd_psea', array('_query' => array('course' => (string) $_courseSku)))) . '" '
						. 'style="display: inline-block; padding: 8px 18px; background: #16a34a; color: #ffffff; font-weight: 600; border-radius: 6px; text-decoration: none;">'
						. 'Submit PSEA Form</a></p>',
					// No anchor: authored headings use the full scheme name
					// ("SkillsFuture Enterprise Credit (SFEC)"), so a short-code
					// anchor wouldn't match reliably. Append after the existing
					// schemes — PSEA sits last, matching how authored courses show it.
					'before' => '',
				),
			);
			foreach ($_fundingFallbacks as $_badgeName => $_fallback) {
				if (!in_array($_badgeName, $_courseBadges, true)) continue;
				if (stripos($_inner, '>' . $_badgeName . '<') !== false
					|| stripos($_inner, '>' . $_badgeName . ' ') !== false) continue;
				$_anchor = $_fallback['before'];
				$_anchorPattern = '#<h[1-6][^>]*>' . $_WS . '*' . preg_quote($_anchor, '#') . '\b#siu';
				if ($_anchor !== '' && preg_match($_anchorPattern, $_inner, $_am, PREG_OFFSET_CAPTURE)) {
					$_inner = substr($_inner, 0, $_am[0][1]) . $_fallback['html'] . substr($_inner, $_am[0][1]);
				} else {
					$_inner .= $_fallback['html'];
				}
			}

			// Wrap each remaining <h[1-6]>…(body until next h)…</h> into its
			// own .wsq-sub block so the SFC / UTAP / PSEA / SFEC sub-sections
			// render as visually separated mini-cards instead of flat text.
			// Tag each block with a slug derived from the heading text so the
			// CSS can colour-code by scheme.
			$_inner = preg_replace_callback(
				'#<h[1-6][^>]*>(?P<title>.*?)</h[1-6]>(?P<body>.*?)(?=<h[1-6]|\z)#siu',
				function ($m) {
					$titleText = trim(strip_tags($m['title']));
					if ($titleText === '') { return trim($m['body']); }
					// Prefer the acronym in parentheses ("SkillsFuture Credit (SFC)"
					// → "sfc"); otherwise fall back to a slug of the full title.
					if (preg_match('#\(([A-Z]{2,6})\)#u', $titleText, $am)) {
						$slug = strtolower($am[1]);
					} elseif (preg_match('#^([A-Z]{2,6})\b#u', $titleText, $am)) {
						$slug = strtolower($am[1]);
					} else {
						$slug = strtolower(preg_replace('#[^a-z0-9]+#i', '-', $titleText));
						$slug = trim($slug, '-');
					}
					if ($slug === '') { return trim($m['body']); }
					return '<div class="wsq-sub wsq-sub--' . $slug . '">'
						 . '<div class="wsq-sub__title">' . htmlspecialchars($titleText, ENT_QUOTES, 'UTF-8') . '</div>'
						 . '<div class="wsq-sub__body">' . trim($m['body']) . '</div>'
						 . '</div>';
				},
				$_inner
			);

			$_wsqNarrativeHtml = trim($_inner);
		}
	}
	if ($_isNoFundingCourse) {
		$_hasWsqFunding = true;
		$_wsqNarrativeHtml =
			'<p>' . $this->escapeHtml($this->__('No funding is available for this course.')) . '</p>';
	}

	// Helper: build a "<h[1-6]> Section </h[1-6]>(.*?)" extractor whose
	// lookahead stops before any wrapper opening tag that immediately
	// precedes the next heading. Returns [bodyHtml, descriptionWithSectionRemoved].
	//
	// The title may be wrapped in inline formatting tags inside the heading —
	// WYSIWYG authors produce e.g. <h2><span style="font-size: 1.5em;">Course
	// Brochure</span></h2>. Without tolerating those wrappers the section is
	// invisible to this extractor, so it stays inline in the description AND
	// double-renders next to its card (real case: TGS-2020504020, stripped by
	// migration 938). Only inline/presentational tags are allowed through, so
	// the pattern can't run past a real block-level boundary.
	$_extractSection = function ($title, $desc) use ($_WS) {
		$inlineOpen  = '(?:<(?:span|strong|em|b|i|u|font)\b[^>]*>' . $_WS . '*)*';
		$inlineClose = '(?:</(?:span|strong|em|b|i|u|font)>' . $_WS . '*)*';
		$pattern = '#<h[1-6][^>]*>' . $_WS . '*(?:<br\s*/?>' . $_WS . '*)*' . $inlineOpen . $title . $_WS . '*:?' . $_WS . '*' . $inlineClose . '</h[1-6]>(.*?)(?=(?:<[a-z][a-z0-9]*\b[^>]*>' . $_WS . '*)*<h[1-6]|\z)#siu';
		if (preg_match($pattern, $desc, $m)) {
			return [trim($m[1]), preg_replace($pattern, '', $desc)];
		}
		return ['', $desc];
	};

	// (2) Learning Outcomes — per-course cms/block first, regex fallback.
	// Always run the strip so any residual heading in short_description
	// doesn't double-render in the narrative below.
	list($_loExtracted, $shortDescription) = $_extractSection('Learning' . $_WS . '+Outcomes', $shortDescription);
	$_learningOutcomesHtml = $_courseSectionHtml('learning_outcomes');
	if ($_learningOutcomesHtml === '') { $_learningOutcomesHtml = $_loExtracted; }
	unset($_loExtracted);

	// (3) Course Brochure — per-course cms/block first, regex fallback.
	list($_brExtracted, $shortDescription) = $_extractSection('Course' . $_WS . '+Brochure', $shortDescription);
	$_courseBrochureHtml = $_courseSectionHtml('brochure');
	if ($_courseBrochureHtml === '') { $_courseBrochureHtml = $_brExtracted; }
	unset($_brExtracted);
	// Pull the first <a href> out of the brochure block so the CTA button
	// can link to it directly with a clean label.
	$_courseBrochureUrl   = '';
	$_courseBrochureLabel = 'Download Course Brochure';
	if ($_courseBrochureHtml !== '' && preg_match('#<a\s[^>]*href=["\']([^"\']+)["\'][^>]*>(.*?)</a>#siu', $_courseBrochureHtml, $_bm)) {
		$_courseBrochureUrl   = $_bm[1];
		$_clean               = trim(strip_tags($_bm[2]));
		if ($_clean !== '') { $_courseBrochureLabel = $_clean; }
	}
	// Filesystem-first: when a generated brochure file exists for
	// (this SKU, this country), always rebuild the URL from the
	// CURRENT host's media base + the file's mtime. This OVERRIDES
	// whatever URL the admin saved in the brochure CMS-block textarea,
	// which intentionally swallows two failure modes:
	//
	//   - Admin saved a localhost:8080/... link from local-dev and
	//     pushed the CMS block content to prod. Without this override
	//     a live storefront would serve a localhost link to its
	//     learners. The fresh build uses the current store host instead.
	//   - Cache-busting: every regenerate updates the file mtime, so
	//     the `?v=<mtime>` ensures the new PDF is fetched even when
	//     the browser / CDN cached an older version under the same
	//     URL.
	//
	// Manual CMS-block overrides are only honoured when no file
	// exists yet for this (SKU, store). Generated brochures own the
	// link.
	$_brochureCcMap = array(1 => 'SG', 4 => 'NG');
	$_brochureStoreId = (int) Mage::app()->getStore()->getId();
	if ($_courseSku !== '' && isset($_brochureCcMap[$_brochureStoreId])) {
		$_brochureCc   = $_brochureCcMap[$_brochureStoreId];
		$_brochureFile = Mage::getBaseDir('media') . '/courses/brochures/' . $_courseSku . '-' . $_brochureCc . '.pdf';
		if (is_file($_brochureFile)) {
			$_courseBrochureUrl = rtrim(Mage::getBaseUrl('media'), '/')
				. '/courses/brochures/' . rawurlencode($_courseSku . '-' . $_brochureCc) . '.pdf'
				. '?v=' . filemtime($_brochureFile);
		}
	}

	// (4) Skills Framework — per-course cms/block first, regex fallback.
	// Typical body shape:
	//   <h2>Skills Framework</h2>
	//   <p>This course follows the guideline of <strong>{Title} {Code} TSC</strong> under {Framework} Skills Framework</p>
	// TSC Title / TSC Code are derived from the body below.
	list($_sfExtracted, $shortDescription) = $_extractSection('Skills' . $_WS . '+Framework', $shortDescription);
	$_skillsFrameworkRawHtml = $_courseSectionHtml('skills_framework');
	if ($_skillsFrameworkRawHtml === '') { $_skillsFrameworkRawHtml = $_sfExtracted; }
	unset($_sfExtracted);
	$_skillsTitle = '';
	$_skillsCode  = '';
	if ($_skillsFrameworkRawHtml !== '') {
		// Flatten the whole section body to text — the code may sit in a
		// different <strong> from the title (e.g. Power Apps WSQ course has
		// 3 separate strongs: "{Title}", "{Code}", "TSC"). Looking at only
		// the first strong would miss the code entirely.
		$_haystack = html_entity_decode(strip_tags($_skillsFrameworkRawHtml), ENT_QUOTES | ENT_HTML5, 'UTF-8');
		$_haystack = preg_replace('#[\x{00A0}\x{2007}\x{202F}]#u', ' ', $_haystack);
		$_haystack = preg_replace('#\s+#u', ' ', trim($_haystack));

		// Code lookup — strategy 1: anchor on the " T"/" TSC" marker.
		// Strategy 2: structured uppercase-dash-digits pattern.
		// The trailing "TSC" marker is only an anchor for finding the code —
		// it is not part of the code, and the card's own "TSC Code" label
		// already says it, so the displayed value drops it (matching what
		// strategy 2 produces). $_codeFull keeps the marker so the title
		// slice below still removes the whole span.
		$_codeFull = '';
		if (preg_match('#([A-Z]{2,}(?:-[A-Z][A-Z0-9]*)+(?:[-.][0-9][0-9.\-]*)?)\s+(T(?:SC)?)\b#u', $_haystack, $_cm)) {
			$_skillsCode = trim($_cm[1]);
			$_codeFull   = $_cm[0];
		} elseif (preg_match('#([A-Z]{2,}(?:-[A-Z][A-Z0-9]*)+(?:[-.][0-9][0-9.\-]*))#u', $_haystack, $_cm)) {
			$_skillsCode = trim($_cm[1]);
			$_codeFull   = $_cm[0];
		}

		// Title — start from the haystack, slice the code out, then trim the
		// surrounding boilerplate prefix/suffix ("This course follows the
		// guideline of … under … Skills Framework"). What's left is the
		// human-readable framework title.
		$_titleSrc = $_haystack;
		if ($_codeFull !== '') {
			$_titleSrc = preg_replace('#\s*' . preg_quote($_codeFull, '#') . '\s*#u', ' ', $_titleSrc);
		}
		$_titleSrc = preg_replace('#^.*?follows\s+the\s+guideline\s+of\s+#iu', '', $_titleSrc);
		$_titleSrc = preg_replace('#\s+under\s+.*?Skills\s+Framework\s*\.?\s*$#iu', '', $_titleSrc);
		$_skillsTitle = trim($_titleSrc);
	}

	// (5) Certification section.
	// SG store: the per-course cms/block `course_<sku>_certification` is the
	// SOURCE OF TRUTH (migration 885 moved the copy there out of
	// short_description, so ops can edit it from the Edit Course screen).
	//
	// The SKU-keyed writeup below is only a FALLBACK for a course whose block
	// is missing/empty (e.g. a brand-new course created after 885). It keeps
	// the same rules the migration used:
	//   - TGS-* SKUs (WSQ courses) → Certificate of Completion + OpenCert
	//   - CASL and all other SG SKUs (C-prefix etc.) → Certificate only
	// Other stores keep the original per-course extraction.
	if (Mage::app()->getStore()->getId() == 1) {
		// Strip whatever heading variant the description carries so it
		// doesn't double-render inside the course narrative below.
		list($_certIgnored, $shortDescription) = $_extractSection('(?:Certifications?|Certificate)', $shortDescription);
		unset($_certIgnored);

		$_certificationHtml = $_courseSectionHtml('certification');
		if ($_certificationHtml === '') {
			// CASL courses carry TGS- SKUs too but do NOT award OpenCerts
			// (rule 2026-07-23) — key off the name prefix.
			$_isCaslCert = (stripos(trim((string) $_product->getName()), 'CASL') === 0);
			$_isWsqCert = !$_isCaslCert && (stripos((string) $_product->getSku(), 'TGS-') === 0);
			$_certificationHtml  = '<ul class="cert-bullets">';
			$_certificationHtml .= '<li><strong>Certificate of Achievement from Tertiary Infotech Academy Pte Ltd</strong> - Upon meeting at least 75% attendance and passing the assessment(s), participants will receive a Certificate of Achievement from Tertiary Infotech Academy Pte Ltd.</li>';
			if ($_isWsqCert) {
				$_certificationHtml .= '<li><strong>OpenCerts from SkillsFuture Singapore</strong> - After passing the assessment(s) and achieving at least 75% attendance, participants will receive a OpenCert (aka Statement of Achievement) from SkillsFuture Singapore, certifying that they have achieved the Competency Standard(s) in the above Skills Framework.</li>';
			}
			$_certificationHtml .= '</ul>';
		}
	} else {
		// Other active stores: strip the heading variant
		// from short_description so it doesn't double-render, then resolve
		// the cert body in priority order:
		//   1. per-course cms/block `course_<sku>_certification`
		//   2. per-store global cms/block `course_certification` (migration 143)
		//   3. whatever the regex extracted from short_description
		list($_certExtracted, $shortDescription) = $_extractSection('(?:Certifications?|Certificate)', $shortDescription);
		$_certificationHtml = $_courseSectionHtml('certification');
		if ($_certificationHtml === '') {
			$_certificationHtml = $_cmsBlockHtml('course_certification');
		}
		if ($_certificationHtml === '') {
			$_certificationHtml = $_certExtracted;
		}
		unset($_certExtracted);
	}

	// (4b) About IBF Certification — carried by IBF courses only (the TSC
	// addressed + MySkills Portfolio / certification links). Per-course
	// cms/block first, regex fallback from short_description.
	list($_ibfExtracted, $shortDescription) = $_extractSection('About' . $_WS . '+IBF' . $_WS . '+Certifications?', $shortDescription);
	$_aboutIbfHtml = $_courseSectionHtml('about_ibf_certification');
	if ($_aboutIbfHtml === '') { $_aboutIbfHtml = $_ibfExtracted; }
	unset($_ibfExtracted);

	// (4c) Complimentary Exam Voucher — carried only by the courses that bundle
	// a voucher with the class. Block-only (no regex fallback): this copy has
	// never lived in short_description, so an empty block simply means the
	// course doesn't include a voucher and the card stays hidden.
	$_examVoucherHtml = $_courseSectionHtml('exam_voucher');

	if ($_isNoFundingCourse) {
		$shortDescription = preg_replace('#(<p\b[^>]*>\s*)WSQ\s+#iu', '$1', $shortDescription, 1);
		$shortDescription = preg_replace('#^\s*WSQ\s+#iu', '', $shortDescription, 1);
	}

	// "Free Certificate Practice Exams" card: render ONLY for courses in the
	// Cert Prep Training category tree (cat 182) â not other WSQ/non-WSQ courses.
	// exams.tertiaryinfotech.com hosts the free practice exams + exam vouchers.
	// Resolve the certification-course tree by its url_key, not a hardcoded id or
	// name: SG=182 "Cert Prep Training", but the mirrored tree on the MY/GH
	// partner DBs has a different id AND a different name ("CERT Prep Courses").
	// The url_key `certification-exam-prep-courses` is identical on all three
	// sites (it IS the /certification-exam-prep-courses.html landing page), so it
	// fires the card for every course under that page on every site.
	$_hasPracticeExams = false;
	$_courseCatIds = $_product->getCategoryIds();
	if (!empty($_courseCatIds)) {
		$_certRootId = (int) Mage::getResourceModel('catalog/category_collection')
			->addAttributeToFilter('url_key', 'certification-exam-prep-courses')
			->setPageSize(1)
			->getFirstItem()
			->getId();
		if ($_certRootId) {
			$_certPrepRoot = Mage::getModel('catalog/category')->load($_certRootId);
			$_hasPracticeExams = (bool) array_intersect($_courseCatIds, (array) $_certPrepRoot->getAllChildren(true));
		}
	}

	// (5b) Strip the vendor "authorised training/delivery partner" promo blurb
	// out of the course narrative so it no longer renders in the "About" card.
	// The Free Practice Exams card below replaces it. Covers CompTIA (red
	// heading), Microsoft Learning Partner, and Pearson Vue. Autodesk uses an
	// image badge (different markup) and is intentionally left untouched.
	$_beforeStrip = $shortDescription;
	$shortDescription = preg_replace(array(
		// CompTIA red heading + any trailing empty (red) paragraphs.
		'#<h[1-6][^>]*>\s*(?:<span[^>]*>\s*)?We\s+are\s+Authori[sz]ed\s+CompTIA\s+Delivery\s+Partner\.?\s*(?:</span>\s*)?</h[1-6]>(?:\s*<p[^>]*>(?:\s|&nbsp;|<span[^>]*>|</span>|<br\s*/?>)*</p>)*#i',
		// "Microsoft Learning Partner" heading + its "We are Authorised..." paragraph.
		'#<h[1-6][^>]*>\s*Microsoft\s+Learning\s+Partner\s*</h[1-6]>\s*<p[^>]*>.*?</p>#is',
		// Residual "We are Authorised Microsoft Learning Partner (Org ID...)" paragraph.
		'#<p[^>]*>(?:(?!</p>).)*?Authori[sz]ed(?:(?!</p>).)*?Microsoft\s+Learning\s+Partner(?:(?!</p>).)*?</p>#is',
		// Pearson Vue authorised training partner line.
		'#<p[^>]*>\s*<strong>\s*We\s+are\s+Pearson\s+Vue\s+Authori[sz]ed\s+Training\s+Partner\.?\s*</strong>\s*</p>#i',
		// "Certification Exam at Pearson Vue" heading + its "Authorised Pearson
		// Vue Testing Center" / "purchase the exam voucher" paragraphs. The Free
		// Practice Exams card below replaces this vendor-exam blurb.
		'#<h[1-6][^>]*>\s*Certification\s+Exam\s+at\s+Pearson\s+Vue\s*</h[1-6]>(?:\s*<p\b[^>]*>.*?</p>)*#is',
		// "Register for Google Cloud Certification" heading + its "Kryterion
		// Authorized Testing Center / course fee does not include the exam fee"
		// paragraph(s). Same vendor-exam blurb, different vendor.
		'#<h[1-6][^>]*>\s*Register\s+for\s+Google\s+Cloud\s+Certification\s*</h[1-6]>(?:\s*<p\b[^>]*>.*?</p>)*#is',
	), '', $shortDescription);

	// "<X> Exam Voucher" heading + its following paragraph(s): both the "…is
	// included in this course fee" claim AND the voucher-redemption steps (e.g.
	// the PeopleCert "1: Visit … 2: Create account …" block). GUARDED to courses
	// only: the 50 standalone Exam-Voucher PRODUCTS carry "Exam Voucher" in their
	// own name and their description legitimately describes the voucher — never
	// strip those. A course's name never contains "Exam Voucher".
	if (stripos((string) $_product->getName(), 'Exam Voucher') === false) {
		$shortDescription = preg_replace(
			'#<h[1-6][^>]*>[^<]*Exam\s+Voucher[^<]*</h[1-6]>(?:\s*<p\b[^>]*>.*?</p>)*#is',
			'',
			$shortDescription
		);
	}

	// Show the Free Practice Exams card whenever we actually removed a partner
	// blurb — this is the store-independent "remove → replace" pairing. The
	// cat-182 gate above is SG-specific (partner sites have their own category
	// IDs), so relying on it alone would leave MY/GH with the blurb stripped
	// but no card. OR-ing the two covers both: SG cert-prep courses without a
	// blurb still get the card; MY/GH cert courses get it via the strip.
	$_hasPracticeExams = $_hasPracticeExams || ($shortDescription !== $_beforeStrip);

	// Free Practice Exams card (button-CTA design). Placed in the left column
	// on SG and in the primary (center) column, right after the "About" card,
	// on the partner stores (MY/GH). Built once here; echoed per store below.
	$_isSgStore = (Mage::app()->getStore()->getCode() === 'singapore');
	$_practiceExamCardHtml = '';
	if ($_hasPracticeExams) {
		$_practiceExamCardHtml =
			'<section class="course-policy-card course-policy-card--practice">'
			. '<header class="course-policy-card__header">'
			. '<span class="course-policy-card__icon" aria-hidden="true">'
			. '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>'
			. '</span>'
			. '<h3 class="course-policy-card__title">Bonus: Free Practice Exams</h3>'
			. '</header>'
			. '<div class="course-policy-card__body std">'
			. '<p>Get exam-ready on our <strong>Practice Exam Portal</strong> &mdash; train in realistic <strong>Practice Mode</strong> and timed <strong>Exam Mode</strong>, then retake them as many times as you like before the real exam.</p>'
			. '<p><a class="practice-exam-cta" href="https://exams.tertiaryinfotech.com/" target="_blank" rel="noopener">Start Practising &rarr;</a></p>'
			. '</div>'
			. '</section>';
	}

	// (5c) ATC / partner accreditations (2026-08). The inline "Autodesk ATC"
	// remark (heading + "We are Autodesk Authorized Training Center..."
	// paragraph, or the legacy image-badge variant) is stripped from the
	// narrative at render time — the atc_partners-driven cards below replace
	// it. Kept separate from the (5b) strip array so it doesn't toggle the
	// Free Practice Exams card.
	$shortDescription = preg_replace(array(
		// "Autodesk ATC" heading + its following paragraph(s).
		'#<h[1-6][^>]*>\s*Autodesk\s+ATC\s*</h[1-6]>(?:\s*<p\b[^>]*>.*?</p>)*#is',
		// Standalone "We are Autodesk Authorised Training Center" paragraph.
		'#<p[^>]*>(?:(?!</p>).)*?We\s+are(?:(?!</p>).)*?Autodesk\s+Authori[sz]ed\s+Training\s+Cent(?:er|re)(?:(?!</p>).)*?</p>#is',
		// Legacy Autodesk ATC image-badge paragraph.
		'#<p[^>]*>(?:(?!</p>).)*?<img[^>]*autodesk-atc[^>]*>(?:(?!</p>).)*?</p>#is',
	), '', $shortDescription);

	// (5d) ATC / partner-accreditation cards — driven by the `atc_partners`
	// attribute (Edit Course → ATC checkboxes). One card per selected
	// partner, title = the partner accreditation name, canonical copy from
	// MMD_CourseImage_Helper_Data::getAtcPartners(). Rendered below the
	// About (course description) card.
	$_atcCardsHtml = '';
	try {
		$_atcHelper = Mage::helper('mmd_courseimage');
		$_atcVocab  = $_atcHelper->getAtcPartners();
		foreach ($_atcHelper->getProductAtcPartners($_product) as $_atcKey) {
			$_atcCardsHtml .= '<section class="course-policy-card course-policy-card--atc">'
				. '<header class="course-policy-card__header">'
				. '<span class="course-policy-card__icon" aria-hidden="true">'
				. '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>'
				. '</span>'
				. '<h3 class="course-policy-card__title">' . htmlspecialchars($_atcVocab[$_atcKey]['label'], ENT_COMPAT, 'UTF-8') . '</h3>'
				. '</header>'
				. '<div class="course-policy-card__body std">' . $_atcVocab[$_atcKey]['html'] . '</div>'
				. '</section>';
		}
	} catch (Exception $e) {
		$_atcCardsHtml = '';
	}

	// (6) Funding and Grant. Per-course cms/block first, regex fallback
	// for legacy content still in short_description. Stores without this
	// section return empty from both block and regex, so no card renders.
	list($_fgExtracted, $shortDescription) = $_extractSection('Funding' . $_WS . '+(?:and|&amp;|&)' . $_WS . '+Grant', $shortDescription);
	// Merged single block: funding_and_grant cms/block holds either WSQ
	// narrative (SG WSQ) or HRD Corp content (MY) per course. When the WSQ
	// card has ALREADY consumed it ($_hasWsqFunding == true), suppress the
	// separate Funding and Grant card to avoid rendering the same content
	// twice. SG WSQ (TGS-) courses are checkbox-driven and never read the
	// block — without this guard, unticking WSQ would resurface the retired
	// block as a Funding and Grant card. Otherwise (non-WSQ products), this
	// card renders the block.
	if ($_hasWsqFunding || $_isSgWsqCourse) {
		$_fundingAndGrantHtml = '';
	} else {
		$_fundingAndGrantHtml = $_courseSectionHtml('funding_and_grant');
		if ($_fundingAndGrantHtml === '') { $_fundingAndGrantHtml = $_fgExtracted; }
	}
	unset($_fgExtracted);

	// (6b) Funding Validity — renders as its own card right after the funding
	// card(s). A per-course cms/block override wins (legacy CASL
	// re-registrations); otherwise every WSQ course (TGS- SKU) builds the card
	// from the Funding Validity Start/End Date attributes (news_from_date /
	// news_to_date, repurposed + seeded from the SSG TPG master list by
	// migrations 875/876). Partner sites carry no TGS- SKUs, so this is
	// SG-only by construction.
	$_fundingValidityHtml = $_courseSectionHtml('funding_validity');
	if ($_fundingValidityHtml === '' && stripos((string)$_product->getSku(), 'TGS-') === 0) {
		$_fvStartTs = $_product->getData('news_from_date') ? strtotime($_product->getData('news_from_date')) : 0;
		$_fvEndTs   = $_product->getData('news_to_date')   ? strtotime($_product->getData('news_to_date'))   : 0;
		if ($_fvStartTs && $_fvEndTs) {
			$_fundingValidityHtml = '<p>Funding for this course is valid from <strong>' . date('j M Y', $_fvStartTs)
				. '</strong> to <strong>' . date('j M Y', $_fvEndTs)
				. '</strong>. Register and complete the course within this period to qualify for funding support.</p>';
		}
		unset($_fvStartTs, $_fvEndTs);
	}

	//Rich snippets
	$useRichSnippets = ($helperSnippets->isEnabledOnProductPage() && $productTypeId !== 'grouped');
	$priceProperties = '';
	if ($useRichSnippets)
	{
		$priceProperties = $helperSnippets->getPriceProperties($_product); //Has to be called before getOfferItemscope
	}

	//Get grid classes for product page sections
	$grid = $helperThis->getGridClasses();

	//Product collaterals
	//--------------------------------------------------------------
	$section = array();
	$relatedProductsHtml = '';
	$upsellProductsHtml = '';
	
	//Related products.
	//If related products not assigned to collateral data container.
	if (!$theme->getCfg('product_page/collateral_related'))
	{
		$replaceRelated = $theme->getCfg('product_page/replace_related');
		if ($replaceRelated == 1) //don't replace with static block
		{
			if ($tmpHtml = trim($this->getChildHtml('related_products_wrapper')))
				$relatedProductsHtml = $tmpHtml;
			//$relatedProductsHtml = trim($this->getChildHtml('related_products_wrapper'));
		}
		elseif ($replaceRelated == 2) //if related is empty, replace with static block
		{
			if ($tmpHtml = trim($this->getChildHtml('related_products_wrapper')))
				$relatedProductsHtml = $tmpHtml;
			else //related empty
				if ($tmpHtml = $this->getChildHtml('block_product_replace_related'))
					$relatedProductsHtml = '<div class="block_product_replace_related">'. $tmpHtml .'</div>';
		}
		elseif ($replaceRelated == 3) //replace with static block
		{
			if ($tmpHtml = $this->getChildHtml('block_product_replace_related'))
				$relatedProductsHtml = '<div class="block_product_replace_related">'. $tmpHtml .'</div>';
		}
	}

	//Up-sell products.
	//If up-sell products not assigned to collateral data container.
	if (!$theme->getCfg('product_page/collateral_upsell'))
	{
		$replaceUpsell = $theme->getCfg('product_page/replace_upsell');
		if ($replaceUpsell == 1) //don't replace with static block
		{
			if ($tmpHtml = trim($this->getChildHtml('upsell_products_wrapper')))
				$upsellProductsHtml = $tmpHtml;
			//$upsellProductsHtml = $this->getChildHtml('upsell_products_wrapper');
		}
		elseif ($replaceUpsell == 2) //if upsell is empty, replace with static block
		{
			if ($tmpHtml = trim($this->getChildHtml('upsell_products_wrapper')))
				$upsellProductsHtml = $tmpHtml;
			else //upsell empty
				if ($tmpHtml = $this->getChildHtml('block_product_replace_upsell'))
					$upsellProductsHtml = '<div class="block_product_replace_upsell">'. $tmpHtml .'</div>';
		}
		elseif ($replaceUpsell == 3) //replace with static block
		{
			if ($tmpHtml = $this->getChildHtml('block_product_replace_upsell'))
				$upsellProductsHtml = '<div class="block_product_replace_upsell">'. $tmpHtml .'</div>';
		}
	}

	//Assign blocks to selected position
	$p = array();

	// ----------------------------------------------------------------------
	// Recommended Courses (tabbed) + right-column Photo Gallery
	//
	// Defaults from Ultimo:
	//   related_position = secCol_3   (right column)
	//   upsell_position  = lowerPrimCol_2 (full-width bottom)
	//
	// We override that wiring:
	//   * Bottom of page: ONE block "Recommended Courses" with two tabs —
	//     "You May Be Interested" (upsells) and "Related Courses". Lets the
	//     learner flip between two angles of cross-sell without scrolling
	//     twice. Tabs hidden if either list is empty.
	//   * Right column (was Related): a Photo Gallery sourced from the
	//     product's standard Media Gallery (Manage Images). Skips the base
	//     image so we don't double-show the hero. Renders nothing if the
	//     product has no extra gallery images — no empty wrapper.
	// ----------------------------------------------------------------------

	$relatedTabHtml = trim((string) $relatedProductsHtml);
	$upsellTabHtml  = trim((string) $upsellProductsHtml);
	$recommendedHtml = '';
	if ($relatedTabHtml !== '' || $upsellTabHtml !== '') {
		$tabs = array();
		if ($upsellTabHtml !== '') {
			$tabs['upsell'] = array(
				'label' => $this->__('Recommended Courses'),
				'html'  => $upsellTabHtml,
			);
		}
		if ($relatedTabHtml !== '') {
			$tabs['related'] = array(
				'label' => $this->__('Related Courses'),
				'html'  => $relatedTabHtml,
			);
		}
		$activeKey = array_key_first($tabs);
		$recommendedHtml .= '<div class="box-collateral box-recommended">';
		// Parent heading intentionally omitted — the tab labels carry the
		// section name; an extra "Recommended Courses" h3 above them was
		// visually redundant.
		$recommendedHtml .= '<ul class="recommended-tabs" role="tablist">';
		foreach ($tabs as $k => $tab) {
			$active = ($k === $activeKey) ? ' is-active' : '';
			$recommendedHtml .= '<li class="recommended-tab' . $active . '" role="tab" data-target="recommended-' . $k . '" aria-selected="' . ($k === $activeKey ? 'true' : 'false') . '">' . $tab['label'] . '</li>';
		}
		$recommendedHtml .= '</ul>';
		foreach ($tabs as $k => $tab) {
			$active = ($k === $activeKey) ? ' is-active' : '';
			$recommendedHtml .= '<div class="recommended-panel' . $active . '" id="recommended-' . $k . '" role="tabpanel">';
			// Strip the original block's own h3 — the parent block owns the heading now.
			$panel = preg_replace('#<h3 class="section-title[^"]*">.*?</h3>#s', '', $tab['html'], 1);
			$recommendedHtml .= $panel;
			$recommendedHtml .= '</div>';
		}
		$recommendedHtml .= '</div>';
		// JS tab toggle — vanilla, no jQuery dependency.
		if (count($tabs) > 1) {
			$recommendedHtml .= <<<HTML
<script>
(function(){
	var box = document.currentScript.previousElementSibling;
	if (!box) return;
	var tabs = box.querySelectorAll('.recommended-tab');
	var panels = box.querySelectorAll('.recommended-panel');
	// Owl Carousel 1.x measures width at init time; sliders living inside a
	// display:none tab read width=0 and fall back to a single column. When a
	// tab is activated we trigger an Owl refresh so the carousel re-measures
	// against the now-visible panel.
	function refreshSliders(panel) {
		if (!window.jQuery) return;
		var sliders = panel.querySelectorAll('.itemslider');
		sliders.forEach(function(el){
			var \$el = window.jQuery(el);
			var data = \$el.data('owlCarousel');
			if (data) {
				if (typeof data.reinit === 'function') {
					data.reinit();
				} else if (typeof \$el.trigger === 'function') {
					\$el.trigger('owl.refresh');
				}
			}
		});
	}
	tabs.forEach(function(t){
		t.addEventListener('click', function(){
			tabs.forEach(function(x){ x.classList.remove('is-active'); x.setAttribute('aria-selected','false'); });
			panels.forEach(function(x){ x.classList.remove('is-active'); });
			t.classList.add('is-active');
			t.setAttribute('aria-selected','true');
			var target = document.getElementById(t.getAttribute('data-target'));
			if (target) {
				target.classList.add('is-active');
				refreshSliders(target);
			}
		});
	});
})();
</script>
HTML;
		}
	}
	if ($recommendedHtml !== '') {
		$p['lowerPrimCol_2'] = isset($p['lowerPrimCol_2']) ? $p['lowerPrimCol_2'] . $recommendedHtml : $recommendedHtml;
	}

	// Photo Gallery — replaces what Ultimo's related block used to render in
	// the right column. Walks the product's Media Gallery, drops the image
	// flagged as base (already shown as the main product image), and renders
	// the rest as a simple thumbnail grid. Each thumb links to the full-size
	// image so the existing lightbox / direct view works.
	$photoGalleryHtml = '';
	if (method_exists($_product, 'getMediaGalleryImages')) {
		$galleryImages = $_product->getMediaGalleryImages();
		$baseImage = (string) $_product->getImage();
		$extras = array();
		if ($galleryImages) {
			foreach ($galleryImages as $img) {
				if ($img->getDisabled()) continue;
				if ($baseImage !== '' && $baseImage !== 'no_selection' && $img->getFile() === $baseImage) continue;
				$extras[] = $img;
			}
		}
		if (!empty($extras)) {
			$photoGalleryHtml .= '<div class="box-collateral box-photo-gallery">';
			$photoGalleryHtml .= '<h3 class="section-title padding-right">' . $this->__('Photo Gallery') . '</h3>';
			$photoGalleryHtml .= '<ul class="photo-gallery-grid">';
			foreach ($extras as $img) {
				$full  = $this->escapeHtml($img->getUrl());
				$label = $this->escapeHtml((string) $img->getLabel());
				$photoGalleryHtml .= '<li class="photo-gallery-item"><a href="' . $full . '" target="_blank" rel="noopener"><img src="' . $full . '" alt="' . $label . '" loading="lazy" /></a></li>';
			}
			$photoGalleryHtml .= '</ul></div>';
		}
	}
	if ($photoGalleryHtml !== '') {
		$p['secCol_3'] = isset($p['secCol_3']) ? $p['secCol_3'] . $photoGalleryHtml : $photoGalleryHtml;
	}

	//Product collateral data (displayed as tabs or stacked blocks)
