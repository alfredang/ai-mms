<script>(function(){var EN=<?php echo $k?'true':'false'; ?>,ps=false;
function v(){var e="",f=document.forms["hiringForm"];if(!f["name"].value)e+="Please enter your name<br/>";if(!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value))e+="Please enter a valid email<br/>";if(!f["roles"].value)e+="Please select the role you are applying for<br/>";if(!f["nationality"].value)e+="Please select your nationality<br/>";if(!f["comment"].value)e+="Please add a cover note<br/>";document.getElementById("hiring-error").innerHTML=e;return e==="";}
function s(){var b=document.getElementById("hiring-submit");if(b)b.disabled=true;document.forms["hiringForm"].submit();}
window.onHireTs=function(t){var i=document.getElementById("hiring-tk");if(i)i.value=t;if(ps){ps=false;s();}};window.onHireTsE=function(){ps=false;document.getElementById("hiring-error").innerHTML="Spam check could not run. Please refresh and try again.";};window.onHireTsX=function(){var i=document.getElementById("hiring-tk");if(i)i.value="";};
