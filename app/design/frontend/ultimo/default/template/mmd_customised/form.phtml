<?php $ts=Mage::helper('magentocaptcha/turnstile'); $k=$ts->getSiteKey(); $u=Mage::getUrl('customised/index/post'); ?>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style>
.tcu-w{max-width:760px;margin:34px auto 0;background:#fff;border:1px solid #e6e9ef;border-radius:16px;box-shadow:0 18px 50px rgba(15,23,42,.08);overflow:hidden}
.tcu-h{background:linear-gradient(135deg,#0f172a,#14304a);color:#fff;padding:26px 30px}.tcu-h h3{color:#fff;margin:0 0 4px;font-size:24px}.tcu-h p{color:#9fb3c8;margin:0;font-size:15px}
.tcu-b{padding:26px 30px 30px}.tcu-row{display:flex;gap:16px;flex-wrap:wrap}.tcu-f{flex:1 1 220px;margin-bottom:16px}.tcu-f.full{flex-basis:100%}
.tcu-f label{display:block;font-weight:600;color:#0f172a;font-size:14px;margin-bottom:6px}.tcu-f label .r{color:#f4511e}
.tcu-f input,.tcu-f textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid #d6dbe4;border-radius:9px;font-size:15px;background:#fbfcfe}
.tcu-f input:focus,.tcu-f textarea:focus{outline:none;border-color:#14b8a6;box-shadow:0 0 0 3px rgba(20,184,166,.16);background:#fff}.tcu-f textarea{min-height:100px;resize:vertical}
.tcu-e{color:#dc2626;font-size:14px;margin:0 0 14px;min-height:1px}
.tcu-s{display:inline-flex;align-items:center;gap:10px;background:#f4511e;color:#fff;border:0;border-radius:999px;padding:14px 30px;font-size:16px;font-weight:700;cursor:pointer}.tcu-s:hover{background:#d63c0c}
</style>
<div class="tcu-w" id="customised-enquiry">
  <div class="tcu-h"><h3><?php echo $this->__('Request Customised Training') ?></h3><p><?php echo $this->__('Tell us your training needs and we will design a programme for your team.') ?></p></div>
  <div class="tcu-b">
    <form action="<?php echo $u ?>" method="post" id="customisedForm" name="customisedForm">
      <div class="tcu-e" id="customised-error"></div>
      <div class="tcu-row"><div class="tcu-f"><label><?php echo $this->__('Full Name') ?> <span class="r">*</span></label><input type="text" name="name" maxlength="255"/></div>
        <div class="tcu-f"><label><?php echo $this->__('Email') ?> <span class="r">*</span></label><input type="email" name="email" maxlength="255"/></div></div>
      <div class="tcu-row"><div class="tcu-f"><label><?php echo $this->__('Phone / WhatsApp') ?></label><input type="text" name="telephone" maxlength="64"/></div>
        <div class="tcu-f"><label><?php echo $this->__('Company / Organisation') ?></label><input type="text" name="company" maxlength="255"/></div></div>
      <div class="tcu-row"><div class="tcu-f"><label><?php echo $this->__('No. of Participants') ?></label><input type="text" name="num_pax" maxlength="32"/></div>
        <div class="tcu-f"><label><?php echo $this->__('Preferred Dates') ?></label><input type="text" name="preferred_dates" maxlength="128"/></div></div>
      <div class="tcu-f full"><label><?php echo $this->__('Training Topic / Course') ?></label><input type="text" name="training_topic" maxlength="255" placeholder="<?php echo $this->__('e.g. Generative AI, Cyber Security, Data Analytics') ?>"/></div>
      <div class="tcu-f full"><label><?php echo $this->__('Tell us more about your requirements') ?> <span class="r">*</span></label><textarea name="comment"></textarea></div>
      <input type="hidden" name="source" value="customised-training"/>
      <input type="text" name="hideit" value="" tabindex="-1" autocomplete="off" style="display:none !important;"/>
      <input type="hidden" name="cf-turnstile-response" id="customised-tk" value=""/>
      <?php if ($k): ?><div class="cf-turnstile" data-sitekey="<?php echo $this->htmlEscape($k) ?>" data-size="invisible" data-callback="onCustTs" data-error-callback="onCustTsE" data-expired-callback="onCustTsX"></div><?php endif; ?>
      <button type="submit" id="customised-submit" class="tcu-s"><?php echo $this->__('Submit Enquiry') ?></button>
    </form>
  </div>
</div>
<script>(function(){var EN=<?php echo $k?'true':'false'; ?>,ps=false;
function v(){var e="",f=document.forms["customisedForm"];if(!f["name"].value)e+="Please enter your name<br/>";if(!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value))e+="Please enter a valid email<br/>";if(!f["comment"].value)e+="Please describe your requirements<br/>";document.getElementById("customised-error").innerHTML=e;return e==="";}
function s(){var b=document.getElementById("customised-submit");if(b)b.disabled=true;document.forms["customisedForm"].submit();}
window.onCustTs=function(t){var i=document.getElementById("customised-tk");if(i)i.value=t;if(ps){ps=false;s();}};window.onCustTsE=function(){ps=false;document.getElementById("customised-error").innerHTML="Spam check could not run. Please refresh and try again.";};window.onCustTsX=function(){var i=document.getElementById("customised-tk");if(i)i.value="";};
document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("customisedForm");if(!f)return;f.addEventListener("submit",function(e){e.preventDefault();if(!v())return;if(!EN||typeof window.turnstile==="undefined"){s();return;}var i=document.getElementById("customised-tk");if(i&&i.value){s();return;}ps=true;try{window.turnstile.execute();}catch(x){ps=false;s();}});});})();</script>
