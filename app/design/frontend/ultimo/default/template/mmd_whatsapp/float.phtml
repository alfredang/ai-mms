         : (in_array($code, array('ghana', 'gh'), true) ? 'gh' : 'sg');

// Per-site support avatar (SG = same as exams.tertiaryinfotech.com).
$avatar = $this->getSkinUrl('images/chat-avatar-' . $country . '.svg');

// The funding question is the only per-country suggestion.
$fundingQuestion = array(
    'sg' => 'Can I use SkillsFuture Credit or WSQ funding?',
    'my' => 'Is this course HRD Corp claimable?',
    'gh' => 'Do you offer corporate or group training?',
);
$questions = array(
    $this->__('Hi! I\'d like to know more about your courses.'),
    $this->__($fundingQuestion[$country]),
    $this->__('When is the next available class?'),
    $this->__('I need help with a registration or payment.'),
