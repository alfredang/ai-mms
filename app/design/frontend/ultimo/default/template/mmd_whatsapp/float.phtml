</div>

<script type="text/javascript">
//<![CDATA[
(function () {
    var root = document.getElementById('mmd-wa');
    if (!root) { return; }
    var launcher = document.getElementById('mmd-wa-launcher');
    var popup    = document.getElementById('mmd-wa-popup');
    var greet    = document.getElementById('mmd-wa-greet');
    var KEY      = 'mmd-wa-greeting-dismissed';

    function isOpen() { return root.classList.contains('is-open'); }
    function open() {
        root.classList.add('is-open');
        popup.hidden = false;
        launcher.setAttribute('aria-expanded', 'true');
    }
    function close() {
        root.classList.remove('is-open');
        popup.hidden = true;
        launcher.setAttribute('aria-expanded', 'false');
    }
    function dismissGreeting() {
        greet.hidden = true;
        try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
    }

    launcher.addEventListener('click', function () {
        dismissGreeting();
        if (isOpen()) { close(); } else { open(); }
    });
    document.getElementById('mmd-wa-close').addEventListener('click', close);
    document.getElementById('mmd-wa-greet-open').addEventListener('click', function () {
        dismissGreeting();
        open();
    });
    document.getElementById('mmd-wa-greet-close').addEventListener('click', dismissGreeting);
    var links = popup.getElementsByTagName('a');
    for (var i = 0; i < links.length; i++) { links[i].addEventListener('click', close); }
    document.addEventListener('mousedown', function (e) {
        if (isOpen() && !root.contains(e.target)) { close(); }
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' || e.keyCode === 27) { close(); }
    });

    // Greeting bubble: show after 2.5s, auto-hide after 12s, once per session.
    var seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    if (!seen) {
        setTimeout(function () { if (!isOpen()) { greet.hidden = false; } }, 2500);
        setTimeout(function () { greet.hidden = true; }, 12000);
    }
})();
//]]>
</script>
