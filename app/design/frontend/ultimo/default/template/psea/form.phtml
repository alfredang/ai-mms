<script type="text/javascript">
(function () {
    var TURNSTILE_ENABLED = <?php echo $tsSiteKey ? 'true' : 'false'; ?>;
    var MAX_BYTES = 8388608;
    var pendingSubmit = false;

    function validateForm() {
        var error = "";
        var f = document.forms["pseaForm"];
        if (!f["name"].value) { error += "Please enter your name<br/>"; }
        if (!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value)) {
            error += "Please enter a valid email<br/>";
        }
        var file = f["psea_form"];
        if (!file.files || !file.files.length) {
            error += "Please attach your filled PSEA Withdrawal Form<br/>";
        } else {
            var name = file.files[0].name.toLowerCase();
            if (!/\.(pdf|jpe?g|png)$/.test(name)) {
                error += "The form must be a PDF, JPG or PNG file<br/>";
            } else if (file.files[0].size > MAX_BYTES) {
                error += "The attached file is over 8 MB — please compress it<br/>";
            }
        }
        document.getElementById("error").innerHTML = error;
        return error === "";
    }

    function doSubmit() {
        var btn = document.getElementById("tc-submit-btn");
        if (btn) { btn.disabled = true; }
        document.forms["pseaForm"].submit();
    }

    window.onTurnstileSuccess = function (token) {
        var input = document.getElementById("cf-turnstile-response");
        if (input) { input.value = token; }
        if (pendingSubmit) { pendingSubmit = false; doSubmit(); }
    };
    window.onTurnstileError = function () {
        pendingSubmit = false;
        document.getElementById("error").innerHTML =
            "Spam check could not run. Please refresh the page and try again.";
    };
    window.onTurnstileExpired = function () {
        var input = document.getElementById("cf-turnstile-response");
        if (input) { input.value = ""; }
    };

    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("pseaForm");
        if (!form) { return; }
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) { return; }
            if (!TURNSTILE_ENABLED || typeof window.turnstile === "undefined") { doSubmit(); return; }
            var input = document.getElementById("cf-turnstile-response");
            if (input && input.value) { doSubmit(); return; }
            pendingSubmit = true;
            try { window.turnstile.execute(); }
            catch (err) { pendingSubmit = false; doSubmit(); }
        });
    });
})();
</script>
