<script type="text/javascript">
(function () {
    var TURNSTILE_ENABLED = <?php echo $tsSiteKey ? 'true' : 'false'; ?>;
    var pendingSubmit = false;
    function validateForm() {
        var error = "", f = document.forms["trainerForm"];
        if (!f["name"].value) { error += "Please enter your name<br/>"; }
        if (!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value)) { error += "Please enter a valid email<br/>"; }
        if (!f["comment"].value) { error += "Please add a brief introduction<br/>"; }
        document.getElementById("trainer-error").innerHTML = error;
        return error === "";
    }
    function doSubmit() {
        var btn = document.getElementById("trainer-submit");
        if (btn) { btn.disabled = true; }
        document.forms["trainerForm"].submit();
    }
    window.onTrainerTurnstileSuccess = function (token) {
        var input = document.getElementById("trainer-turnstile-token");
        if (input) { input.value = token; }
        if (pendingSubmit) { pendingSubmit = false; doSubmit(); }
    };
    window.onTrainerTurnstileError = function () {
        pendingSubmit = false;
        document.getElementById("trainer-error").innerHTML = "Spam check could not run. Please refresh the page and try again.";
    };
    window.onTrainerTurnstileExpired = function () {
        var input = document.getElementById("trainer-turnstile-token");
        if (input) { input.value = ""; }
    };
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("trainerForm");
        if (!form) { return; }
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) { return; }
            if (!TURNSTILE_ENABLED || typeof window.turnstile === "undefined") { doSubmit(); return; }
            var input = document.getElementById("trainer-turnstile-token");
            if (input && input.value) { doSubmit(); return; }
            pendingSubmit = true;
            try { window.turnstile.execute(); }
            catch (err) { pendingSubmit = false; doSubmit(); }
        });
    });
})();
</script>
