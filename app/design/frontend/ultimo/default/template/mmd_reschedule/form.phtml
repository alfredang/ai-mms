</div>
<script>(function(){var EN=<?php echo $k?'true':'false'; ?>,ps=false;
function v(){var e="",f=document.forms["reschedForm"];
if(!f["name"].value)e+="Please enter your name<br/>";
if(!f["nric"].value)e+="Please enter your NRIC<br/>";
if(!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value))e+="Please enter a valid email<br/>";
if(!f["telephone"].value)e+="Please enter your phone number<br/>";
if(!f["course"].value)e+="Please enter the course title<br/>";
if(!f["course_code"].value)e+="Please enter the course code<br/>";
if(!f["current_date"].value)e+="Please enter the course start date<br/>";
document.getElementById("resched-error").innerHTML=e;return e==="";}
function s(){var b=document.getElementById("resched-submit");if(b)b.disabled=true;document.forms["reschedForm"].submit();}
window.onRsTs=function(t){var i=document.getElementById("resched-tk");if(i)i.value=t;if(ps){ps=false;s();}};window.onRsTsE=function(){ps=false;document.getElementById("resched-error").innerHTML="Spam check could not run. Please refresh and try again.";};window.onRsTsX=function(){var i=document.getElementById("resched-tk");if(i)i.value="";};
document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("reschedForm");if(!f)return;f.addEventListener("submit",function(e){e.preventDefault();if(!v())return;if(!EN||typeof window.turnstile==="undefined"){s();return;}var i=document.getElementById("resched-tk");if(i&&i.value){s();return;}ps=true;try{window.turnstile.execute();}catch(x){ps=false;s();}});});})();</script>
