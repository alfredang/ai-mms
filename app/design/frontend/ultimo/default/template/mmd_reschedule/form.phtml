      <div class="tcs-f"><label><?php echo $this->__('Course Start Date') ?> <span class="r">*</span></label><input type="text" name="current_date" maxlength="64" placeholder="<?php echo $this->__('e.g. 12 May 2026') ?>"/></div>
      <div class="tcs-f"><label><?php echo $this->__('Next Course Start Date') ?></label><input type="text" name="preferred_date" maxlength="64" placeholder="<?php echo $this->__('e.g. 9 Jun 2026') ?>"/>
        <span class="tcs-hint"><?php echo $this->__('Please refer to the') ?> <a href="<?php echo Mage::getUrl('') ?>" target="_blank"><?php echo $this->__('course schedule on our website') ?></a> <?php echo $this->__('for available dates.') ?></span></div>
