</style>
<div class="tcs-w" id="reschedule-enquiry">
  <div class="tcs-h"><h3><?php echo $this->__('Request a Class Reschedule') ?></h3><p><?php echo $this->__('Complete the form below and our team will confirm your new class date.') ?></p></div>
  <div class="tcs-b"><form action="<?php echo $u ?>" method="post" id="reschedForm" name="reschedForm">
    <div class="tcs-e" id="resched-error"></div>
    <div class="tcs-row">
      <div class="tcs-f"><label><?php echo $this->__('Name') ?> <span class="r">*</span></label><input type="text" name="name" maxlength="255"/></div>
