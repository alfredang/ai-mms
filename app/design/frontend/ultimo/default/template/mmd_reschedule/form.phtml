      <div class="tcs-f"><label><?php echo $this->__('Email') ?> <span class="r">*</span></label><input type="email" name="email" maxlength="255"/></div>
      <div class="tcs-f"><label><?php echo $this->__('Phone') ?> <span class="r">*</span></label><input type="text" name="telephone" maxlength="64"/></div>
    </div>
    <div class="tcs-row">
      <div class="tcs-f"><label><?php echo $this->__('Course Title') ?> <span class="r">*</span></label><input type="text" name="course" maxlength="255"/></div>
      <div class="tcs-f"><label><?php echo $this->__('Course Code') ?> <span class="r">*</span></label><input type="text" name="course_code" maxlength="64"/></div>
    </div>
