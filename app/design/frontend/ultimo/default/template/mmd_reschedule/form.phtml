<script>
(function () {
'use strict';

var RS = {
    email:          '',
    verifiedEmail:  '',
    selectedCourse: null,
    resendTimer:    null,
    resendCountdown:0,
    tsEnabled:      <?= $tsEnabled ? 'true' : 'false' ?>,
    isFallback:     false,
    ajaxBase:       '<?= $this->escapeHtml(rtrim(Mage::getUrl('reschedule/ajax'), '/')) ?>/',
};

// ---- Utility -------------------------------------------------------

function qs(id) { return document.getElementById(id); }

function showError(msg) {
    var el = qs('rs-error');
    el.textContent = msg;
    el.style.display = msg ? 'block' : 'none';
    if (msg) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function setLoading(btnId, loading) {
    var btn = qs(btnId);
    if (!btn) return;
    btn.disabled = loading;
    if (loading) {
        btn.dataset.origText = btn.textContent;
        btn.textContent = 'Please wait…';
    } else if (btn.dataset.origText) {
        btn.textContent = btn.dataset.origText;
    }
}

function post(action, data) {
    var params = Object.keys(data).map(function(k) {
        return encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
    }).join('&');
    return fetch(RS.ajaxBase + action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params,
        credentials: 'same-origin',
    }).then(function(r) { return r.json(); });
}

// ---- Progress bar --------------------------------------------------

function rsGoStep(n) {
    showError('');
    ['1','2','3','4','fallback'].forEach(function(s) {
        var el = qs('rs-step-' + s);
        if (el) el.classList.remove('active');
    });
    var target = qs('rs-step-' + n);
    if (target) target.classList.add('active');

    var showProgress = (n !== 'fallback');
    qs('rs-progress').style.display = showProgress ? 'flex' : 'none';
    if (!showProgress) return;

    var stepNum = parseInt(n, 10);
    for (var i = 1; i <= 4; i++) {
        var dot  = qs('rs-d' + i);
        var line = i < 4 ? qs('rs-l' + i) : null;
        if (i < stepNum)       { dot.className = 'rs-dot done'; }
        else if (i === stepNum){ dot.className = 'rs-dot active'; }
        else                   { dot.className = 'rs-dot'; }
        if (line) line.className = (i < stepNum) ? 'rs-line done' : 'rs-line';
    }
}
window.rsGoStep = rsGoStep;

// ---- Step 1: Send OTP ----------------------------------------------

window.rsSendOtp = function() {
    var email = qs('rs-email').value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
    }
    RS.email = email;
    setLoading('rs-btn-sendotp', true);
    post('sendotp', { email: email }).then(function(r) {
        setLoading('rs-btn-sendotp', false);
        if (!r.ok) { showError(r.message || 'Could not send code. Please try again.'); return; }
        qs('rs-otp-email-display').textContent = email;
        rsGoStep(2);
        rsStartResendTimer(60);
        var boxes = qs('rs-otp-boxes').querySelectorAll('input');
        if (boxes.length) boxes[0].focus();
    }).catch(function() {
        setLoading('rs-btn-sendotp', false);
        showError('Network error. Please try again.');
    });
};

window.rsResendOtp = function() {
    post('sendotp', { email: RS.email }).then(function(r) {
        if (!r.ok) { showError(r.message || 'Could not resend.'); return; }
        showError('');
        rsStartResendTimer(60);
    }).catch(function() { showError('Network error.'); });
};

function rsStartResendTimer(secs) {
    var btn = qs('rs-btn-resend');
    var timerEl = qs('rs-resend-timer');
    btn.disabled = true;
    RS.resendCountdown = secs;
    clearInterval(RS.resendTimer);
    RS.resendTimer = setInterval(function() {
        RS.resendCountdown--;
        if (RS.resendCountdown <= 0) {
            clearInterval(RS.resendTimer);
            btn.disabled = false;
            timerEl.textContent = '';
        } else {
            timerEl.textContent = '(' + RS.resendCountdown + 's)';
        }
    }, 1000);
}

// OTP box auto-advance + paste
(function() {
    document.addEventListener('DOMContentLoaded', function() {
        var boxes = qs('rs-otp-boxes').querySelectorAll('input');
        boxes.forEach(function(box, i) {
            box.addEventListener('input', function() {
                var val = box.value.replace(/\D/g, '');
                box.value = val.charAt(0);
                if (val && i < boxes.length - 1) boxes[i + 1].focus();
            });
            box.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
                if (e.key === 'ArrowLeft'  && i > 0)              boxes[i - 1].focus();
                if (e.key === 'ArrowRight' && i < boxes.length-1) boxes[i + 1].focus();
            });
            box.addEventListener('paste', function(e) {
                var text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                e.preventDefault();
                text.split('').slice(0, 6).forEach(function(ch, j) { if (boxes[j]) boxes[j].value = ch; });
                var last = Math.min(text.length, boxes.length - 1);
                if (boxes[last]) boxes[last].focus();
            });
        });
    });
})();

// ---- Step 2: Verify OTP --------------------------------------------

window.rsVerifyOtp = function() {
    var boxes = qs('rs-otp-boxes').querySelectorAll('input');
    var code  = Array.from(boxes).map(function(b) { return b.value; }).join('');
    if (code.length !== 6) { showError('Please enter the full 6-digit code.'); return; }
    setLoading('rs-btn-verifyotp', true);
    post('verifyotp', { email: RS.email, code: code }).then(function(r) {
        setLoading('rs-btn-verifyotp', false);
        if (!r.ok) { showError(r.message || 'Invalid or expired code.'); return; }
        RS.verifiedEmail = RS.email;
        rsGoStep(3);
        rsLoadEnrollments();
    }).catch(function() {
        setLoading('rs-btn-verifyotp', false);
        showError('Network error. Please try again.');
    });
};

// ---- Step 3: Enrollments -------------------------------------------

function rsLoadEnrollments() {
    qs('rs-enrollments-loading').style.display = 'block';
    qs('rs-course-list').style.display         = 'none';
    qs('rs-no-courses').style.display          = 'none';
    qs('rs-step3-nav').style.display           = 'none';

    post('getenrollments', {}).then(function(r) {
        qs('rs-enrollments-loading').style.display = 'none';
        if (!r.ok) { showError(r.message || 'Could not load enrolments.'); return; }
        var courses = r.courses || [];
        if (!courses.length) {
            qs('rs-no-courses').style.display = 'block';
            return;
        }
        var list = qs('rs-course-list');
        list.innerHTML = '';
        courses.forEach(function(c, idx) {
            var li    = document.createElement('li');
            var badge = c.is_wsq
                ? '<span class="rs-badge rs-badge-wsq">WSQ</span>'
                : '<span class="rs-badge rs-badge-nonwsq">Non-WSQ</span>';
            var dateStr = c.course_start_date
                ? c.course_start_date + (c.course_end_date && c.course_end_date !== c.course_start_date
                    ? ' – ' + c.course_end_date : '')
                : 'Date TBC';
            li.innerHTML =
                '<label>'
                + '<input type="radio" name="rs_course" value="' + idx + '">'
                + '<div><div style="font-weight:600">' + rsEsc(c.course_title) + badge + '</div>'
                + '<div class="rs-course-meta">' + rsEsc(c.course_sku)
                + ' &nbsp;&middot;&nbsp; ' + rsEsc(dateStr) + '</div></div>'
                + '</label>';
            li.querySelector('input').addEventListener('change', function() {
                RS.selectedCourse = c;
                qs('rs-btn-tocourse').disabled = false;
            });
            list.appendChild(li);
        });
        list.style.display      = 'block';
        qs('rs-step3-nav').style.display = 'block';
    }).catch(function() {
        qs('rs-enrollments-loading').style.display = 'none';
        showError('Network error loading courses. Please fill in manually.');
    });
}

window.rsSelectCourse = function() {
    if (!RS.selectedCourse) { showError('Please select a course.'); return; }
    rsGoStep(4);
    rsFillStep4(RS.selectedCourse);
};

function rsFillStep4(course) {
    qs('rs-run-id').value             = course.run_id || '';
    qs('rs-is-wsq').value             = course.is_wsq ? '1' : '0';
    qs('rs-course-code-h').value      = course.course_sku || '';
    qs('rs-course-title-display').value = course.course_title || '';
    qs('rs-start-date-display').value   = course.course_start_date || '';
    qs('rs-target-run-id').value      = '';

    // Reset target fields
    qs('rs-target-select-field').style.display = 'none';
    qs('rs-target-text-field').style.display   = 'block';
    qs('rs-sibling-loading').style.display     = 'none';
    qs('rs-target-select').innerHTML = '<option value="">-- Select a date --</option>';
    qs('rs-next-date').value = '';

    if (course.is_wsq) {
        qs('rs-sibling-loading').style.display   = 'block';
        qs('rs-target-text-field').style.display = 'none';
        post('getsiblingruns', { run_id: course.run_id }).then(function(r) {
            qs('rs-sibling-loading').style.display = 'none';
            if (r.ok && r.runs && r.runs.length) {
                var sel = qs('rs-target-select');
                r.runs.forEach(function(run) {
                    var opt = document.createElement('option');
                    // LMS may return different field names; try common ones
                    opt.value       = run.id || run.uuid || run.courseRunId || '';
                    opt.textContent = run.startDate || run.label || run.date || opt.value;
                    sel.appendChild(opt);
                });
                qs('rs-target-select-field').style.display = 'block';
            } else {
                // LMS endpoint not yet available — show text fallback
                qs('rs-target-text-field').style.display = 'block';
            }
        }).catch(function() {
            qs('rs-sibling-loading').style.display  = 'none';
            qs('rs-target-text-field').style.display = 'block';
        });
    }
}

window.rsOnTargetRunChange = function() {
    var sel = qs('rs-target-select');
    qs('rs-target-run-id').value = sel.value;
};

window.rsShowFallback = function() {
    RS.isFallback = true;
    if (RS.verifiedEmail) qs('rs-fb-email').value = RS.verifiedEmail;
    rsGoStep('fallback');
};

window.rsBackFromFallback = function() {
    RS.isFallback = false;
    rsGoStep(RS.verifiedEmail ? 3 : 1);
};

// ---- Step 4: Submit ------------------------------------------------

window.rsSubmit = function() {
    showError('');
    var name   = qs('rs-name').value.trim();
    var nric   = qs('rs-nric').value.trim();
    var phone  = qs('rs-phone').value.trim();
    var course = qs('rs-course-title-display').value.trim();
    var code   = qs('rs-course-code-h').value.trim();
    var startD = qs('rs-start-date-display').value.trim();
    var isWsq  = qs('rs-is-wsq').value === '1';
    var usingSel = isWsq && qs('rs-target-select-field').style.display !== 'none';
    var nextD  = usingSel
        ? (qs('rs-target-select').options[qs('rs-target-select').selectedIndex] || {}).text || ''
        : qs('rs-next-date').value.trim();

    if (!name || !nric || !phone || !course || !code || !startD) {
        showError('Please complete all required fields.'); return;
    }

    var payload = {
        email:                 RS.verifiedEmail,
        name:                  name,
        nric:                  nric,
        telephone:             phone,
        course:                course,
        course_code:           code,
        course_start_date:     startD,
        next_course_start_date:nextD,
        run_id:                qs('rs-run-id').value,
        target_run_id:         qs('rs-target-run-id').value,
        is_wsq:                isWsq ? '1' : '0',
        comment:               qs('rs-comment').value.trim(),
        hideit:                qs('rs-hideit').value,
    };

    if (RS.tsEnabled) {
        setLoading('rs-btn-submit', true);
        window._rsPendingPayload = payload;
        if (window.turnstile) window.turnstile.execute();
        return;
    }
    rsDoSubmit(payload, false);
};

window.rsOnTurnstile = function(token) {
    var tokenKey = '<?= $this->escapeHtml($tokenField) ?>';
    if (RS.isFallback && window._rsFbPendingPayload) {
        window._rsFbPendingPayload[tokenKey] = token;
        rsDoSubmit(window._rsFbPendingPayload, true);
    } else if (window._rsPendingPayload) {
        window._rsPendingPayload[tokenKey] = token;
        rsDoSubmit(window._rsPendingPayload, false);
    }
};
window.rsOnTurnstileError = function() {
    setLoading('rs-btn-submit', false);
    setLoading('rs-btn-fb-submit', false);
    showError('Security check failed. Please refresh the page and try again.');
};
window.rsOnTurnstileExpired = function() {
    setLoading('rs-btn-submit', false);
    setLoading('rs-btn-fb-submit', false);
    showError('Security check expired. Please try again.');
};

function rsDoSubmit(payload, isFb) {
    post('submit', payload).then(function(r) {
        setLoading(isFb ? 'rs-btn-fb-submit' : 'rs-btn-submit', false);
        if (!r.ok) { showError(r.message || 'Submission failed. Please try again.'); return; }
        // Hide all steps; show success
        ['1','2','3','4','fallback'].forEach(function(s) {
            var el = qs('rs-step-' + s); if (el) el.classList.remove('active');
        });
        qs('rs-progress').style.display = 'none';
        showError('');
        qs('rs-success-msg').textContent = r.message || 'Thank you for your submission.';
        qs('rs-success').style.display = 'block';
    }).catch(function() {
        setLoading(isFb ? 'rs-btn-fb-submit' : 'rs-btn-submit', false);
        showError('Network error. Please try again or call +65 6100 0613.');
    });
}

// ---- Fallback (manual) submit --------------------------------------

window.rsFallbackSubmit = function() {
    showError('');
    var name  = qs('rs-fb-name').value.trim();
    var nric  = qs('rs-fb-nric').value.trim();
    var email = qs('rs-fb-email').value.trim();
    var phone = qs('rs-fb-phone').value.trim();
    var course= qs('rs-fb-course').value.trim();
    var code  = qs('rs-fb-code').value.trim();
    var start = qs('rs-fb-startdate').value.trim();

    if (!name || !nric || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || !phone || !course || !code || !start) {
        showError('Please complete all required fields.'); return;
    }
    var isWsq = /^TGS-/i.test(code);
    var payload = {
        email:                 email,
        name:                  name,
        nric:                  nric,
        telephone:             phone,
        course:                course,
        course_code:           code,
        course_start_date:     start,
        next_course_start_date:qs('rs-fb-nextdate').value.trim(),
        run_id:                '',
        target_run_id:         '',
        is_wsq:                isWsq ? '1' : '0',
        comment:               qs('rs-fb-comment').value.trim(),
        hideit:                qs('rs-fb-hideit').value,
    };

    if (RS.tsEnabled) {
        setLoading('rs-btn-fb-submit', true);
        window._rsFbPendingPayload = payload;
        if (window.turnstile) window.turnstile.execute();
        return;
    }
    rsDoSubmit(payload, true);
};

// ---- HTML escape ---------------------------------------------------

function rsEsc(s) {
    return String(s || '')
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

})();
</script>
