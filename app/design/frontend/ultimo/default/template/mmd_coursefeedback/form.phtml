<script>(function(){var EN=<?php echo $k?'true':'false'; ?>,ps=false;
function v(){var e="",f=document.forms["fbForm"];if(!f["name"].value)e+="Please enter your name<br/>";if(!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value))e+="Please enter a valid email<br/>";
function chk(n){return f[n]&&Array.prototype.slice.call(f[n].length?f[n]:[f[n]]).some(function(x){return x.checked;});}
if(!chk("rating_objectives")||!chk("rating_trainer")||!chk("rating_environment"))e+="Please answer all three rating questions<br/>";
document.getElementById("fb-error").innerHTML=e;return e==="";}
function s(){var b=document.getElementById("fb-submit");if(b)b.disabled=true;document.forms["fbForm"].submit();}
window.onFbTs=function(t){var i=document.getElementById("fb-tk");if(i)i.value=t;if(ps){ps=false;s();}};window.onFbTsE=function(){ps=false;document.getElementById("fb-error").innerHTML="Spam check could not run. Please refresh and try again.";};window.onFbTsX=function(){var i=document.getElementById("fb-tk");if(i)i.value="";};
document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("fbForm");if(!f)return;f.addEventListener("submit",function(e){e.preventDefault();if(!v())return;if(!EN||typeof window.turnstile==="undefined"){s();return;}var i=document.getElementById("fb-tk");if(i&&i.value){s();return;}ps=true;try{window.turnstile.execute();}catch(x){ps=false;s();}});});})();</script>
