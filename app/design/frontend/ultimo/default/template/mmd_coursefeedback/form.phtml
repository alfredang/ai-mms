$scale = function($field) {
    $h = '<div class="tcfb-scale">';
    for ($i = 1; $i <= 5; $i++) { $h .= '<label><input type="radio" name="' . $field . '" value="' . $i . '"/><span>' . $i . '</span></label>'; }
    return $h . '</div>';
};
