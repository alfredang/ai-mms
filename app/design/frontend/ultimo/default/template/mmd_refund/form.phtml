<?php $ts=Mage::helper('magentocaptcha/turnstile'); $k=$ts->getSiteKey(); $u=Mage::getUrl('refund/index/post'); ?>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style>
.tcr-w{max-width:760px;margin:34px auto 0;background:#fff;border:1px solid #e6e9ef;border-radius:16px;box-shadow:0 18px 50px rgba(15,23,42,.08);overflow:hidden}
.tcr-h{background:linear-gradient(135deg,#0f172a,#14304a);color:#fff;padding:26px 30px}.tcr-h h3{color:#fff;margin:0 0 4px;font-size:24px}.tcr-h p{color:#9fb3c8;margin:0;font-size:15px}
.tcr-b{padding:26px 30px 30px}.tcr-row{display:flex;gap:16px;flex-wrap:wrap}.tcr-f{flex:1 1 220px;margin-bottom:16px}.tcr-f.full{flex-basis:100%}
.tcr-f label{display:block;font-weight:600;color:#0f172a;font-size:14px;margin-bottom:6px}.tcr-f label .r{color:#f4511e}
.tcr-f input,.tcr-f textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid #d6dbe4;border-radius:9px;font-size:15px;background:#fbfcfe}
.tcr-f input:focus,.tcr-f textarea:focus{outline:none;border-color:#14b8a6;box-shadow:0 0 0 3px rgba(20,184,166,.16);background:#fff}.tcr-f textarea{min-height:110px;resize:vertical}
.tcr-e{color:#dc2626;font-size:14px;margin:0 0 14px;min-height:1px}
.tcr-s{display:inline-flex;align-items:center;gap:10px;background:#f4511e;color:#fff;border:0;border-radius:999px;padding:14px 30px;font-size:16px;font-weight:700;cursor:pointer}.tcr-s:hover{background:#d63c0c}
</style>
<div class="tcr-w" id="refund-enquiry">
  <div class="tcr-h"><h3><?php echo $this->__('Submit a Refund Request') ?></h3><p><?php echo $this->__('Complete the form below and our team will review your refund request.') ?></p></div>
  <div class="tcr-b"><form action="<?php echo $u ?>" method="post" id="refundForm" name="refundForm">
    <div class="tcr-e" id="refund-error"></div>
    <div class="tcr-row"><div class="tcr-f"><label><?php echo $this->__('Name') ?> <span class="r">*</span></label><input type="text" name="name" maxlength="255"/></div>
      <div class="tcr-f"><label><?php echo $this->__('Email') ?> <span class="r">*</span></label><input type="email" name="email" maxlength="255"/></div></div>
    <div class="tcr-row"><div class="tcr-f"><label><?php echo $this->__('Phone') ?> <span class="r">*</span></label><input type="text" name="telephone" maxlength="64"/></div>
      <div class="tcr-f"><label><?php echo $this->__('NRIC') ?> <span class="r">*</span></label><input type="text" name="nric" maxlength="32"/></div></div>
    <div class="tcr-row"><div class="tcr-f"><label><?php echo $this->__('Course Title') ?> <span class="r">*</span></label><input type="text" name="course" maxlength="255"/></div>
      <div class="tcr-f"><label><?php echo $this->__('Course Code') ?> <span class="r">*</span></label><input type="text" name="course_code" maxlength="64"/></div></div>
    <div class="tcr-row"><div class="tcr-f"><label><?php echo $this->__('Order / Invoice No.') ?> <span class="r">*</span></label><input type="text" name="order_ref" maxlength="128"/></div>
      <div class="tcr-f"><label><?php echo $this->__('Net Amount Paid') ?> <span class="r">*</span></label><input type="text" name="net_amount_paid" maxlength="32" placeholder="<?php echo $this->__('e.g. S$500.00') ?>"/></div></div>
    <div class="tcr-row"><div class="tcr-f"><label><?php echo $this->__('SkillsFuture Claimed Amount') ?></label><input type="text" name="skillsfuture_claimed" maxlength="32" placeholder="<?php echo $this->__('optional') ?>"/></div>
      <div class="tcr-f"><label><?php echo $this->__('Amount to Refund') ?> <span class="r">*</span></label><input type="text" name="refund_amount" maxlength="32" placeholder="<?php echo $this->__('e.g. S$500.00') ?>"/></div></div>
    <div class="tcr-f full"><label><?php echo $this->__('Message') ?></label><textarea name="comment" placeholder="<?php echo $this->__('Reason for refund (optional)') ?>"></textarea></div>
    <input type="text" name="hideit" value="" tabindex="-1" autocomplete="off" style="display:none !important;"/>
    <input type="hidden" name="cf-turnstile-response" id="refund-tk" value=""/>
    <?php if ($k): ?><div class="cf-turnstile" data-sitekey="<?php echo $this->htmlEscape($k) ?>" data-size="invisible" data-callback="onRfTs" data-error-callback="onRfTsE" data-expired-callback="onRfTsX"></div><?php endif; ?>
    <button type="submit" id="refund-submit" class="tcr-s"><?php echo $this->__('Submit Request') ?></button>
  </form></div>
</div>
<script>(function(){var EN=<?php echo $k?'true':'false'; ?>,ps=false;
function v(){var e="",f=document.forms["refundForm"];
if(!f["name"].value)e+="Please enter your name<br/>";
if(!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value))e+="Please enter a valid email<br/>";
if(!f["telephone"].value)e+="Please enter your phone<br/>";
if(!f["nric"].value)e+="Please enter your NRIC<br/>";
if(!f["course"].value)e+="Please enter the course title<br/>";
if(!f["course_code"].value)e+="Please enter the course code<br/>";
if(!f["order_ref"].value)e+="Please enter the order/invoice no<br/>";
if(!f["net_amount_paid"].value)e+="Please enter the net amount paid<br/>";
if(!f["refund_amount"].value)e+="Please enter the amount to refund<br/>";
document.getElementById("refund-error").innerHTML=e;return e==="";}
function s(){var b=document.getElementById("refund-submit");if(b)b.disabled=true;document.forms["refundForm"].submit();}
window.onRfTs=function(t){var i=document.getElementById("refund-tk");if(i)i.value=t;if(ps){ps=false;s();}};window.onRfTsE=function(){ps=false;document.getElementById("refund-error").innerHTML="Spam check could not run. Please refresh and try again.";};window.onRfTsX=function(){var i=document.getElementById("refund-tk");if(i)i.value="";};
document.addEventListener("DOMContentLoaded",function(){var f=document.getElementById("refundForm");if(!f)return;f.addEventListener("submit",function(e){e.preventDefault();if(!v())return;if(!EN||typeof window.turnstile==="undefined"){s();return;}var i=document.getElementById("refund-tk");if(i&&i.value){s();return;}ps=true;try{window.turnstile.execute();}catch(x){ps=false;s();}});});})();</script>
