<style>
#customer-reviews-list { transition: opacity .18s ease; }
#customer-reviews-list[aria-busy="true"] { opacity: .45; pointer-events: none; }
#customer-reviews-list > h2:focus { outline: none; }
/* Page size is fixed at 5 in layout (local.xml setLimit), so "Show N per page" does nothing: hide it. */
#customer-reviews-list .pager .limiter { display: none; }
</style>
<script type="text/javascript">
//<![CDATA[
// Review pager without a page reload. A page link fetches that page of reviews in the background and swap only #customer-reviews-list, so the
// course page never jumps to the top. The URL follows (?p=N) and Back/Forward
// step through review pages. Any failure falls back to a normal page load.
(function () {
    var list = document.getElementById('customer-reviews-list');
    if (!list) return;
    var STICKY = 90;   // sticky header height

    var openReviewTab = function () {
        if (!window.jQuery) return;
        var $ = jQuery, $root = $('#product-tabs'), api, idx;
        if ($root.hasClass('accor')) {
            api = $root.children('.tabs-panels').data('tabs');
            idx = $root.children('.tabs-panels').children('.acctab').index($('#acctab-tabreviews'));
        } else {
            api = $root.children('.tabs').data('tabs');
            idx = $root.children('.tabs').children('#tab-tabreviews').index();
        }
        if (api && idx >= 0 && api.getIndex() !== idx) api.click(idx);
    };
    var scrollToList = function (smooth) {
        var top = list.getBoundingClientRect().top;
        if (top >= STICKY && top < window.innerHeight * 0.4) return;   // already in view
        var y = window.pageYOffset + top - STICKY - 10;
        if (smooth && 'scrollBehavior' in document.documentElement.style) window.scrollTo({ top: y, behavior: 'smooth' });
        else window.scrollTo(0, y);
    };

    // Opened from a shared / refreshed review-page URL: show the reviews.
    var q = window.location.search;
    if (/[?&]p=/.test(q) || window.location.hash === '#customer-reviews') {
        var land = function () { openReviewTab(); scrollToList(false); };
        if (window.jQuery) jQuery(function () { setTimeout(land, 0); }); else window.addEventListener('load', land);
    }

    if (!window.fetch || !window.DOMParser || !window.history || !history.pushState) return;

    var controller = null;
    var load = function (url, push) {
        if (controller && controller.abort) controller.abort();
        controller = window.AbortController ? new AbortController() : null;
        list.style.minHeight = list.offsetHeight + 'px';   // hold the layout while loading
        list.setAttribute('aria-busy', 'true');
        fetch(url, { credentials: 'same-origin', signal: controller ? controller.signal : undefined })
            .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(function (html) {
                var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('customer-reviews-list');
                if (!fresh) throw new Error('no list');
                list.innerHTML = fresh.innerHTML;
                list.style.minHeight = '';
                list.removeAttribute('aria-busy');
                if (push) history.pushState({ reviewsUrl: url }, '', url);
                scrollToList(true);
                var h = list.querySelector('h2');
                if (h) { h.setAttribute('tabindex', '-1'); h.focus({ preventScroll: true }); }
            })
            .catch(function (e) {
                if (e && e.name === 'AbortError') return;
                window.location.href = url;   // fall back to a normal page load
            });
    };

    list.addEventListener('click', function (e) {
        var a = e.target.closest ? e.target.closest('.pager a[href]') : null;
        if (!a || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        var li = a.closest('li'), ol = li && li.parentNode;
        if (li && ol && /^\d+$/.test(a.textContent.trim())) {   // show the chosen page as current at once
            var cur = ol.querySelector('li.current');
            if (cur) cur.className = '';
            li.className = 'current';
        }
        load(a.href, true);
    });

    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    history.replaceState({ reviewsUrl: window.location.href }, '', window.location.href);
    window.addEventListener('popstate', function (e) {
        if (e.state && e.state.reviewsUrl) load(e.state.reviewsUrl, false);
    });
})();
//]]>
</script>

