/**

 * - Each review title: "a" replaced with "span.heading"

 */

?>



<?php $_items = $this->getReviewsCollection()->getItems();?>

<div class="box-collateral box-reviews" id="customer-reviews">

    <?php

        $reviewsTotalNumber = 0;

        $reviewsLimitPerPage = 10;

        $toolbar = $this->getChild('toolbar');

        if ($toolbar)

        {

            $reviewsTotalNumber = $toolbar->getTotalNum();

            $reviewsLimitPerPage = $toolbar->getLimit();

        }

    ?>

    <?php if (count($_items)): ?>

        <h2><?php echo $this->__('Customer Reviews') . " ({$reviewsTotalNumber})"?></h2>

        <?php //if ($reviewsTotalNumber > $reviewsLimitPerPage) echo $this->getChildHtml('toolbar'); ?>

        <dl>

        <?php foreach ($_items as $_review):?>

            <dt>

            	<span class="heading"><?php echo $this->escapeHtml($_review->getTitle()) ?></span>
				Review by <span>Course Participant/Trainee</span>
				<?php /*echo $this->__('Review by <span>%s</span>', $this->escapeHtml($_review->getNickname()))*/ ?>

            </dt>

            <dd>

                <?php $_votes = $_review->getRatingVotes(); ?>

                <?php if (count($_votes)): ?>

                <table class="ratings-table">

                   <!-- <col width="1" />

                    <col />-->

                    <tbody>

                        <?php foreach ($_votes as $_vote): ?>

                        <tr>

                            <th><?php echo $this->escapeHtml($_vote->getRatingCode()) ?></th>

                            <td>

                                <div class="rating-box">

                                    <div class="rating" style="width:<?php echo $_vote->getPercent() ?>%;"></div>

                                </div>

                            </td>

                        </tr>

                        <?php endforeach; ?>

                    </tbody>

                </table>

                <?php endif; ?>

                <?php echo nl2br($this->escapeHtml($_review->getDetail())) ?>

                <small class="date"><?php echo $this->__('(Posted on %s)', $this->formatDate($_review->getCreatedAt()), 'long') ?></small>

            </dd>

        <?php endforeach; ?>

        </dl>

        <?php if ($reviewsTotalNumber > $reviewsLimitPerPage) echo $this->getChildHtml('toolbar'); ?>

    <?php endif;?>
 <?php echo $this->getLayout()->createBlock('review/form')->setTemplate('magentocaptcha/reviewform.phtml')->toHtml(); ?>
    <?php  /*echo $this->getChildHtml('review_form')*/ ?>

</div>
<script type="text/javascript">
//<![CDATA[
// Review pager: the stock pager links reload the course page at the top with the
// Review tab closed. Send every page / per-page link to #customer-reviews, and on
// a load with that hash open the Review tab (tabs or accordion) and scroll to it.
(function () {
    var box = document.getElementById('customer-reviews');
    if (!box) return;
    var H = '#customer-reviews';
    var withHash = function (u) { return u ? u.replace(/#.*$/, '') + H : u; };
    var i, links = box.querySelectorAll('.pager a[href]'), opts = box.querySelectorAll('.pager select option');
    for (i = 0; i < links.length; i++) links[i].setAttribute('href', withHash(links[i].getAttribute('href')));
    for (i = 0; i < opts.length; i++) opts[i].value = withHash(opts[i].value);
    if (window.location.hash !== H || !window.jQuery) return;

    window.addEventListener('load', function () {
        var $ = jQuery, $root = $('#product-tabs'), api, idx;
        if ($root.hasClass('accor')) {
            api = $root.children('.tabs-panels').data('tabs');
            idx = $root.children('.tabs-panels').children('.acctab').index($('#acctab-tabreviews'));
        } else {
            api = $root.children('.tabs').data('tabs');
            idx = $root.children('.tabs').children('#tab-tabreviews').index();
        }
        if (api && idx >= 0) api.click(idx);
        setTimeout(function () {
            $('html, body').scrollTop($(box).offset().top - 90);
        }, 50);
    });
})();
//]]>
</script>

