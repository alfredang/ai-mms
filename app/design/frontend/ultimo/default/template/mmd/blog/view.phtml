<?php
/**
 * Single blog post — hero, meta row, share buttons, thumbs-up like, article body,
 * lead-magnet CTA (related courses + WSQ funding / SkillsFuture Credit hook),
 * tags, JSON-LD Article schema. Design mirrors tertiaryinfotech.com/blog.
 * @var MMD_Blog_Block_View $this
 */
$post   = $this->getPost();
$helper = Mage::helper('mmd_blog');
$likes  = (int) $post->getLikeCount();
$courses = $this->getRelatedCourses();
$tags    = $this->getTags();
$storeName = Mage::getStoreConfig('general/store_information/name') ?: 'Tertiary Infotech Academy';
?>
<article class="mmd-blog mmd-blog-post" itemscope itemtype="https://schema.org/Article">
    <div class="mmd-blog-post-hero<?php echo $post->getHeroImageUrl() ? '' : ' is-fallback' ?>">
        <?php if ($post->getHeroImageUrl()): ?>
            <img src="<?php echo $this->escapeHtml($post->getHeroImageUrl()) ?>" alt="<?php echo $this->escapeHtml($post->getTitle()) ?>" itemprop="image"/>
        <?php else: ?>
            <?php $kickerTags = array_slice($tags, 0, 2); ?>
            <span class="mmd-blog-hero-fallback"><span class="mmd-blog-hero-kicker">[ <?php echo $this->escapeHtml($kickerTags ? mb_strtoupper(implode(' · ', $kickerTags), 'UTF-8') : 'ARTICLE') ?> ]</span><span class="mmd-blog-hero-title"><?php echo $this->escapeHtml($post->getTitle()) ?></span></span>
        <?php endif; ?>
    </div>

    <header class="mmd-blog-post-head">
        <p class="mmd-blog-crumb"><a href="<?php echo $helper->getListUrl() ?>">Blog</a> <span>/</span> <?php echo $this->escapeHtml($post->getTitle()) ?></p>
        <h1 itemprop="headline"><?php echo $this->escapeHtml($post->getTitle()) ?></h1>
        <div class="mmd-blog-post-meta">
            <span class="mmd-blog-avatar" aria-hidden="true"><?php echo $this->escapeHtml(strtoupper(substr($post->getAuthor() ?: $storeName, 0, 1))) ?></span>
            <span itemprop="author"><?php echo $this->escapeHtml($post->getAuthor() ?: $storeName) ?></span>
            <span class="mmd-blog-dot">&middot;</span>
            <time itemprop="datePublished" datetime="<?php echo $this->escapeHtml($post->getPublishedAt()) ?>"><?php echo date('d-m-Y', strtotime($post->getPublishedAt())) ?></time>
            <span class="mmd-blog-dot">&middot;</span>
            <span><?php echo $this->getReadingMinutes() ?> min read</span>
        </div>

        <div class="mmd-blog-actions">
            <div class="mmd-blog-share" aria-label="Share this article">
                <?php foreach ($this->getShareLinks() as $label => $href): ?>
                    <a class="mmd-blog-share-btn mmd-share-<?php echo strtolower($label) ?>" href="<?php echo $this->escapeHtml($href) ?>" target="_blank" rel="noopener nofollow" title="Share on <?php echo $label ?>"><?php echo $label === 'X' ? '&#120143;' : $this->escapeHtml($label) ?></a>
                <?php endforeach; ?>
            </div>
            <button type="button" class="mmd-blog-like" id="mmd-blog-like"
                 data-post="<?php echo (int) $post->getId() ?>"
                 data-url="<?php echo $this->escapeHtml($this->getLikeUrl()) ?>"
                 aria-label="Like this article">
                <svg class="mmd-blog-like-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
                <span class="mmd-blog-like-count" id="mmd-blog-like-count"><?php echo $likes ?></span>
            </button>
        </div>
    </header>

    <div class="mmd-blog-post-body" itemprop="articleBody">
        <?php echo $this->getContentHtml() ?>
    </div>

    <!-- Lead magnet CTA: every post funnels readers to course registration. -->
    <aside class="mmd-blog-cta">
        <h2>Ready to build this skill? &#127891;</h2>
        <p>Join the hands-on, instructor-led training below. <strong>WSQ courses enjoy up to 70% SkillsFuture (WSQ) funding</strong> for eligible Singaporeans and PRs, and you can <strong>offset the fee with your SkillsFuture Credit</strong>. Seats are limited — reserve yours today.</p>
        <?php if ($courses): ?>
        <div class="mmd-blog-cta-courses">
            <?php foreach ($courses as $course): ?>
            <a class="mmd-blog-cta-course" href="<?php echo $this->escapeHtml($course->getProductUrl()) ?>">
                <span class="mmd-blog-cta-course-name"><?php echo $this->escapeHtml($course->getName()) ?></span>
                <span class="mmd-blog-cta-course-action">View schedule &amp; register &rarr;</span>
            </a>
            <?php endforeach; ?>
        </div>
        <?php else: ?>
        <p><a class="mmd-blog-cta-course" href="<?php echo Mage::getBaseUrl() ?>">Browse all courses &rarr;</a></p>
        <?php endif; ?>
    </aside>

    <?php if ($tags): ?>
    <footer class="mmd-blog-post-tags">
        <span>Tags:</span>
        <?php foreach ($tags as $t): ?>
            <a class="mmd-blog-tag" href="<?php echo $helper->getTagUrl($t) ?>"><?php echo $this->escapeHtml($t) ?></a>
        <?php endforeach; ?>
    </footer>
    <?php endif; ?>

    <p class="mmd-blog-backlink-row"><a class="mmd-blog-backlink" href="<?php echo $helper->getListUrl() ?>">&larr; Back to all articles</a></p>
</article>

<script type="application/ld+json">
<?php
$schema = array(
    '@context'      => 'https://schema.org',
    '@type'         => 'Article',
    'headline'      => $post->getTitle(),
    'description'   => trim(strip_tags((string) ($post->getMetaDescription() ?: $post->getExcerpt()))),
    'datePublished' => $post->getPublishedAt(),
    'dateModified'  => $post->getUpdatedAt(),
    'author'        => array('@type' => 'Organization', 'name' => $post->getAuthor() ?: $storeName),
    'publisher'     => array('@type' => 'Organization', 'name' => $storeName),
    'mainEntityOfPage' => $this->getPostUrl(),
);
if ($post->getHeroImageUrl()) {
    $schema['image'] = $post->getHeroImageUrl();
}
if ($likes > 0) {
    $schema['interactionStatistic'] = array(
        '@type'                => 'InteractionCounter',
        'interactionType'      => 'https://schema.org/LikeAction',
        'userInteractionCount' => $likes,
    );
}
echo json_encode($schema, JSON_UNESCAPED_SLASHES);
?>
</script>

<script>
(function () {
    var btn = document.getElementById('mmd-blog-like');
    if (!btn) return;
    var countEl = document.getElementById('mmd-blog-like-count');
    var liked = false;
    btn.addEventListener('click', function () {
        if (liked) return;
        liked = true;
        btn.classList.add('is-liked');
        var xhr = new XMLHttpRequest();
        xhr.open('POST', btn.getAttribute('data-url'), true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function () {
            try {
                var rsp = JSON.parse(xhr.responseText);
                if (rsp.ok && typeof rsp.likes !== 'undefined') {
                    countEl.textContent = rsp.likes;
                }
            } catch (e) {}
        };
        xhr.send('post_id=' + btn.getAttribute('data-post'));
    });
})();
</script>
