<script type="application/ld+json">
<?php
// BlogPosting (Article subtype) — publisher logo + author + honest dates are
// exactly the authorship/freshness signals AI Overview summarisers lean on.
$orgLogo = rtrim(Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_LINK), '/') . '/skin/frontend/ultimo/default/images/TertiaryCoursesSingapore.png';
$schema = array(
    '@context'      => 'https://schema.org',
    '@type'         => 'BlogPosting',
    'headline'      => $post->getTitle(),
    'description'   => trim(strip_tags((string) ($post->getMetaDescription() ?: $post->getExcerpt()))),
    'url'           => $this->getPostUrl(),
    'inLanguage'    => 'en',
    'wordCount'     => str_word_count(strip_tags((string) $contentHtml)),
    'datePublished' => date('c', strtotime($post->getPublishedAt())),
    'dateModified'  => date('c', strtotime($post->getUpdatedAt() ?: $post->getPublishedAt())),
    'author'        => array('@type' => 'Organization', 'name' => $post->getAuthor() ?: $storeName, 'url' => rtrim(Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_LINK), '/')),
    'publisher'     => array(
        '@type' => 'Organization',
        'name'  => $storeName,
        'logo'  => array('@type' => 'ImageObject', 'url' => $orgLogo),
    ),
    'mainEntityOfPage' => array('@type' => 'WebPage', '@id' => $this->getPostUrl()),
    'image'         => $heroImg ?: $orgLogo,
);
if ($tags) {
    $schema['keywords'] = implode(', ', $tags);
}
if ($likes > 0) {
    $schema['interactionStatistic'] = array(
        '@type'                => 'InteractionCounter',
        'interactionType'      => 'https://schema.org/LikeAction',
        'userInteractionCount' => $likes,
    );
}
echo json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
?>
</script>
<?php
// FAQPage — mirrors the post's native <details> FAQ accordions (already plain
// HTML in the DOM, so answers stay extractable). Emitted only when present.
$faqEntities = array();
if (preg_match_all('#<details[^>]*>(.*?)</details>#si', (string) $contentHtml, $faqBlocks)) {
    foreach ($faqBlocks[1] as $faqBlock) {
        if (!preg_match('#<summary[^>]*>(.*?)</summary>#si', $faqBlock, $faqQ)) {
            continue;
        }
        $q = trim(html_entity_decode(strip_tags($faqQ[1]), ENT_QUOTES, 'UTF-8'));
        $a = trim(preg_replace('/\s+/', ' ', html_entity_decode(strip_tags(preg_replace('#<summary[^>]*>.*?</summary>#si', '', $faqBlock)), ENT_QUOTES, 'UTF-8')));
        if ($q === '' || $a === '') {
            continue;
        }
        $faqEntities[] = array(
            '@type'          => 'Question',
            'name'           => $q,
            'acceptedAnswer' => array('@type' => 'Answer', 'text' => $a),
        );
    }
}
if ($faqEntities): ?>
<script type="application/ld+json">
<?php echo json_encode(array(
    '@context'   => 'https://schema.org',
    '@type'      => 'FAQPage',
    'mainEntity' => $faqEntities,
), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>
</script>
<?php endif; ?>
<script type="application/ld+json">
<?php echo json_encode(array(
    '@context' => 'https://schema.org',
    '@type'    => 'BreadcrumbList',
    'itemListElement' => array(
        array('@type' => 'ListItem', 'position' => 1, 'name' => 'Home', 'item' => rtrim(Mage::getBaseUrl(Mage_Core_Model_Store::URL_TYPE_LINK), '/') . '/'),
        array('@type' => 'ListItem', 'position' => 2, 'name' => 'Blog', 'item' => $helper->getListUrl()),
        array('@type' => 'ListItem', 'position' => 3, 'name' => $post->getTitle(), 'item' => $this->getPostUrl()),
    ),
), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE); ?>
</script>

<script>
(function () {
    var btn = document.getElementById('mmd-blog-like');
    if (!btn) return;
    var countEl = document.getElementById('mmd-blog-like-count');
    var liked = false;
    btn.addEventListener('click', function () {
        if (liked) return;
        liked = true;
        btn.classList.add('is-liked');
        var xhr = new XMLHttpRequest();
        xhr.open('POST', btn.getAttribute('data-url'), true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function () {
            try {
                var rsp = JSON.parse(xhr.responseText);
                if (rsp.ok && typeof rsp.likes !== 'undefined') {
                    countEl.textContent = rsp.likes;
                }
            } catch (e) {}
        };
        xhr.send('post_id=' + btn.getAttribute('data-post'));
    });
})();
(function () {
    var copy = document.getElementById('mmd-blog-copy');
    if (!copy) return;
    copy.addEventListener('click', function () {
        var url = copy.getAttribute('data-url');
        var done = function () { copy.classList.add('is-copied'); setTimeout(function () { copy.classList.remove('is-copied'); }, 1500); };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done, done);
        } else {
            var t = document.createElement('textarea'); t.value = url; document.body.appendChild(t); t.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(t); done();
        }
    });
})();
</script>
