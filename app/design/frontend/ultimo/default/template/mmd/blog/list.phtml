<?php
/**
 * Blog listing — dark "journal" design mirroring www.tertiaryinfotech.com/blog:
 * [ BLOG ] kicker + bold headline, tag filter pills, 3-col card grid (gradient
 * cover, mono teal date, star rating, title, excerpt, tag pills), numbered pager.
 * Styles: skin/frontend/ultimo/default/css/blog.css
 * @var MMD_Blog_Block_List $this
 */
$helper = $this->helper('mmd_blog');
$posts  = $this->getPosts();
$tag    = $this->getTagName();
$query  = $this->getSearchQuery();
$allTags = $helper->getPublishedTagNames();
?>
<div class="mmd-blog">
    <header class="mmd-blog-header">
        <p class="mmd-blog-kicker">[ BLOG ]</p>
        <h1>Level up with <span class="mmd-blog-accent">AI &amp; tech skills</span> that pay for themselves.</h1>
        <p class="mmd-blog-sub">Practical guides from our trainers — plus how to fund your upskilling with
            <strong>WSQ funding</strong> and <strong>SkillsFuture Credit</strong>.</p>
    </header>

    <form class="mmd-blog-search" method="get" action="<?php echo $helper->getListUrl() ?>" role="search">
        <span class="mmd-blog-search-icon" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></span>
        <input type="search" name="q" value="<?php echo $this->escapeHtml($query) ?>" placeholder="Search blog posts&hellip;" aria-label="Search blog posts" maxlength="200"/>
        <button type="submit">Search</button>
    </form>

    <?php if ($query !== ''): ?>
    <p class="mmd-blog-search-summary">
        <?php $n = $this->getResultCount(); ?>
        <strong><?php echo $n ?></strong> <?php echo $n === 1 ? 'article' : 'articles' ?> matching &ldquo;<?php echo $this->escapeHtml($query) ?>&rdquo;
        <a class="mmd-blog-search-clear" href="<?php echo $helper->getListUrl() ?>">Clear search</a>
    </p>
    <?php endif; ?>

    <?php if ($allTags): ?>
    <?php // Collapsed to two rows by default; expanded when a tag filter is active so the active pill is visible. ?>
    <div class="mmd-blog-filter<?php echo $tag ? '' : ' is-collapsed' ?>" id="mmd-blog-filter">
        <span class="mmd-blog-filter-label">Tags</span>
        <a class="mmd-blog-tag<?php echo $tag ? '' : ' is-active' ?>" href="<?php echo $helper->getListUrl() ?>">All</a>
        <?php foreach ($allTags as $t): ?>
            <a class="mmd-blog-tag<?php echo $tag === $t ? ' is-active' : '' ?>" href="<?php echo $helper->getTagUrl($t) ?>">#<?php echo $this->escapeHtml($t) ?></a>
        <?php endforeach; ?>
    </div>
    <button type="button" class="mmd-blog-filter-toggle" id="mmd-blog-filter-toggle"
            aria-controls="mmd-blog-filter" aria-expanded="<?php echo $tag ? 'true' : 'false' ?>">
        <?php echo $tag ? 'Show fewer tags &#9650;' : 'Show all tags &#9660;' ?>
    </button>
    <script>
    (function () {
        var strip  = document.getElementById('mmd-blog-filter');
        var toggle = document.getElementById('mmd-blog-filter-toggle');
        if (!strip || !toggle) { return; }
        // Hide the toggle when every pill already fits in the collapsed height.
        // scrollHeight includes the strip's 21px padding/border on top of the
        // 61px collapsed max-height in blog.css — anything ≤ 90 means two rows fit.
        var COLLAPSED_MAX = 90;
        if (strip.scrollHeight <= COLLAPSED_MAX) {
            strip.classList.remove('is-collapsed');
            toggle.style.display = 'none';
            return;
        }
        toggle.addEventListener('click', function () {
            var collapsed = strip.classList.toggle('is-collapsed');
            toggle.innerHTML = collapsed ? 'Show all tags ▼' : 'Show fewer tags ▲';
            toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
        });
    })();
    </script>
    <?php endif; ?>

    <?php if (!count($posts)): ?>
        <p class="mmd-blog-empty"><?php echo $query !== ''
            ? 'No articles matched your search — try a different keyword or browse the tags above.'
            : 'No articles yet — check back soon.' ?></p>
    <?php else: ?>
    <div class="mmd-blog-grid">
        <?php foreach ($posts as $post): ?>
        <?php $url = $helper->getPostUrl($post); $likes = (int) $post->getLikeCount(); $heroImg = $helper->getHeroImage($post); ?>
        <article class="mmd-blog-card">
            <a class="mmd-blog-card-hero" href="<?php echo $url ?>">
                <?php if ($heroImg): ?>
                    <img src="<?php echo $this->escapeHtml($heroImg) ?>" alt="<?php echo $this->escapeHtml($post->getTitle()) ?>" loading="lazy"/>
                <?php else: ?>
                    <?php $kickerTags = array_slice($helper->getPostTags($post->getId()), 0, 2); ?>
                    <span class="mmd-blog-hero-fallback"><span class="mmd-blog-hero-kicker">[ <?php echo $this->escapeHtml($kickerTags ? mb_strtoupper(implode(' · ', $kickerTags), 'UTF-8') : 'ARTICLE') ?> ]</span><span class="mmd-blog-hero-title"><?php echo $this->escapeHtml($post->getTitle()) ?></span></span>
                <?php endif; ?>
            </a>
            <div class="mmd-blog-card-body">
                <div class="mmd-blog-card-meta">
                    <span class="mmd-blog-date"><?php echo date('d-m-Y', strtotime($post->getPublishedAt())) ?></span>
                    <span class="mmd-blog-likes-inline" aria-label="<?php echo $likes ?> likes"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg> <?php echo $likes ?></span>
                </div>
                <h2><a href="<?php echo $url ?>"><?php echo $this->escapeHtml($post->getTitle()) ?></a></h2>
                <?php if ($post->getExcerpt()): ?>
                    <p class="mmd-blog-card-excerpt"><?php echo $this->escapeHtml($post->getExcerpt()) ?></p>
                <?php endif; ?>
                <?php $tags = $helper->getPostTags($post->getId()); ?>
                <?php if ($tags): ?>
                <div class="mmd-blog-taglist">
                    <?php foreach (array_slice($tags, 0, 4) as $t): ?>
                        <a class="mmd-blog-tag" href="<?php echo $helper->getTagUrl($t) ?>">#<?php echo $this->escapeHtml($t) ?></a>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>
            </div>
        </article>
        <?php endforeach; ?>
    </div>

    <?php $last = $this->getLastPage(); $cur = $this->getCurrentPage(); ?>
    <?php if ($last > 1): ?>
    <nav class="mmd-blog-pager">
        <?php for ($i = 1; $i <= $last; $i++): ?>
            <a class="mmd-blog-pg<?php echo $i === $cur ? ' is-active' : '' ?>" href="<?php echo $this->getPageUrl($i) ?>"><?php echo $i ?></a>
        <?php endfor; ?>
        <?php if ($cur < $last): ?><a class="mmd-blog-pg mmd-blog-pg-next" href="<?php echo $this->getPageUrl($cur + 1) ?>">Next &rarr;</a><?php endif; ?>
    </nav>
    <?php endif; ?>
    <?php endif; ?>
</div>
