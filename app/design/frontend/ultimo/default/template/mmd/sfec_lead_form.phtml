<script type="text/javascript">
(function () {
    var TURNSTILE_ENABLED = <?php echo $tsSiteKey ? 'true' : 'false'; ?>;
    var pendingSubmit = false;

    function validateForm() {
        var error = "", f = document.forms["sfecLeadForm"];
        if (!f["name"].value) { error += "Please enter your name<br/>"; }
        if (!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value)) { error += "Please enter a valid email<br/>"; }
        document.getElementById("sfec-error").innerHTML = error;
        return error === "";
    }
    function composeComment() {
        var interest = document.getElementById("sfec-interest").value;
        var note = document.getElementById("sfec-note").value;
        var comment = "SFEC Claim Kit request - " + interest;
        if (note) { comment += "\nCourses / skills in mind: " + note; }
        document.getElementById("sfec-comment").value = comment;
    }
    function doSubmit() {
        var btn = document.getElementById("sfec-submit");
        if (btn) { btn.disabled = true; }
        document.forms["sfecLeadForm"].submit();
    }
    window.onSfecTurnstileSuccess = function (token) {
        var input = document.getElementById("sfec-turnstile-token");
        if (input) { input.value = token; }
        if (pendingSubmit) { pendingSubmit = false; doSubmit(); }
    };
    window.onSfecTurnstileError = function () {
        pendingSubmit = false;
        document.getElementById("sfec-error").innerHTML = "Spam check could not run. Please refresh the page and try again.";
    };
    window.onSfecTurnstileExpired = function () {
        var input = document.getElementById("sfec-turnstile-token");
        if (input) { input.value = ""; }
    };
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("sfecLeadForm");
        if (!form) { return; }
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) { return; }
            composeComment();
            if (!TURNSTILE_ENABLED || typeof window.turnstile === "undefined") { doSubmit(); return; }
            var input = document.getElementById("sfec-turnstile-token");
            if (input && input.value) { doSubmit(); return; }
            pendingSubmit = true;
            try { window.turnstile.execute(); }
            catch (err) { pendingSubmit = false; doSubmit(); }
        });
    });
})();
</script>
