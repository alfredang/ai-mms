<script type="text/javascript">
(function () {
    var TURNSTILE_ENABLED = <?php echo $tsSiteKey ? 'true' : 'false'; ?>;
    var pendingSubmit = false;

    function validateForm() {
        var error = "", f = document.forms["utapLeadForm"];
        if (!f["name"].value) { error += "Please enter your name<br/>"; }
        if (!/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,})+$/.test(f["email"].value)) { error += "Please enter a valid email<br/>"; }
        document.getElementById("utap-error").innerHTML = error;
        return error === "";
    }
    function composeComment() {
        var interest = document.getElementById("utap-interest").value;
        var note = document.getElementById("utap-note").value;
        var comment = "UTAP Claim Kit request - interested in: " + interest;
        if (note) { comment += "\nCourse / AI tool in mind: " + note; }
        document.getElementById("utap-comment").value = comment;
    }
    function doSubmit() {
        var btn = document.getElementById("utap-submit");
        if (btn) { btn.disabled = true; }
        document.forms["utapLeadForm"].submit();
    }
    window.onUtapTurnstileSuccess = function (token) {
        var input = document.getElementById("utap-turnstile-token");
        if (input) { input.value = token; }
        if (pendingSubmit) { pendingSubmit = false; doSubmit(); }
    };
    window.onUtapTurnstileError = function () {
        pendingSubmit = false;
        document.getElementById("utap-error").innerHTML = "Spam check could not run. Please refresh the page and try again.";
    };
    window.onUtapTurnstileExpired = function () {
        var input = document.getElementById("utap-turnstile-token");
        if (input) { input.value = ""; }
    };
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("utapLeadForm");
        if (!form) { return; }
        form.addEventListener("submit", function (e) {
            e.preventDefault();
            if (!validateForm()) { return; }
            composeComment();
            if (!TURNSTILE_ENABLED || typeof window.turnstile === "undefined") { doSubmit(); return; }
            var input = document.getElementById("utap-turnstile-token");
            if (input && input.value) { doSubmit(); return; }
            pendingSubmit = true;
            try { window.turnstile.execute(); }
            catch (err) { pendingSubmit = false; doSubmit(); }
        });
    });
})();
</script>
