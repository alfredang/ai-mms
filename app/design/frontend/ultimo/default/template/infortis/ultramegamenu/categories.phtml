?>

<?php

    $helper = Mage::helper('ultramegamenu');

    $visibilityClass = $helper->getCfg('sidemenu/hide_on_mobile') ? ' hide-below-768' : '';



    //Get starting category - a point where traverse begins

    $categoryId = $this->getParent();

    if ($categoryId === NULL) //Param not set

    {

        $categoryId = $helper->getCfg('sidemenu/parent');

    }



    //Get depth of recursion - how many levels of subcategories retrieve

    $depth = $this->getDepth();

    if ($depth === NULL) //Param not set

    {

        $depth = intval($helper->getCfg('sidemenu/depth'));

    }

    else

    {

        $depth = intval($depth);

    }



    //Render categories menu HTML
$categoryId = 3;
    $html = $this->renderMe(TRUE, $categoryId, $depth);

    if (!$html)

    {

        return '';

    }

?>

<div class="block block-vertnav<?php echo $visibilityClass; ?>">

    <div class="block-title">

        <strong><span><?php echo $this->__('Course Categories'); ?></span></strong>

    </div>

    <div class="block-content">

        <ul class="accordion accordion-style1 vertnav vertnav-side clearer"> <?php //Class "vertnav-side" left for backward compatibility ?>

            <?php echo $html; ?>

        </ul>

    </div>

</div>

<script type="text/javascript">
//<![CDATA[
(function () {
    // Auto-expand the "Infocomm Technology" branch in the sidebar Course Categories menu.
    function expandInfocomm() {
        var items = document.querySelectorAll('.block-vertnav .accordion.vertnav > li');
        if (!items.length) { return; }
        var target = null;
        for (var i = 0; i < items.length; i++) {
            var link = items[i].querySelector('a');
            if (link && /Infocomm Technology/i.test(link.textContent || link.innerText)) { target = items[i]; break; }
        }
        if (!target) { target = items[0]; }
        target.className += ' active open';
        var opener = target.querySelector('.opener');
        if (opener) { opener.className += ' active'; }
        var sub = target.querySelector('ul');
        if (sub) { sub.style.display = 'block'; }
    }
    if (document.readyState !== 'loading') { expandInfocomm(); }
    else { document.addEventListener('DOMContentLoaded', expandInfocomm); }
    if (window.addEventListener) { window.addEventListener('load', expandInfocomm); }
})();
//]]>
</script>

