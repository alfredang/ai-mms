<?php

/**

 * Use this template to display the sidebar menu inside static blocks and pages.

 */

?>

<?php

    $helper = Mage::helper('ultramegamenu');

    $visibilityClass = $helper->getCfg('sidemenu/hide_on_mobile') ? ' hide-below-768' : '';



    //Get starting category - a point where traverse begins

    $categoryId = $this->getParent();

    if ($categoryId === NULL) //Param not set

    {

        $categoryId = $helper->getCfg('sidemenu/parent');

    }



    //Get depth of recursion - how many levels of subcategories retrieve

    $depth = $this->getDepth();

    if ($depth === NULL) //Param not set

    {

        $depth = intval($helper->getCfg('sidemenu/depth'));

    }

    else

    {

        $depth = intval($depth);

    }



    //Render categories menu HTML
$categoryId = 3;
    $html = $this->renderMe(TRUE, $categoryId, $depth);

    // Prepend the "AI Courses" branch (a sibling of All Courses under the store root).
    // Resolved by name: its id differs per site (SG 252, MY/GH 25).
    $aiCategory = Mage::getResourceModel('catalog/category_collection')
        ->setStoreId(Mage::app()->getStore()->getId())
        ->addAttributeToSelect('name')
        ->addFieldToFilter('parent_id', Mage::app()->getStore()->getRootCategoryId())
        ->addAttributeToFilter('name', 'AI Courses')
        ->addAttributeToFilter('is_active', 1)
        ->setPageSize(1)
        ->getFirstItem();
    if ($aiCategory->getId()) {
        $aiChildren = $this->renderMe(TRUE, (int) $aiCategory->getId(), max(1, $depth - 1));
        $html = '<li class="nav-item level0 nav-ai' . ($aiChildren ? ' parent' : '') . '">'
            . '<a href="' . $this->getCategoryUrl($aiCategory) . '"><span>' . $this->escapeHtml($aiCategory->getName()) . '</span></a>'
            . ($aiChildren ? '<span class="opener"></span><ul class="level0 nav-submenu">' . $aiChildren . '</ul>' : '')
            . '</li>' . $html;
    }

    if (!$html)

    {

        return '';

    }

?>

<div class="block block-vertnav<?php echo $visibilityClass; ?>">

    <div class="block-title">

        <strong><span><?php echo $this->__('Course Categories'); ?></span></strong>

    </div>

    <div class="block-content">

        <ul class="accordion accordion-style1 vertnav vertnav-side clearer"> <?php //Class "vertnav-side" left for backward compatibility ?>

            <?php echo $html; ?>

        </ul>

    </div>

</div>

<script type="text/javascript">
//<![CDATA[
(function () {
    // Sidebar Course Categories: auto-expand "AI Courses" and "Infocomm Technology",
    // and list "Cyber Security" first under Infocomm Technology.
    function findChild(parent, re) {
        if (!parent) { return null; }
        for (var i = 0; i < parent.children.length; i++) {
            var link = parent.children[i].querySelector('a');
            if (link && re.test(link.textContent || link.innerText)) { return parent.children[i]; }
        }
        return null;
    }
    function expand(li) {
        if (!li) { return; }
        if (!/\bopen\b/.test(li.className)) { li.className += ' active open'; }
        var opener = li.querySelector('.opener');
        if (opener && !/\bactive\b/.test(opener.className)) { opener.className += ' active'; }
        var sub = li.querySelector('ul');
        if (sub) { sub.style.display = 'block'; }
    }
    function arrangeSidebar() {
        var menu = document.querySelector('.block-vertnav .accordion.vertnav');
        var infocomm = findChild(menu, /Infocomm Technology/i);
        var infocommSub = infocomm && infocomm.querySelector('ul');
        var cyber = findChild(infocommSub, /^\s*Cyber Security\s*$/i);
        if (cyber && cyber !== infocommSub.firstElementChild) { infocommSub.insertBefore(cyber, infocommSub.firstElementChild); }
        expand(findChild(menu, /^\s*AI Courses\s*$/i));
        expand(infocomm);
    }
    arrangeSidebar();
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', arrangeSidebar); }
    if (window.addEventListener) { window.addEventListener('load', arrangeSidebar); }
})();
//]]>
</script>

