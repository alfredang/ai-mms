<?xml version="1.0"?>
<layout>
    <default>
        <reference name="header">
            <block type="mmd_rolemanager/page_header_roleSwitcher"
                   name="role_switcher"
                   template="rolemanager/role-switcher.phtml" />
        </reference>
        <!-- Load rolemanager.css globally on every admin page so PJAX
             (instant-nav.js) swaps to .rm-table-bearing pages (e.g.
             classes/index, rolemanagement/index, cpgenerator/index)
             always have the stylesheet available. Previously this was
             added only on five specific layout handles; PJAX never
             updates <head>, so navigating from any other admin page
             rendered the .rm-table elements unstyled until a full
             refresh. ~10KB of CSS on every page is a tiny price for
             not having to chase every CSS-bound new route. -->
        <reference name="head">
            <action method="addCss"><name>rolemanager.css</name></action>
        </reference>
    </default>

    <!-- Add Course button above the Manage Courses product grid -->
    <adminhtml_catalog_product_index>
        <reference name="content">
            <block type="core/template" name="add.course.btn" before="products_list"
                   template="rolemanager/add-course-btn.phtml" />
        </reference>
    </adminhtml_catalog_product_index>
</layout>
