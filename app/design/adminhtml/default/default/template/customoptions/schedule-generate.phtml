<?php
/**
 * "Generate Course Dates" panel on the Edit Template (class schedule) page.
 *
 * Hidden by default. On load it is relocated to sit directly below the button
 * row (the theme relocates the varienTabs to right after .content-header and
 * flows the form buttons into that row, so we anchor to the relocated tabs).
 * The "Generate Course Dates" toolbar button toggles it via
 * mmdScheduleGenToggle().
 *
 * Posts a schedule code + start/end range to customoptions_options/generateDates,
 * which runs the native PHP port of the Google Apps Script generator and MERGES
 * the resulting Course Date values into this template (idempotent).
 *
 * The schedule code is READ-ONLY here — it is fixed to the current template
 * (derived from the title). A future enhancement on the main Manage Class
 * Schedule page will make it selectable for bulk generation.
 *
 * Styling uses design tokens only so it matches the dark edit-page theme.
 *
 * @var Mage_Adminhtml_Block_Template $this
 */
$groupId     = (int) $this->getData('group_id');
$storeId     = (int) $this->getData('store_id');
$action      = $this->getData('form_action');
$defaultCode = $this->getData('default_code');
$formKey     = Mage::getSingleton('core/session')->getFormKey();
?>
<div id="mmd-schedule-gen" class="mmd-gen-panel" style="display:none;">
    <div class="mmd-gen-head">
        <span class="mmd-gen-title"><?php echo $this->__('Generate Course Dates') ?></span>
        <button type="button" class="mmd-gen-close" title="<?php echo $this->__('Close') ?>"
                onclick="mmdScheduleGenToggle(); return false;">&times;</button>
    </div>
    <p class="mmd-gen-note">
        <?php echo $this->__('Choose a date range; matching class dates for this template\'s schedule code are generated and added to its "Course Date" option. Re-running the same range will not create duplicates. After generating, click "Save And Continue Edit" to apply the new dates to this template\'s assigned courses.') ?>
    </p>
    <form action="<?php echo $this->escapeHtml($action) ?>" method="post" id="mmd-schedule-gen-form">
        <input type="hidden" name="form_key" value="<?php echo $formKey ?>" />
        <input type="hidden" name="group_id" value="<?php echo $groupId ?>" />
        <?php if ($storeId > 0): ?>
        <input type="hidden" name="store" value="<?php echo $storeId ?>" />
        <?php endif; ?>
        <div class="mmd-gen-row">
            <div class="mmd-gen-field">
                <label for="mmd-gen-code"><?php echo $this->__('Schedule Code') ?></label>
                <input type="text" id="mmd-gen-code" name="schedule_code" class="input-text"
                       value="<?php echo $this->escapeHtml($defaultCode) ?>"
                       readonly="readonly" title="<?php echo $this->__('Fixed to this template') ?>"
                       style="width:84px;" />
            </div>
            <div class="mmd-gen-field">
                <label for="mmd-gen-start"><?php echo $this->__('Start Date') ?></label>
                <input type="date" id="mmd-gen-start" name="start_date" class="input-text" required />
            </div>
            <div class="mmd-gen-field">
                <label for="mmd-gen-end"><?php echo $this->__('End Date') ?></label>
                <input type="date" id="mmd-gen-end" name="end_date" class="input-text" required />
            </div>
            <div class="mmd-gen-field mmd-gen-action">
                <button type="submit" class="mm-btn-primary"><?php echo $this->__('Generate Dates') ?></button>
            </div>
        </div>
    </form>
</div>
<style>
/* Inset panel — colours/typography from global tokens to match the edit page. */
