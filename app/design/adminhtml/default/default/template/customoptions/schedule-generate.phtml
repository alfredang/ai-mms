<script type="text/javascript">
//<![CDATA[
(function () {
    // Place the (hidden) panel directly below the button/tabs row, above the
    // form. The form (#edit_form) is server-rendered and never moved by the
    // theme's JS, and always sits below the .content-header + relocated tabs,
    // so inserting the panel just before it is timing-independent. Fall back
    // to after the relocated tabs / content-header if the form id changes.
    function positionPanel() {
        var panel = document.getElementById('mmd-schedule-gen');
        if (!panel || panel.getAttribute('data-positioned')) { return; }
        var form = document.getElementById('edit_form');
        if (form && form.parentNode) {
            form.parentNode.insertBefore(panel, form);
            panel.setAttribute('data-positioned', '1');
            return;
        }
        var main = document.querySelector('.main-col-inner') || document.body;
        var anchor = main.querySelector('.tabs-relocated') || main.querySelector('.content-header');
        if (anchor && anchor.parentNode) {
            anchor.parentNode.insertBefore(panel, anchor.nextSibling);
            panel.setAttribute('data-positioned', '1');
        }
    }

    if (document.readyState !== 'loading') { positionPanel(); }
    else { document.addEventListener('DOMContentLoaded', positionPanel); }
    setTimeout(positionPanel, 200); // safety net

    window.mmdScheduleGenToggle = function () {
        var panel = document.getElementById('mmd-schedule-gen');
        if (!panel) { return false; }
        positionPanel();
        var hidden = (panel.style.display === 'none' || panel.style.display === '');
        panel.style.display = hidden ? 'block' : 'none';
        if (hidden) {
            try { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
            var s = document.getElementById('mmd-gen-start');
            if (s) { s.focus(); }
        }
        return false;
    };

    // Braille spinner on the Generate button while the synchronous POST runs
    // (the page reloads on completion, which ends the animation naturally).
    var form = document.getElementById('mmd-schedule-gen-form');
    if (form) {
        form.addEventListener('submit', function () {
            var btn = form.querySelector('button[type="submit"]');
            if (!btn) { return; }
            var frames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
            var i = 0;
            btn.disabled = true;
            btn.textContent = frames[0] + ' Generating…';
            setInterval(function () {
                i = (i + 1) % frames.length;
                btn.textContent = frames[i] + ' Generating…';
            }, 90);
        });
    }
})();
//]]>
</script>
