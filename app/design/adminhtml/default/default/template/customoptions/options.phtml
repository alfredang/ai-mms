<style>
/* The auto-card-wrap JS (sidebar-nav-v2.js → wrapMmdGridInCard) hoists
   the .form-buttons children into .mmd-auto-card-actions on the same
   .dcf-mag-bar flex row as the title and the massaction toolbar. Long
   labels ("1. Clean Templates" / "2. Apply to Products" /
   "Add Class Schedule") then wrap vertically into a stack because the
   right-side space is squeezed by the massaction.
   Body-scoped overrides below force the bar to wrap and put the three
   buttons on their own full-width row as an equal-column grid. Title
   stays in the natural top-left position. */
body[class*="customoptions"] .dcf-mag.mmd-auto-card > .dcf-mag-bar {
    flex-wrap: wrap !important;
    row-gap: 12px !important;
}
body[class*="customoptions"] .dcf-mag.mmd-auto-card > .dcf-mag-bar > .mmd-auto-card-actions {
    flex: 1 1 100% !important;
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 10px !important;
    order: 99 !important;   /* push buttons to a new row at the end */
    width: 100% !important;
}
body[class*="customoptions"] .dcf-mag.mmd-auto-card .mmd-auto-card-actions > button.scalable {
    width: 100% !important;
    max-width: none !important;
}
</style>
<div><?php echo $this->getGridHtml() ?></div>
<script type="text/javascript">
//<![CDATA[
    // PHP-generated list URL so we don't have to reverse-engineer
    // /index/ vs no-action and admin secret-URL-key segments from
    // window.location — Mage::helper('adminhtml')->getUrl() emits
    // the canonical, secret-key-included URL that Magento will
    // round-trip through frontController validation. Trailing slash
    // guaranteed.
    var MMD_SCHEDULE_LIST_URL = <?php echo json_encode(rtrim(Mage::helper('adminhtml')->getUrl('*/customoptions_options/index'), '/') . '/'); ?>;
    (function injectScheduleSearch() {
        function go() {
            var firstCell = document.querySelector('#customoptionsOptionsGrid table.massaction > tbody > tr > td:first-child')
                         || document.querySelector('#customoptionsOptionsGrid table.massaction tr > td:first-child');
            var titleFilter = document.getElementById('customoptionsOptionsGrid_filter_title');
            if (!firstCell || !titleFilter) {
                return setTimeout(go, 100);
            }
            if (document.getElementById('mmd-schedule-search-input')) return;
            var wrap = document.createElement('span');
            wrap.id = 'mmd-schedule-search-wrap';
            wrap.style.cssText = 'display:inline-block;margin-left:24px;vertical-align:middle;';
            var input = document.createElement('input');
            input.type = 'text';
            input.id = 'mmd-schedule-search-input';
            input.className = 'input-text';
            input.placeholder = 'Search title…';
            input.value = titleFilter.value || '';
            input.style.cssText = 'width:320px;height:30px;padding:4px 10px;border-radius:6px;border:1px solid #2a3447;background:#0f172a;color:#e5e7eb;font-size:13px;box-sizing:border-box;vertical-align:middle;';
            input.addEventListener('keydown', function (e) {
                if (e.keyCode !== 13) return;
                e.preventDefault();
                titleFilter.value = input.value;
                var val = (input.value || '').trim();
                // Build the filter URL on top of the canonical
                // PHP-emitted list URL (action segment + admin
                // secret-URL-key already correct). Magento decodes
                // the filter string with base64_decode + parse_str
                // — see Mage_Adminhtml_Helper_Data::prepareFilterString.
                var url = MMD_SCHEDULE_LIST_URL;
                if (val) {
                    url += 'filter/' + btoa('title=' + encodeURIComponent(val)) + '/';
                }
                window.location.href = url;
            });
            wrap.appendChild(input);
            firstCell.appendChild(wrap);
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', go);
        } else {
            go();
        }
    })();
//]]>
</script>