<?php
/**
 * MMD Advanced Product Options — Manage Class Schedule
 */

// Build the list of templates that have recognised schedule codes for the bulk panel.
$generator       = Mage::getModel('mmd/schedule_generator');
$allGroups       = Mage::getResourceModel('customoptions/group_collection');
$bulkTemplates   = array();
foreach ($allGroups as $grp) {
    $ncode = $generator->normalizeCode((string) $grp->getTitle());
    if ($ncode !== '' && $generator->isKnownCode($ncode)) {
        $bulkTemplates[] = array(
            'group_id' => (int) $grp->getId(),
            'title'    => (string) $grp->getTitle(),
            'code'     => strtoupper($ncode),
        );
    }
}
usort($bulkTemplates, function ($a, $b) {
    $c = strcmp($a['code'], $b['code']);
    return $c !== 0 ? $c : strcmp($a['title'], $b['title']);
});

$batchGenerateUrl = Mage::helper('adminhtml')->getUrl('*/customoptions_options/runBulkGenerateBatch');
$batchApplyUrl    = Mage::helper('adminhtml')->getUrl('*/customoptions_options/runBulkApplyBatch');
$stateUrl         = Mage::helper('adminhtml')->getUrl('*/customoptions_options/getBulkState');
$bulkDataJson = json_encode($bulkTemplates);
?>
