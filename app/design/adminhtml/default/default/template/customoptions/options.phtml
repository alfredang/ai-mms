<script type="text/javascript">
//<![CDATA[
(function () {

var _batchGenerateUrl = <?php echo json_encode($batchGenerateUrl) ?>;
var _batchApplyUrl    = <?php echo json_encode($batchApplyUrl) ?>;
var _stateUrl         = <?php echo json_encode($stateUrl) ?>;
var _scheduleListUrl = <?php echo json_encode(rtrim(Mage::helper('adminhtml')->getUrl('*/customoptions_options/index'), '/') . '/') ?>;

/* ── Spinner ── */
var _frames = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'], _fi = 0, _ft = null, _spinnerLi = null;

function _stopSpinner() {
    if (_ft) { clearInterval(_ft); _ft = null; }
    // Also remove the spinner li from the DOM so it doesn't stay visible after done.
    if (_spinnerLi && _spinnerLi.parentNode) { _spinnerLi.parentNode.removeChild(_spinnerLi); _spinnerLi = null; }
}

function _showSpinner(logId) {
    _stopSpinner();
    _spinnerLi = _addEntry(logId, _frames[0] + ' Processing…', 'wait');
    _ft = setInterval(function () {
        _fi = (_fi + 1) % _frames.length;
        if (_spinnerLi) _spinnerLi.textContent = _frames[_fi] + ' Processing…';
    }, 90);
}

function _clearWait(logId) {
    var log = document.getElementById(logId);
    if (!log) return;
    var waits = log.querySelectorAll('li.mbgp-wait');
    Array.prototype.forEach.call(waits, function (w) { w.parentNode.removeChild(w); });
}

/* ── Log helpers ── */
function _addEntry(logId, text, cls) {
    var li = document.createElement('li');
    li.className = 'mbgp-' + (cls || 'ok');
    li.textContent = text;
    var log = document.getElementById(logId);
    if (log) { log.appendChild(li); log.scrollTop = log.scrollHeight; }
    return li;
}

function _clearLog(logId) {
    var log = document.getElementById(logId);
    if (log) log.innerHTML = '';
}

/* ── Plain XHR (bypasses Prototype Ajax.Responders / loading mask) ── */
function _xhr(url, cb) {
    var r = new XMLHttpRequest();
    r.open('GET', url, true);
    r.onload = function () {
        try { cb(null, JSON.parse(r.responseText)); }
        catch (e) {
            var err = new Error('Parse error');
            err.responseText = r.responseText;
            cb(err);
        }
    };
    r.onerror = function () { cb(new Error('Network error')); };
    r.send();
}

/* ── Flash the Apply All button (also called from the Step 2 tab click) ── */
window._flashApplyAll = function () {
    var applyAllBtn = document.getElementById('mbg-apply-direct-btn');
    if (!applyAllBtn) return;
    applyAllBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
    applyAllBtn.classList.add('mbg-btn-flash');
    setTimeout(function () { applyAllBtn.classList.remove('mbg-btn-flash'); }, 2200);
};

/* ── Tab switching ── */
window.mmdBulkSwitchTab = function (name) {
    var tabs     = document.querySelectorAll('.mbg-tab');
    var contents = document.querySelectorAll('.mbg-tab-content');
    Array.prototype.forEach.call(tabs, function (t) {
        t.classList.toggle('mbg-tab-active', t.getAttribute('data-tab') === name);
    });
    Array.prototype.forEach.call(contents, function (c) {
        c.style.display = c.id === 'mbg-tab-' + name ? '' : 'none';
    });
};

function _setTabBadge(tab, text) {
    var btn = document.querySelector('.mbg-tab[data-tab="' + tab + '"]');
    if (!btn) return;
    var existing = btn.querySelector('.mbg-tab-badge');
    if (existing) existing.parentNode.removeChild(existing);
    if (text) {
        var b = document.createElement('span');
        b.className = 'mbg-tab-badge';
        b.textContent = text;
        btn.appendChild(b);
    }
}

/* ── Status indicator ── */
function _setStatus(text, cls) {
    var el = document.getElementById('mbg-status');
    if (!el) return;
    el.textContent = text;
    el.className = text ? 'mbg-s-' + cls : '';
}

/* ── Template count ── */
window.mmdBulkCheckAll = function (checked) {
    var boxes = document.querySelectorAll('#mbg-checklist input[type="checkbox"]');
    Array.prototype.forEach.call(boxes, function (b) { b.checked = checked; });
    mmdBulkUpdateCount();
};
window.mmdBulkUpdateCount = function () {
    var boxes = document.querySelectorAll('#mbg-checklist input[type="checkbox"]');
    var n = 0;
    Array.prototype.forEach.call(boxes, function (b) { if (b.checked) n++; });
    var el = document.getElementById('mbg-count');
    if (el) el.textContent = n + ' template' + (n === 1 ? '' : 's') + ' selected';
    var btn = document.getElementById('mbg-run-generate');
    if (btn) btn.disabled = (n === 0);
};

/* ── Generate phase (server-side batch + client poll) ── */
var _genPollTimer      = null;
var _genPollCount      = 0;
var _genPollLastSeen   = 0;
var _genPollStale      = 0;

function _startGenerate() {
    var start = document.getElementById('mbg-start').value;
    var end   = document.getElementById('mbg-end').value;
    if (!start || !end) { alert('Enter a start and end date.'); return; }
    if (start > end)    { alert('Start date must be on or before end date.'); return; }

    var groupIds = [];
    Array.prototype.forEach.call(
        document.querySelectorAll('#mbg-checklist input[type="checkbox"]:checked'),
        function (cb) { groupIds.push(cb.getAttribute('data-group-id')); }
    );
    if (!groupIds.length) { alert('Select at least one template.'); return; }

    _genPollCount = 0;
    _clearLog('mbg-gen-log');
    _clearLog('mbg-apply-log');
    _applyPollCount = 0;
    document.getElementById('mbg-apply-review').style.display = 'none';
    mmdBulkSwitchTab('generate');
    _setTabBadge('apply', '');
    document.getElementById('mbg-run-generate').disabled = true;
    _setStatus('Generating on server…', 'running');
    _showSpinner('mbg-gen-log');

    _startPollGenerate();

    var url = _batchGenerateUrl
            + '?group_ids=' + encodeURIComponent(groupIds.join(','))
            + '&start='     + encodeURIComponent(start)
            + '&end='       + encodeURIComponent(end);

    _xhr(url, function (err, finalState) {
        _stopPollGenerate();
        _stopSpinner();
        if (finalState && finalState.gen_results) {
            _replayGenLog(finalState.gen_results);
        }
        _onGenerateDone(err, finalState);
    });
}

function _startPollGenerate() {
    if (_genPollTimer) return;
    _genPollLastSeen = _genPollCount;
    _genPollStale    = 0;
    _genPollTimer = setInterval(function () {
        _xhr(_stateUrl + '&_ts=' + Date.now(), function (err, state) {
            if (err || !state || !state.gen_results) return;
            _replayGenLog(state.gen_results);
            if (state.status === 'complete_generate' || state.status === 'applying' || state.status === 'complete') {
                _stopPollGenerate();
                return;
            }
            // If no new results for 30 s (15 polls × 2 s), server process died
            if (state.gen_results.length > _genPollLastSeen) {
                _genPollLastSeen = state.gen_results.length;
                _genPollStale    = 0;
            } else if (++_genPollStale >= 15) {
                _stopPollGenerate();
                _stopSpinner();
                _addEntry('mbg-gen-log', '— Server process stopped. Click Run Generate to restart. —', 'err');
                document.getElementById('mbg-run-generate').disabled = false;
                _setStatus('Interrupted — click Run Generate to restart', 'history');
            }
        });
    }, 2000);
}

function _stopPollGenerate() {
    if (_genPollTimer) { clearInterval(_genPollTimer); _genPollTimer = null; }
}

function _replayGenLog(results) {
    if (!results || results.length <= _genPollCount) return;
    for (var i = _genPollCount; i < results.length; i++) {
        var r = results[i];
        _addEntry('mbg-gen-log', r.text || '', r.status || 'ok');
    }
    _genPollCount = results.length;
}

function _onGenerateDone(err, finalState) {
    _stopSpinner();
    if (!err) {
        _addEntry('mbg-gen-log', 'Generation complete — see Apply tab to push changes to courses.', 'done');
    }
    document.getElementById('mbg-run-generate').disabled = false;
    _setStatus('Generate complete', 'ok');
    _setTabBadge('apply', '!');
    if (finalState && finalState.gen_results) {
        _showApplyReview(finalState);
        mmdBulkSwitchTab('apply');
    }
}

/* ── Apply tab: review panel ── */
function _showApplyReview(state) {
    var genResults    = state.gen_results  || [];
    var applyList     = state.apply_list   || [];
    var totalNew = 0, totalExisting = 0, totalProds = 0;
    genResults.forEach(function (r) { totalNew += r.added || 0; totalExisting += r.existing || 0; });
    applyList.forEach(function (r)  { totalProds += r.product_count || 0; });

    document.getElementById('mbg-review-stats').innerHTML =
        _stat(totalNew,                              'New dates') +
        _stat(totalExisting,                         'Existing dates') +
        _stat(applyList.length,                      'Templates changed') +
        _stat(genResults.length - applyList.length,  'No changes');

    var tbody = document.getElementById('mbg-review-tbody');
    tbody.innerHTML = '';
    genResults.forEach(function (r) {
        var tr = document.createElement('tr');
        tr.innerHTML =
            '<td>' + _esc(r.title || '') + '</td>' +
            '<td class="mbgp-col-num">' + _badge(r.added, 'new') + '</td>' +
            '<td class="mbgp-col-num">' + _badge(r.existing || 0, 'skip') + '</td>' +
            '<td class="mbgp-col-num">' + (r.changed > 0 ? r.product_count : '<span class="mbgp-badge-skip">—</span>') + '</td>';
        tbody.appendChild(tr);
    });

    document.getElementById('mbg-apply-review').style.display = '';
}

/* ── Apply phase (server-side batch + client poll) ── */
var _applyPollTimer    = null;
var _applyPollCount    = 0;
var _applyPollLastSeen = 0;
var _applyPollStale    = 0;
var _applyDone         = false; // one-shot guard — prevents duplicate "All done" from concurrent XHR + poll callbacks

function _startApply(applyList) {
    _applyDone = false;
    mmdBulkSwitchTab('apply');
    document.getElementById('mbg-apply-review').style.display = 'none';
    _clearLog('mbg-apply-log');
    _applyPollCount = 0;
    document.getElementById('mbg-apply-direct-btn').disabled = true;
    _setTabBadge('apply', '⟳');
    _setStatus('Applying on server…', 'running');
    document.getElementById('mbg-apply-log').scrollIntoView({ behavior: 'smooth', block: 'start' });
    _showSpinner('mbg-apply-log');
    _startPollApply();

    // Fire the batch request. ignore_user_abort on the server keeps PHP running
    // even if this XHR drops (Apache timeout, page refresh). Progress comes via
    // polling — do NOT stop the poll when XHR returns. Let the poll detect
    // completion (state.status === 'complete') and call _onApplyDone then.
    _xhr(_batchApplyUrl, function (err, finalState) {
        if (!err && finalState && finalState.status === 'locked') {
            // PHP mutex: another process already holds the lock — just keep polling.
            _addEntry('mbg-apply-log', '— Another apply is already running; monitoring via poll… —', 'skip');
            return;
        }
        if (err) {
            // Connection dropped or server returned non-JSON (PHP warning etc.).
            // Log first 300 chars of the raw response so the user can see what PHP said.
            var raw = (err.responseText || '').replace(/</g, '&lt;').substring(0, 300);
            if (raw) _addEntry('mbg-apply-log', '— Server response (debug): ' + raw + ' —', 'err');
            _addEntry('mbg-apply-log', '— HTTP connection closed; PHP may still be running — monitoring via poll… —', 'skip');
            // Keep polling — PHP set ignore_user_abort so it continues even if connection dropped.
        } else if (finalState && finalState.apply_results) {
            // XHR returned the final state — replay missing results and signal done.
            _replayApplyLog(finalState.apply_results);
            _stopPollApply();
            _onApplyDone(null);
        }
        // If finalState is valid but no apply_results yet, leave poll running.
    });
}
window._startApply = _startApply; // expose for inline onclick attributes (IIFE scope)

function _startPollApply() {
    if (_applyPollTimer) return;
    _applyPollLastSeen = _applyPollCount;
    _applyPollStale    = 0;
    _applyPollTimer = setInterval(function () {
        _xhr(_stateUrl + '&_ts=' + Date.now(), function (err, state) {
            if (err || !state) {
                // Poll request itself failed — count as stale tick
                if (++_applyPollStale >= 15) {
                    _stopPollApply();
                    _stopSpinner();
                    _addEntry('mbg-apply-log', '— Server process stopped. Click Apply to retry. —', 'err');
                    _setStatus('Interrupted — click Apply to retry', 'history');
                }
                return;
            }
            if (state.apply_results) _replayApplyLog(state.apply_results);
            if (state.status === 'complete' || state.status === 'idle') {
                _stopPollApply();
                _onApplyDone(false);
                return;
            }
            // Track staleness by result count — also fires when apply_results is absent
            // (server just set status=applying but hasn't processed a template yet).
            var seen = state.apply_results ? state.apply_results.length : 0;
            if (seen > _applyPollLastSeen) {
                _applyPollLastSeen = seen;
                _applyPollStale    = 0;
            } else if (++_applyPollStale >= 90) {
                _stopPollApply();
                // 3 minutes of no new results. Could be a very slow template (40+ products)
                // or a genuinely stalled/dead process. Check state and use _fireRetryXhr
                // (lightweight — does NOT reset log or poll count, avoids duplicate entries).
                _xhr(_stateUrl + '&_ts=' + Date.now(), function (err2, s2) {
                    if (!err2 && s2 && s2.status === 'applying') {
                        _setStatus('Reconnecting…', 'running');
                        setTimeout(function () { _fireRetryXhr(); }, 3000);
                    } else {
                        _stopSpinner();
                        _addEntry('mbg-apply-log', '— Server process stopped. Click Apply to retry. —', 'err');
                        document.getElementById('mbg-apply-direct-btn').disabled = false;
                        _setStatus('Interrupted — click Apply to retry', 'history');
                    }
                });
            }
        });
    }, 2000);
}

function _stopPollApply() {
    if (_applyPollTimer) { clearInterval(_applyPollTimer); _applyPollTimer = null; }
}

// Lightweight reconnect fired by staleness handler — does NOT reset the log or
// poll count, so already-logged entries are not replayed. The PHP mutex means only
// one server process runs at a time; if one is already running we just get 'locked'
// back and resume polling.
function _fireRetryXhr() {
    _addEntry('mbg-apply-log', '— Reconnecting to server… —', 'skip');
    _xhr(_batchApplyUrl, function (err, finalState) {
        if (!err && finalState) {
            if (finalState.status === 'locked') {
                _addEntry('mbg-apply-log', '— Apply already running, resuming poll… —', 'skip');
                _applyPollStale = 0;
                _startPollApply();
                return;
            }
            if (finalState.apply_results) _replayApplyLog(finalState.apply_results);
            if (finalState.status === 'complete') {
                _stopPollApply();
                _onApplyDone(null);
                return;
            }
        } else if (err) {
            _addEntry('mbg-apply-log', '— Connection error on retry; will keep monitoring… —', 'skip');
        }
        _applyPollStale = 0;
        _startPollApply();
    });
}

function _replayApplyLog(results) {
    if (!results || results.length <= _applyPollCount) return;
    for (var i = _applyPollCount; i < results.length; i++) {
        var r = results[i];
        _addEntry('mbg-apply-log', r.text || '', r.status || 'ok');
    }
    _applyPollCount = results.length;
}

function _onApplyDone(err) {
    if (_applyDone) return; // guard: XHR callback + poll both call this — only run once
    _applyDone = true;
    _stopSpinner();
    if (!err) {
        _addEntry('mbg-apply-log', 'All done — page cache flushed, storefront will show new dates.', 'done');
    }
    document.getElementById('mbg-apply-review').style.display = '';
    document.getElementById('mbg-apply-direct-btn').disabled = false;
    _setStatus('Apply complete', 'ok');
    _setTabBadge('apply', '');
}

/* ── State restoration (panel open → fetch last run) ── */
function _restoreFromState(state) {
    if (!state || state.status === 'idle') return;
    // Pre-fill dates
    if (state.start_date && document.getElementById('mbg-start')) {
        document.getElementById('mbg-start').value = state.start_date;
    }
    if (state.end_date && document.getElementById('mbg-end')) {
        document.getElementById('mbg-end').value = state.end_date;
    }

    var genResults   = state.gen_results   || [];
    var applyResults = state.apply_results || [];

    // Restore generate log
    _clearLog('mbg-gen-log');
    genResults.forEach(function (r) {
        _addEntry('mbg-gen-log', r.text || '', r.status || 'ok');
    });

    if (state.status === 'complete_generate' || state.status === 'applying' || state.status === 'complete') {
        if (genResults.length) _addEntry('mbg-gen-log', '— History from last run —', 'skip');
        _showApplyReview(state);

        _clearLog('mbg-apply-log');
        _applyPollCount = 0;
        applyResults.forEach(function (r) {
            _addEntry('mbg-apply-log', r.text || '', r.status || 'ok');
        });
        _applyPollCount = applyResults.length;

        if (state.status === 'applying' || state.status === 'complete') {
            mmdBulkSwitchTab('apply');
        }
        if (state.status === 'applying') {
            // Hide review table and show only the live log while apply is in progress.
            document.getElementById('mbg-apply-review').style.display = 'none';
            _setTabBadge('apply', '⟳');
            document.getElementById('mbg-apply-direct-btn').disabled = true;
            _addEntry('mbg-apply-log', '— Server-side apply is running, reconnecting… —', 'skip');
            _startPollApply();
        }
        if (state.status === 'complete') {
            document.getElementById('mbg-apply-review').style.display = '';
            _addEntry('mbg-apply-log', '— Last run completed —', 'done');
        }
        _setStatus('Last run history', 'history');
    } else if (state.status === 'generating') {
        if (genResults.length > 0) {
            _genPollCount = genResults.length;
            _addEntry('mbg-gen-log', '— Server-side generate is still running, reconnecting… —', 'skip');
        }
        document.getElementById('mbg-run-generate').disabled = true;
        _startPollGenerate();
        _setStatus('Generating on server…', 'running');
    }
}

/* ── Panel toggle ── */
window.mmdBulkGenToggle = function () {
    var panel = document.getElementById('mmd-bulk-gen-panel');
    if (!panel) return false;
    var shown = (panel.style.display !== '' && panel.style.display !== 'none');
    if (!shown) {
        panel.style.display = 'block';
        mmdBulkUpdateCount();
        // Fetch and restore state on open
        _xhr(_stateUrl + '&_ts=' + Date.now(), function (err, state) {
            if (!err && state) _restoreFromState(state);
        });
        try { panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); } catch (e) {}
        var s = document.getElementById('mbg-start');
        if (s && !s.value) s.focus();
    } else {
        panel.style.display = 'none';
    }
    return false;
};

/* ── Wire run button ── */
var runBtn = document.getElementById('mbg-run-generate');
if (runBtn) {
    runBtn.addEventListener('click', function () { _startGenerate(); });
}

/* ── Init count ── */
mmdBulkUpdateCount();

/* ── Schedule title search (injected into massaction row) ── */
(function injectScheduleSearch() {
    function go() {
        var firstCell = document.querySelector('#customoptionsOptionsGrid table.massaction > tbody > tr > td:first-child')
                     || document.querySelector('#customoptionsOptionsGrid table.massaction tr > td:first-child');
        var titleFilter = document.getElementById('customoptionsOptionsGrid_filter_title');
        if (!firstCell || !titleFilter) { return setTimeout(go, 100); }
        if (document.getElementById('mmd-schedule-search-input')) return;
        var wrap = document.createElement('span');
        wrap.id = 'mmd-schedule-search-wrap';
        wrap.style.cssText = 'display:inline-block;margin-left:24px;vertical-align:middle;';
        var input = document.createElement('input');
        input.type = 'text';
        input.id   = 'mmd-schedule-search-input';
        input.className   = 'input-text';
        input.placeholder = 'Search title…';
        input.value = titleFilter.value || '';
        input.style.cssText = 'width:320px;height:30px;padding:4px 10px;border-radius:6px;border:1px solid #2a3447;background:#0f172a;color:#e5e7eb;font-size:13px;box-sizing:border-box;vertical-align:middle;';
        function doSearch() {
            var val = (input.value || '').trim();
            var url = _scheduleListUrl;
            // Always send an explicit filter segment so Magento overwrites the
            // session value even when clearing (empty val → btoa('title=') resets it).
            url += 'filter/' + btoa('title=' + encodeURIComponent(val)) + '/';
            window.location.href = url;
        }
        input.addEventListener('keydown', function (e) {
            if (e.keyCode !== 13) return;
            e.preventDefault();
            doSearch();
        });
        var clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.title = 'Clear search';
        clearBtn.textContent = '×';
        clearBtn.style.cssText = 'margin-left:6px;background:none;border:none;color:#64748b;font-size:18px;line-height:1;cursor:pointer;vertical-align:middle;padding:0 4px;';
        clearBtn.addEventListener('click', function () {
            input.value = '';
            doSearch();
        });
        wrap.appendChild(input);
        wrap.appendChild(clearBtn);
        firstCell.appendChild(wrap);
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', go);
    } else {
        go();
    }
})();

/* ── Shared helpers ── */
function _stat(val, lbl) {
    return '<div class="mbg-stat"><span class="mbg-stat-val">' + val + '</span><span class="mbg-stat-lbl">' + lbl + '</span></div>';
}
function _badge(n, type) {
    if (!n) return '<span class="mbgp-badge-skip">—</span>';
    return '<span class="mbgp-badge-' + type + '">' + n + '</span>';
}
function _esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

})();
//]]>
</script>
