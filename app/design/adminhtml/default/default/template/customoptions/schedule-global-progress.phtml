<script type="text/javascript">
//<![CDATA[
(function () {

/* ── suppress Magento's "Please wait" loading mask for this whole page ──
   Ajax.Responders re-shows it on every new Ajax.Request, so a one-shot
   hide() loses every race after the first. We run a tight interval that
   force-hides it whenever it reappears, for the full duration of the page. */
var _maskSuppressor = setInterval(function () {
    var m = document.getElementById('loading-mask');
    if (m && m.style.display !== 'none') { m.style.display = 'none'; }
    if (typeof hideMask === 'function') { try { hideMask(); } catch (e) {} }
}, 150);

/* ── shared helpers ── */
var _frames = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'], _fi = 0, _ft = null;

function addEntry(logId, text, cls) {
    var li = document.createElement('li');
    li.className = 'mbgp-' + cls;
    li.textContent = text;
    var log = document.getElementById(logId);
    if (log) log.appendChild(li);
    window.scrollTo(0, 99999);
    return li;
}

function clearWait(logId) {
    var log = document.getElementById(logId);
    if (!log) return;
    var waits = log.querySelectorAll('li.mbgp-wait');
    for (var i = 0; i < waits.length; i++) waits[i].parentNode.removeChild(waits[i]);
}

function showSpinner(logId) {
    if (_ft) { clearInterval(_ft); _ft = null; }
    var li = addEntry(logId, _frames[0] + ' Processing…', 'wait');
    _ft = setInterval(function () {
        _fi = (_fi + 1) % _frames.length;
        li.textContent = _frames[_fi] + ' Processing…';
    }, 90);
    return li;
}

/* ── Phase 1: generate ── */
var genResults = []; // accumulates per-template result objects

function runGenerate(data) {
    clearWait('mbgp-gen-log');
    if (_ft) { clearInterval(_ft); _ft = null; }

    if (data.text) {
        addEntry('mbgp-gen-log', data.text, data.status || 'ok');
    }
    /* collect result metadata for review panel */
    if (typeof data.group_id !== 'undefined') {
        genResults.push({
            group_id:      data.group_id,
            title:         data.title || '',
            added:         data.added  || 0,
            fixed:         data.fixed  || 0,
            changed:       data.changed || 0,
            product_count: data.product_count || 0,
            status:        data.status || 'ok'
        });
    }

    if (data.stop) {
        showReview(genResults);
        return;
    }

    showSpinner('mbgp-gen-log');
    new Ajax.Request(data.url, {
        method: 'get',
        onSuccess: function (t) {
            if (t.responseText.isJSON()) {
                runGenerate(t.responseText.evalJSON());
            } else {
                clearWait('mbgp-gen-log');
                if (_ft) { clearInterval(_ft); _ft = null; }
                addEntry('mbgp-gen-log', '<?php echo $this->__('Unexpected server response — check PHP error log.') ?>', 'err');
            }
        },
        onFailure: function () {
            clearWait('mbgp-gen-log');
            if (_ft) { clearInterval(_ft); _ft = null; }
            addEntry('mbgp-gen-log', '<?php echo $this->__('Network error. Check server logs.') ?>', 'err');
        }
    });
}

/* ── Phase 2: review panel ── */
function showReview(results) {
    var totalNew      = 0, totalExisting = 0, totalProds = 0, changedTemplates = 0;
    var applyList     = []; /* only those with changes */

    results.forEach(function (r) {
        totalNew      += r.added    || 0;
        totalExisting += r.existing || 0;
        if (r.changed > 0) {
            totalProds += r.product_count;
            changedTemplates++;
            applyList.push(r);
        }
    });

    /* summary stats */
    var stats = document.getElementById('mbgp-review-stats');
    if (stats) {
        stats.innerHTML =
            mbgpStat(totalNew,                              '<?php echo $this->__('New dates') ?>') +
            mbgpStat(totalExisting,                         '<?php echo $this->__('Existing dates') ?>') +
            mbgpStat(changedTemplates,                      '<?php echo $this->__('Templates changed') ?>') +
            mbgpStat(results.length - changedTemplates,     '<?php echo $this->__('No changes') ?>');
    }

    /* table rows */
    var tbody = document.getElementById('mbgp-review-body');
    if (tbody) {
        tbody.innerHTML = '';
        results.forEach(function (r) {
            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td>' + escH(r.title) + '</td>' +
                '<td class="mbgp-col-num">' + badge(r.added,            'new')  + '</td>' +
                '<td class="mbgp-col-num">' + badge(r.existing || 0,    'skip') + '</td>' +
                '<td class="mbgp-col-num">' + (r.changed > 0 ? r.product_count : '<span class="mbgp-badge-skip">—</span>') + '</td>';
            tbody.appendChild(tr);
        });
    }

    /* apply button */
    var btn = document.getElementById('mbgp-apply-btn');
    if (btn) {
        if (applyList.length > 0) {
            btn.textContent = '<?php echo $this->__('Apply to Products') ?> (' + totalProds + ' product(s) across ' + applyList.length + ' template(s))';
            btn.onclick = function () { startApply(applyList); return false; };
        } else {
            btn.style.display = 'none';
            var link = document.getElementById('mbgp-skip-link');
            if (link) link.textContent = '<?php echo $this->__('No changes to apply — return to list') ?>';
        }
    }

    document.getElementById('mbgp-review').style.display = 'block';
    window.scrollTo(0, 0);
}

function mbgpStat(val, lbl) {
    return '<div class="mbgp-stat"><span class="mbgp-stat-val">' + val + '</span><span class="mbgp-stat-lbl">' + lbl + '</span></div>';
}
function badge(n, type) {
    if (n === 0) return '<span class="mbgp-badge-skip">—</span>';
    return '<span class="mbgp-badge-' + type + '">' + n + '</span>';
}
function escH(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ── Phase 3: apply ── */
var _applyBaseUrl = '<?php echo $applyBaseUrl ?>';
var _returnUrl    = '<?php echo $returnUrl ?>';

function startApply(applyList) {
    document.getElementById('mbgp-review').style.display = 'none';
    document.getElementById('mbgp-apply-phase').style.display = 'block';
    window.scrollTo(0, 0);
    runApply(applyList, 0);
}

function runApply(applyList, idx) {
    if (idx >= applyList.length) {
        clearWait('mbgp-apply-log');
        if (_ft) { clearInterval(_ft); _ft = null; }
        addEntry('mbgp-apply-log', '<?php echo $this->__('All done — redirecting…') ?>', 'done');
        setTimeout(function () { window.location = _returnUrl; }, 1500);
        return;
    }

    clearWait('mbgp-apply-log');
    if (_ft) { clearInterval(_ft); _ft = null; }

    var item = applyList[idx];
    var url  = _applyBaseUrl +
               '?group_id=' + encodeURIComponent(item.group_id) +
               '&idx='      + idx +
               '&total='    + applyList.length;

    showSpinner('mbgp-apply-log');

    new Ajax.Request(url, {
        method: 'get',
        onSuccess: function (t) {
            clearWait('mbgp-apply-log');
            if (_ft) { clearInterval(_ft); _ft = null; }
            if (t.responseText.isJSON()) {
                var d = t.responseText.evalJSON();
                addEntry('mbgp-apply-log', d.text || '', d.status || 'ok');
                runApply(applyList, idx + 1);
            } else {
                addEntry('mbgp-apply-log', '<?php echo $this->__('Unexpected response — check PHP error log.') ?>', 'err');
            }
        },
        onFailure: function () {
            clearWait('mbgp-apply-log');
            if (_ft) { clearInterval(_ft); _ft = null; }
            addEntry('mbgp-apply-log', '<?php echo $this->__('Network error on apply — check server logs.') ?>', 'err');
        }
    });
}

/* ── kick off ── */
runGenerate({
    text:   '<?php echo $this->__('Starting generation…') ?>',
    status: 'skip',
    url:    '<?php echo $startGenerateUrl ?>'
});

})();
//]]>
</script>
