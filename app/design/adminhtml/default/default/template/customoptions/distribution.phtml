/**
 * Manage Class Schedule → Schedule Distribution
 * @var MMD_Adminhtml_Block_Customoptions_Distribution $this
 */
$report  = $this->getReport();
$series  = $report['series'];
$type    = $this->getTypeFilter();
$listUrl = $this->getUrl('*/customoptions_options/index');

$sum = function ($key) use ($series) { return array_sum(array_column($series, $key)); };
$totCourses   = $sum('courses');
$totSchedules = $sum('schedules');

/**
 * One single-series vertical bar chart. $bars = [[label, value, tooltip], …].
 * $avg draws a dashed reference line (null = none).
 */
$barChart = function (array $bars, $avg = null, $fmt = '%d') {
    $max = max(1, $avg ?: 0, max(array_merge(array(0), array_column($bars, 1))));
    $h = '<div class="sd-chart" role="img">';
    if ($avg !== null) {
        $h .= '<div class="sd-avg" style="bottom:' . round($avg / $max * 100, 2) . '%"></div>';
    }
    foreach ($bars as $b) {
        $pct = round($b[1] / $max * 100, 2);
        $h .= '<div class="sd-col mmd-tip" data-tip="' . htmlspecialchars($b[2]) . '" aria-label="' . htmlspecialchars($b[2]) . '">'
            . '<span class="sd-val">' . sprintf($fmt, $b[1]) . '</span>'
            . '<span class="sd-bar" style="height:' . $pct . '%"></span>'
            . '<span class="sd-lbl">' . htmlspecialchars($b[0]) . '</span></div>';
    }
    return $h . '</div>';
};

$seriesBars = function ($key, $noun, $fmt = '%d') use ($series) {
    $bars = array();
    foreach ($series as $s) {
        $bars[] = array($s['letter'], $s[$key], $s['label'] . ': ' . sprintf($fmt, $s[$key]) . ' ' . $noun);
    }
    return $bars;
};
