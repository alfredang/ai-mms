            <form method="post" action="<?php echo $this->escapeHtml($this->getReplyPostUrl()) ?>">
                <input type="hidden" name="form_key" value="<?php echo $this->getFormKey() ?>"/>

                <?php
                // Password-manager defence in depth: readonly-until-focus +
                // 1Password/LastPass opt-outs + field names that contain no
                // "email"/"user" trigger words (extensions heuristically match
                // on name/id and ignore autocomplete="off" — "interns" from a
                // saved login clobbered the prefilled lead email in prod; see
                // memory feedback_chrome_autofill_admin_search_inputs). A JS
                // watchdog below restores the prefill if anything other than
                // real typing changes the field.
                $af = 'autocomplete="off" data-1p-ignore data-lpignore="true" data-form-type="other" readonly onfocus="this.removeAttribute(\'readonly\')"';
                ?>
