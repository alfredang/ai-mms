                <?php
                // Single-line TEXTAREA on purpose: password managers autofill
                // saved usernames into the first text <input> of a form no
                // matter what attributes it carries ("interns" kept clobbering
                // the lead email on prod) — but they never touch textareas.
                ?>
                <textarea name="rcpt_addr" id="rcpt_addr" rows="1" wrap="off" <?php echo $af ?> style="margin-bottom:14px;min-height:0;height:42px;resize:none;overflow:hidden;white-space:nowrap;"><?php echo $this->escapeHtml($this->getInitialTo()) ?></textarea>

