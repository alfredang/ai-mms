                    <button type="submit" class="mmd-primary"><?php echo $this->__('Send Reply') ?></button>
                    <button type="button" class="mmd-secondary" id="mmd_ai_regen"><?php echo $this->__('Regenerate AI Draft') ?></button>
                    <a href="<?php echo $this->escapeHtml($this->getBackUrl()) ?>"><button type="button" class="mmd-secondary"><?php echo $this->__('Back') ?></button></a>
                    <a href="<?php echo $this->escapeHtml($this->getDeleteUrl()) ?>" onclick="return confirm('<?php echo $this->__('Delete this lead permanently?') ?>');"><button type="button" class="mmd-danger"><?php echo $this->__('Delete') ?></button></a>
                </div>
