                // Same single-line TEXTAREA trick as To: once To stopped being
                // an <input>, CC became the form's FIRST text input and the
                // password managers moved their autofill ("interns") here.
                ?>
                <textarea name="rcpt_cc" id="rcpt_cc" rows="1" wrap="off" <?php echo $af ?> style="margin-bottom:14px;min-height:0;height:42px;resize:none;overflow:hidden;white-space:nowrap;"><?php echo $this->escapeHtml($this->getInitialCc()) ?></textarea>

