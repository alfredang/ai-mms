            <script>
            (function () {
                var draftUrl  = '<?php echo $this->escapeUrl($this->getAiDraftUrl()) ?>';
                var statusBox = document.getElementById('mmd_ai_status');
                var statusTxt = document.getElementById('mmd_ai_status_text');
                var subjectEl = document.getElementById('subject_course');
                var bodyEl    = document.getElementById('reply_body_html');
                var regenBtn  = document.getElementById('mmd_ai_regen');
                var seeded    = { subject: subjectEl.value, body: bodyEl.value };
                var busy      = false;

                function setStatus(state, msg) {
                    statusBox.className = 'mmd-ai-status' + (state ? ' is-' + state : '');
                    statusBox.querySelector('.mmd-ai-spinner').style.display = state ? 'none' : '';
                    statusTxt.textContent = msg;
                }

                function applyDraft(d, force) {
                    // Never clobber operator edits: only overwrite a field the
                    // operator hasn't touched since page load (unless forced
                    // via the Regenerate button).
                    if (force || subjectEl.value === seeded.subject) { subjectEl.value = d.subject_course; }
                    if (force || bodyEl.value === seeded.body)       { bodyEl.value    = d.body_html; }
                    seeded = { subject: subjectEl.value, body: bodyEl.value };
                }

                function fetchDraft(force) {
                    if (busy) { return; }
                    busy = true;
                    regenBtn.disabled = true;
                    setStatus(null, '<?php echo $this->jsQuoteEscape($this->__('Drafting reply with AI from the lead message + live course data…')) ?>');
                    fetch(draftUrl, { credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (d && d.ok) {
                                applyDraft(d, force);
                                setStatus('done', '<?php echo $this->jsQuoteEscape($this->__('AI draft ready — review and edit before sending.')) ?>');
                            } else {
                                setStatus('error', (d && d.error) || '<?php echo $this->jsQuoteEscape($this->__('AI draft failed — the catalog-matched prefill below is still usable.')) ?>');
                            }
                        })
                        .catch(function () {
                            setStatus('error', '<?php echo $this->jsQuoteEscape($this->__('AI draft failed — the catalog-matched prefill below is still usable.')) ?>');
                        })
                        .then(function () { busy = false; regenBtn.disabled = false; });
                }

                regenBtn.addEventListener('click', function () { fetchDraft(true); });
                fetchDraft(false);

                // Timeline refresh — reload the page to re-read pipeline state.
                var refreshBtn = document.getElementById('lv_refresh');
                if (refreshBtn) {
                    refreshBtn.addEventListener('click', function () {
                        refreshBtn.classList.add('is-busy');
                        window.location.reload();
                    });
                }

                // Keep the single-line To/CC textareas single-line.
                ['rcpt_addr', 'rcpt_cc'].forEach(function (fid) {
                    var el = document.getElementById(fid);
                    if (!el) { return; }
                    el.addEventListener('keydown', function (e) {
                        if (e.key === 'Enter') { e.preventDefault(); }
                    });
                    el.form && el.form.addEventListener('submit', function () {
                        el.value = el.value.replace(/\s+/g, '');
                    });
                });

                // Autofill watchdog: password managers inject values without
                // any keystroke. Restore the server prefill on To/CC unless
                // the change came from the operator actually typing/pasting
                // in the field.
                ['rcpt_addr', 'rcpt_cc'].forEach(function (fid) {
                    var el = document.getElementById(fid);
                    if (!el) { return; }
                    var expected = el.value;
                    var userTouched = false;
                    ['keydown', 'paste', 'cut', 'drop'].forEach(function (ev) {
                        el.addEventListener(ev, function () { userTouched = true; });
                    });
                    el.addEventListener('input', function () {
                        if (userTouched) { expected = el.value; }
                    });
                    var guard = setInterval(function () {
                        if (!userTouched && el.value !== expected && document.activeElement !== el) {
                            el.value = expected;
                        }
                    }, 400);
                    setTimeout(function () { clearInterval(guard); }, 15000);
                    el.form && el.form.addEventListener('submit', function () {
                        if (!userTouched && el.value !== expected) { el.value = expected; }
                    });
                });
            })();
            </script>
        </div>
    </div>

</div>
