            <div class="login-footer">
                <a href="#" onclick="event.preventDefault();lpOpenModal('privacy');">Privacy Policy</a>
                <a href="#" onclick="event.preventDefault();lpOpenModal('aup');">Acceptable Use Policy</a>
                <a href="#" onclick="event.preventDefault();lpOpenModal('feedback');">Feedback</a>
                <div style="margin-top:10px;">
                    Browse our WSQ courses at<br/>
                    <a href="https://www.tertiarycourses.com.sg/" class="site-link">https://www.tertiarycourses.com.sg/</a>
                </div>
            </div>
        </div>
        </section>
    </div>

    <script type="text/javascript">
    //<![CDATA[
    var loginForm = new varienForm('loginForm');

    // Anti-autofill plumbing for the single-line email textareas:
    // block/repurpose Enter, strip pasted newlines, and clear anything a
    // password manager injects at page load ("interns" incident — fills
    // happen at load; a manual fill from the extension comes later and
    // is untouched).
    (function () {
        function singleLine(el, onEnter) {
            if (!el) return;
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.keyCode === 13) { e.preventDefault(); onEnter(); }
            });
            el.addEventListener('input', function () {
                if (/[\r\n]/.test(el.value)) el.value = el.value.replace(/[\r\n]+/g, '');
            });
        }
        singleLine(document.getElementById('otp-email'), sendOtp);
        singleLine(document.getElementById('username'), function () {
            var pwd = document.getElementById('login');
            if (pwd && !pwd.value) { pwd.focus(); } else { loginForm.submit(); }
        });
        var lf = document.getElementById('loginForm');
        if (lf) lf.addEventListener('submit', function () {
            var u = document.getElementById('username');
            if (u) u.value = u.value.replace(/\s+/g, '');
        });
        function clearAutofill() {
            ['username', 'otp-email', 'login'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el && el.value && document.activeElement !== el) el.value = '';
            });
        }
        document.addEventListener('DOMContentLoaded', function () {
            clearAutofill();
            setTimeout(clearAutofill, 250);
            setTimeout(clearAutofill, 800);
        });
        // Autofill fires an `input` event on the field WITHOUT focusing it
        // (user typing always has focus) — catch late fills the load-time
        // sweep above misses. Manual extension fills on a focused field pass.
        ['username', 'otp-email', 'login'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.addEventListener('input', function () {
                if (document.activeElement !== el) el.value = '';
            });
        });
    })();

    function togglePw() {
        var inp = document.getElementById('login');
        var open = document.getElementById('pw-eye-open');
        var closed = document.getElementById('pw-eye-closed');
        if (inp.type === 'password') {
            inp.type = 'text';
            open.style.display = 'none';
            closed.style.display = 'block';
        } else {
            inp.type = 'password';
            open.style.display = 'block';
            closed.style.display = 'none';
        }
    }

    function switchTab(tab) {
        var passwordForm = $('loginForm');
        var otpForm = $('otpForm');
        var otpEmail  = $('otp-email');
        var pwdEmail  = $('username');
        if (tab === 'otp') {
            if (pwdEmail && pwdEmail.value && otpEmail && !otpEmail.value) otpEmail.value = pwdEmail.value;
            passwordForm.addClassName('hidden');
            otpForm.removeClassName('hidden');
        } else {
            if (otpEmail && otpEmail.value && pwdEmail) pwdEmail.value = otpEmail.value;
            passwordForm.removeClassName('hidden');
            otpForm.addClassName('hidden');
            if (pwdEmail && pwdEmail.value) {
                var pwd = $('login');
                if (pwd) pwd.focus();
            }
        }
    }

    function sendOtp() {
        var email = $('otp-email').value.replace(/\s+/g, '');
        if (!email) { alert('Please enter your email address'); return; }

        var btn = $('btn-send-otp');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $otpSendUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            btn.disabled = false;
            btn.innerHTML = 'Send OTP';
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success) {
                    $('otp-step-email').addClassName('hidden');
                    $('otp-step-verify').removeClassName('hidden');
                    $('otp-sent-email').innerHTML = email.escapeHTML ? email.escapeHTML() : email;
                    var input = $('otp-code');
                    if (input) { input.value = ''; input.focus(); }
                } else {
                    alert(resp.message || 'Failed to send OTP');
                }
            } catch(e) { alert('Error sending OTP. Please try again.'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Send OTP'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&form_key=<?php echo $formKey ?>');
    }

    function otpInput(el) {
        el.value = el.value.replace(/[^0-9]/g, '').slice(0, 6);
        if (el.value.length === 6) { verifyOtp(); }
    }

    // Paste handler: pull the OTP out of whatever was copied — a bare code,
    // "Your OTP is 123 456", a code with dashes/spaces, etc. Prefer the first
    // run of exactly 6 consecutive digits (the code as it appears in the
    // email); fall back to the first 6 digits found. Auto-submits when full.
    function otpPaste(e) {
        var cd = e.clipboardData || window.clipboardData;
        if (!cd) { return; } // let the default paste + oninput handle it
        var text = cd.getData('text') || '';
        var m = text.match(/\b(\d{6})\b/);
        var code = m ? m[1] : (text.replace(/[^0-9]/g, '').slice(0, 6));
        if (!code) { return; }
        e.preventDefault();
        var el = $('otp-code');
        el.value = code;
        if (code.length === 6) { verifyOtp(); }
    }

    function verifyOtp() {
        var otp = ($('otp-code').value || '').replace(/[^0-9]/g, '');
        if (otp.length < 6) { alert('Please enter the complete 6-digit OTP'); return; }

        var email = $('otp-email').value.replace(/\s+/g, '');
        var btn = $('btn-verify-otp');
        btn.disabled = true;
        btn.innerHTML = 'Verifying...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $otpVerifyUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success && resp.redirect) {
                    window.location.href = resp.redirect;
                } else {
                    btn.disabled = false;
                    btn.innerHTML = 'Verify &amp; Login';
                    alert(resp.message || 'Verification failed');
                }
            } catch(e) { btn.disabled = false; btn.innerHTML = 'Verify &amp; Login'; alert('Error verifying OTP'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Verify &amp; Login'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp) + '&form_key=<?php echo $formKey ?>');
    }
    //]]>
    </script>

