                            <svg id="pw-eye-closed" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>
                </div>
                <?php echo $this->getChildHtml('form.additional.info'); ?>
                <button type="submit" class="btn-primary">Sign In</button>
                <div class="login-links">
                    <a href="<?php echo $forgotUrl ?>">Forgot Password?</a>
                </div>
                <div class="login-switch">
                    <a onclick="switchTab('otp')">Login with OTP instead</a>
                </div>
            </form>

            <!-- OTP Login Form -->
            <div id="otpForm">
                <div id="otp-step-email">
                    <div class="field-group">
                        <label class="field-label" for="otp-email">Email</label>
                        <!-- Single-line textarea for the same anti-autofill reason
                             as #username above. Enter sends the OTP (JS below). -->
                        <textarea id="otp-email" rows="1" wrap="off" class="field-input" placeholder="Enter your email address" autocomplete="off" autocapitalize="off" spellcheck="false" inputmode="email"></textarea>
                    </div>
                    <button type="button" class="btn-otp" id="btn-send-otp" onclick="sendOtp()">Send OTP</button>
                    <div class="login-switch">
                        <a onclick="switchTab('password')">Login with password instead</a>
                    </div>
                </div>
                <div id="otp-step-verify" class="hidden">
                    <h2 class="otp-verify-title">Verify your identity</h2>
                    <p class="otp-verify-sub">An OTP has been sent to<br/><strong id="otp-sent-email">your email</strong>.</p>
                    <div class="otp-row">
                        <input type="text" id="otp-code" class="otp-digit" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="______" oninput="otpInput(this)" onpaste="otpPaste(event)" onfocus="this.select()" aria-label="6-digit OTP code" />
                    </div>
                    <p class="otp-sent-msg" id="otp-sent-text">OTP has been sent to your email address</p>
                    <p class="otp-spam-hint">If you don&rsquo;t see the OTP email in your inbox, please check the spam/all emails.</p>
                    <button type="button" class="btn-otp" id="btn-verify-otp" onclick="verifyOtp()">Verify &amp; Log In</button>
                    <div class="otp-resend">
                        <a onclick="sendOtp()">Resend OTP</a>
                        <span class="otp-resend-sep">|</span>
                        <a onclick="switchTab('password')">Use Password</a>
