                        <?php if ($_rowPending && $_review): ?>
                        <button type="button" class="mmd-grid-action mmd-grid-action--check" title="Approve" onclick="bpReview(<?php echo (int) $_r['post_id'] ?>,'approve')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></button>
                        <button type="button" class="mmd-grid-action mmd-grid-action--edit" title="Request changes" onclick="bpReview(<?php echo (int) $_r['post_id'] ?>,'changes')"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></button>
