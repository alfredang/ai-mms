                        echo 'Published ', date('D j M', strtotime($_r['published_at']));
                    } else {
                        echo $_r['scheduled_publish_at'] ? date('D j M · g:ia', strtotime($_r['scheduled_publish_at'])) : '—';
                    } ?></td>
                <td class="tnum"><?php echo (int) $_r['likes'] ?></td>
                <td class="muted"><?php echo $_r['source_sku'] ? 'Auto' : 'Manual' ?></td>
                <td class="ta-r">
                    <div class="mmd-grid-actions" style="justify-content:flex-end;">
