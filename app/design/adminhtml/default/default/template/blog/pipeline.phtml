<script type="text/javascript">
var bpUrls = {
    decide:  <?php echo json_encode($_urlDecide) ?>,
    search:  <?php echo json_encode($_urlSearch) ?>,
    qlist:   <?php echo json_encode($_urlQList) ?>,
    qadd:    <?php echo json_encode($_urlQAdd) ?>,
    qremove: <?php echo json_encode($_urlQRemove) ?>,
    qorder:  <?php echo json_encode($_urlQOrder) ?>,
    qbrief:  <?php echo json_encode($_urlQBrief) ?>,
    run:     <?php echo json_encode($_urlRun) ?>,
    preview: <?php echo json_encode(Mage::helper('adminhtml')->getUrl('adminhtml/blog/preview')) ?>,
    edit:    <?php echo json_encode($_urlEdit) ?>
};
var bpQueueData = [];
// post_id -> is this post awaiting a decision? Drives the modal's Approve button.
var bpPending = <?php
    $_pendMap = array();
    foreach ($_rows as $_r) {
        $_pendMap[(int) $_r['post_id']] = ($_review && in_array((int) $_r['status'], array(
            MMD_Blog_Model_Post::STATUS_PENDING_REVIEW,
            MMD_Blog_Model_Post::STATUS_CHANGES_REQUESTED), true)) ? 1 : 0;
    }
    echo json_encode((object) $_pendMap);
?>;

/**
 * Rich article preview — POSTs to adminhtml/blog/preview and drops the returned
 * self-contained document into the iframe. Same contract as the newsletter
 * panel's mnLoadDraft (dashboard/index.phtml).
 */
function bpPreview(id) {
    var modal = document.getElementById('bp-preview-modal');
    var ifr   = document.getElementById('bp-preview-iframe');
    var load  = document.getElementById('bp-preview-loading');
    if (!modal || !ifr) return;
    // Lift out of the panel so position:fixed measures against the viewport,
    // not a transformed ancestor.
    if (modal.parentNode !== document.body) document.body.appendChild(modal);

    document.getElementById('bp-preview-title').textContent = 'Loading…';
    document.getElementById('bp-preview-meta').textContent  = '';
    document.getElementById('bp-preview-edit').href = bpUrls.edit + 'id/' + id + '/';
    var approve = document.getElementById('bp-preview-approve');
    if (bpPending[id]) {
        approve.style.display = '';
        approve.onclick = function () { bpReview(id, 'approve'); };
    } else {
        approve.style.display = 'none';
    }

    ifr.style.display = 'none';
    ifr.srcdoc = '';
    load.style.display = '';
    load.textContent = 'Loading preview…';
    bpSetViewport('desktop');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('post_id', String(id));
    fetch(bpUrls.preview, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
            if (!j || !j.success) {
                load.textContent = 'Could not load preview' + (j && j.message ? ': ' + j.message : '.');
                return;
            }
            document.getElementById('bp-preview-title').textContent = j.title || 'Article preview';
            document.getElementById('bp-preview-meta').textContent  = j.meta || '';
            ifr.srcdoc = j.html;
            ifr.style.display = '';
            load.style.display = 'none';
        })
        .catch(function (e) { load.textContent = 'Network error — ' + e; });
}

function bpClosePreview(e) {
    if (e && e.target && e.target.id !== 'bp-preview-modal') return;
    var modal = document.getElementById('bp-preview-modal');
    if (!modal) return;
    modal.style.display = 'none';
    document.body.style.overflow = '';
    var ifr = document.getElementById('bp-preview-iframe');
    if (ifr) ifr.srcdoc = '';
}

function bpSetViewport(mode) {
    var stage = document.getElementById('bp-preview-stage');
    if (!stage) return;
    if (mode !== 'mobile') mode = 'desktop';
    stage.setAttribute('data-vp', mode);
    // Geometry also set inline: a stale browser-cached copy of the panel CSS
    // would otherwise leave the toggle visually dead (newsletter incident
    // 2026-07-16 — same fix as mnSetDraftViewport).
    var ifr = document.getElementById('bp-preview-iframe');
    if (ifr) {
        if (mode === 'mobile') {
            stage.style.padding = '18px';
            ifr.style.width = '390px'; ifr.style.maxWidth = '100%';
            ifr.style.height = '100%'; ifr.style.minHeight = '600px';
            ifr.style.borderRadius = '18px';
        } else {
            stage.style.padding = '0';
            ifr.style.width = '100%'; ifr.style.maxWidth = 'none';
            ifr.style.height = '100%'; ifr.style.minHeight = '520px';
            ifr.style.borderRadius = '0';
        }
    }
    var d = document.getElementById('bp-vp-desktop'), m = document.getElementById('bp-vp-mobile');
    if (d) d.className = 'bp-vp-btn' + (mode === 'desktop' ? ' active' : '');
    if (m) m.className = 'bp-vp-btn' + (mode === 'mobile'  ? ' active' : '');
}

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') bpClosePreview();
});

function bpReview(id, decision) {
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('post_id', String(id));
    fd.append('decision', decision);
    if (decision === 'changes') {
        var fb = prompt('What should be changed? (angle, wording, structure, funding emphasis, ...)\n\nThe article is regenerated with your feedback and re-sent for approval — this can take a couple of minutes.');
        if (fb === null) return;
        fd.append('feedback', fb);
    } else if (!confirm('Approve this post? It will be scheduled into the next free Tuesday/Friday 9:00am slot, then auto-shared to LinkedIn + Facebook after publishing.')) {
        return;
    }
    fetch(bpUrls.decide, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) { alert(j.message || (j.success ? 'Done.' : 'Failed.')); location.reload(); })
        .catch(function () { alert('Request failed.'); });
}

var bpSearchTimer = null;
function bpSearchCourses(input) {
    clearTimeout(bpSearchTimer);
    var q = input.value.trim();
    var box = document.getElementById('bp-search-results');
    if (q.length < 2) { box.innerHTML = ''; return; }
    bpSearchTimer = setTimeout(function () {
        fetch(bpUrls.search + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                if (!j.success || !j.courses.length) { box.innerHTML = ''; return; }
                var html = '<div class="bp-sr">';
                j.courses.forEach(function (c) {
                    html += '<div class="bp-sr-item" onclick="bpQueueAdd(' + c.id + ')"><b>'
                        + bpEsc(c.name) + '</b><span class="sku">' + bpEsc(c.sku) + '</span></div>';
                });
                box.innerHTML = html + '</div>';
            });
    }, 250);
}
// Enter in the search box adds the top match — without this the only way to
// queue a course was clicking a dropdown suggestion, and Enter silently did nothing.
function bpSearchEnter(ev, input) {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    var first = document.querySelector('#bp-search-results .bp-sr-item');
    if (first) { first.click(); return; }
    var q = input.value.trim();
    if (q.length < 2) return;
    clearTimeout(bpSearchTimer);
    fetch(bpUrls.search + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
            if (j.success && j.courses.length) { bpQueueAdd(j.courses[0].id); }
            else { alert('No course matches "' + q + '".'); }
        });
}
function bpEsc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

function bpQueueAdd(pid) {
    document.getElementById('bp-search-results').innerHTML = '';
    document.getElementById('bp-course-search').value = '';
    var topicsEl = document.getElementById('bp-add-topics');
    var linksEl  = document.getElementById('bp-add-links');
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('course_id', String(pid));
    if (topicsEl && topicsEl.value.trim()) fd.append('topics', topicsEl.value.trim());
    if (linksEl && linksEl.value.trim())   fd.append('links', linksEl.value.trim());
    if (topicsEl) topicsEl.value = '';
    if (linksEl)  linksEl.value = '';
    fetch(bpUrls.qadd, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
            if (!j.success) alert(j.message || 'Could not add the course to the queue.');
            bpQueueLoad();
        })
        .catch(function () { bpQueueLoad(); });
}

// "Save brief" under the top add-course fields — attaches the typed topics/links
// to the #1 queued course (the one the pipeline writes about next). Without this,
// the top fields only reach a course when it is (re-)added via the search box.
function bpBriefAttachTop() {
    if (!bpQueueData.length) return;
    var topicsEl = document.getElementById('bp-add-topics');
    var linksEl  = document.getElementById('bp-add-links');
    var topics = topicsEl ? topicsEl.value.trim() : '';
    var links  = linksEl ? linksEl.value.trim() : '';
    if (!topics && !links) { alert('Type the topics / reference links first.'); return; }
    var top = bpQueueData[0];
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('queue_id', String(top.queue_id));
    // queueBriefAction replaces both columns — keep the row's existing value
    // for whichever field was left empty here.
    fd.append('topics', topics || (top.topics || ''));
    fd.append('links',  links  || (top.links  || ''));
    fetch(bpUrls.qbrief, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function () {
            if (topicsEl) topicsEl.value = '';
            if (linksEl)  linksEl.value = '';
            bpQueueLoad();
        });
}

function bpBriefToggle(qid) {
    var row = document.querySelector('.bp-q-brief-row[data-bqid="' + qid + '"]');
    if (row) row.style.display = (row.style.display === 'none' ? '' : 'none');
}

function bpBriefSave(qid) {
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('queue_id', String(qid));
    fd.append('topics', (document.getElementById('bp-brief-topics-' + qid) || {}).value || '');
    fd.append('links',  (document.getElementById('bp-brief-links-' + qid)  || {}).value || '');
    fetch(bpUrls.qbrief, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function () { bpQueueLoad(); });
}

function bpQueueRemove(qid) {
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('queue_id', String(qid));
    fetch(bpUrls.qremove, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function () { bpQueueLoad(); });
}

function bpRunNow(qid, pid, name) {
    if (!confirm('Run the blog agent team for "' + name + '" now?\n\nResearch (web search) + writing takes a few minutes; the page will load when the draft has been emailed for approval.')) return;
    // generateAction consumes the queue row server-side (reads the admin
    // topics/links brief BEFORE deleting it) so the direction reaches the agents.
    window.location = bpUrls.run + 'queue_id/' + qid + '/course_id/' + pid + '/';
}

function bpQueueLoad() {
    fetch(bpUrls.qlist, { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (j) {
            var tbody = document.getElementById('bp-queue-list');
            var count = document.getElementById('bp-queue-count');
            var attach = document.getElementById('bp-brief-attach');
            var hint   = document.getElementById('bp-brief-attach-hint');
            if (attach) attach.style.display = (j.success && j.queue.length) ? '' : 'none';
            if (hint && j.success && j.queue.length) {
                hint.innerHTML = '&rarr; attaches to <b>#1 ' + bpEsc(j.queue[0].name) + '</b> (' + bpEsc(j.queue[0].sku) + ')';
            }
            if (!j.success) {
                tbody.innerHTML = '<tr><td colspan="5" class="mm-table-empty">' + bpEsc(j.message || 'Queue unavailable') + '</td></tr>';
                if (count) count.textContent = '—';
                return;
            }
            if (count) count.textContent = String(j.queue.length);
            if (!j.queue.length) {
                tbody.innerHTML = '<tr><td colspan="5" class="mm-table-empty">Queue is empty — the pipeline falls back to the best-selling unblogged course.</td></tr>';
                return;
            }
            bpQueueData = j.queue;
            var html = '';
            j.queue.forEach(function (row, i) {
                var topics = (row.topics || '').trim();
                var links  = (row.links || '').trim();
                var nLinks = links ? links.split('\n').filter(function (l) { return l.trim(); }).length : 0;
                var brief  = '';
                if (topics || nLinks) {
                    brief = '<div class="bp-q-brief">'
                        + (topics ? '<span title="' + bpEsc(topics) + '">&#127919; ' + bpEsc(topics.length > 90 ? topics.slice(0, 87) + '…' : topics) + '</span>' : '')
                        + (nLinks ? '<span class="bp-q-brief-links">&#128279; ' + nLinks + ' link' + (nLinks > 1 ? 's' : '') + '</span>' : '')
                        + '</div>';
                }
                html += '<tr class="bp-q-row" draggable="true" data-qid="' + row.queue_id + '">'
                    + '<td class="center"><span class="bp-q-grip">&#8942;&#8942;</span></td>'
                    + '<td class="muted">' + (i + 1) + '</td>'
                    + '<td class="strong wrap">' + bpEsc(row.name) + brief + '</td>'
                    + '<td class="muted" style="font-family:ui-monospace,Menlo,monospace;">' + bpEsc(row.sku) + '</td>'
                    + '<td class="center"><div class="mmd-grid-actions" style="justify-content:center;">'
                    + '<button type="button" class="mmd-grid-action mmd-grid-action--check" title="Run Now" onclick="bpRunNow(' + row.queue_id + ',' + row.product_id + ',\'' + bpEsc(row.name).replace(/'/g, "\\'") + '\')">'
                    + '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg></button>'
                    + '<button type="button" class="mmd-grid-action mmd-grid-action--edit" title="Edit topics / reference links" onclick="bpBriefToggle(' + row.queue_id + ')">'
                    + '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>'
                    + '<button type="button" class="mmd-grid-action mmd-grid-action--delete" title="Remove from queue" onclick="bpQueueRemove(' + row.queue_id + ')">'
                    + '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>'
                    + '</div></td></tr>'
                    + '<tr class="bp-q-brief-row" data-bqid="' + row.queue_id + '" style="display:none;"><td></td><td></td><td colspan="3">'
                    + '<div class="bp-q-brief-form">'
                    + '<input type="text" id="bp-brief-topics-' + row.queue_id + '" class="bp-input" value="' + bpEsc(topics) + '" placeholder="Topics / angle to research and write about..." />'
                    + '<textarea id="bp-brief-links-' + row.queue_id + '" class="bp-input bp-links-input" rows="2" placeholder="Reference links, one per line...">' + bpEsc(links) + '</textarea>'
                    + '<div class="bp-q-brief-actions">'
                    + '<button type="button" class="mm-btn mm-btn-primary mm-btn-sm" onclick="bpBriefSave(' + row.queue_id + ')">Save brief</button>'
                    + '<button type="button" class="mm-btn mm-btn-ghost mm-btn-sm" onclick="bpBriefToggle(' + row.queue_id + ')">Cancel</button>'
                    + '</div></div></td></tr>';
            });
            tbody.innerHTML = html;
            bpWireDrag();
        });
}

function bpWireDrag() {
    var tbody = document.getElementById('bp-queue-list');
    var dragging = null;
    Array.prototype.forEach.call(tbody.querySelectorAll('.bp-q-row'), function (row) {
        row.addEventListener('dragstart', function () { dragging = row; row.classList.add('bp-q-dragging'); });
        row.addEventListener('dragend', function () {
            row.classList.remove('bp-q-dragging');
            dragging = null;
            var order = Array.prototype.map.call(tbody.querySelectorAll('.bp-q-row'), function (r) { return r.getAttribute('data-qid'); }).join(',');
            var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
            fd.append('order', order);
            fetch(bpUrls.qorder, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function () { bpQueueLoad(); });
        });
        row.addEventListener('dragover', function (e) {
            e.preventDefault();
            if (!dragging || dragging === row) return;
            var rect = row.getBoundingClientRect();
            var after = (e.clientY - rect.top) > rect.height / 2;
            row.parentNode.insertBefore(dragging, after ? row.nextSibling : row);
        });
    });
}

bpQueueLoad();
</script>
