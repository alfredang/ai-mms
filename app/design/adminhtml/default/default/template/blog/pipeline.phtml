<?php
/**
 * Agentic Blog Pipeline — same timeline design as the newsletter panel's
 * Agentic Flyer Pipeline (dashboard/index.phtml, .mn-* block), adapted to the
 * blog flow: Research & Write -> Approval sent -> Approved -> Scheduled ->
 * Published (then auto-shared to LinkedIn + Facebook). Class names carry a
 * bp- prefix so the copied styles can never collide with the dashboard panel.
 *
 * Stages come straight from mmd_blog_post.status (see MMD_Blog_Model_Post);
 * the "Next blog queue" card feeds mmd_blog_queue (migration 822) which the
 * daily proposer consumes head-first before its best-seller auto-pick.
 */
$_helper  = Mage::helper('mmd_blog');
$_cron    = Mage::getModel('mmd_blog/cron_autoblog');
$_read    = Mage::getSingleton('core/resource')->getConnection('core_read');
$_table   = Mage::getSingleton('core/resource')->getTableName('mmd_blog/post');
$_enabled = Mage::getStoreConfigFlag('mmd_blog/autoblog/enabled');
$_review  = !Mage::getStoreConfigFlag('mmd_blog/autoblog/auto_publish');

$_rows = array();
$_slot = null;
try {
    $_rows = $_read->fetchAll(
        "SELECT post_id, title, status, source_sku, related_skus, scheduled_publish_at,
                published_at, review_decisions, linkedin_urn, facebook_post_id, likes, created_at
         FROM {$_table} ORDER BY post_id DESC LIMIT 30"
    );
    $_slot = $_cron->nextPublishSlot();
} catch (Exception $e) { /* panel must never take the grid down */ }

// Published-this-week count (SGT week, Mon-Sun) vs the 2/week pace.
$_tz        = new DateTimeZone('Asia/Singapore');
$_now       = new DateTime('now', $_tz);
$_weekStart = clone $_now;
$_weekStart->modify('monday this week')->setTime(0, 0, 0);
$_thisWeek  = 0;
foreach ($_rows as $_r) {
    if ((int) $_r['status'] === MMD_Blog_Model_Post::STATUS_PUBLISHED
        && $_r['source_sku'] && $_r['published_at']
        && $_r['published_at'] >= $_weekStart->format('Y-m-d')) {
        $_thisWeek++;
    }
}

/**
 * Map a post row to its pipeline stage: [index 0-4, label, css-key].
 * Research & Write -> Approval sent -> Approved -> Scheduled -> Published.
 */
$_bpStage = function ($row) {
    $st  = (int) $row['status'];
    $dec = json_decode((string) $row['review_decisions'], true);
    $sent = is_array($dec) && !empty($dec['_sent_at']);
    if ($st === MMD_Blog_Model_Post::STATUS_PUBLISHED) {
        return array(4, 'Published' . ($row['published_at'] ? ' &middot; ' . date('D j M', strtotime($row['published_at'])) : ''), 'done');
    }
    if ($st === MMD_Blog_Model_Post::STATUS_SCHEDULED) {
        return array(3, $row['scheduled_publish_at']
            ? 'Scheduled &middot; ' . date('D j M, g:ia', strtotime($row['scheduled_publish_at']))
            : 'Scheduled', 'sched');
    }
    if ($st === MMD_Blog_Model_Post::STATUS_CHANGES_REQUESTED) {
        return array(1, 'Changes requested', 'changes');
    }
    if ($st === MMD_Blog_Model_Post::STATUS_PENDING_REVIEW) {
        return array($sent ? 1 : 0, $sent ? 'Pending approval' : 'Awaiting review email', 'pending');
    }
    return array(0, 'Draft', 'muted');
};
$_bpStageNames = array('Research &amp; Write', 'Approval sent', 'Approved', 'Scheduled', 'Published');

// Active flows = pending / changes-requested / scheduled pipeline posts (auto or
// manual), most advanced first — the blog counterpart of the newsletter flows.
$_active = array();
foreach ($_rows as $_r) {
    if (in_array((int) $_r['status'], array(
        MMD_Blog_Model_Post::STATUS_PENDING_REVIEW,
        MMD_Blog_Model_Post::STATUS_CHANGES_REQUESTED,
        MMD_Blog_Model_Post::STATUS_SCHEDULED), true)) {
        $_active[] = $_r;
    }
}
usort($_active, function ($a, $b) use ($_bpStage) {
    list($sa) = $_bpStage($a);
    list($sb) = $_bpStage($b);
    if ($sa !== $sb) { return $sb - $sa; }
    return (int) $a['post_id'] - (int) $b['post_id'];
});
$_active = array_slice($_active, 0, 2);

$_urlDecide  = Mage::helper('adminhtml')->getUrl('adminhtml/blog/reviewDecision');
$_urlSearch  = Mage::helper('adminhtml')->getUrl('adminhtml/blog/searchCourses');
$_urlQList   = Mage::helper('adminhtml')->getUrl('adminhtml/blog/queueList');
$_urlQAdd    = Mage::helper('adminhtml')->getUrl('adminhtml/blog/queueAdd');
$_urlQRemove = Mage::helper('adminhtml')->getUrl('adminhtml/blog/queueRemove');
$_urlQOrder  = Mage::helper('adminhtml')->getUrl('adminhtml/blog/queueReorder');
$_urlQBrief  = Mage::helper('adminhtml')->getUrl('adminhtml/blog/queueBrief');
$_urlRun     = Mage::helper('adminhtml')->getUrl('adminhtml/blog/generate');
$_urlEdit    = Mage::helper('adminhtml')->getUrl('adminhtml/blog/edit');
?>
<div class="bp-pipe">
    <div class="bp-pipe-bar">
        <div class="bp-pipe-title">Agentic Blog Pipeline
            <span class="bp-pipe-flag <?php echo $_enabled ? 'on' : 'off' ?>"><?php echo $_enabled ? ($_review ? 'REVIEW FLOW · ENABLED' : 'AUTO-PUBLISH · ENABLED') : 'DISABLED' ?></span>
        </div>
        <div class="bp-pipe-caps">
            <span class="bp-cap" title="Published pipeline posts this week (max 2)"><em>Posts</em><b><?php echo (int) $_thisWeek ?>/2</b></span>
            <span class="bp-cap" title="Next free Tuesday/Friday 9:00am publish slot"><em>Next slot</em><b><?php echo $_slot ? htmlspecialchars($_slot->format('D, j M · g:ia')) : '—' ?></b></span>
            <span class="bp-cap"><em>Queue</em><b id="bp-queue-count">—</b></span>
        </div>
    </div>

    <?php if (!empty($_active)): ?>
        <?php foreach ($_active as $_ai => $_flow):
            list($_fi, $_flabel, $_fcss) = $_bpStage($_flow);
            $_pending = in_array((int) $_flow['status'], array(
                MMD_Blog_Model_Post::STATUS_PENDING_REVIEW,
                MMD_Blog_Model_Post::STATUS_CHANGES_REQUESTED), true); ?>
        <div class="bp-flow">
            <div class="bp-flow-head">
                <span class="bp-flow-tag <?php echo $_ai === 0 ? 'cur' : 'nxt' ?>">Flow <?php echo $_ai + 1 ?> · <?php echo $_ai === 0 ? 'current' : 'next' ?></span>
                <span class="bp-flow-name"><?php echo htmlspecialchars($_flow['title']) ?></span>
                <?php if ($_flow['source_sku']): ?><span class="bp-flow-sku"><?php echo htmlspecialchars($_flow['source_sku']) ?></span><?php endif; ?>
                <span class="bp-badge s-<?php echo $_fcss ?>"><?php echo $_flabel ?></span>
                <span style="margin-left:auto;display:inline-flex;gap:6px;align-items:center;">
                    <?php if ($_ai === 0): ?>
                    <button type="button" class="mmd-iconbtn mmd-tip" data-tip="Refresh timeline" aria-label="Refresh timeline" onclick="window.location.reload()">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    </button>
                    <?php endif; ?>
                    <?php if ($_pending && $_review): ?>
                    <button type="button" class="bp-abtn ok" onclick="bpReview(<?php echo (int) $_flow['post_id'] ?>,'approve')">&#10003; Approve</button>
                    <button type="button" class="bp-abtn ghost" onclick="bpReview(<?php echo (int) $_flow['post_id'] ?>,'changes')">&#9998; Request changes</button>
                    <?php endif; ?>
                </span>
            </div>
            <ol class="bp-steps">
                <?php foreach ($_bpStageNames as $_si => $_sname):
                    $_cls = $_si < $_fi ? 'done' : ($_si === $_fi ? 'current' : ''); ?>
                    <li class="bp-step <?php echo $_cls ?>">
                        <span class="bp-dot"><?php echo $_si < $_fi ? '&#10003;' : ($_si + 1) ?></span>
                        <span class="bp-slabel"><?php echo $_sname ?></span>
                    </li>
                <?php endforeach; ?>
            </ol>
        </div>
        <?php endforeach; ?>
        <?php if (count($_active) < 2): ?>
        <div class="bp-flow bp-flow-ghost">
            <div class="bp-flow-head">
                <span class="bp-flow-tag nxt">Flow <?php echo count($_active) + 1 ?> · next (auto)</span>
                <span class="bp-flow-name" style="color:#64748b;">The daily cron researches + writes the next queue course automatically (2 posts/week, published Tue &amp; Fri 9:00am)</span>
            </div>
        </div>
        <?php endif; ?>
    <?php else: ?>
    <div class="bp-flow bp-flow-ghost">
        <div class="bp-flow-head">
            <span class="bp-flow-tag nxt">Flow 1 · next (auto)</span>
            <span class="bp-flow-name" style="color:#64748b;">No post in flight — add courses to the queue below and click <b>&#9654; Run Now</b>, or the daily cron researches + writes the next one automatically</span>
            <span style="margin-left:auto;display:inline-flex;">
                <button type="button" class="mmd-iconbtn mmd-tip" data-tip="Refresh timeline" aria-label="Refresh timeline" onclick="window.location.reload()">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                </button>
            </span>
        </div>
        <ol class="bp-steps">
            <?php foreach ($_bpStageNames as $_si => $_sname): ?>
                <li class="bp-step"><span class="bp-dot"><?php echo $_si + 1 ?></span><span class="bp-slabel"><?php echo $_sname ?></span></li>
            <?php endforeach; ?>
        </ol>
    </div>
    <?php endif; ?>

    <?php /* Newsletter-parity data table — one row per pipeline post with stage
             badge, approval-sent date, schedule, source and icon actions (the
             blog counterpart of the newsletter's .mn-ptable). */ ?>
    <?php if (!empty($_rows)): $_ptRows = array_slice($_rows, 0, 12); ?>
    <table class="bp-ptable">
        <thead><tr><th>Post title</th><th>Course</th><th>Stage</th><th>Approval sent</th><th>Scheduled / Published</th><th>Likes</th><th>Source</th><th class="ta-r">Actions</th></tr></thead>
        <tbody>
        <?php foreach ($_ptRows as $_r):
            list($_ri, $_rlabel, $_rcss) = $_bpStage($_r);
            $_dec    = json_decode((string) $_r['review_decisions'], true);
            $_sentAt = (is_array($_dec) && !empty($_dec['_sent_at'])) ? date('j M · g:ia', strtotime($_dec['_sent_at'])) : '—';
            $_rowPending = in_array((int) $_r['status'], array(
                MMD_Blog_Model_Post::STATUS_PENDING_REVIEW,
                MMD_Blog_Model_Post::STATUS_CHANGES_REQUESTED), true); ?>
            <tr>
                <td class="strong"><?php echo htmlspecialchars($_r['title']) ?></td>
                <td class="muted" style="font-family:ui-monospace,Menlo,monospace;font-size:12px;white-space:nowrap;"><?php echo htmlspecialchars($_r['related_skus'] ?: '—') ?></td>
