// E-Attendance entry for the Course Menu (View Course). Built once and echoed
// at the top of BOTH nav blocks (mobile drawer + wide sidebar); self-gates so
// only a trainer or learner with a real run gets a link, every other role
// renders ''. Both reach it via their dashboard (admin) session:
//   trainer -> admin E-Attendance page (roster + QR)
//   learner -> login-based self-mark confirmation (no QR; their session is the
//              identity). Works because storefront accounts are now unified with
//              dashboard accounts (MMD_AccountSync: learner role + synced password).
$_lcdRunId = (int) (Mage::app()->getRequest()->getParam('run')
    ?: (isset($_selectedCourse['cr_run_id']) ? $_selectedCourse['cr_run_id'] : 0));
$_eAttendanceNavHtml = '';
$_eaCardHref = ''; // destination of the E-Attendance content card (set per role below)
if ($_lcdRunId > 0 && in_array($activeRole, array('trainer', 'learner'), true)) {
    $_eaIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>';
    if ($activeRole === 'trainer') {
        $_eaBucket   = (isset($_selectedCourse['time_status']) && $_selectedCourse['time_status'] === 'past') ? 'completed' : 'active';
        $_eaCardHref = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/index', array('run_id' => $_lcdRunId, 'bucket' => $_eaBucket));
    } else { // learner -> dashboard self-mark confirmation
        $_eaCardHref = Mage::helper('adminhtml')->getUrl('adminhtml/selfmark/index', array('run_id' => $_lcdRunId));
    }
    // The nav item SCROLLS to the in-page E-Attendance card (matches LMS); the
    // card itself carries the link to the attendance page / self-mark.
    $_eAttendanceNavHtml = '<a href="#eattendance" class="lcd-nav-item" onclick="return lcdNavTo(this,\'eattendance\')">'
        . $_eaIcon . '<span>E-Attendance</span></a>';
}
