<script type="text/javascript">
window.atmUpdateInviteBtn = function() {
    var sel = document.getElementById('atm-invite-sel');
    var lbl = document.getElementById('atm-invite-btn-label');
    if (!sel || !lbl) return;
    var firstName = sel.value ? sel.value.split(' ')[0] : '';
    lbl.textContent = firstName ? ('Invite: ' + firstName + '…') : 'Send Invitation';
};

window.atmSendInvitation = function() {
    var st = window._atmState;
    if (!st.runId) { alert('No class selected.'); return; }
    var btn      = document.getElementById('atm-invite-btn');
    var lbl      = document.getElementById('atm-invite-btn-label');
    var statusEl = document.getElementById('atm-invite-status');
    var sel      = document.getElementById('atm-invite-sel');
    var trainerName = sel ? sel.value : '';
    btn.disabled = true;
    if (lbl) lbl.textContent = 'Sending…';
    statusEl.textContent = '';
    var fd = new FormData();
    fd.append('run_id', st.runId);
    fd.append('trainer_name', trainerName);
    fd.append('form_key', window.FORM_KEY || '');
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/coursesave/sendTrainerInvitation') ?>', {
        method: 'POST',
        body: fd,
        credentials: 'same-origin'
    })
    .then(function(r){ return r.json(); })
    .then(function(d) {
        btn.disabled = false;
        atmUpdateInviteBtn();
        if (d.success) {
            statusEl.style.color = '#10b981';
            statusEl.textContent = '✓ ' + (d.message || 'Invitation sent.');
            // Optimistically reflect Pending on this class row (server renders
            // it authoritatively on the next load). Only when no confirmed
            // trainer is set yet — an invite never overrides a confirmed one.
            var invName = trainerName || d.trainer_name || d.trainer || '';
            var prow = document.querySelector('#at-tbody tr[data-cr-runid="' + st.runId + '"]');
            if (prow && prow.getAttribute('data-trainers-empty') === '1') {
                prow.setAttribute('data-pending', invName);
                var pcell = prow.children[5];
                if (pcell) {
                    pcell.innerHTML = '';
                    var ppill = document.createElement('span');
                    ppill.className = 'at-trainer-pill';
                    ppill.style.cssText = 'background:rgba(245,158,11,.15);color:#f59e0b;border:1px solid rgba(245,158,11,.3);';
                    ppill.textContent = invName ? ('Pending — ' + invName) : 'Pending';
                    pcell.appendChild(ppill);
                }
            }
        } else {
            statusEl.style.color = '#f87171';
            statusEl.textContent = '✗ ' + (d.message || 'Failed to send.');
        }
    })
    .catch(function() {
        btn.disabled = false;
        atmUpdateInviteBtn();
        statusEl.style.color = '#f87171';
        statusEl.textContent = '✗ Network error.';
    });
};
</script>

