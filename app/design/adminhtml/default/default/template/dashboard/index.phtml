            <?php /* ===== AI Brochure: one-click generate =====
                 Mirrors the SEO Meta UX (one-click, no modal):
                   1. POST product_id to adminhtml/coursesave/generateBrochure
                   2. Controller assembles a text-only PDF (graphics stripped)
                      from product EAV + per-course CMS blocks, with three-tier
                      AI prose polishing.
                   3. PDF lands at media/courses/brochures/<sku>.pdf.
                   4. We drop a "Download Course Brochure" anchor into the
                      cms_block_brochure textarea so it persists when the
                      admin clicks Save Changes. */ ?>
            <script>
            (function() {
                var BTN = document.querySelector('.ai-brochure-btn');
                if (!BTN) return;
                var PWRAP = document.querySelector('.ai-brochure-progress-wrap');
                var PBAR  = document.querySelector('.ai-brochure-progress-bar');
                var STATUS = document.querySelector('.ai-brochure-status');
                var TEXTAREA = document.querySelector('textarea[name="cms_block_brochure"]');
                var PREVIEW = document.querySelector('.ai-brochure-preview-btn');

                // Pre-populate Preview from the existing textarea on page load
                // so admins can open the current PDF without first regenerating.
                // Match the href in any <a href="...courses/brochures/...pdf">.
                function setPreviewUrl(url) {
                    if (!PREVIEW || !url) return;
                    PREVIEW.href = url;
                    PREVIEW.style.display = 'inline-flex';
                }
                (function prefillPreviewFromTextarea() {
                    if (!TEXTAREA || !PREVIEW) return;
                    var v = (TEXTAREA.value || '');
                    var m = v.match(/href=["']([^"']*courses\/brochures\/[^"']+\.pdf[^"']*)["']/i);
                    if (m) setPreviewUrl(m[1]);
                })();
                var progressTimer = null;
                var EXPECTED_MS = 25000;  // brochure is faster than SEO meta

                function setStatus(txt, color) {
                    STATUS.textContent = txt || '';
                    STATUS.style.color = color || '#94a3b8';
                }
                function startProgress() {
                    var started = Date.now();
                    PWRAP.style.display = 'block';
                    PBAR.style.transition = 'width 0.4s linear';
                    PBAR.style.width = '0%';
                    if (progressTimer) clearInterval(progressTimer);
                    progressTimer = setInterval(function() {
                        var elapsed = Date.now() - started;
                        var pct = elapsed < EXPECTED_MS
                            ? (elapsed / EXPECTED_MS) * 90
                            : 90 + (1 - Math.exp(-(elapsed - EXPECTED_MS) / 20000)) * 8;
                        PBAR.style.width = pct.toFixed(1) + '%';
                    }, 400);
                }
                function finishProgress() {
                    if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }
                    PBAR.style.transition = 'width 0.25s ease-out';
                    PBAR.style.width = '100%';
                    setTimeout(function() {
                        PWRAP.style.display = 'none';
                        PBAR.style.width = '0%';
                    }, 500);
                }

                BTN.addEventListener('click', function() {
                    var pid = parseInt(BTN.getAttribute('data-product-id'), 10) || 0;
                    if (pid <= 0) {
                        alert('No product_id on button — re-open the course edit page.');
                        return;
                    }
                    var origHtml = BTN.innerHTML;
                    BTN.disabled = true;
                    BTN.style.opacity = '.6';
                    BTN.style.cursor = 'wait';
                    BTN.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:ai-seo-spin 0.7s linear infinite;"></span> Generating…';
                    setStatus('Asking Claude to polish prose and rendering PDF…');
                    startProgress();

                    var fd = new FormData();
                    fd.append('form_key', window.FORM_KEY || '<?php echo Mage::getSingleton("core/session")->getFormKey() ?>');
                    fd.append('product_id', pid);
                    // Carry the Store-View bar selection across the fetch.
                    // The button's data-wid is set at page render to the
                    // current View-As website_id; without this the POST
                    // would hit the controller with no ?store= and the
                    // helper would fall back to SG, ignoring the country
                    // pill the admin actually clicked.
                    fd.append('wid', BTN.getAttribute('data-wid') || '');

                    fetch('<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/coursesave/generateBrochure") ?>', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(j) {
                        BTN.disabled = false;
                        BTN.style.opacity = '1';
                        BTN.style.cursor = 'pointer';
                        BTN.innerHTML = origHtml;
                        finishProgress();
                        if (!j || !j.success) {
                            setStatus('Failed: ' + ((j && j.message) || 'unknown error'), '#f87171');
                            return;
                        }
                        var html = '<a href="' + j.url + '" target="_blank">Download Course Brochure</a>';
                        if (TEXTAREA) TEXTAREA.value = html;
                        setPreviewUrl(j.url);
                        var note = j.stubbed
                            ? 'PDF generated (AI fallback used — click Save Changes to keep the link).'
                            : 'PDF generated. Click Save Changes to keep the link.';
                        // Append Drive-upload status when present. Three
                        // outcomes: uploaded (✓), skipped (not configured —
                        // silent message), or failed (red, but non-blocking).
                        if (j.drive) {
                            if (j.drive.uploaded) {
                                note += ' Uploaded to Drive (' + (j.drive.folder || '') + ').';
                            } else if (!j.drive.skipped) {
                                note += ' ⚠ ' + (j.drive.message || 'Drive upload failed');
                            }
                        }
                        setStatus(note, j.stubbed ? '#f59e0b' : '#22c55e');
                        if (j.stubbed) console.warn('Brochure stub used: ' + j.stub_reason);
                        if (j.drive && !j.drive.uploaded && !j.drive.skipped) {
                            console.warn('Drive upload failed: ' + j.drive.message);
                        }
                    })
                    .catch(function(err) {
                        BTN.disabled = false;
                        BTN.style.opacity = '1';
                        BTN.style.cursor = 'pointer';
                        BTN.innerHTML = origHtml;
                        finishProgress();
                        setStatus('Network error: ' + err.message, '#f87171');
                    });
                });

                // Re-use the SEO Meta spinner keyframes if already injected,
                // else inject our own.
                if (!document.getElementById('ai-seo-spin-style')) {
                    var st = document.createElement('style');
                    st.id = 'ai-seo-spin-style';
                    st.textContent = '@keyframes ai-seo-spin{to{transform:rotate(360deg);}}';
                    document.head.appendChild(st);
                }
            })();
            </script>

