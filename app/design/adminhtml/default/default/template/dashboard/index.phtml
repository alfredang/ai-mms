<script>
function courseSyncRun(btn) {
    btn.disabled = true;
    btn.textContent = 'Syncing…';
    var status = document.getElementById('course-sync-status');
    status.style.display = 'block';
    status.style.color = '#94a3b8';
    status.textContent = 'Syncing courses from SG — this may take a few minutes…';
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fetch('<?php echo $this->jsQuoteEscape($_syncUrl) ?>', { method:'POST', body:fd })
        .then(function(r){ return r.json(); })
        .then(function(d){
            btn.disabled = false;
            btn.textContent = 'Sync Now';
            if (d.success) {
                status.style.color = '#22c55e';
                status.textContent = 'Sync complete — fetched:' + d.fetched + ' created:' + d.created + ' updated:' + d.updated + (d.disabled?' disabled:'+d.disabled:'') + (d.errors?' errors:'+d.errors:'');
            } else {
                status.style.color = '#ef4444';
                status.textContent = 'Sync failed: ' + (d.message || 'unknown error');
            }
            setTimeout(function(){ location.reload(); }, 3000);
        })
        .catch(function(e){
            btn.disabled = false;
            btn.textContent = 'Sync Now';
            status.style.color = '#ef4444';
            status.textContent = 'Network error: ' + e;
        });
}
function courseSyncToggle(cb) {
    var on = cb.checked ? 1 : 0;
    cb.closest('.dcf-toggle-sw').setAttribute('title', on ? 'Daily auto-sync ON' : 'Daily auto-sync OFF');
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('value', on);
    fetch('<?php echo $this->jsQuoteEscape($_syncTogUrl) ?>', { method:'POST', body:fd })
        .then(function(r){ return r.json(); })
        .then(function(d){ if (!d.success) { cb.checked = !cb.checked; alert(d.message); } });
}
function courseSyncSaveConfig() {
    var url = document.getElementById('sync-sg-url').value.trim();
    var key = document.getElementById('sync-api-key').value.trim();
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('sg_url', url);
    fd.append('api_key', key);
    fetch('<?php echo $this->jsQuoteEscape($_syncCfgUrl) ?>', { method:'POST', body:fd })
        .then(function(r){ return r.json(); })
        .then(function(d){ alert(d.message || (d.success ? 'Saved.' : 'Error.')); });
}
</script>
