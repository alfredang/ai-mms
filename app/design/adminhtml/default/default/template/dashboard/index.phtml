                    <?php foreach ($_websites as $_w): ?>
                    <div style="margin-bottom:12px;">
                        <label style="display:flex;align-items:center;gap:8px;color:#f1f5f9;font-weight:600;font-size:14px;cursor:pointer;">
                            <input type="checkbox" name="websites[]" value="<?php echo (int)$_w->getId() ?>"<?php echo in_array((int)$_w->getId(), $_currentWebIds, true) ? ' checked' : '' ?> style="accent-color:#2563eb;width:16px;height:16px;" />
