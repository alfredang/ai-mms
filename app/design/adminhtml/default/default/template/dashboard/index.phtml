                    <script>
                    (function(){
                        window.csToggleOpt = function(headBtn) {
                            var opt = headBtn.closest('.cs-opt');
                            if (!opt) return;
                            var open = opt.classList.toggle('cs-collapsed');
                            // toggle returns true if class is now present, i.e. collapsed
                            headBtn.setAttribute('aria-expanded', open ? 'false' : 'true');
                        };
                        var newCounter = {};  // per-option_id new-row counter
                        window.csAddRow = function(optionId) {
                            newCounter[optionId] = (newCounter[optionId] || 0) + 1;
                            var n = newCounter[optionId];
                            var tbody = document.getElementById('cs-rows-' + optionId);
                            if (!tbody) return;
                            var tr = document.createElement('tr');
                            tr.setAttribute('data-new', n);
                            tr.innerHTML =
                                '<td class="cs-id" style="color:#22d3ee;">new</td>' +
                                '<td><input type="text" class="cs-input" name="schedule_new[' + optionId + '][' + n + '][title]" placeholder="e.g. 27 May 2026 (Tue)" /></td>' +
                                '<td><input type="date" class="cs-input" name="schedule_new[' + optionId + '][' + n + '][reg_course]" /></td>' +
                                '<td><input type="number" step="0.01" class="cs-input cs-w-price" name="schedule_new[' + optionId + '][' + n + '][price]" placeholder="0.00" /></td>' +
                                '<td><input type="number" step="1" class="cs-input cs-w-sort" name="schedule_new[' + optionId + '][' + n + '][sort]" value="0" /></td>' +
                                '<td><button type="button" class="cs-rm-btn" title="Cancel" aria-label="Cancel" onclick="this.closest(\'tr\').remove()"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button></td>';
                            tbody.appendChild(tr);
                            tr.querySelector('input').focus();
                        };
                        /* Column header click — toggle asc/desc and reorder rows in
                           place. Pure DOM reorder, does NOT touch sort_order values;
                           if the user wants to persist a new order they edit the SORT
                           inputs and click Save. Date/Price/Sort sort numeric, Title
                           sorts case-insensitive locale, ID sorts numeric. */
                        function csCmpVal(td, key) {
                            if (key === 'id') return parseInt(td.textContent.trim(), 10) || 0;
                            if (key === 'title') return (td.querySelector('input') || {}).value || '';
                            if (key === 'date')  return (td.querySelector('input[type=date]') || {}).value || '';
                            if (key === 'price') return parseFloat((td.querySelector('input') || {}).value || '0') || 0;
                            if (key === 'sort')  return parseInt((td.querySelector('input') || {}).value || '0', 10) || 0;
                            return '';
                        }
                        var colIndex = { id:0, title:1, date:2, price:3, sort:4 };
                        document.addEventListener('click', function(e) {
                            var head = e.target.closest('.cs-sort-h');
                            if (!head) return;
                            var key = head.getAttribute('data-sort');
                            var tbl = head.closest('table');
                            if (!tbl || !key) return;
                            /* Cycle: not-active → asc; asc → desc; desc → asc */
                            var dir = head.getAttribute('data-dir') === 'asc' ? 'desc' : 'asc';
                            /* Reset siblings in same header row */
                            tbl.querySelectorAll('thead .cs-sort-h').forEach(function(h){
                                h.classList.remove('cs-sort-active');
                                h.removeAttribute('data-dir');
                                var a = h.querySelector('.cs-sort-arrow');
                                if (a) a.innerHTML = '';
                            });
                            head.classList.add('cs-sort-active');
                            head.setAttribute('data-dir', dir);
                            var arrow = head.querySelector('.cs-sort-arrow');
                            if (arrow) arrow.innerHTML = dir === 'asc' ? '▲' : '▼';

                            var tbody = tbl.querySelector('tbody');
                            if (!tbody) return;
                            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                            var ci = colIndex[key];
                            rows.sort(function(a, b){
                                var av = csCmpVal(a.children[ci], key);
                                var bv = csCmpVal(b.children[ci], key);
                                if (typeof av === 'string' || typeof bv === 'string') {
                                    av = String(av).toLowerCase(); bv = String(bv).toLowerCase();
                                    if (av < bv) return dir === 'asc' ? -1 : 1;
                                    if (av > bv) return dir === 'asc' ?  1 : -1;
                                    return 0;
                                }
                                return dir === 'asc' ? (av - bv) : (bv - av);
                            });
                            rows.forEach(function(r){ tbody.appendChild(r); });
                        });

                        /* Renumber the SORT inputs in this option's table to 10, 20,
                           30 … in ascending Date order. Skips rows marked for removal
                           and rows with a blank date (those keep their existing sort).
                           Pure DOM mutation — Save & Continue persists it. */
                        window.csRenumberByDate = function(optionId) {
                            var tbody = document.getElementById('cs-rows-' + optionId);
                            if (!tbody) return;
                            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
                            var dated = [], undated = [];
                            rows.forEach(function(tr){
                                if (tr.classList.contains('cs-marked-remove')) return;
                                var dInp = tr.querySelector('input[type=date]');
                                var sInp = tr.querySelector('input.cs-w-sort');
                                if (!sInp) return;
                                var d = dInp ? dInp.value : '';
                                (d ? dated : undated).push({tr:tr, date:d, sortInp:sInp});
                            });
                            dated.sort(function(a, b){ return a.date < b.date ? -1 : a.date > b.date ? 1 : 0; });
                            var step = 10;
                            dated.forEach(function(item, i){
                                item.sortInp.value = (i + 1) * step;
                            });
                            /* Reorder rows in the DOM to match the new sort, so the
                               user immediately sees the dated-row order. Undated rows
                               keep their previous position at the bottom. */
                            dated.forEach(function(item){ tbody.appendChild(item.tr); });
                            undated.forEach(function(item){ tbody.appendChild(item.tr); });
                            /* Flash the Sort header so the user knows the click did
                               something even when values were already sequential. */
                            var head = tbody.closest('table').querySelector('.cs-sort-h[data-sort="sort"]');
                            if (head) {
                                head.style.transition = 'color .25s';
                                head.style.color = 'var(--green,#22c55e)';
                                setTimeout(function(){ head.style.color = ''; }, 600);
                            }
                        };

                        /* Server-side bulk renumber: rewrites SORT for every product's
                           "Course Date" option in date order (×10). scope='store' uses
                           the storefront the admin is currently editing under;
                           scope='global' targets every product. Persists immediately —
                           no Save & Continue needed. */
                        window.csBulkRenumber = function(scope, btn) {
                            var label = scope === 'store' ? 'every product in THIS STORE' : 'EVERY PRODUCT across ALL STORES';
                            if (!confirm('Renumber the Course Date sort order for ' + label +
                                ' in steps of 10 (earliest date = 10)?\n\n' +
                                'This writes directly to the DB and cannot be undone.')) return;
                            var status = document.getElementById('cs-bulk-status');
                            if (status) status.textContent = 'Working…';
                            if (btn) btn.disabled = true;
                            var fd = new FormData();
                            fd.append('form_key', '<?php echo Mage::getSingleton("core/session")->getFormKey() ?>');
                            fd.append('scope', scope);
                            fd.append('store_id', '<?php echo (int) Mage::app()->getStore()->getId() ?>');
                            fetch('<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/coursesave/bulkRenumber") ?>', {
                                method: 'POST', body: fd, credentials: 'same-origin'
                            })
                            .then(function(r){ return r.json(); })
                            .then(function(j){
                                if (btn) btn.disabled = false;
                                if (!j || !j.success) {
                                    if (status) status.textContent = '';
                                    alert('Renumber failed: ' + ((j && j.message) || 'unknown error'));
                                    return;
                                }
                                var msg = 'Done. Products renumbered: ' + j.products_processed +
                                          ' · values updated: ' + j.values_renumbered +
                                          (j.products_skipped_no_dates ? ' · skipped (no dates): ' + j.products_skipped_no_dates : '');
                                if (status) status.textContent = msg;
                                alert(msg + '\n\nReload the page to see updated sort positions on this course.');
                            })
                            .catch(function(e){
                                if (btn) btn.disabled = false;
                                if (status) status.textContent = '';
                                alert('Renumber failed: ' + e);
                            });
                        };

                        window.csToggleRemove = function(btn, valueId) {
                            var tr = btn.closest('tr');
                            var hidden = tr.querySelector('input[name="schedule_remove[' + valueId + ']"]');
                            if (!hidden) return;
                            var marked = hidden.value === '1';
                            hidden.value = marked ? '0' : '1';
                            tr.classList.toggle('cs-marked-remove', !marked);
                            btn.classList.toggle('active', !marked);
                            var _trash = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';
                            var _undo = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg>';
                            btn.title = marked ? 'Remove' : 'Undo';
                            btn.setAttribute('aria-label', btn.title);
                            btn.innerHTML = marked ? _trash : _undo;
                            // Disable inputs in marked-for-remove rows so they don't waste a save round-trip
                            tr.querySelectorAll('input.cs-input').forEach(function(el){ el.disabled = !marked; });
                        };
                    })();
                    </script>
                </div>
            </div>
