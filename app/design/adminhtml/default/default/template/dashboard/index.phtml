                        foreach ($_cRead->fetchAll(
                            "SELECT run_id, token FROM `$_cTbl` WHERE LOWER(learner_email) = ? AND status = 'sent'",
                            array(strtolower($_loggedInEmail))
                        ) as $_cc) {
                            $_certByRun[(int)$_cc['run_id']] = $_cc['token'];
                        }
                    } catch (Exception $e) { /* table may not exist pre-migration */ }
                }
                $_certDlBase = rtrim(Mage::getBaseUrl(), '/') . '/certificate/download/index?token=';
