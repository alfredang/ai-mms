// Resolve the country (store view) this edit applies to BEFORE the form
// renders, so the active-store banner and every per-row scope label can
// surface the same value. Lookup precedence mirrors the SEO Meta block:
//   1. ?store=N    2. ?dev_country=<Name>    3. dev_back's dev_country/store
//   4. admin session branchscope    5. fall back to Singapore.
$_seoStoreToCountry = array(
    1 => 'Singapore', 4 => 'Nigeria',
);
$_seoCountryToStore = array_flip($_seoStoreToCountry);
$_seoStoreId = 0;
$_seoReq = Mage::app()->getRequest();
$_seoUrlStore = $_seoReq->getParam('store', null);
if ($_seoUrlStore !== null && ctype_digit((string) $_seoUrlStore)) {
    $_seoStoreId = (int) $_seoUrlStore;
}
if (!isset($_seoStoreToCountry[$_seoStoreId])) {
    $_seoUrlCountry = (string) $_seoReq->getParam('dev_country', '');
    if (isset($_seoCountryToStore[$_seoUrlCountry])) {
        $_seoStoreId = $_seoCountryToStore[$_seoUrlCountry];
    }
}
if (!isset($_seoStoreToCountry[$_seoStoreId])) {
    $_seoDevBack = (string) $_seoReq->getParam('dev_back', '');
    if ($_seoDevBack !== '') {
        $_seoDecoded = urldecode($_seoDevBack);
        if (preg_match('/(?:^|&)dev_country=([^&]+)/', $_seoDecoded, $_seoM)) {
            $_seoBackCountry = urldecode($_seoM[1]);
            if (isset($_seoCountryToStore[$_seoBackCountry])) {
                $_seoStoreId = $_seoCountryToStore[$_seoBackCountry];
            }
        }
        if (!isset($_seoStoreToCountry[$_seoStoreId])
                && preg_match('/(?:^|&)store=(\d+)/', $_seoDecoded, $_seoM2)) {
            $_seoStoreId = (int) $_seoM2[1];
        }
    }
}
if (!isset($_seoStoreToCountry[$_seoStoreId])) {
    try {
        $_seoSession = Mage::getSingleton('admin/session');
        $_seoSessStore = $_seoSession ? (int) $_seoSession->getData('mmd_branchscope_current_store_id') : 0;
        if ($_seoSessStore > 0) $_seoStoreId = $_seoSessStore;
    } catch (Exception $_e) {}
}
$_seoActiveCountry = isset($_seoStoreToCountry[$_seoStoreId])
    ? $_seoStoreToCountry[$_seoStoreId]
    : 'Singapore';
$_dcfStoreFlag = array(
    'Singapore' => 'SG', 'Nigeria' => 'NG',
);
$_dcfScopeLabel = '[' . strtoupper($_seoActiveCountry) . ' STORE]';
