                <input type="number" id="at-autoinv-window" min="1" max="365" value="<?php echo (int)$_aiWindow ?>" onchange="atWindowSet(this)" style="width:60px;background:#0f172a;color:#e2e8f0;border:1px solid #334155;border-radius:6px;padding:5px 8px;font-size:12px;"> days
