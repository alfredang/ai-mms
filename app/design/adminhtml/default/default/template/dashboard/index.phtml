<?php
// Data prep — only runs when this panel is the active sub-view.
$_alActive = ($activeRole === 'admin') && (Mage::app()->getRequest()->getParam('panel') === 'assign_learner');
$_alKpi = array('upcoming' => 0, 'ongoing' => 0, 'completed' => 0, 'trainees' => 0, 'no_trainee' => 0);
$_alRows = array();
$_alCourseTitles = array();
if ($_alActive) {
    // Country scope from the logged-in admin (admin.<cc>@…).
    $_alWid = (int) Mage::helper('mmd_rolemanager')->getActiveWebsiteId();
    try {
        // Source from course_runs — one row per scheduled class run.
        // Window: last 2 years to unlimited future (all tabs).
        $_alWinFrom = date('Y-m-d', strtotime('-2 years'));
        $_alRunsList = $read->fetchAll(
            "SELECT cr.run_id, cr.product_id, cr.class_id, cr.course_sku,
                    cr.course_start_date, cr.course_end_date,
                    cr.course_start_time, cr.course_end_time
             FROM course_runs cr
             JOIN catalog_product_website pw ON pw.product_id=cr.product_id AND pw.website_id={$_alWid}
             WHERE cr.course_sku NOT LIKE 'TGS%'
               AND cr.course_start_date >= '{$_alWinFrom}'
             ORDER BY cr.course_start_date ASC, cr.run_id ASC
             LIMIT 3000"
        );

        // Batch-load product names/SKUs for the pids in those runs.
        $_alProdById = array();
        if (!empty($_alRunsList)) {
            $_alRunPidsCsv = implode(',', array_unique(array_map(function($r){ return (int)$r['product_id']; }, $_alRunsList)));
            try {
                foreach ($read->fetchAll(
                    "SELECT e.entity_id, e.sku, vname.value AS name
                     FROM catalog_product_entity e
                     LEFT JOIN catalog_product_entity_varchar vname
                        ON vname.entity_id=e.entity_id AND vname.attribute_id=71 AND vname.store_id=0
                     WHERE e.entity_id IN ({$_alRunPidsCsv})"
                ) as $_pr) {
                    $_alProdById[(int)$_pr['entity_id']] = $_pr;
                }
            } catch (Exception $e) {}
        }

        // Enrolment counts by run_id from course_run_enrolments.
        // course_run_enrolments is now the single source of truth
        // (backfilled for all historical orders).
        $_alEnrol = array();
        if (!empty($_alRunsList)) {
            $_alRunIdsCsv = implode(',', array_map(function($r){ return (int)$r['run_id']; }, $_alRunsList));
            try {
                foreach ($read->fetchAll(
                    "SELECT run_id, COUNT(DISTINCT learner_email) AS c
                     FROM course_run_enrolments
                     WHERE run_id IN ({$_alRunIdsCsv})
                       AND learner_email IS NOT NULL AND learner_email <> ''
                     GROUP BY run_id"
                ) as $_er) {
                    $_alEnrol[(int)$_er['run_id']] = (int)$_er['c'];
                }
            } catch (Exception $e) {}
        }

        $_alToday = strtotime(date('Y-m-d'));
        foreach ($_alRunsList as $_run) {
            $_pid  = (int) $_run['product_id'];
            $_prod = isset($_alProdById[$_pid]) ? $_alProdById[$_pid] : array();

            $_sd = $_run['course_start_date'] ? strtotime($_run['course_start_date']) : 0;
            $_ed = $_run['course_end_date']   ? strtotime($_run['course_end_date'])   : 0;

            if ($_sd && $_ed && $_sd <= $_alToday && $_ed >= $_alToday) $_tab = 'ongoing';
            elseif ($_ed && $_ed < $_alToday)                           $_tab = 'completed';
            elseif ($_sd && $_sd < $_alToday && !$_ed)                  $_tab = 'completed';
            else                                                        $_tab = 'upcoming';

            $_traineeCount = isset($_alEnrol[(int)$_run['run_id']]) ? (int)$_alEnrol[(int)$_run['run_id']] : 0;

            $_alClassTime = '';
            if (!empty($_run['course_start_time']) && !empty($_run['course_end_time'])) {
                $_alClassTime = date('g:ia', strtotime($_run['course_start_time'])) . ' – ' . date('g:ia', strtotime($_run['course_end_time']));
            }

            $_alName = isset($_prod['name']) ? (string)$_prod['name'] : '';
            $_alRows[] = array(
                'pid'             => $_pid,
                'internal_run_id' => (int)$_run['run_id'],
                'sku'             => isset($_prod['sku']) ? (string)$_prod['sku'] : (string)$_run['course_sku'],
                'title'           => $_alName !== '' ? $_alName : '(No Name)',
                'run_id'          => (string) $_run['class_id'],
                'start_date'      => $_sd ? date('d/m/Y', $_sd) : '—',
                'start_iso'       => $_sd ? date('Y-m-d', $_sd) : '',
                'class_time'      => $_alClassTime,
                'tab'             => $_tab,
                'trainees'        => $_traineeCount,
            );
            if ($_alName !== '') $_alCourseTitles[$_alName] = true;

            if ($_tab === 'upcoming')  $_alKpi['upcoming']++;
            if ($_tab === 'ongoing')   $_alKpi['ongoing']++;
            if ($_tab === 'completed') $_alKpi['completed']++;
            if ($_tab === 'upcoming' && $_traineeCount === 0) $_alKpi['no_trainee']++;
        }
        ksort($_alCourseTitles);
        $_alCourseTitles = array_keys($_alCourseTitles);

        // Sort rows by effective start date ascending (soonest first),
        // empty dates last. The earlier SQL ORDER BY only sees
        // news_from_date — it can't know about course_runs / Course
        // Date custom-option fallbacks that fill in dates per row in
        // PHP, so without this re-sort the table looks scrambled.
        usort($_alRows, function ($a, $b) {
            $aEmpty = $a['start_iso'] === '';
            $bEmpty = $b['start_iso'] === '';
            if ($aEmpty !== $bEmpty) return $aEmpty ? 1 : -1;
            if ($a['start_iso'] !== $b['start_iso']) return strcmp($a['start_iso'], $b['start_iso']);
            return $a['pid'] - $b['pid'];
        });

        // Distinct trainee count per tab bucket. The Sum-of-counts
        // approach inflated the KPI because a learner enrolled in 5
        // upcoming courses got counted 5×. We instead query distinct
        // emails over the union of products in each bucket so the
        // tile reads "people enrolled in upcoming classes", not
        // "enrolment seats filled".
        $_alRunIdsByTab = array('upcoming' => array(), 'ongoing' => array(), 'completed' => array());
        $_alNoTraineeByTab = array('upcoming' => 0, 'ongoing' => 0, 'completed' => 0);
        foreach ($_alRows as $_r) {
            $_alRunIdsByTab[$_r['tab']][] = (int)$_r['internal_run_id'];
            if ((int)$_r['trainees'] === 0) $_alNoTraineeByTab[$_r['tab']]++;
        }
        $_alDistinctByTab = array('upcoming' => 0, 'ongoing' => 0, 'completed' => 0);
        foreach ($_alRunIdsByTab as $_tabName => $_runIdsT) {
            if (empty($_runIdsT)) continue;
            try {
                $_runIdsList = implode(',', $_runIdsT);
                $_alDistinctByTab[$_tabName] = (int) $read->fetchOne(
                    "SELECT COUNT(DISTINCT LOWER(learner_email))
                     FROM course_run_enrolments
                     WHERE learner_email IS NOT NULL AND learner_email <> ''
                       AND run_id IN ({$_runIdsList})"
                );
            } catch (Exception $e) {}
        }
        $_alKpi['trainees'] = $_alDistinctByTab['upcoming'];
    } catch (Exception $e) {}
}
if (!isset($_alDistinctByTab))   $_alDistinctByTab   = array('upcoming' => 0, 'ongoing' => 0, 'completed' => 0);
if (!isset($_alNoTraineeByTab))  $_alNoTraineeByTab  = array('upcoming' => 0, 'ongoing' => 0, 'completed' => 0);
?>
