    <div class="mn-draft-modal-card" onclick="event.stopPropagation()">
        <div class="mn-draft-modal-head">
            <div>
                <div class="mn-draft-modal-title" id="mn-draft-modal-title">Newsletter preview</div>
                <div class="mn-draft-modal-meta" id="mn-draft-modal-meta"></div>
            </div>
            <div class="mn-draft-modal-actions">
