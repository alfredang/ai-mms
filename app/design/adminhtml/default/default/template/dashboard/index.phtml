<script type="text/javascript">
window.cncPickCourse = function(sel) {
    var ref = document.getElementById('cnc-ref');
    if (sel.value && ref && !ref.value) ref.value = sel.value;
};
window.cncToggleTrainer = function(cb) {
    var section = document.getElementById('cnc-trainer-section');
    var inp     = document.getElementById('cnc-trainer-id');
    if (!section) return;
    section.style.display = cb.checked ? '' : 'none';
    if (inp) {
        if (cb.checked) inp.setAttribute('required', 'required');
        else { inp.removeAttribute('required'); inp.value = ''; }
    }
};
window.cncSubmit = function(ev) {
    ev.preventDefault();
    var sku       = (document.getElementById('cnc-ref')       ||{value:''}).value.trim();
    var startDate = (document.getElementById('cnc-start')     ||{value:''}).value;
    var endDate   = (document.getElementById('cnc-end')       ||{value:''}).value;
    var startTime = (document.getElementById('cnc-start-time')||{value:''}).value;
    var endTime   = (document.getElementById('cnc-end-time')  ||{value:''}).value;
    if (!sku)       { alert('Please fill in the Course Reference Number.'); return false; }
    if (!startDate) { alert('Please select a Course Start Date.');          return false; }
    if (!endDate)   { alert('Please select a Course End Date.');            return false; }
    if (!startTime) { alert('Please enter a Start Time.');                  return false; }
    if (!endTime)   { alert('Please enter an End Time.');                   return false; }
    if (endDate < startDate) { alert('End Date cannot be before Start Date.'); return false; }
    if (startDate === endDate && endTime <= startTime) { alert('End Time must be after Start Time.'); return false; }
    var trainerUid = '';
    if ((document.getElementById('cnc-opt-trainer')||{checked:false}).checked) {
        trainerUid = (document.getElementById('cnc-trainer-id')||{value:''}).value;
        if (!trainerUid) { alert('Please pick a trainer or untick "Assign Trainer".'); return false; }
    }
    function val(id) { var el = document.getElementById(id); return el ? el.value : ''; }
    var fd = new FormData();
    fd.append('course_sku',        sku);
    fd.append('trainer_user_id', trainerUid);
    fd.append('start_date',        startDate);
    fd.append('end_date',          endDate);
    fd.append('start_time',        startTime);
    fd.append('end_time',          endTime);
    fd.append('reg_open_date',     val('cnc-reg-open'));
    fd.append('reg_close_date',    val('cnc-reg-close'));
    fd.append('venue_block',       val('cnc-venue-block'));
    fd.append('venue_street',      val('cnc-venue-street'));
    fd.append('venue_building',    val('cnc-venue-building'));
    fd.append('venue_floor',       val('cnc-floor'));
    fd.append('venue_unit',        val('cnc-unit'));
    fd.append('postal_code',       val('cnc-postal'));
    fd.append('room',              val('cnc-room'));
    fd.append('wheelchair',        val('cnc-wheelchair'));
    fd.append('mode_of_training',  val('cnc-mode'));
    fd.append('admin_email',       val('cnc-admin-email'));
    fd.append('vacancy',           val('cnc-vacancy'));
    var btn = ev.target.querySelector('.cnc-btn-primary');
    if (btn) { btn.disabled = true; btn.textContent = 'Creating...'; }
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/coursesave/createNewClass') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data && data.success) {
            alert(data.message || 'Class created.');
            window.location.href = '<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/dashboard') ?>';
        } else {
            alert('Could not create class: ' + (data && data.message ? data.message : 'unknown error'));
            if (btn) { btn.disabled = false; btn.textContent = 'Create Class'; }
        }
    })
    .catch(function(err) {
        alert('Network error: ' + err);
        if (btn) { btn.disabled = false; btn.textContent = 'Create Class'; }
    });
    return false;
};
</script>
</div><!-- end dash-panel-createclass -->

<?php /* ===== PANEL: Assign Trainer (Admin only) ===== */ ?>
<?php
// Data prep — only runs when this panel is the active sub-view, otherwise
// the page pays for ~3 extra queries on every dashboard load.
$_atActive = ($activeRole === 'admin') && (Mage::app()->getRequest()->getParam('panel') === 'assign_trainer');
$_atKpi = array(
    'upcoming' => 0, 'ongoing' => 0, 'completed' => 0,
    'assigned' => 0, 'missing' => 0,
    'assigned_upcoming'  => 0, 'missing_upcoming'  => 0,
    'assigned_ongoing'   => 0, 'missing_ongoing'   => 0,
    'assigned_completed' => 0, 'missing_completed' => 0,
);
$_atRows = array();
$_atTrainerOpts = array();
$_atTrainerAccounts = array(); // account picker source — used in always-rendered modal markup
$_atCourseTitles = array();
if ($_atActive) {
    // Country scope from the logged-in admin's email (admin.<cc>@…).
    // Defaults to Singapore for accounts that don't match the pattern.
    $_atWid       = (int) Mage::helper('mmd_rolemanager')->getActiveWebsiteId();
    $_atCountry   = Mage::helper('mmd_rolemanager')->getActiveCountryName();
    $_atSelfLabel = $_atCountry . ' Admin'; // e.g. "Malaysia Admin"
    $_atTrainerOptsScoped = array();
    try {
        $_atTrainersAttrId = isset($_eavAttrIds['trainers']) ? $_eavAttrIds['trainers'] : 0;
        // Trainer option_id → name. Full list is used by the inline
        // editor (admin can pick any trainer to assign). The filter
        // dropdown below uses a country-scoped subset built later.
        if ($_atTrainersAttrId) {
            $_atTrainerOpts = $read->fetchPairs(
                "SELECT eaov.option_id, eaov.value
                 FROM eav_attribute_option eao
                 JOIN eav_attribute_option_value eaov ON eao.option_id=eaov.option_id AND eaov.store_id=0
                 WHERE eao.attribute_id=?
                 ORDER BY eaov.value",
                array($_atTrainersAttrId)
            );

            // Country-scoped trainer subset — anyone whose option_id
            // appears in the trainers multiselect of any product on
            // this country's catalog OR in any course_runs row whose
            // product is on this country's catalog. Plus the matching
            // "<Country> Admin" option, always included so admins can
            // filter to their own self-assigned classes.
            $_atScopedOids = array();
            try {
                $rows = $read->fetchAll(
                    "SELECT t.value FROM catalog_product_entity_text t
                     JOIN catalog_product_website pw ON pw.product_id = t.entity_id AND pw.website_id = ?
                     WHERE t.attribute_id = ? AND t.value <> ''",
                    array($_atWid, $_atTrainersAttrId)
                );
                foreach ($rows as $r) {
                    foreach (explode(',', $r['value']) as $_oid) {
                        $_oid = (int) trim($_oid);
                        if ($_oid) $_atScopedOids[$_oid] = true;
                    }
                }
                $crOids = $read->fetchCol(
                    "SELECT DISTINCT cr.trainer_option_id FROM course_runs cr
                     JOIN catalog_product_website pw ON pw.product_id = cr.product_id AND pw.website_id = ?
                     WHERE cr.trainer_option_id IS NOT NULL",
                    array($_atWid)
                );
                foreach ($crOids as $_oid) $_atScopedOids[(int)$_oid] = true;
                foreach ($_atTrainerOpts as $_oid => $_name) {
                    if (strcasecmp(trim($_name), $_atSelfLabel) === 0) {
                        $_atScopedOids[(int)$_oid] = true;
                    }
                }
                foreach ($_atTrainerOpts as $_oid => $_name) {
                    if (isset($_atScopedOids[(int)$_oid])) $_atTrainerOptsScoped[(int)$_oid] = $_name;
                }
            } catch (Exception $e) {}
        }

        // Phase 2 — account-based trainer pool. The picker lists real
        // trainer accounts (admin_user with the 'trainer' role); the
        // approved pool persists to mmd_product_trainer and drives the
        // invitation system. Legacy EAV stays as a display/invite
        // fallback (hybrid) so previously-assigned trainers still resolve.
        $_atTrainerAccounts = array(); // user_id => display name (picker source)
        $_atUserNames       = array(); // user_id => name (run resolution)
        try {
            foreach (Mage::helper('mmd_rolemanager/trainer')->getTrainerAccounts() as $_acc) {
                $_uid = (int) $_acc['user_id'];
                $_nm  = trim((string) $_acc['name']);
                $_em  = trim((string) $_acc['email']);
                $_atTrainerAccounts[$_uid] = ($_nm !== '' ? $_nm : $_em);
                $_atUserNames[$_uid]       = $_atTrainerAccounts[$_uid];
            }
        } catch (Exception $e) {}

        // Source from course_runs — one row per scheduled class run.
        // Products without a course_runs entry are excluded (no concrete
        // class date means nothing to assign a trainer to).
        // Window: last 2 years to unlimited future covers all tabs.
        $_atWinFrom = date('Y-m-d', strtotime('-2 years'));
        $_atRunsList = $read->fetchAll(
            "SELECT cr.run_id, cr.product_id, cr.class_id, cr.course_sku,
                    cr.course_start_date, cr.course_end_date,
                    cr.trainer_option_id, cr.trainer_user_id,
                    inv.status AS inv_status, inv.trainer_name AS inv_trainer_name
             FROM course_runs cr
             JOIN catalog_product_website pw ON pw.product_id=cr.product_id AND pw.website_id={$_atWid}
             LEFT JOIN (
                 SELECT i.run_id, i.status, i.trainer_name
                   FROM course_run_trainer_invitations i
                   INNER JOIN (SELECT run_id, MAX(id) AS mid FROM course_run_trainer_invitations GROUP BY run_id) l
                      ON l.run_id = i.run_id AND l.mid = i.id
             ) inv ON inv.run_id = cr.run_id
             WHERE cr.course_sku NOT LIKE 'TGS%'
               AND cr.course_start_date >= '{$_atWinFrom}'
             ORDER BY cr.course_start_date ASC, cr.run_id ASC
             LIMIT 3000"
        );

        // Batch-load product attributes for all pids referenced by those runs.
        $_atProdById = array();
        if (!empty($_atRunsList)) {
            $_atRunPidsCsv = implode(',', array_unique(array_map(function($r){ return (int)$r['product_id']; }, $_atRunsList)));
            $_atTrainersJoinAid = $_atTrainersAttrId ? (int)$_atTrainersAttrId : 0;
            try {
                foreach ($read->fetchAll(
                    "SELECT e.entity_id, e.sku,
                            vname.value AS name,
                            vstatus.value AS status_val,
                            " . ($_atTrainersAttrId ? "vtrain.value AS trainers_csv," : "NULL AS trainers_csv,") . "
                            vprofile.value AS trainer_profile_html
                     FROM catalog_product_entity e
                     LEFT JOIN catalog_product_entity_varchar vname
                        ON vname.entity_id=e.entity_id AND vname.attribute_id=71 AND vname.store_id=0
                     LEFT JOIN catalog_product_entity_int vstatus
                        ON vstatus.entity_id=e.entity_id AND vstatus.attribute_id={$statusAid} AND vstatus.store_id=0
                     " . ($_atTrainersAttrId
                        ? "LEFT JOIN catalog_product_entity_text vtrain ON vtrain.entity_id=e.entity_id AND vtrain.attribute_id={$_atTrainersJoinAid} AND vtrain.store_id=0"
                        : "") . "
                     LEFT JOIN catalog_product_entity_text vprofile
                        ON vprofile.entity_id=e.entity_id AND vprofile.attribute_id=153 AND vprofile.store_id=0
                     WHERE e.entity_id IN ({$_atRunPidsCsv})"
                ) as $_pr) {
                    $_atProdById[(int)$_pr['entity_id']] = $_pr;
                }
            } catch (Exception $e) {}
        }

        // Batch-load the account-based approved pool (mmd_product_trainer)
        // for every product on the page — one query, no N+1.
        $_atProductAccounts = array(); // pid => [user_id, ...] in sort order
        if (!empty($_atRunsList)) {
            try {
                $_ptTbl = $read->getTableName('mmd_product_trainer');
                foreach ($read->fetchAll(
                    "SELECT product_id, user_id FROM {$_ptTbl}
                      WHERE product_id IN ({$_atRunPidsCsv})
                      ORDER BY product_id, sort_order, id"
                ) as $_ptr) {
                    $_atProductAccounts[(int)$_ptr['product_id']][] = (int)$_ptr['user_id'];
                }
            } catch (Exception $e) {}
        }

        $_atToday = strtotime(date('Y-m-d'));
        foreach ($_atRunsList as $_run) {
            $_pid  = (int) $_run['product_id'];
            $_prod = isset($_atProdById[$_pid]) ? $_atProdById[$_pid] : array();

            $_sd = $_run['course_start_date'] ? strtotime($_run['course_start_date']) : 0;
            $_ed = $_run['course_end_date']   ? strtotime($_run['course_end_date'])   : 0;

            if ($_sd && $_ed && $_sd <= $_atToday && $_ed >= $_atToday) $_tab = 'ongoing';
            elseif ($_ed && $_ed < $_atToday)                           $_tab = 'completed';
            elseif ($_sd && $_sd < $_atToday && !$_ed)                  $_tab = 'completed';
            else                                                        $_tab = 'upcoming';

            $_sv = isset($_prod['status_val']) ? (int)$_prod['status_val'] : 1;

            // Approved candidate pool (mmd_product_trainer) — feeds the modal
            // picker + the invitation queue ONLY. It is NOT the assignment.
            $_tuids = isset($_atProductAccounts[$_pid]) ? $_atProductAccounts[$_pid] : array();
            $_tunames = array();
            foreach ($_tuids as $_uid) {
                $_tunames[] = isset($_atUserNames[$_uid]) ? $_atUserNames[$_uid] : ('#' . $_uid);
            }

            // CONFIRMED trainer for THIS run only (LMS model): an accepted
            // account assignment (trainer_user_id) or a legacy per-run EAV
            // assignment (trainer_option_id). The candidate pool and the
            // course-level EAV list are NEVER shown as "assigned".
            $_tnames = array(); $_toids = array();
            $_runUid = (int) (isset($_run['trainer_user_id']) ? $_run['trainer_user_id'] : 0);
            if ($_runUid > 0 && isset($_atUserNames[$_runUid])) {
                $_tnames[] = $_atUserNames[$_runUid];
            } elseif ((int)$_run['trainer_option_id'] > 0 && isset($_atTrainerOpts[(int)$_run['trainer_option_id']])) {
                $_tnames[] = $_atTrainerOpts[(int)$_run['trainer_option_id']];
                $_toids[]  = (int)$_run['trainer_option_id'];
            }

            // Pending invitation: only when there's no confirmed trainer yet
            // and the latest invitation is still awaiting a response.
            $_invStatus   = isset($_run['inv_status']) ? (string)$_run['inv_status'] : '';
            $_pendingName = (empty($_tnames) && $_invStatus === 'pending')
                ? trim((string)(isset($_run['inv_trainer_name']) ? $_run['inv_trainer_name'] : ''))
                : '';

            // Class status (LMS model, trainer-driven — matches All Classes):
            // Cancelled if the course is disabled; Confirmed once a trainer is
            // confirmed for THIS run (accepted invite -> trainer_user_id, or a
            // grandfathered legacy trainer_option_id); otherwise Pending —
            // including classes that only have a pending invite or candidates.
            if ($_sv !== 1)           { $_lbl = 'Cancelled'; $_cls = 'at-badge-cancelled'; }
            elseif (!empty($_tnames)) { $_lbl = 'Confirmed'; $_cls = 'at-badge-confirmed'; }
            else                      { $_lbl = 'Pending';   $_cls = 'at-badge-pending'; }

            $_atName = isset($_prod['name']) ? (string)$_prod['name'] : '';
            $_atRows[] = array(
                'pid'          => $_pid,
                'sku'          => isset($_prod['sku']) ? (string)$_prod['sku'] : (string)$_run['course_sku'],
                'title'        => $_atName !== '' ? $_atName : '(No Name)',
                'run_id'       => (string) $_run['class_id'],
                'cr_run_id'    => (int) $_run['run_id'],
                'start_date'   => $_sd ? date('d/m/Y', $_sd) : '—',
                'start_iso'    => $_sd ? date('Y-m-d', $_sd) : '',
                'tab'          => $_tab,
                'status'       => $_lbl,
                'status_cls'   => $_cls,
                'trainers'      => $_tnames,
                'trainer_oids'  => $_toids,
                'trainer_uids'  => $_tuids,
                'trainer_unames'=> $_tunames,
                'pending_name'  => $_pendingName,
            );
            if ($_atName !== '') $_atCourseTitles[$_atName] = true;
            if ($_tab === 'upcoming') $_atKpi['upcoming']++;
            if ($_tab === 'ongoing')  $_atKpi['ongoing']++;
            if ($_tab === 'completed')$_atKpi['completed']++;
            $_kpiKey  = 'assigned_' . $_tab;
            $_kpiKey2 = 'missing_'  . $_tab;
            if (!isset($_atKpi[$_kpiKey]))  $_atKpi[$_kpiKey] = 0;
            if (!isset($_atKpi[$_kpiKey2])) $_atKpi[$_kpiKey2] = 0;
            if (!empty($_tnames)) $_atKpi[$_kpiKey]++;
            else                  $_atKpi[$_kpiKey2]++;
            if ($_tab === 'upcoming') {
                if (!empty($_tnames)) $_atKpi['assigned']++;
                else                  $_atKpi['missing']++;
            }
        }
        ksort($_atCourseTitles);
        $_atCourseTitles = array_keys($_atCourseTitles);
    } catch (Exception $e) {}
    foreach (array('upcoming','ongoing','completed') as $_tk) {
        if (!isset($_atKpi['assigned_' . $_tk])) $_atKpi['assigned_' . $_tk] = 0;
        if (!isset($_atKpi['missing_' . $_tk]))  $_atKpi['missing_' . $_tk]  = 0;
    }
}
