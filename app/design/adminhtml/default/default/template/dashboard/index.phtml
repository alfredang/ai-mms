<?php
// Data prep — only runs when this panel is the active sub-view.
$_cncActive  = ($activeRole === 'admin') && (Mage::app()->getRequest()->getParam('panel') === 'create_class');
$_cncCourses  = array();
$_cncTrainers = array();
if ($_cncActive) {
    $_cncWid = (int) Mage::helper('mmd_rolemanager')->getActiveWebsiteId();
    try {
        $_cncCourses = $read->fetchAll(
            "SELECT e.entity_id, e.sku, v.value AS name
             FROM catalog_product_entity e
             INNER JOIN catalog_product_website pw ON pw.product_id=e.entity_id AND pw.website_id={$_cncWid}
             INNER JOIN catalog_product_entity_varchar v
                ON v.entity_id=e.entity_id AND v.attribute_id=71 AND v.store_id=0
             INNER JOIN catalog_product_entity_int s
                ON s.entity_id=e.entity_id AND s.attribute_id={$statusAid} AND s.store_id=0 AND s.value=1
             WHERE v.value IS NOT NULL AND v.value <> ''
             ORDER BY v.value ASC LIMIT 3000"
        );
    } catch (Exception $e) { Mage::logException($e); }

    // Phase 2 — the trainer picker lists real trainer accounts (admin_user
    // with the 'trainer' role). The chosen account is written to
    // course_runs.trainer_user_id and added to the course's approved pool
    // (mmd_product_trainer) on create — no more EAV option assignment.
    try {
        foreach (Mage::helper('mmd_rolemanager/trainer')->getTrainerAccounts() as $_acc) {
            $_nm = trim((string) $_acc['name']);
            $_cncTrainers[(int) $_acc['user_id']] = ($_nm !== '' ? $_nm : (string) $_acc['email']);
        }
    } catch (Exception $e) { Mage::logException($e); }
}
