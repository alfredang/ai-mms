                                var o = window._cncTrainerOpts[i];
                                if (!q || o.name.toLowerCase().indexOf(q) !== -1) hits.push(o);
                                if (hits.length >= 200) break;
                            }
                            if (!hits.length) {
                                var n = document.createElement('div');
                                n.className = 'cnc-trainer-empty'; n.textContent = 'No matches';
                                box.appendChild(n);
                            } else {
                                hits.forEach(function(m) {
                                    var d = document.createElement('div');
                                    d.className = 'cnc-trainer-row'; d.textContent = m.name;
                                    d.onclick = function() {
                                        inp.value = m.name;
                                        document.getElementById('cnc-trainer-id').value = String(m.id);
                                        box.style.display = 'none';
                                    };
                                    box.appendChild(d);
                                });
                            }
                            box.style.display = '';
                        };
                        document.addEventListener('click', function(e) {
                            var w = document.querySelector('.cnc-trainer-wrap');
                            var b = document.getElementById('cnc-trainer-list');
                            if (w && b && !w.contains(e.target)) b.style.display = 'none';
                        });
                        </script>
                    </div>
                </div>
            </div>
        </div>

        <div class="cnc-actions">
            <button type="button" class="cnc-btn cnc-btn-cancel"
                onclick="window.location.href='<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/dashboard') ?>'">Cancel</button>
            <button type="submit" class="cnc-btn cnc-btn-primary">Create Class</button>
        </div>
