                $initials = strtoupper(substr(trim($tr['title']), 0, 1));
                $hasImg   = !empty($tr['profile_image']);
                // NRIC masking: show last 4 chars, mask the rest
                $nricDisplay = '';
                if ($tnric !== '' && $tnric !== 'N/A') {
                    $nricLen = strlen($tnric);
                    $nricDisplay = ($nricLen > 4) ? str_repeat('*', $nricLen - 4) . substr($tnric, -4) : $tnric;
