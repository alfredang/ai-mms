} catch (Exception $e) {}

// Country / store badges per card. Look up catalog_product_website rows for
// the products on this page so each card can show small SG / NG
// pills indicating which country storefronts carry the course.
// Keyed by product_id → array of website_ids (matches $_devCountryMap).
$_devProductWebsites = array();
$_devWebsiteLabels   = array(
    1 => 'SG', 4 => 'NG',
);
$_devWebsiteFlags    = array(
    1 => '🇸🇬', 4 => '🇳🇬', 7 => '',
);
if (!empty($_devCourses)) {
    try {
        $_pids = array();
        foreach ($_devCourses as $_dc) { $_pids[] = (int) $_dc['id']; }
        if ($_pids) {
            $_pwRead = Mage::getSingleton('core/resource')->getConnection('core_read');
            $_pwTbl2 = $_pwRead->getTableName('catalog_product_website');
            $_pwRows = $_pwRead->fetchAll(
                "SELECT product_id, website_id FROM {$_pwTbl2} WHERE product_id IN (" . implode(',', $_pids) . ")"
            );
            foreach ($_pwRows as $_pwR) {
                $_devProductWebsites[(int) $_pwR['product_id']][] = (int) $_pwR['website_id'];
            }
        }
    } catch (Exception $_pwEx) {}
}

$_devTotalPages = max(1, (int) ceil($_devTotalCount / $_devPageSize));
// "Total Courses" header value. Stable per-tab count, independent of
// search / type / courseware filters.
//
// "All" tab: every course in the catalog (regardless of status). Magento's
// flat-catalog collection bakes in WHERE status=1, so we go to the raw
// catalog_product_entity table to get a true total.
//
// Country tabs: active courses on that country's website (uses the flat
// collection's implicit status filter + addWebsiteFilter).
if ($_devWebsiteId > 0) {
    $_devTotalAll = Mage::getModel('catalog/product')->getCollection()
        ->addAttributeToFilter('status', 1)
        ->addWebsiteFilter($_devWebsiteId)
        ->getSize();
} else {
    $_devTotalAll = (int) Mage::getSingleton('core/resource')
        ->getConnection('core_read')
        ->fetchOne("SELECT COUNT(*) FROM " . Mage::getSingleton('core/resource')->getTableName('catalog_product_entity'));
}
