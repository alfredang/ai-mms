<script type="text/javascript">
window.hspOpenModal = function() {
    var b = document.getElementById('hsp-modal-backdrop');
    var m = document.getElementById('hsp-modal');
    if (b) b.classList.add('open');
    if (m) { m.classList.add('open'); m.setAttribute('aria-hidden', 'false'); }
    var s = document.getElementById('hsp-subject');
    if (s) setTimeout(function(){ try{s.focus();}catch(e){} }, 60);
};
window.hspCloseModal = function() {
    var b = document.getElementById('hsp-modal-backdrop');
    var m = document.getElementById('hsp-modal');
    if (b) b.classList.remove('open');
    if (m) { m.classList.remove('open'); m.setAttribute('aria-hidden', 'true'); }
};
window.hspSubmitTicket = function(ev) {
    if (ev && typeof ev.preventDefault === 'function') ev.preventDefault();
    var s = document.getElementById('hsp-subject');
    var d = document.getElementById('hsp-description');
    if (!s || !s.value.trim()) { if (s) s.focus(); return false; }
    if (!d || !d.value.trim()) { if (d) d.focus(); return false; }
    /* Frontend mock — no backend persistence wired yet. */
    alert('Your ticket has been submitted. Our team will be in touch shortly.');
    var f = document.querySelector('.hsp-modal-form');
    if (f && typeof f.reset === 'function') f.reset();
    hspCloseModal();
    return false;
};
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        var m = document.getElementById('hsp-modal');
        if (m && m.classList.contains('open')) hspCloseModal();
    }
});
</script>
</div>

