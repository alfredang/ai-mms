<div class="crd-toast" id="crd-toast"></div>
<script>
function crdToast(msg, kind) {
    var t = document.getElementById('crd-toast');
    t.textContent = msg;
    t.className = 'crd-toast ' + (kind || 'ok');
    t.style.display = 'block';
    clearTimeout(window._crdToastT);
    window._crdToastT = setTimeout(function(){ t.style.display = 'none'; }, kind === 'err' ? 6000 : 3500);
}
// Quick-fill an SMTP card with the common-case settings for a provider.
// Doesn't touch username / password (those are per-mailbox secrets) — only
// the transport knobs that 99% of relays expect for that provider.
var CRD_SMTP_PRESETS = {
    gmail:       { host: 'smtp.gmail.com',     port: '587', ssl: 'tls', auth: 'login' },
    outlook:     { host: 'smtp.office365.com', port: '587', ssl: 'tls', auth: 'login' },
    // Generic port/SSL presets — leave host alone, user fills it. Covers any
    // SMTP relay (cPanel mailbox, transactional service, third-party host).
    generic_tls: { host: '',                   port: '587', ssl: 'tls', auth: 'login' },
    generic_ssl: { host: '',                   port: '465', ssl: 'ssl', auth: 'login' }
};
function crdSmtpPreset(code, presetKey) {
    var p = CRD_SMTP_PRESETS[presetKey];
    if (!p) return;
    var card = document.querySelector('.crd-smtp-card[data-website="' + code + '"]');
    if (!card) return;
    var set = function(field, value) {
        var el = card.querySelector('[name="smtp_' + code + '_' + field + '"]');
        if (!el) return;
        // Only override host if the preset has one (cPanel ones don't —
        // your host stays as whatever you typed).
        if (field === 'host' && !value && el.value) return;
        el.value = value;
    };
    if (p.host) set('host', p.host);
    set('port', p.port);
    set('ssl',  p.ssl);
    set('auth', p.auth);
    crdToast('Filled ' + presetKey.replace('_', ' ') + ' defaults — enter username + password and Save.', 'ok');
}

// Fire the per-website SMTP test endpoint and render the result inline
// Toggle a per-card SMTP password between hidden (•••) and visible.
// Two cases:
//   1. User is typing a new password → just flip input type. Trivial.
//   2. Field shows masked dots (saved password from a previous Save) →
//      fetch the decrypted value from /maildiagnose/revealsmtp, replace
//      the dots with the real password so the user can copy it. Flip
//      back to "password" + restore the dots when toggled off so the
//      reveal doesn't survive an accidental form submit (the save
//      handler still skips fields that contain a • sentinel).
// Minimal-icon set used by the eye toggle. Stroke icons, currentColor,
// 16px viewBox — same visual language as the other SMTP-card icons.
var CRD_EYE_SVG     = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
var CRD_EYE_OFF_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"/><path d="M10.6 6.1A10 10 0 0112 6c6.5 0 10 7 10 7a16.6 16.6 0 01-3.3 4.1"/><path d="M6.5 7.1A16.6 16.6 0 002 12s3.5 7 10 7a10 10 0 003.8-.7"/><path d="M9.9 9.9a3 3 0 004.2 4.2"/></svg>';
var CRD_SPIN_SVG    = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9" stroke-opacity="0.25"/><path d="M21 12a9 9 0 00-9-9"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.9s" repeatCount="indefinite"/></path></svg>';

// Eye toggle for the partial-mask credential cards (API keys + Google
// OAuth secrets). Sister of crdPwdToggle but talks to /maildiagnose/
// revealcred and works on the masked placeholder ("xxxx••••yyyy"
// pattern) rather than the all-dots SMTP password pattern. Same SVG
// swap + spinner behaviour for visual consistency.
function crdCredToggle(field, btn) {
    var inp = document.getElementById('cred-' + field);
    if (!inp) return;
    var setIcon = function(svg) { btn.innerHTML = svg; };
    var isHidden = inp.dataset.original === '__MASKED__' && inp.value.indexOf('•') !== -1;

    if (isHidden) {
        setIcon(CRD_SPIN_SVG);
        var data = new FormData();
        data.append('field', field);
        data.append('form_key', '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>');
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/maildiagnose/revealcred") ?>', true);
        xhr.onload = function() {
            setIcon(CRD_EYE_SVG);
            if (xhr.status >= 400) {
                crdToast('Reveal HTTP ' + xhr.status + ': ' + xhr.responseText.substring(0, 120), 'err');
                return;
            }
            var r;
            try { r = JSON.parse(xhr.responseText); }
            catch (ex) {
                var snippet = (xhr.responseText || '').replace(/<[^>]+>/g, ' ').trim().substring(0, 140);
                crdToast('Reveal: non-JSON response (HTTP ' + xhr.status + '): ' + (snippet || '(empty)'), 'err');
                return;
            }
            if (r.ok) {
                inp.dataset.maskedPlaceholder = inp.value;
                inp.value = r.value;
                setIcon(CRD_EYE_OFF_SVG);
                btn.title = 'Hide saved value';
            } else {
                crdToast('Could not reveal: ' + (r.error || 'unknown'), 'err');
            }
        };
        xhr.onerror = function() {
            setIcon(CRD_EYE_SVG);
            crdToast('Network error revealing value', 'err');
        };
        xhr.send(data);
    } else {
        setIcon(CRD_EYE_SVG);
        btn.title = 'Show saved value';
        if (inp.dataset.original === '__MASKED__' && inp.dataset.maskedPlaceholder) {
            inp.value = inp.dataset.maskedPlaceholder;
        }
    }
}

function crdPwdToggle(code, btn) {
    var inp  = document.getElementById('smtp-pwd-' + code);
    var icon = btn.querySelector('.crd-pwd-eye-icon');
    if (!inp) return;
    var isHidden = inp.type === 'password';
    var setIcon = function(svg) { btn.innerHTML = svg; icon = btn.firstChild; };

    if (isHidden) {
        // Switching to visible.
        if (inp.dataset.original === '__MASKED__' && inp.value.indexOf('•') !== -1) {
            // Fetch the saved decrypted password from the backend.
            setIcon(CRD_SPIN_SVG);
            var data = new FormData();
            data.append('website', code);
            data.append('form_key', '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>');
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/maildiagnose/revealsmtp") ?>', true);
            xhr.onload = function() {
                setIcon(CRD_EYE_SVG);
                if (xhr.status >= 400) {
                    crdToast('Reveal HTTP ' + xhr.status + ': ' + xhr.responseText.substring(0, 120), 'err');
                    return;
                }
                var r;
                try { r = JSON.parse(xhr.responseText); }
                catch (ex) {
                    var snippet = (xhr.responseText || '').replace(/<[^>]+>/g, ' ').trim().substring(0, 140);
                    crdToast('Reveal: non-JSON response (HTTP ' + xhr.status + '): ' + (snippet || '(empty)'), 'err');
                    console.error('reveal raw response:', xhr.responseText);
                    return;
                }
                if (r.ok) {
                    inp.dataset.maskedPlaceholder = inp.value; // remember to restore
                    inp.value = r.password;
                    inp.type  = 'text';
                    setIcon(CRD_EYE_OFF_SVG);
                    btn.title = 'Hide password';
                } else {
                    crdToast('Could not reveal: ' + (r.error || 'unknown'), 'err');
                }
            };
            xhr.onerror = function() {
                setIcon(CRD_EYE_SVG);
                crdToast('Network error revealing password', 'err');
            };
            xhr.send(data);
        } else {
            // User typed a new value — just flip type.
            inp.type = 'text';
            setIcon(CRD_EYE_OFF_SVG);
            btn.title = 'Hide password';
        }
    } else {
        // Switching back to hidden.
        inp.type = 'password';
        setIcon(CRD_EYE_SVG);
        btn.title = 'Show password';
        if (inp.dataset.original === '__MASKED__' && inp.dataset.maskedPlaceholder) {
            // Restore the masked dots so a stray Save doesn't overwrite the
            // saved password with the just-revealed real password.
            inp.value = inp.dataset.maskedPlaceholder;
        }
    }
}

// Fire the per-website SMTP test endpoint and render the result inline
// under the matching card. Backend builds Zend_Mail_Transport_Smtp from
// the website-scope `smtppro/general/*` rows — same path real order /
// contact-us / OTP / lead-auto-reply mail uses for that country store —
// and returns either "Accepted by host:port" or the SMTP error message.
function crdSmtpTest(code) {
    var input = document.querySelector('.crd-smtp-test-to[data-website="' + code + '"]');
    var btn   = document.querySelector('.crd-smtp-test-btn[data-website="' + code + '"]');
    var out   = document.getElementById('crd-smtp-result-' + code);
    var to    = (input.value || '').trim();
    if (!to || to.indexOf('@') === -1) {
        out.style.display = 'block';
        out.style.color = '#fecaca';
        out.textContent = 'Enter a test recipient email first.';
        return;
    }
    btn.disabled = true;
    btn.textContent = 'Sending…';
    out.style.display = 'block';
    out.style.color = '#94a3b8';
    out.textContent = 'Connecting to SMTP relay…';
    var data = new FormData();
    data.append('website', code);
    data.append('to', to);
    data.append('form_key', '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>');
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/maildiagnose/testsmtp") ?>', true);
    xhr.onload = function() {
        btn.disabled = false;
        btn.textContent = 'Send Test';
        try {
            var r = JSON.parse(xhr.responseText);
            // Minimal inline-SVG icons in JS results so we stay emoji-free.
            var checkSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-2px;margin-right:5px;"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/></svg>';
            var crossSvg = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-2px;margin-right:5px;"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>';
            if (r.ok) {
                out.style.color = '#34d399';
                out.innerHTML = checkSvg + r.message + ' <span style="color:#64748b">(' + r.elapsed_ms + 'ms)</span>';
            } else {
                out.style.color = '#fecaca';
                out.innerHTML = crossSvg + (r.error || 'unknown error');
            }
        } catch (ex) {
            out.style.color = '#fecaca';
            out.textContent = '❌ HTTP ' + xhr.status + ' — bad response';
        }
    };
    xhr.onerror = function() {
        btn.disabled = false;
        btn.textContent = 'Send Test';
        out.style.color = '#fecaca';
        out.textContent = '❌ Network error';
    };
    xhr.send(data);
}
function crdSubmit(e) {
    e.preventDefault();
    var form = document.getElementById('crd-form');
    var data = new FormData();
    // Include both <input> and <select> values; checkboxes only when checked.
    form.querySelectorAll('input, select').forEach(function(inp) {
        if (!inp.name) return;
        // If the field's value is unchanged from the masked placeholder,
        // skip it — server keeps the existing DB row untouched.
        if (inp.dataset.original === '__MASKED__' && inp.value.indexOf('•') !== -1) {
            return;
        }
        if (inp.type === 'checkbox') {
            data.append(inp.name, inp.checked ? '1' : '0');
            return;
        }
        data.append(inp.name, inp.value);
    });
    data.append('form_key', '<?php echo Mage::getSingleton('core/session')->getFormKey() ?>');
    var xhr = new XMLHttpRequest();
    xhr.open('POST', '<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/maildiagnose/savecreds") ?>', true);
    xhr.onload = function() {
        try {
            var r = JSON.parse(xhr.responseText);
            if (r.ok) {
                crdToast('Credentials saved.', 'ok');
                setTimeout(function(){ window.location.reload(); }, 800);
            } else {
                crdToast('Error: ' + (r.error || 'unknown'), 'err');
            }
        } catch (ex) {
            crdToast('Save failed (' + xhr.status + ')', 'err');
        }
    };
    xhr.send(data);
    return false;
}
</script>
