                    Add Topic
                </button>
                <script>
                (function(){
                    // Seed topics. Prefer the canonical JSON marker we wrote on
                    // the previous save (lossless round-trip of subsec / text /
                    // typed links), falling back to the legacy <strong> parser
                    // for courses last edited before the visual editor learned
                    // to persist itself.
                    var topics = <?php
                        $_loRaw = (string)$_editCourseData['learning_outcomes'];
                        $_seed = array();
                        if (preg_match('/<!--\s*LSN_DATA:\s*(\[.*?\])\s*-->/s', $_loRaw, $_lj)) {
                            $_decoded = json_decode($_lj[1], true);
                            if (is_array($_decoded)) {
                                $_seed = $_decoded;
                            }
                        }
                        if (empty($_seed) && $_loRaw !== ''
                            && preg_match('#<strong>\s*(?:LU|Lesson|Topic|Module)\s*\d+#i', $_loRaw)) {
                            // Split on each LU heading so the T#: … lines
                            // listed under it (legacy Course-Topics HTML)
                            // seed as Section rows, not just the LU title.
                            $_sdParts = preg_split(
                                '#<strong>\s*((?:LU|Lesson|Topic|Module)\s*\d+[^<]*?)\s*</strong>#i',
                                $_loRaw, -1, PREG_SPLIT_DELIM_CAPTURE
                            );
                            for ($_sdPi = 1; $_sdPi < count($_sdParts); $_sdPi += 2) {
                                $_sdT = trim(html_entity_decode($_sdParts[$_sdPi]), " :\t\n\r\0\x0B");
                                if ($_sdT === '') continue;
                                $_sdBody = isset($_sdParts[$_sdPi + 1]) ? $_sdParts[$_sdPi + 1] : '';
                                $_sdSubs = array();
                                if (preg_match_all('#<em>(.*?)</em>#is', $_sdBody, $_sdEm)) {
                                    foreach ($_sdEm[1] as $_st) {
                                        $_st = trim(html_entity_decode(strip_tags($_st)), " :\t\n\r\0\x0B");
                                        if ($_st !== '') $_sdSubs[] = $_st;
                                    }
                                } else {
                                    foreach (preg_split('#</?(?:p|li|br|div)[^>]*>#i', $_sdBody) as $_ln) {
                                        $_ln = trim(html_entity_decode(strip_tags($_ln)), " :\t\n\r\0\x0B");
                                        if ($_ln !== '') $_sdSubs[] = $_ln;
                                    }
                                }
                                $_seed[] = array(
                                    'title'   => $_sdT,
                                    'subsecs' => $_sdSubs,
                                    'links'   => array(),
                                );
                            }
                        }
                        echo json_encode($_seed);
                    ?>;

                    function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
                    function syncJson(){ document.getElementById('lsn-topics-json').value = JSON.stringify(topics); }

                    // Normalize seed before rendering. The data model evolved
                    // in three stages:
                    //   v1: { title, subsec: '<string>', links: [...] }
                    //   v2: { title, subsecs: ['<string>', ...], links: [...] }
                    //   v3: { title, subsecs: [{title, links: []}, ...] }
                    // Migrate v1/v2 into v3 so render() only deals with one
                    // shape. Old topic-level `links` get attached to the
                    // first subsec so the user doesn't lose them.
                    topics.forEach(function(t){
                        if (!Array.isArray(t.subsecs)) {
                            t.subsecs = (t.subsec && String(t.subsec).trim() !== '') ? [t.subsec] : [''];
                        }
                        delete t.subsec;
                        t.subsecs = t.subsecs.map(function(s){
                            if (s && typeof s === 'object' && !Array.isArray(s)) {
                                return {
                                    title: String(s.title || ''),
                                    links: Array.isArray(s.links) ? s.links : [],
                                };
                            }
                            return { title: String(s || ''), links: [] };
                        });
                        if (t.subsecs.length === 0) t.subsecs.push({ title: '', links: [] });
                        // Migrate any pre-existing topic-level links into the
                        // first subsec, then drop the field.
                        if (Array.isArray(t.links) && t.links.length) {
                            t.subsecs[0].links = (t.subsecs[0].links || []).concat(t.links);
                        }
                        delete t.links;
                    });

                    function render(){
                        var wrap = document.getElementById('lsn-topics');
                        wrap.innerHTML = '';
                        topics.forEach(function(t, ti){
                            var box = document.createElement('div');
                            box.className = 'lsn-topic' + (t._open ? ' open' : '');
                            var subsecsHtml = (t.subsecs || []).map(function(s, si){
                                var linksHtml = (s.links || []).map(function(l, li){
                                    var cls = 'lsn-tag-' + (l.type || 'web').toLowerCase();
                                    var tag = (l.type || 'web').toUpperCase();
                                    return '<div class="lsn-link">' +
                                        '<div class="lsn-link-drag"><span></span><span></span><span></span></div>' +
                                        '<span class="lsn-tag ' + cls + '">' + tag + '</span>' +
                                        '<input type="text" class="lsn-link-title" value="' + esc(l.title) + '" placeholder="Title" onchange="lsnEditLink(' + ti + ',' + si + ',' + li + ',\'title\',this.value)" />' +
                                        '<input type="text" class="lsn-link-url" value="' + esc(l.url) + '" placeholder="URL" onchange="lsnEditLink(' + ti + ',' + si + ',' + li + ',\'url\',this.value)" />' +
                                        '<button type="button" class="lsn-link-del" onclick="lsnDeleteLink(' + ti + ',' + si + ',' + li + ')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>' +
                                    '</div>';
                                }).join('');
                                return '<div class="lsn-subsec-block">' +
                                    '<div class="lsn-subsec">' +
                                        '<div class="lsn-subsec-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>' +
                                        '<input type="text" class="lsn-subsec-title" value="' + esc(s.title) + '" placeholder="Section name" onchange="lsnEditSubsec(' + ti + ',' + si + ',this.value)" />' +
                                        ((t.subsecs || []).length > 1
                                            ? '<button type="button" class="lsn-subsec-del" onclick="lsnDeleteSubsec(' + ti + ',' + si + ')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg></button>'
                                            : '') +
                                    '</div>' +
                                    linksHtml +
                                    '<div class="lsn-add-row">' +
                                        '<button type="button" onclick="lsnAddLink(' + ti + ',' + si + ',\'web\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Web</button>' +
                                        '<button type="button" onclick="lsnAddLink(' + ti + ',' + si + ',\'doc\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Document</button>' +
                                        '<button type="button" onclick="lsnAddLink(' + ti + ',' + si + ',\'yt\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> YouTube</button>' +
                                        '<button type="button" onclick="lsnAddLink(' + ti + ',' + si + ',\'act\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Activity</button>' +
                                        '<button type="button" onclick="lsnAddLink(' + ti + ',' + si + ',\'qz\')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Quiz</button>' +
                                    '</div>' +
                                '</div>';
                            }).join('');
                            box.innerHTML =
                                '<div class="lsn-topic-head">' +
                                    '<div class="lsn-topic-drag"><span></span><span></span><span></span></div>' +
                                    '<input type="text" class="lsn-topic-title" value="' + esc(t.title) + '" onchange="lsnEditTopic(' + ti + ',\'title\',this.value)" />' +
                                    '<button type="button" class="lsn-topic-btn" onclick="lsnToggleTopic(' + ti + ')" style="background:transparent !important;background-image:none !important;border:1px solid #475569 !important;border-radius:5px !important;width:28px !important;height:28px !important;padding:0 !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;box-shadow:none !important;text-shadow:none !important;cursor:pointer;"><svg class="lsn-caret-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display:block"><polyline points="6 9 12 15 18 9"/></svg></button>' +
                                    '<button type="button" class="lsn-topic-btn lsn-del" onclick="lsnDeleteTopic(' + ti + ')" style="background:transparent !important;background-image:none !important;border:1px solid #f87171 !important;border-radius:5px !important;width:28px !important;height:28px !important;padding:0 !important;display:inline-flex !important;align-items:center !important;justify-content:center !important;color:#f87171 !important;box-shadow:none !important;text-shadow:none !important;cursor:pointer;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:block"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M10 11v6M14 11v6"/></svg></button>' +
                                '</div>' +
                                '<div class="lsn-topic-body">' +
                                    subsecsHtml +
                                    '<button type="button" class="lsn-add-subsec" onclick="lsnAddSubsec(' + ti + ')"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Section name</button>' +
                                '</div>';
                            wrap.appendChild(box);
                        });
                        syncJson();
                    }

                    window.lsnAddTopic = function(){
                        topics.push({ title: 'Topic ' + (topics.length + 1) + ': New Topic', subsecs: [{ title: '', links: [] }], _open: true });
                        render();
                    };

                    /* Drag-and-drop reordering of topic cards.
                       Event-delegated on the #lsn-topics container so we
                       wire it up exactly once and don't re-attach handlers
                       on every render. Only the hamburger handle starts a
                       drag — clicks inside text inputs / buttons don't. */
                    (function attachTopicDragDrop(){
                        var wrap = document.getElementById('lsn-topics');
                        if (!wrap || wrap._dragWired) return;
                        wrap._dragWired = true;

                        wrap.addEventListener('mousedown', function (e) {
                            var handle = e.target.closest && e.target.closest('.lsn-topic-drag');
                            if (!handle) return;
                            var topic = handle.closest('.lsn-topic');
                            if (topic) topic.setAttribute('draggable', 'true');
                        });
                        wrap.addEventListener('mouseup', function () {
                            wrap.querySelectorAll('.lsn-topic[draggable="true"]').forEach(function (t) {
                                t.removeAttribute('draggable');
                            });
                        });

                        function indexOfTopic(el) {
                            var children = Array.prototype.slice.call(wrap.children);
                            return children.indexOf(el);
                        }

                        wrap.addEventListener('dragstart', function (e) {
                            var topic = e.target.closest && e.target.closest('.lsn-topic');
                            if (!topic || topic.getAttribute('draggable') !== 'true') return;
                            var fromIdx = indexOfTopic(topic);
                            if (fromIdx < 0) return;
                            e.dataTransfer.setData('text/plain', String(fromIdx));
                            e.dataTransfer.effectAllowed = 'move';
                            topic.classList.add('lsn-topic-dragging');
                        });
                        wrap.addEventListener('dragend', function (e) {
                            var topic = e.target.closest && e.target.closest('.lsn-topic');
                            if (topic) topic.classList.remove('lsn-topic-dragging');
                            wrap.querySelectorAll('.lsn-topic-drop-target').forEach(function (t) {
                                t.classList.remove('lsn-topic-drop-target');
                            });
                            wrap.querySelectorAll('.lsn-topic[draggable="true"]').forEach(function (t) {
                                t.removeAttribute('draggable');
                            });
                        });
                        wrap.addEventListener('dragover', function (e) {
                            e.preventDefault();
                            e.dataTransfer.dropEffect = 'move';
                            var topic = e.target.closest && e.target.closest('.lsn-topic');
                            wrap.querySelectorAll('.lsn-topic-drop-target').forEach(function (t) {
                                if (t !== topic) t.classList.remove('lsn-topic-drop-target');
                            });
                            if (topic && !topic.classList.contains('lsn-topic-dragging')) {
                                topic.classList.add('lsn-topic-drop-target');
                            }
                        });
                        wrap.addEventListener('drop', function (e) {
                            e.preventDefault();
                            var target = e.target.closest && e.target.closest('.lsn-topic');
                            if (!target) return;
                            var fromIdx = parseInt(e.dataTransfer.getData('text/plain'), 10);
                            var toIdx = indexOfTopic(target);
                            wrap.querySelectorAll('.lsn-topic-drop-target').forEach(function (t) {
                                t.classList.remove('lsn-topic-drop-target');
                            });
                            if (isNaN(fromIdx) || fromIdx === toIdx || fromIdx < 0 || toIdx < 0) return;
                            var moved = topics.splice(fromIdx, 1)[0];
                            topics.splice(toIdx, 0, moved);
                            render();
                        });
                    })();
                    window.lsnAddSubsec = function(ti){
                        topics[ti].subsecs = topics[ti].subsecs || [];
                        topics[ti].subsecs.push({ title: '', links: [] });
                        render();
                    };
                    window.lsnDeleteSubsec = function(ti, si){
                        topics[ti].subsecs.splice(si, 1);
                        if (topics[ti].subsecs.length === 0) topics[ti].subsecs = [{ title: '', links: [] }];
                        render();
                    };
                    window.lsnEditSubsec = function(ti, si, val){
                        topics[ti].subsecs[si].title = val;
                        syncJson();
                    };
                    window.lsnDeleteTopic = function(ti){
                        topics.splice(ti, 1);
                        render();
                    };
                    window.lsnToggleTopic = function(ti){
                        topics[ti]._open = !topics[ti]._open;
                        render();
                    };
                    // Bulk open/close. Writes the flag into the canonical
                    // topics[] state (not just DOM classes) so subsequent
                    // edits / adds / deletes don't lose the expanded state
                    // when render() rebuilds the cards from the array.
                    window.lsnSetAllOpen = function(open){
                        for (var i = 0; i < topics.length; i++) topics[i]._open = !!open;
                        render();
                    };
                    window.lsnEditTopic = function(ti, field, val){
                        topics[ti][field] = val;
                        syncJson();
                    };
                    window.lsnAddLink = function(ti, si, type){
                        var s = topics[ti].subsecs[si];
                        s.links = s.links || [];
                        s.links.push({ type: type, title: '', url: '' });
                        render();
                    };
                    window.lsnDeleteLink = function(ti, si, li){
                        topics[ti].subsecs[si].links.splice(li, 1);
                        render();
                    };
                    window.lsnEditLink = function(ti, si, li, field, val){
                        topics[ti].subsecs[si].links[li][field] = val;
                        syncJson();
                    };

                    // Persistence: serialise topics into the description field
                    // before the form submits. The HTML body stays human-readable
                    // (so anyone editing description directly still sees the
                    // structure), and a hidden JSON comment lets us round-trip
                    // exactly on next load.
                    function serializeTopicsToHtml() {
                        var typeLabels = { web:'Web', doc:'Document', yt:'YouTube', act:'Activity', qz:'Quiz' };
                        // Strip transient fields (_open) before persisting.
                        // Each subsection now carries its own links.
                        var clean = topics.map(function(t){
                            return {
                                title:   t.title || '',
                                subsecs: (t.subsecs || []).map(function(s){
                                    return {
                                        title: String((s && s.title) || ''),
                                        links: ((s && s.links) || []).map(function(l){
                                            return { type: l.type || 'web', title: l.title || '', url: l.url || '' };
                                        }),
                                    };
                                }).filter(function(s){
                                    // Drop fully-empty subsecs to keep the saved
                                    // doc tidy, but keep ones that have either a
                                    // title or any link.
                                    return s.title !== '' || s.links.length > 0;
                                }),
                            };
                        });
                        var marker = '<!-- LSN_DATA: ' + JSON.stringify(clean).replace(/-->/g, '--&gt;') + ' -->';
                        var html = marker + '\n';
                        clean.forEach(function(t){
                            html += '<p><strong>' + esc(t.title || 'Topic') + '</strong></p>\n';
                            t.subsecs.forEach(function(s){
                                if (s.title) html += '<p><em>' + esc(s.title) + '</em></p>\n';
                                if (s.links.length) {
                                    html += '<ul>\n';
                                    s.links.forEach(function(l){
                                        var lbl = typeLabels[l.type] || (l.type || '').toUpperCase();
                                        var titleText = l.title || l.url || '';
                                        if (l.url) {
                                            html += '  <li><a href="' + esc(l.url) + '" target="_blank" rel="noopener">'
                                                  + esc(titleText) + '</a> <em>[' + lbl + ']</em></li>\n';
                                        } else {
                                            html += '  <li>' + esc(titleText) + ' <em>[' + lbl + ']</em></li>\n';
                                        }
                                    });
                                    html += '</ul>\n';
                                }
                            });
                        });
                        return html;
                    }

                    var dcfForm = document.getElementById('dcf-form');
                    if (dcfForm) {
                        // Empty topics list means the user cleared the editor;
                        // leave whatever they typed in the description textarea
                        // alone instead of blanking it.
                        function flushTopicsToTextarea(){
                            if (!topics.length) return;
                            var ta = dcfForm.querySelector('textarea[name="learning_outcomes"]');
                            if (!ta) return;
                            // If the user has typed inside the Quill / contenteditable
                            // surface for this field (course-topics-tools.js sets
                            // data-ct-edited on user input), their edits win — leave
                            // whatever they wrote alone instead of serialising the
                            // legacy topic cards on top of it.
                            if (ta.getAttribute('data-ct-edited') === '1') return;
                            ta.value = serializeTopicsToHtml();
                        }

                        // Three paths cover every way this form can submit:
                        //
                        // 1. Native submit event — fires for the type=submit
                        //    "Save Changes" button and for Enter-in-a-field.
                        dcfForm.addEventListener('submit', flushTopicsToTextarea, false);
                        // 2. Programmatic form.submit() — used by the
                        //    "Save & Continue" button. By HTML spec this does
                        //    NOT dispatch the submit event, so we shadow the
                        //    prototype method on this instance.
                        try {
                            var nativeSubmit = HTMLFormElement.prototype.submit.bind(dcfForm);
                            dcfForm.submit = function(){
                                flushTopicsToTextarea();
                                return nativeSubmit();
                            };
                        } catch (e) { /* some browsers refuse the override */ }
                        // 3. Belt-and-suspenders — attach capture-phase click
                        //    listeners directly on every save button so even
                        //    if the prototype shadow above silently fails,
                        //    serialization still runs before the click's own
                        //    inline-onclick handler fires.
                        var saveBtns = document.querySelectorAll(
                            '.dcf-btn-save, .dcf-btn-save-cont, button[type="submit"].dcf-btn'
                        );
                        saveBtns.forEach(function(btn){
                            btn.addEventListener('click', flushTopicsToTextarea, true);
                        });
                    }

                    render();
                })();
                </script>
