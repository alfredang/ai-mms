/**
 * Map a proposal row to its pipeline stage: [index 0-5, label, css-key].
 * Designed → Approval sent → Approved → Scheduled → Waiting → Blasted.
 */
$_mnStage = function ($row) {
    $rs = (string) $row['review_status'];
    $st = (string) $row['status'];
    $mlId = trim((string) $row['mailerlite_id']);
    $decisions = json_decode((string) $row['review_decisions'], true);
    $appr = 0;
    if (is_array($decisions)) { foreach ($decisions as $d) { if ($d === 'approve') $appr++; } }
    if ($st === 'sent')                      return array(4, 'Blasted', 'done');
    // "Scheduled" = booked into MailerLite. Detect via mailerlite_id (the
    // reliable signal) — the legacy status enum has no 'scheduled' value so the
    // status write lands as '' and can't be trusted here.
    if ($mlId !== '' || $st === 'scheduled') {
        $future = $row['scheduled_send_at'] && strtotime($row['scheduled_send_at']) > time();
        return $future
            ? array(3, 'Scheduled &middot; ' . date('D j M, g:ia', strtotime($row['scheduled_send_at'])), 'sched')
            : array(3, 'Scheduled', 'sched');
    }
    if ($rs === 'approved')                  return array(2, 'Approved', 'ok');
    if ($rs === 'changes_requested')         return array(1, 'Changes requested', 'changes');
    if ($rs === 'expired')                   return array(0, 'Expired', 'muted');
    if ($rs === 'pending')                   return array(1, 'Pending approval', 'pending');
    return array(0, 'Design', 'muted');
};
