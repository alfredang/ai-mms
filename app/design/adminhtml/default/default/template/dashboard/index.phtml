        var el=document.getElementById('at-autoinv-status'); if(!el) return;
        el.textContent='✓ '+msg; el.style.color= ok?'#22c55e':'#f87171';
        setTimeout(function(){ if(el && el.textContent==='✓ '+msg) el.textContent=''; }, 2500);
    };
    window.atAutoInvSet = function(cb){
        var val = cb.checked ? 1 : 0;
        cb.checked = (val === 0); // hold until the server confirms
        if (val === 1 && !confirm('Enable automated trainer invitation emails?\n\nThe cron will email the next eligible trainer for upcoming classes twice a week.')) return;
        cb.disabled = true;
        var fd = new FormData(); fd.append('value', val); fd.append('form_key', window.FORM_KEY || '');
        fetch('<?php echo $_aiToggleUrl ?>', {method:'POST',body:fd,credentials:'same-origin'})
          .then(function(r){return r.json();}).then(function(d){
