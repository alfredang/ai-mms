                $temail   = htmlspecialchars($tr['email'] ?: '');
                $tphone   = htmlspecialchars(isset($tr['telephone']) ? trim($tr['telephone']) : '');
                $tnric    = htmlspecialchars(isset($tr['nric']) ? trim($tr['nric']) : '');
                $ttype    = isset($tr['trainer_type']) ? trim($tr['trainer_type']) : '';
                $tgender  = isset($tr['gender']) ? trim($tr['gender']) : '';
                $tlinked  = isset($tr['linkedin_url']) ? trim($tr['linkedin_url']) : (isset($tr['linkedin']) ? trim($tr['linkedin']) : '');
