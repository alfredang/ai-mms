<script type="text/javascript">
window.__trnAddUrl   = <?php echo json_encode($trnAddUrl) ?>;
window.__trnEditUrl   = <?php echo json_encode($trnEditUrl) ?>;
window.__trnToggleUrl = <?php echo json_encode($trnToggleUrl) ?>;
window.__trnDeleteUrl = <?php echo json_encode($trnDeleteUrl) ?>;
window.__trnBulkUrl   = <?php echo json_encode($trnBulkUrl) ?>;
window.__trnFormKey  = <?php echo json_encode($_adminFormKey) ?>;

// Only Full Name is required (both Add and Edit modes). All other
// fields are now optional at every layer — HTML attribute, JS check,
// and server-side validation (see TrainerController::add/editAction).
// Kept as a no-op for compatibility with old callers that may still
// invoke window._trnSetRequiredForMode(...).
window._trnSetRequiredForMode = function(_isEdit) { /* no-op */ };

window.trnOpenAddModal = function() {
    // Reset to "Add" mode and clear all fields
    window._trnEditId = 0;
    var ov = document.getElementById('trnAddOverlay');
    if (!ov) return;
    var title = ov.querySelector('h2');
    if (title) title.textContent = 'Add New Trainer';
    var btn = document.getElementById('trnAddBtn');
    if (btn) { btn.textContent = 'Add Trainer'; btn.removeAttribute('data-mode'); }
    // Clear all inputs
    var ids = ['trnEmail','trnName','trnTel','trnLinkedin','trnDescription','trnAreaExpertise'];
    for (var i=0; i<ids.length; i++) { var el = document.getElementById(ids[i]); if (el) el.value = ''; }
    document.getElementById('trnPwd').value = 'Tertiary888';
    // Reset dropdowns to first option
    var sels = ['trnType','trnStatus','trnGender'];
    for (var j=0; j<sels.length; j++) { var s = document.getElementById(sels[j]); if (s) s.selectedIndex = 0; }
    // Clear any error message
    var msg = document.getElementById('trnAddMsg');
    if (msg) { msg.style.display = 'none'; msg.textContent = ''; }
    window._trnSetRequiredForMode(false); // Add mode — restore required
    ov.style.display = 'flex';
};
window.trnCloseAddModal = function() {
    var ov = document.getElementById('trnAddOverlay');
    if (ov) ov.style.display = 'none';
    var msg = document.getElementById('trnAddMsg');
    if (msg) { msg.style.display = 'none'; msg.textContent = ''; }
};
// Snapshot the current search / filter / page state so the next
// window.location.reload() can restore them. Used by edit-save, delete,
// and toggle-status — anything that mutates the grid and reloads it.
// trnRestoreState (in the init IIFE near the bottom of this file) is
// the consumer; it removes the key after reading.
window._trnSnapshotStateBeforeReload = function() {
    try {
        var snap = {
            search   : (document.getElementById('trnSearch')         || {}).value || '',
            type     : (document.getElementById('trnFilterType')     || {}).value || '',
            status   : (document.getElementById('trnFilterStatus')   || {}).value || '',
            linkedin : (document.getElementById('trnFilterLinkedIn') || {}).value || '',
            page     : window._trnPage || 1
        };
        sessionStorage.setItem('_trnRestoreState', JSON.stringify(snap));
    } catch (e) { /* sessionStorage disabled — silent */ }
};

// ---- Toggle trainer status (Deactivate / Activate) ----
window.trnToggleStatus = function(id, name, currentActive) {
    var action = currentActive ? 'deactivate' : 'activate';
    if (!confirm('Are you sure you want to ' + action + ' "' + name + '"?')) return;

    var fd = new FormData();
    fd.append('trainer_id', id);
    fd.append('form_key', window.__trnFormKey);

    fetch(window.__trnToggleUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(data){
            if (data.success) {
                window._trnSnapshotStateBeforeReload();
                window.location.reload();
            } else {
                alert(data.message || 'Failed to ' + action + ' trainer');
            }
        })
