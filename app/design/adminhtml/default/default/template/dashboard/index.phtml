                <script>
                /* Direct-upload helper for the Image URL Link field. Posts the
                   selected file to adminhtml/courseimage/upload, then writes
                   the returned media URL into the text input and updates the
                   preview. The Save Changes flow remains unchanged — the URL
                   is still persisted via the same `image_url` form field. */
                (function () {
                    var fileInput   = document.getElementById('dcf-image-file');
                    var btn         = document.getElementById('dcf-image-upload-btn');
                    var urlInput    = document.getElementById('dcf-image-url');
                    var preview     = document.getElementById('dcf-image-preview');
                    var previewWrap = document.getElementById('dcf-image-preview-wrap');
                    var msg         = document.getElementById('dcf-image-upload-msg');
                    var lbl         = document.getElementById('dcf-image-upload-lbl');
                    if (!fileInput || !btn || !urlInput) return;

                    var uploadUrl = <?php echo json_encode(Mage::helper('adminhtml')->getUrl('adminhtml/courseimage/upload')) ?>;

                    function showMsg(text, color) {
                        msg.style.display = 'block';
                        msg.style.color = color || '#94a3b8';
                        msg.textContent = text;
                    }
                    function refreshPreview() {
                        if (!preview || !previewWrap) return;
                        var v = (urlInput.value || '').trim();
                        if (!v) { previewWrap.style.display = 'none'; return; }
                        preview.src = v;
                        previewWrap.style.display = '';
                    }
                    urlInput.addEventListener('input', refreshPreview);

                    btn.addEventListener('click', function () { fileInput.click(); });

                    fileInput.addEventListener('change', function () {
                        var f = fileInput.files && fileInput.files[0];
                        if (!f) return;
                        if (!/^image\/(jpe?g|png|gif|webp)$/i.test(f.type)) {
                            showMsg('Only JPG / PNG / GIF / WebP images are accepted.', '#fb7185');
                            fileInput.value = '';
                            return;
                        }
                        var fd = new FormData();
                        fd.append('image', f);
                        fd.append('form_key', (window.FORM_KEY || ''));
                        btn.disabled = true;
                        lbl.textContent = 'Uploading…';
                        showMsg('Uploading ' + f.name + '…');
                        fetch(uploadUrl, {
                            method: 'POST',
                            body: fd,
                            credentials: 'same-origin'
                        }).then(function (r) { return r.json(); })
                          .then(function (data) {
                            if (data && data.success && data.url) {
                                urlInput.value = data.url;
                                refreshPreview();
                                showMsg('Uploaded. Click Save Changes to persist.', '#34d399');
                            } else {
                                showMsg('Upload failed: ' + (data && data.message ? data.message : 'unknown error'), '#fb7185');
                            }
                          })
                          .catch(function (err) {
                            showMsg('Upload error: ' + err.message, '#fb7185');
                          })
                          .then(function () {
                            btn.disabled = false;
                            lbl.textContent = 'Upload';
                            fileInput.value = '';
                          });
                    });
                })();

                /* MMD_CourseImage — AI Generate cover.
                   Posts course_id to /tigerdragon/coursecover/generate, drops
                   the returned R2 URL into the Image URL Link field, and
                   refreshes the preview. The URL is NOT persisted until the
                   admin clicks Save Changes (which routes through
                   CoursesaveController -> course_image_url attribute). */
                (function () {
                    var aiBtn   = document.getElementById('dcf-image-aigen-btn');
                    var aiLbl   = document.getElementById('dcf-image-aigen-lbl');
                    var urlIn   = document.getElementById('dcf-image-url');
                    var preview = document.getElementById('dcf-image-preview');
                    var prevWrap = document.getElementById('dcf-image-preview-wrap');
                    var msg     = document.getElementById('dcf-image-upload-msg');
                    if (!aiBtn || !urlIn) return;

                    var courseId = <?php echo (int) ($_selectedCourse['id'] ?? 0) ?>;
                    var generateUrl = <?php echo json_encode(Mage::helper('adminhtml')->getUrl('adminhtml/coursecover/generate')) ?>;

                    function showMsg(text, color) {
                        if (!msg) return;
                        msg.style.display = 'block';
                        msg.style.color = color || '#94a3b8';
                        msg.textContent = text;
                    }

                    aiBtn.addEventListener('click', function () {
                        if (!courseId) {
                            showMsg('No course loaded — open a course in edit mode first.', '#fb7185');
                            return;
                        }
                        aiBtn.disabled = true;
                        aiLbl.textContent = 'Generating…';
                        showMsg('Rendering cover and uploading to R2…');

                        var fd = new FormData();
                        fd.append('course_id', String(courseId));
                        fd.append('form_key', (window.FORM_KEY || ''));
                        var badgeBoxes = document.querySelectorAll('.dcf-aigen-badge:checked');
                        for (var i = 0; i < badgeBoxes.length; i++) {
                            fd.append('badges[]', badgeBoxes[i].value);
                        }

                        fetch(generateUrl, {
                            method: 'POST',
                            body: fd,
                            credentials: 'same-origin'
                        }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                          .then(function (resp) {
                            if (resp.data && resp.data.ok && resp.data.url) {
                                urlIn.value = resp.data.url;
                                if (preview && prevWrap) {
                                    preview.src = resp.data.url;
                                    prevWrap.style.display = '';
                                }
                                showMsg('Generated ' + (resp.data.wsq ? '(with WSQ badge)' : '') + ' — click Save Changes to persist.', '#34d399');
                            } else {
                                showMsg('Generate failed: ' + ((resp.data && resp.data.error) || 'unknown error'), '#fb7185');
                            }
                          })
                          .catch(function (err) {
                            showMsg('Network error: ' + err.message, '#fb7185');
                          })
                          .then(function () {
                            aiBtn.disabled = false;
                            aiLbl.textContent = 'AI Generate';
                          });
                    });
                })();
                </script>
