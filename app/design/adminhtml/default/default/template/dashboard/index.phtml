        fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/searchCourses') ?>?wsq=1&q=' + encodeURIComponent(q), { credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
              box.innerHTML = '';
              if (!j || !j.success || !j.courses || !j.courses.length) {
                  var n = document.createElement('div');
                  n.className = 'mn-result-empty';
                  n.textContent = 'No WSQ matches.';
                  box.appendChild(n);
                  return;
              }
              j.courses.forEach(function (c) {
                  var d = document.createElement('div');
                  d.className = 'mn-result';
                  d.textContent = c.sku + ' — ' + c.name;
                  d.onclick = function () { mnFlyerQueueAdd(c.id); inp.value = ''; box.innerHTML = ''; };
                  box.appendChild(d);
              });
          });
    }, 200);
};
window.mnAddPid = function(id, sku, name) {
    id = parseInt(id, 10);
    if (!id || window._mnState.pids.indexOf(id) >= 0) return;
    window._mnState.pids.push(id);
    window._mnState.pidNames[id] = sku + ' — ' + name;
    mnRenderPids();
    mnRefreshPreview();
};
window.mnRemovePid = function(id) {
    id = parseInt(id, 10);
    var i = window._mnState.pids.indexOf(id);
    if (i >= 0) window._mnState.pids.splice(i, 1);
    delete window._mnState.pidNames[id];
    mnRenderPids();
    mnRefreshPreview();
};
window.mnRenderPids = function() {
    var box = document.getElementById('mn-pids');
    box.innerHTML = '';
    window._mnState.pids.forEach(function (id) {
        var c = document.createElement('span');
        c.className = 'mn-pid-chip';
        c.textContent = window._mnState.pidNames[id] || ('#' + id);
        var x = document.createElement('button');
        x.type = 'button';
        x.textContent = '×';
        x.onclick = function () { mnRemovePid(id); };
        c.appendChild(x);
        box.appendChild(c);
    });
};

// --- Next-flyer queue -------------------------------------------------
// Server-backed list (mmd_marketing_flyer_queue): add from the WSQ search,
// drag ⋮⋮ to reorder, × to remove, 👁 to preview. Cron_Flyer::propose()
// consumes the TOP row each Mon/Thu.
// 13-14px stroke SVGs for the canonical .mmd-grid-action row-action icons.
var MN_SVG = {
    run:  '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>',
    eye:  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
    close:'<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
};
window._mnQueue = [];
window.mnFlyerQueueLoad = function() {
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueList') ?>', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        window._mnQueue = (j && j.success && j.queue) ? j.queue : [];
        mnFlyerQueueRender();
        mnRefreshPreview();
    });
};
window.mnFlyerQueueRender = function() {
    var tb = document.getElementById('mn-queue-list');
    if (!tb) return;
    tb.innerHTML = '';
    if (!window._mnQueue.length) {
        tb.innerHTML = '<tr><td colspan="7" class="mm-table-empty">Queue is empty — search above to add WSQ courses. The pipeline falls back to a popular upcoming class.</td></tr>';
        return;
    }
    window._mnQueue.forEach(function (row, idx) {
        var tr = document.createElement('tr');
        tr.setAttribute('draggable', 'true');
        tr.setAttribute('data-qid', row.queue_id);
        tr.className = 'mn-fq-row';
        var fee = row.fee ? 'S$' + Math.round(parseFloat(row.fee)).toLocaleString() : '—';
        tr.innerHTML =
            '<td class="mn-fq-grip" title="Drag to reorder">&#8942;&#8942;</td>' +
            '<td class="muted">' + (idx + 1) + '</td>' +
            '<td class="strong"></td>' +
            '<td class="muted" style="font-family:ui-monospace,Menlo,monospace;"></td>' +
            '<td class="num"></td>' +
            '<td class="muted"></td>' +
            '<td class="center"></td>';
        tr.children[2].textContent = row.name || ('#' + row.product_id);
        tr.children[3].textContent = row.sku || '';
        tr.children[4].textContent = fee;
        tr.children[5].textContent = row.funding_validity || '—';
        // Canonical 26x26 ghost row-action icons (backend-design: .mmd-grid-action).
        var act = tr.children[6];
        var wrap = document.createElement('div'); wrap.className = 'mmd-grid-actions';
        var mkAct = function (kind, title, svg, handler) {
            var a = document.createElement('button');
            a.type = 'button'; a.className = 'mmd-grid-action mmd-grid-action--' + kind; a.title = title;
            a.innerHTML = svg; a.onclick = handler; return a;
        };
        wrap.appendChild(mkAct('check', 'Run Now — design this flyer + send for approval', MN_SVG.run,
            function () { mnFlyerQueueRun(row.queue_id, row.product_id, row.name || row.sku); }));
        wrap.appendChild(mkAct('view', 'Preview flyer', MN_SVG.eye,
            function () { mnPreviewCourse(row.product_id, (row.sku || '') + ' — ' + (row.name || '')); }));
        wrap.appendChild(mkAct('delete', 'Remove from queue', MN_SVG.close,
            function () { mnFlyerQueueRemove(row.queue_id, row.name); }));
        act.appendChild(wrap);
        // drag-and-drop reorder
        tr.addEventListener('dragstart', function (e) {
            window._mnDragQid = row.queue_id;
            tr.classList.add('mn-fq-dragging');
            if (e.dataTransfer) { e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', String(row.queue_id)); } catch (x) {} }
        });
        tr.addEventListener('dragend', function () { tr.classList.remove('mn-fq-dragging'); });
        tr.addEventListener('dragover', function (e) {
            e.preventDefault();
            var dragging = tb.querySelector('.mn-fq-dragging');
            if (!dragging || dragging === tr) return;
            var rect = tr.getBoundingClientRect();
            var after = (e.clientY - rect.top) > rect.height / 2;
            tb.insertBefore(dragging, after ? tr.nextSibling : tr);
        });
        tr.addEventListener('drop', function (e) { e.preventDefault(); mnFlyerQueueSaveOrder(); });
        tb.appendChild(tr);
    });
};
window.mnFlyerQueueSaveOrder = function() {
    var ids = [];
    var rows = document.querySelectorAll('#mn-queue-list tr[data-qid]');
    for (var i = 0; i < rows.length; i++) ids.push(rows[i].getAttribute('data-qid'));
    var fd = new FormData();
    fd.append('order', ids.join(','));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueReorder') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    }).then(function () { mnFlyerQueueLoad(); });
};
window.mnFlyerQueueAdd = function(pid) {
    var fd = new FormData();
    fd.append('course_id', String(pid));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueAdd') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) { alert((j && j.message) || 'Could not add to the queue.'); return; }
        mnFlyerQueueLoad();
    });
};
window.mnFlyerQueueRemove = function(qid, name) {
    if (!confirm('Remove "' + (name || 'this course') + '" from the flyer queue?')) return;
    var fd = new FormData();
    fd.append('queue_id', String(qid));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueRemove') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    }).then(function () { mnFlyerQueueLoad(); });
};

// Run Now for ANY queue row (not just the top): design that course's flyer +
// send for approval, then remove it from the queue. Same pipeline the Mon/Thu
// cron and autoStartNext use, guarded by the 2/week cap server-side.
window.mnFlyerQueueRun = function(qid, pid, name) {
    if (!confirm('Run the pipeline now for "' + (name || pid) + '"?\n\nStep 1 designs the flyer, step 2 emails the managers for approval. It schedules to MailerLite once a manager approves (max 2 flyers per week).')) return;
    var rf = new FormData(); rf.append('queue_id', String(qid));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueRemove') ?>', { method:'POST', body:rf, credentials:'same-origin' });
    var fd = new FormData(); fd.append('course_id', String(pid));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/queueApproval') ?>', { method:'POST', body:fd, credentials:'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) { alert((j && j.message) || 'Could not run.'); mnFlyerQueueLoad(); return; }
        alert(j.message || 'Pipeline started — approval email sent to the managers.');
        location.reload();
    })
    .catch(function (e) { alert('Network error: ' + (e && e.message ? e.message : e)); });
};

// Button states follow the queue: "Send top of queue" needs at least one row.
window.mnRefreshPreview = function() {
    var has = !!(window._mnQueue && window._mnQueue.length);
    var pushBtn = document.getElementById('mn-push-btn');
    if (pushBtn) { has ? pushBtn.removeAttribute('disabled') : pushBtn.setAttribute('disabled', 'disabled'); }
};

// Popup preview for any course (queue rows) — reuses the draft modal +
// renders via the same previewAction the drafts use.
window.mnPreviewCourse = function(pid, label) {
    window._mnState.pids = [parseInt(pid, 10)];
    window._mnState.pidNames[parseInt(pid, 10)] = label || 'Flyer preview';
    mnPreviewPicked();
};
window.mnPreviewPicked = function() {
    var pids = window._mnState.pids || [];
    if (!pids.length) { alert('Pick a course first.'); return; }
    var modal = document.getElementById('mn-draft-modal');
    var ifr   = document.getElementById('mn-draft-modal-iframe');
    var load  = document.getElementById('mn-draft-modal-loading');
    var titleEl = document.getElementById('mn-draft-modal-title');
    var metaEl  = document.getElementById('mn-draft-modal-meta');
    if (!modal || !ifr) return;
    if (modal.parentNode !== document.body) document.body.appendChild(modal);
    if (titleEl) titleEl.textContent = (window._mnState.pidNames && window._mnState.pidNames[pids[0]]) || 'Flyer preview';
    if (metaEl)  metaEl.textContent  = 'agentic_flyer · not queued yet';
    ifr.style.display = 'none';
    ifr.srcdoc = '';
    if (load) { load.style.display = ''; load.textContent = 'Loading preview…'; }
    if (typeof mnSetDraftViewport === 'function') mnSetDraftViewport('desktop');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    var fd = new FormData();
    fd.append('template_key', 'agentic_flyer');
    fd.append('course_pids', pids.join(','));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/preview') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) { if (load) load.textContent = 'Could not load preview' + (j && j.message ? ': ' + j.message : '.'); return; }
        ifr.srcdoc = j.html;
        ifr.style.display = '';
        if (load) load.style.display = 'none';
    })
    .catch(function (e) { if (load) load.textContent = 'Network error — ' + e; });
};

// --- Queue an Agentic flyer for manager approval (the ONLY path to MailerLite) ---
// Never pushes to MailerLite directly — it creates a proposal that both managers
// must approve, then the guarded pipeline schedules it (hard cap: 2 flyers/week).
window.mnQueueApproval = function() {
    var q = window._mnQueue || [];
    if (!q.length) { alert('The flyer queue is empty — add a WSQ course first.'); return; }
    var head = q[0];
    if (!confirm('Run the pipeline now for "' + (head.name || head.sku) + '"?\n\nStep 1 designs the flyer, step 2 emails the managers for approval. It schedules to MailerLite once a manager approves (max 2 flyers per week). This removes it from the queue.')) return;
    var btn = document.getElementById('mn-push-btn');
    if (btn) { btn.disabled = true; btn.textContent = 'Running…'; }
    // consume the head row (mirrors what the Mon/Thu cron does)
    var rf = new FormData();
    rf.append('queue_id', String(head.queue_id));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/flyerQueueRemove') ?>', { method: 'POST', body: rf, credentials: 'same-origin' });
    var fd = new FormData();
    fd.append('course_id', String(head.product_id));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/queueApproval') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (btn) { btn.disabled = false; btn.innerHTML = '&#9654; Run Now'; }
        if (!j || !j.success) { alert((j && j.message) || 'Could not queue.'); return; }
        alert(j.message || 'Queued — approval email sent to the managers.');
        location.reload();
    })
    .catch(function (err) {
        if (btn) { btn.disabled = false; btn.innerHTML = '&#9654; Run Now'; }
        alert('Network error: ' + (err && err.message ? err.message : err));
    });
};
// --- Agentic flyer: manager approve / request-changes (human in the loop) ---
window.mnReview = function(id, decision) {
    if (decision === 'changes') { mnOpenChangesBox(id); return; }   // styled box, not prompt()
    if (!confirm('Approve this flyer?\n\nIt schedules to MailerLite only after BOTH managers approve (max 2 campaigns/week).')) return;
    mnSubmitReview(id, 'approve', '');
};

window.mnSubmitReview = function(id, decision, feedback) {
    var fd = new FormData();
    fd.append('newsletter_id', String(id));
    fd.append('decision', decision);
    fd.append('feedback', feedback);
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/reviewDecision') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) { alert((j && j.message) || 'Action failed.'); return; }
        alert(j.message || 'Recorded.');
        location.reload();
    })
    .catch(function (err) {
        alert('Network error — please try again: ' + (err && err.message ? err.message : err));
    });
};

// --- Request-changes message box (replaces the native prompt) ---------
window.mnOpenChangesBox = function(id) {
    var box = document.getElementById('mn-changes-modal');
    if (!box) return;
    if (box.parentNode !== document.body) document.body.appendChild(box);
    box.setAttribute('data-nid', String(id));
    var ta = document.getElementById('mn-changes-text');
    if (ta) ta.value = '';
    box.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    if (ta) setTimeout(function(){ ta.focus(); }, 50);
};
window.mnCloseChangesBox = function() {
    var box = document.getElementById('mn-changes-modal');
    if (box) box.style.display = 'none';
    document.body.style.overflow = '';
};
window.mnSendChanges = function() {
    var box = document.getElementById('mn-changes-modal');
    var ta  = document.getElementById('mn-changes-text');
    if (!box) return;
    var fb = ta ? ta.value.replace(/^\s+|\s+$/g, '') : '';
    if (fb === '') { if (ta) ta.focus(); return; }
    mnCloseChangesBox();
    mnSubmitReview(parseInt(box.getAttribute('data-nid'), 10) || 0, 'changes', fb);
};

// --- Viewport toggle (Desktop / Mobile) -------------------------------
window.mnSetViewport = function(mode) {
    var stage = document.getElementById('mn-preview-stage');
    if (!stage) return;
    if (mode !== 'mobile') mode = 'desktop';
    stage.dataset.vp = mode;
    var d = document.getElementById('mn-vp-desktop');
    var m = document.getElementById('mn-vp-mobile');
    if (d) { d.classList.toggle('active', mode === 'desktop'); d.setAttribute('aria-selected', mode === 'desktop' ? 'true' : 'false'); }
    if (m) { m.classList.toggle('active', mode === 'mobile');  m.setAttribute('aria-selected', mode === 'mobile' ? 'true' : 'false'); }
};

// Load the next-flyer queue as soon as the panel script parses.
try { mnFlyerQueueLoad(); } catch (e) {}

window.mnDeleteDraft = function(id, title) {
    title = title || 'this draft';
    if (!confirm('Delete "' + title + '"?\n\nThis cannot be undone.')) return;
    var fd = new FormData();
    fd.append('newsletter_id', String(id));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/deleteDraft') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) { alert((j && j.message) || 'Delete failed.'); return; }
        // Drop the row from the DOM and update the count.
        var row = document.querySelector('.mn-draft[data-id="' + id + '"]');
        if (row) row.remove();
        var listEl = document.getElementById('mn-drafts-list');
        if (listEl && !listEl.querySelector('.mn-draft')) {
            listEl.innerHTML = '<div class="mn-result-empty">No drafts yet.</div>';
        }
        var head = document.querySelector('.mn-drafts h3');
        if (head) {
            var n = document.querySelectorAll('.mn-draft').length;
            head.textContent = 'Drafts (' + n + ')';
        }
        // If the draft being edited is the one we just deleted, reset.
        if (window._mnState && Number(window._mnState.newsletterId) === Number(id)) {
            window._mnState.newsletterId = 0;
        }
    })
    .catch(function (e) { alert('Network: ' + e); });
};
window.mnLoadDraft = function(id) {
    var modal = document.getElementById('mn-draft-modal');
    var ifr   = document.getElementById('mn-draft-modal-iframe');
    var load  = document.getElementById('mn-draft-modal-loading');
    var titleEl = document.getElementById('mn-draft-modal-title');
    var metaEl  = document.getElementById('mn-draft-modal-meta');
    if (!modal || !ifr) return;
    // Lift the modal out of the panel container so position:fixed is
    // measured against the viewport, not a transformed ancestor.
    if (modal.parentNode !== document.body) document.body.appendChild(modal);

    var btn = document.querySelector('.mn-draft[data-id="' + id + '"]');
    if (btn) {
        var t = btn.querySelector('.mn-draft-title');
        var m = btn.querySelector('.mn-draft-meta');
        if (t && titleEl) titleEl.textContent = t.textContent;
        if (m && metaEl)  metaEl.textContent  = m.textContent.replace(/\s+/g, ' ').trim();
    }

    ifr.style.display = 'none';
    ifr.srcdoc = '';
    load.style.display = '';
    load.textContent = 'Loading preview…';
    mnSetDraftViewport('desktop');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';

    var fd = new FormData();
    fd.append('newsletter_id', String(id));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/preview') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) {
            load.textContent = 'Could not load preview' + (j && j.message ? ': ' + j.message : '.');
            return;
        }
        ifr.srcdoc = j.html;
        ifr.style.display = '';
        load.style.display = 'none';
    })
    .catch(function (e) {
        load.textContent = 'Network error — ' + e;
    });
};
// Load a saved draft back into the builder for editing. Distinct from
// mnLoadDraft (which only opens a preview modal). Repopulates every
// part of _mnState then triggers the existing render functions to
// rebuild the UI — template choice, course chips, chat history, body
// editor, and preview iframe all reflect the loaded draft.
window.mnEditDraft = function(id) {
    if (window._mnState.newsletterId && window._mnState.newsletterId !== id) {
        if (!confirm('Discard the current draft and load this one?')) return;
    }
    var fd = new FormData();
    fd.append('newsletter_id', String(id));
    fetch('<?php echo Mage::helper('adminhtml')->getUrl('adminhtml/marketingnewsletter/load') ?>', {
        method: 'POST', body: fd, credentials: 'same-origin'
    })
    .then(function (r) { return r.json(); })
    .then(function (j) {
        if (!j || !j.success) {
            alert('Could not load draft' + (j && j.message ? ': ' + j.message : '.'));
            return;
        }
        // Restore the JS state from the saved row.
        window._mnState.newsletterId = j.newsletter_id;
        window._mnState.template     = 'agentic_flyer';
        window._mnState.pids         = (j.pids || []).map(function (v) { return parseInt(v, 10); });
        window._mnState.pidNames     = j.pid_names  || {};

        // Sync UI to the new state.
        var tplBtns = document.querySelectorAll('.mn-tpl');
        for (var i = 0; i < tplBtns.length; i++) {
            if (tplBtns[i].getAttribute('data-tpl') === window._mnState.template) {
                tplBtns[i].classList.add('active');
            } else {
                tplBtns[i].classList.remove('active');
            }
        }
        // Highlight the loaded draft in the list.
        var drafts = document.querySelectorAll('.mn-draft');
        for (var k = 0; k < drafts.length; k++) {
            if (parseInt(drafts[k].getAttribute('data-id'), 10) === j.newsletter_id) {
                drafts[k].classList.add('active');
            } else {
                drafts[k].classList.remove('active');
            }
        }
        if (typeof mnRenderPids        === 'function') mnRenderPids();
        if (typeof mnRefreshPreview    === 'function') mnRefreshPreview();
    })
    .catch(function (e) {
        alert('Network error — ' + e);
    });
};
window.mnCloseDraftModal = function(e) {
    if (e && e.target && e.target.id !== 'mn-draft-modal' && !(e.target.tagName === 'BUTTON' && e.target.getAttribute('aria-label') === 'Close')) return;
    var modal = document.getElementById('mn-draft-modal');
    if (!modal) return;
    modal.style.display = 'none';
    document.body.style.overflow = '';
    var ifr = document.getElementById('mn-draft-modal-iframe');
    if (ifr) ifr.srcdoc = '';
};
window.mnSetDraftViewport = function(mode) {
    var stage = document.getElementById('mn-draft-modal-stage');
    if (!stage) return;
    if (mode !== 'mobile') mode = 'desktop';
    stage.dataset.vp = mode;
    var d = document.getElementById('mn-draft-vp-desktop');
    var m = document.getElementById('mn-draft-vp-mobile');
    if (d) d.classList.toggle('active', mode === 'desktop');
    if (m) m.classList.toggle('active', mode === 'mobile');
};
// Close on Escape
document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') {
        var modal = document.getElementById('mn-draft-modal');
        if (modal && modal.style.display !== 'none') mnCloseDraftModal({ target: modal });
    }
});

(function init() {
    mnRenderPids();
})();
</script>

<!-- Draft preview modal — shown when admin clicks a row in the Drafts list -->
