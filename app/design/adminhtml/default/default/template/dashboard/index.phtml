/* Per-website SMTP creds. NG uses SMTP as its primary
   transport. SG also gets a card here so SMTP creds are available as a
   fallback for the order-email path when Gmail OAuth is unavailable
   (token revoked, quota hit, API unreachable). Each row reads at the
   website's default store — exactly how SMTPPro resolves the values
   when an order / contact-us fires at run time. */
$_smtpWebsites = array(
    'singapore' => array('id' => 1, 'label' => 'Singapore (fallback)', 'code' => 'SG'),
    'nigeria'   => array('id' => 4, 'label' => 'Nigeria',              'code' => 'NG'),
);

/* Reusable inline-SVG icon helper for the SMTP section. Keeps the
   markup minimal (no emoji, no external assets) and themes everything
   via currentColor so the same stroke icon renders correctly inside
   the active / disabled / pitfall pill colors. 16px viewBox, 1.6
   stroke weight throughout for visual consistency. */
$_icon = function($name, $size = 14) {
    $paths = array(
        'book'      => '<path d="M4 4.5A2.5 2.5 0 016.5 2H20v18H6.5A2.5 2.5 0 014 17.5v-13z"/><path d="M4 17.5A2.5 2.5 0 016.5 15H20"/>',
        'bulb'      => '<path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 00-4 10.5c.7.7 1 1.6 1 2.5v1h6v-1c0-.9.3-1.8 1-2.5A6 6 0 0012 3z"/>',
        'warn'      => '<path d="M12 3l10 18H2L12 3z"/><line x1="12" y1="10" x2="12" y2="14"/><circle cx="12" cy="17" r="0.5"/>',
        'check'     => '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/>',
        'dot'       => '<circle cx="12" cy="12" r="3.5"/>',
        'eye'       => '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
        'eye-off'   => '<path d="M3 3l18 18"/><path d="M10.6 6.1A10 10 0 0112 6c6.5 0 10 7 10 7a16.6 16.6 0 01-3.3 4.1"/><path d="M6.5 7.1A16.6 16.6 0 002 12s3.5 7 10 7a10 10 0 003.8-.7"/><path d="M9.9 9.9a3 3 0 004.2 4.2"/>',
        'spinner'   => '<circle cx="12" cy="12" r="9" stroke-opacity="0.25"/><path d="M21 12a9 9 0 00-9-9"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="0.9s" repeatCount="indefinite"/></path>',
    );
    if (!isset($paths[$name])) return '';
    return '<svg width="' . (int)$size . '" height="' . (int)$size . '" viewBox="0 0 24 24"'
        . ' fill="none" stroke="currentColor" stroke-width="1.6"'
        . ' stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"'
        . ' style="display:inline-block;vertical-align:-2px;">'
        . $paths[$name] . '</svg>';
};
$_smtpFields = array('enabled', 'host', 'port', 'ssl', 'auth', 'username', 'password');
$_smtpCfg = array();
foreach ($_smtpWebsites as $_code => $_w) {
    try {
        $_sid = (int) Mage::app()->getWebsite($_w['id'])->getDefaultStore()->getId();
    } catch (Exception $_e) {
        $_sid = 0;
    }
    $_smtpCfg[$_code] = array(
        'enabled'  => (string) Mage::getStoreConfig('smtppro/general/option',              $_sid),
        'host'     => (string) Mage::getStoreConfig('smtppro/general/smtp_host',           $_sid),
        'port'     => (string) Mage::getStoreConfig('smtppro/general/smtp_port',           $_sid),
        'ssl'      => (string) Mage::getStoreConfig('smtppro/general/smtp_ssl',            $_sid),
        'auth'     => (string) Mage::getStoreConfig('smtppro/general/smtp_authentication', $_sid),
        'username' => (string) Mage::getStoreConfig('smtppro/general/smtp_username',       $_sid),
        'password' => (string) Mage::getStoreConfig('smtppro/general/smtp_password',       $_sid),
    );
}
$_credMask = function ($v) {
    $v = (string) $v;
    if ($v === '') return '';
    $n = strlen($v);
    if ($n <= 8) return str_repeat('•', max($n - 2, 1)) . substr($v, -2);
    return substr($v, 0, 4) . str_repeat('•', 12) . substr($v, -4);
};
