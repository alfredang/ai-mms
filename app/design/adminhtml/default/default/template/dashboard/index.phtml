<script type="text/javascript">
var LMC_FEEDBACK_BASE = '<?php echo rtrim(Mage::getBaseUrl(), '/') ?>/feedback/respond/index';
var _lmcFeedbackUrl = '';

function lmcShowFeedback(runId, courseTitle, courseSku) {
    _lmcFeedbackUrl = LMC_FEEDBACK_BASE + '?run_id=' + runId;
    var qrSrc = 'https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(_lmcFeedbackUrl);
    document.getElementById('lmc-feedback-qr-img').src           = qrSrc;
    document.getElementById('lmc-feedback-url-text').textContent = _lmcFeedbackUrl;
    document.getElementById('lmc-feedback-open-link').href       = _lmcFeedbackUrl;
    var refEl = document.getElementById('lmc-feedback-ref');
    if (refEl) refEl.innerHTML = courseSku
        ? 'Course Ref: <strong style="color:#e2e8f0;">' + courseSku + '</strong>'
        : '';
    document.getElementById('lmc-feedback-modal').style.display  = 'flex';
}

function lmcCopyFeedbackUrl() {
    if (!_lmcFeedbackUrl) return;
    if (navigator.clipboard) {
        navigator.clipboard.writeText(_lmcFeedbackUrl).then(function(){ alert('URL copied!'); });
    } else {
        var ta = document.createElement('textarea');
        ta.value = _lmcFeedbackUrl;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        alert('URL copied!');
    }
}

// Close modal on backdrop click.
document.getElementById('lmc-feedback-modal').addEventListener('click', function(e){
    if (e.target === this) this.style.display = 'none';
});
</script>

<script type="text/javascript">
function lmcFilter(type, btn) {
    var tabs = document.querySelectorAll('.lmc-tab');
    for (var i = 0; i < tabs.length; i++) tabs[i].classList.remove('active');
    btn.classList.add('active');
    var cards = document.querySelectorAll('.lmc-card');
    for (var i = 0; i < cards.length; i++) {
        cards[i].style.display = (type === 'all' || cards[i].getAttribute('data-time') === type) ? '' : 'none';
    }
}
function lmcSearch(q) {
    q = q.toLowerCase();
    var cards = document.querySelectorAll('.lmc-card');
    for (var i = 0; i < cards.length; i++) {
        cards[i].style.display = (!q || cards[i].getAttribute('data-search').indexOf(q) >= 0) ? '' : 'none';
    }
}
function lmcSetView(view, btn) {
    var grid = document.getElementById('lmc-grid');
    if (!grid) return;
    if (view === 'list') grid.classList.add('lmc-grid-list');
    else grid.classList.remove('lmc-grid-list');
    var btns = document.querySelectorAll('.lmc-view-btn');
    for (var i = 0; i < btns.length; i++) btns[i].classList.remove('active');
    if (btn) btn.classList.add('active');
}
</script>
