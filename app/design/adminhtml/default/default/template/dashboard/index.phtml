            <?php /* ===== AI SEO Meta: one-click direct-fill =====
                  Click WSQ or Non-WSQ → POST course data → form fields
                  meta_title / meta_keyword / meta_description populate
                  themselves. No modal, no preview, no Apply step. */ ?>
            <script>
            (function() {
                var OPEN_BTNS = document.querySelectorAll('.ai-seo-btn');
                if (!OPEN_BTNS.length) return;
                var FORM = document.getElementById('dcf-form');

                // Map WSQ vs Non-WSQ → POST field names the controller expects.
                var FIELD_MAP = {
                    wsq:     ['course_title', 'learning_outcomes', 'topics'],
                    hrdf:    ['course_title', 'learning_outcomes', 'topics'],
                    non_wsq: ['course_name', 'key_topics', 'course_highlights']
                };

                function stripHtml(s) {
                    if (!s) return '';
                    var tmp = document.createElement('div');
                    tmp.innerHTML = s;
                    return (tmp.textContent || tmp.innerText || '').trim();
                }
                function formVal(name) {
                    var el = FORM && FORM.querySelector('[name="' + name + '"]');
                    return el ? (el.value || '') : '';
                }

                var PROGRESS_WRAP = document.getElementById('ai-seo-progress-wrap');
                var PROGRESS_BAR  = document.getElementById('ai-seo-progress-bar');
                var PROGRESS_ETA  = document.getElementById('ai-seo-progress-eta');
                var progressTimer = null;
                function startProgress() {
                    // Generation typically takes ~20s warm, ~30s cold.
                    // Climb to 90% over 30s, then asymptote toward 98% so
                    // the bar always shows motion even if Claude is slow.
                    // The response handler jumps it to 100%.
                    var EXPECTED_MS = 30000;
                    var started = Date.now();
                    PROGRESS_WRAP.style.display = 'block';
                    PROGRESS_BAR.style.transition = 'width 0.4s linear';
                    PROGRESS_BAR.style.width = '0%';
                    if (progressTimer) clearInterval(progressTimer);
                    progressTimer = setInterval(function() {
                        var elapsed = Date.now() - started;
                        var pct;
                        if (elapsed < EXPECTED_MS) {
                            pct = (elapsed / EXPECTED_MS) * 90;
                        } else {
                            var over = (elapsed - EXPECTED_MS) / 1000;
                            pct = 90 + (1 - Math.exp(-over / 20)) * 8;
                        }
                        var remaining = Math.max(0, EXPECTED_MS - elapsed);
                        var secs = Math.ceil(remaining / 1000);
                        PROGRESS_BAR.style.width = pct.toFixed(1) + '%';
                        PROGRESS_ETA.textContent = secs > 0
                            ? '~' + secs + 's left'
                            : 'Almost done…';
                    }, 400);
                }
                function finishProgress() {
                    if (progressTimer) { clearInterval(progressTimer); progressTimer = null; }
                    PROGRESS_BAR.style.transition = 'width 0.25s ease-out';
                    PROGRESS_BAR.style.width = '100%';
                    PROGRESS_ETA.textContent = 'Done';
                    setTimeout(function() {
                        PROGRESS_WRAP.style.display = 'none';
                        PROGRESS_BAR.style.width = '0%';
                    }, 500);
                }

                function directGenerate(btn, mode) {
                    var origHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.style.opacity = '.6';
                    btn.style.cursor = 'wait';
                    btn.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:ai-seo-spin 0.7s linear infinite;"></span> Generating…';
                    startProgress();

                    var productId = '<?php echo (int)($_selectedCourse["id"] ?? 0) ?>';
                    // Per-button country + target store. Each segment button
                    // carries its own (e.g. SG-WSQ → Singapore / 1, MY-HRDF →
                    // Malaysia / 2) so the save lands at the right EAV scope
                    // regardless of which store-view tab the admin is on.
                    var country       = btn.getAttribute('data-country') || 'Singapore';
                    var targetStoreId = btn.getAttribute('data-target-store') || '0';

                    var fd = new FormData();
                    fd.append('form_key', window.FORM_KEY || '<?php echo Mage::getSingleton("core/session")->getFormKey() ?>');
                    fd.append('product_id', productId);
                    fd.append('mode', mode);
                    fd.append('country', country);
                    fd.append('seo_target_store_id', targetStoreId);
                    fd.append('save', '1');   // persist immediately to that store scope
                    var keys = FIELD_MAP[mode];
                    var courseName  = formVal('general_course_name') || formVal('course_name') || '';
                    var outcomes    = stripHtml(formVal('learning_outcomes'));
                    var description = stripHtml(formVal('course_description'));
                    fd.append(keys[0], courseName);
                    fd.append(keys[1], outcomes);
                    fd.append(keys[2], description);

                    fetch('<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/coursesave/aiSeo") ?>', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(j) {
                        btn.disabled = false;
                        btn.style.opacity = '1';
                        btn.style.cursor = 'pointer';
                        btn.innerHTML = origHtml;
                        finishProgress();
                        if (!j || !j.success) {
                            alert('SEO generation failed: ' + ((j && j.message) || 'unknown error'));
                            return;
                        }
                        // Only repopulate the form when the generated values
                        // were written to the store currently displayed in
                        // the form (the hidden seo_target_store_id input).
                        // Otherwise we'd flash NG copy into the SG form.
                        var displayedStore = (FORM.querySelector('[name="seo_target_store_id"]') || {}).value || '0';
                        if (String(displayedStore) === String(targetStoreId)) {
                            var setField = function(name, value) {
                                var el = FORM.querySelector('[name="' + name + '"]');
                                if (el && value != null && value !== '') el.value = value;
                            };
                            setField('meta_title',       j.meta_title);
                            setField('meta_keyword',     j.meta_keyword);
                            setField('meta_description', j.meta_description);
                        }
                        if (j.saved) {
                            // Subtle confirmation in the panel header so admin
                            // knows the data is already persisted (no Save
                            // Changes needed for the SEO fields specifically).
                            var bar = btn.closest('.dcf-mag-bar');
                            if (bar) {
                                var note = document.createElement('span');
                                note.textContent = '✓ saved to store ' + j.saved_store_id;
                                note.style.cssText = 'color:#22c55e;font-size:11px;font-weight:500;margin-left:8px;';
                                bar.appendChild(note);
                                setTimeout(function() { note.remove(); }, 4000);
                            }
                        }
                        if (j.stubbed) console.warn('SEO stub used: ' + j.stub_reason);
                    })
                    .catch(function(err) {
                        btn.disabled = false;
                        btn.style.opacity = '1';
                        btn.style.cursor = 'pointer';
                        btn.innerHTML = origHtml;
                        finishProgress();
                        alert('Network error: ' + err.message);
                    });
                }

                function generateAllStores(btn) {
                    if (!confirm('Generate SEO meta across both country stores for this course?\n\nThis runs one multi-store AI prompt and writes the result to SG and NG scope. Existing meta on those stores will be replaced.')) return;
                    var origHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.style.opacity = '.6';
                    btn.style.cursor = 'wait';
                    btn.innerHTML = '<span style="display:inline-block;width:12px;height:12px;border:2px solid currentColor;border-top-color:transparent;border-radius:50%;animation:ai-seo-spin 0.7s linear infinite;"></span> Generating for 3 stores…';
                    startProgress();

                    var fd = new FormData();
                    fd.append('form_key', window.FORM_KEY || '<?php echo Mage::getSingleton("core/session")->getFormKey() ?>');
                    fd.append('product_id', '<?php echo (int)($_selectedCourse["id"] ?? 0) ?>');
                    fd.append('course_title',      formVal('general_course_name') || formVal('course_name') || '');
                    fd.append('learning_outcomes', stripHtml(formVal('learning_outcomes')));
                    fd.append('course_highlights', stripHtml(formVal('course_description')));

                    fetch('<?php echo Mage::helper("adminhtml")->getUrl("adminhtml/coursesave/aiSeoAllStores") ?>', {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin'
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(j) {
                        btn.disabled = false;
                        btn.style.opacity = '1';
                        btn.style.cursor = 'pointer';
                        btn.innerHTML = origHtml;
                        finishProgress();
                        if (!j || !j.success) {
                            alert('All-Stores SEO failed: ' + ((j && j.message) || 'unknown error'));
                            return;
                        }
                        if (j.stubbed) {
                            alert('AI generator unavailable (' + (j.stub_reason || '') + '). No changes saved.');
                            return;
                        }
                        var stores = Object.keys(j.per_store || {});
                        var bar = btn.closest('.dcf-mag-bar');
                        if (bar) {
                            var note = document.createElement('span');
                            note.textContent = '✓ saved to ' + stores.length + ' stores: ' + stores.join(', ');
                            note.style.cssText = 'color:#22c55e;font-size:11px;font-weight:500;margin-left:8px;';
                            bar.appendChild(note);
                            setTimeout(function() { note.remove(); }, 6000);
                        }
                        // Repopulate the visible form with the value for the
                        // currently-displayed store, if present.
                        var displayedStore = (FORM.querySelector('[name="seo_target_store_id"]') || {}).value || '0';
                        var row = j.per_store && j.per_store[displayedStore];
                        if (row) {
                            var setField = function(name, value) {
                                var el = FORM.querySelector('[name="' + name + '"]');
                                if (el && value != null && value !== '') el.value = value;
                            };
                            setField('meta_title',       row.meta_title);
                            setField('meta_keyword',     row.meta_keyword);
                            setField('meta_description', row.meta_description);
                        }
                    })
                    .catch(function(err) {
                        btn.disabled = false;
                        btn.style.opacity = '1';
                        btn.style.cursor = 'pointer';
                        btn.innerHTML = origHtml;
                        finishProgress();
                        alert('Network error: ' + err.message);
                    });
                }

                for (var i = 0; i < OPEN_BTNS.length; i++) {
                    (function(btn) {
                        btn.addEventListener('click', function() {
                            directGenerate(btn, btn.getAttribute('data-mode'));
                        });
                    })(OPEN_BTNS[i]);
                }
                var ALL_STORES_BTN = document.getElementById('ai-seo-all-stores-btn');
                if (ALL_STORES_BTN) {
                    ALL_STORES_BTN.addEventListener('click', function() {
                        generateAllStores(ALL_STORES_BTN);
                    });
                }
                if (!document.getElementById('ai-seo-spin-style')) {
                    var st = document.createElement('style');
                    st.id = 'ai-seo-spin-style';
                    st.textContent = '@keyframes ai-seo-spin{to{transform:rotate(360deg);}}';
                    document.head.appendChild(st);
                }
            })();
            </script>
        </div>

