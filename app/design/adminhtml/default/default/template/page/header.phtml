    var root = document.getElementById('mmd-wa-root');
    if (!root) return;
    var panel = document.getElementById('mmd-wa-panel'),
        launcher = document.getElementById('mmd-wa-launcher'),
        list = document.getElementById('mmd-wa-list'),
        search = document.getElementById('mmd-wa-search'),
        browse = document.getElementById('mmd-wa-browse'),
        body = document.getElementById('mmd-wa-body'),
        detail = document.getElementById('mmd-wa-detail'),
        detailLabel = document.getElementById('mmd-wa-detail-label'),
        draft = document.getElementById('mmd-wa-draft'),
        input = document.getElementById('mmd-wa-input'),
        foot = document.getElementById('mmd-wa-foot'),
        /* Trainer set is short enough to always show in full, grouped. */
        showAll = <?php echo $_waIsTrainer ? 'true' : 'false' ?>;

    browse.textContent = 'Browse all ' + TEMPLATES.length + ' requests';

    function render() {
        var q = search.value.toLowerCase().replace(/^\s+|\s+$/g, '');
        var items = TEMPLATES.filter(function (t) {
            if (q) return (t.label + ' ' + t.cat).toLowerCase().indexOf(q) !== -1;
            return showAll || STARTERS.indexOf(t.id) !== -1;
        });
        list.innerHTML = '';
        var lastCat = null;
        for (var i = 0; i < items.length; i++) {
            var t = items[i];
            if ((showAll || q) && t.cat !== lastCat) {
                var h = document.createElement('div');
                h.className = 'mmd-wa-cat';
                h.textContent = t.cat;
                list.appendChild(h);
                lastCat = t.cat;
            }
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'mmd-wa-item';
            b.textContent = t.label;
            b.setAttribute('data-id', t.id);
            list.appendChild(b);
        }
        if (!items.length) {
            var e = document.createElement('div');
            e.className = 'mmd-wa-empty';
            e.textContent = 'No matching request — type your message below instead.';
            list.appendChild(e);
        }
        browse.style.display = (q || showAll) ? 'none' : '';
    }

    function copyText(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).catch(function () {});
            return;
        }
        /* http/older-browser fallback */
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
    }

    function flashLabel(btn, done) {
        var orig = btn.innerHTML;
        btn.innerHTML = done;
        setTimeout(function () { btn.innerHTML = orig; }, 1400);
    }

    function openChat(text) {
        text = (text || '').replace(/^\s+|\s+$/g, '');
        var url = CHAT_URL;
        if (text) {
            /* Group invite links ignore ?text= — clipboard is the carrier there. */
            copyText(text);
            if (/wa\.me|api\.whatsapp\.com/.test(url) && !/chat\.whatsapp\.com/.test(url)) {
                url += (url.indexOf('?') === -1 ? '?' : '&') + 'text=' + encodeURIComponent(text);
            }
        }
        window.open(url, '_blank', 'noopener');
    }

    function showDetail(t) {
        body.hidden = true;
        detail.hidden = false;
        foot.hidden = true;
        detailLabel.textContent = t.label;
        draft.value = t.body;
        draft.focus();
    }
    function showList() {
        detail.hidden = true;
        body.hidden = false;
        foot.hidden = false;
    }

    launcher.onclick = function () {
        var open = !panel.hidden;
        panel.hidden = open;
        launcher.setAttribute('aria-expanded', open ? 'false' : 'true');
        if (!open) { showList(); render(); search.focus(); }
    };
    document.getElementById('mmd-wa-close').onclick = function () {
        panel.hidden = true;
        launcher.setAttribute('aria-expanded', 'false');
    };
    document.getElementById('mmd-wa-back').onclick = showList;
    browse.onclick = function () { showAll = true; render(); };
    search.oninput = render;
    list.onclick = function (ev) {
        var btn = ev.target.closest ? ev.target.closest('.mmd-wa-item') : null;
        if (!btn) return;
        for (var i = 0; i < TEMPLATES.length; i++) {
            if (TEMPLATES[i].id === btn.getAttribute('data-id')) { showDetail(TEMPLATES[i]); break; }
        }
    };
    document.getElementById('mmd-wa-send').onclick = function () {
        openChat(input.value);
        input.value = '';
    };
    document.getElementById('mmd-wa-copy').onclick = function () {
        copyText(draft.value.replace(/^\s+|\s+$/g, ''));
        flashLabel(this, 'Copied &#10003;');
    };
    document.getElementById('mmd-wa-copyopen').onclick = function () {
        openChat(draft.value);
    };
    input.onkeydown = function (ev) { if (ev.key === 'Enter') { openChat(input.value); input.value = ''; } };
    document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && !panel.hidden) {
            if (!detail.hidden) { showList(); }
            else { panel.hidden = true; launcher.setAttribute('aria-expanded', 'false'); }
        }
    });
})();
</script>
