<?php
/**
 * Workflow Guides — per-role, read-only step-by-step reference.
 * Content comes from MMD_WorkflowGuides_Helper_Data::getGuidesForRole();
 * the guide list itself now lives in the left sidebar nav (page/menu.phtml,
 * "Workflow Guides" dropdown) — this template only renders the single
 * active guide picked via the ?guide= request param.
 */
$roleCode = Mage::helper('mmd_rolemanager')->getActiveRoleCode();
$categories = Mage::helper('mmd_workflowguides')->getGuidesForRole($roleCode);
$requestedGuideId = (string) $this->getRequest()->getParam('guide');

$activeGuide = null;
$activeCategory = null;
foreach ($categories as $cat) {
    foreach ($cat['guides'] as $guide) {
        if ($requestedGuideId === '' || $guide['id'] === $requestedGuideId) {
            $activeGuide = $guide;
            $activeCategory = $cat;
            break 2;
        }
    }
}

/**
 * Inline SVG replacements for the emojis the helper still emits as
 * category / step icons. Keeps the helper semantic (emoji = category)
 * while the rendered page uses lucide-style strokes that match the
 * sidebar's icon language.
 */
$_wfgStepIcon = function ($type) {
    if ($type === 'ACTION') {
        // Lightning bolt — denotes the "do this" steps.
        return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" '
             . 'stroke="currentColor" stroke-width="2" stroke-linecap="round" '
             . 'stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>';
    }
    // Settings cog — denotes business-logic / guardrail steps.
    return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" '
         . 'stroke="currentColor" stroke-width="2" stroke-linecap="round" '
         . 'stroke-linejoin="round"><circle cx="12" cy="12" r="3"/>'
         . '<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9c.36.16.76.24 1.17.24H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>';
};

/**
 * Map known category emojis to lucide-style SVGs. Falls back to the raw
 * emoji if unrecognised — adding a new category in the helper just keeps
 * working until someone wires its icon here.
 */
$_wfgCategoryIcon = function ($emoji) {
    $map = array(
        // 📘 Courses (single book)
        "\xF0\x9F\x93\x98" => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
        // 📚 Lesson Delivery (stack of books)
        "\xF0\x9F\x93\x9A" => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
        // 🗂️ Class Management (folder)
        "\xF0\x9F\x97\x82\xEF\xB8\x8F" => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
        // 📝 Feedback & Certificates (clipboard/edit)
        "\xF0\x9F\x93\x9D" => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>',
        // 🏅 Certificates (award medal)
        "\xF0\x9F\x8F\x85" => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>',
    );
    return isset($map[$emoji]) ? $map[$emoji] : htmlspecialchars((string) $emoji, ENT_QUOTES, 'UTF-8');
};
?>
<div class="wfg-wrap">
    <?php if ($activeGuide): ?>
        <div class="wfg-guide-header">
            <h2><span class="wfg-guide-icon"><?php echo $_wfgCategoryIcon($activeCategory['icon']) ?></span><?php echo $this->escapeHtml($activeGuide['title']) ?></h2>
            <?php if (!empty($activeGuide['path'])): ?>
                <p class="wfg-guide-path"><?php echo $this->escapeHtml($activeGuide['path']) ?></p>
            <?php endif; ?>
        </div>
        <div class="wfg-steps-label"><?php echo $this->__('Workflow Steps') ?></div>
        <div class="wfg-steps">
            <?php foreach ($activeGuide['steps'] as $i => $step): ?>
                <div class="wfg-step wfg-step-<?php echo strtolower($step['type']) ?>">
                    <div class="wfg-step-num"><?php echo (int) $i + 1 ?></div>
                    <div class="wfg-step-body">
                        <div class="wfg-step-title-row">
                            <span class="wfg-step-emoji"><?php echo $_wfgStepIcon($step['type']) ?></span>
                            <span class="wfg-step-title"><?php echo $this->escapeHtml($step['title']) ?></span>
                            <span class="wfg-badge wfg-badge-<?php echo strtolower($step['type']) ?>"><?php echo $this->escapeHtml($step['type']) ?></span>
                        </div>
                        <p class="wfg-step-desc"><?php echo $this->escapeHtml($step['description']) ?></p>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <div class="wfg-empty"><?php echo $this->__('No guides are available for your role yet.') ?></div>
    <?php endif; ?>
</div>
