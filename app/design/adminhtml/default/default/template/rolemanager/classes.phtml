<?php
/**
 * Admin "Classes" grid — first-class view over course_runs.
 *
 * Supports four buckets via the 'bucket' block data key:
 *   all       — every class with a start date (default)
 *   ongoing   — start_date <= today AND (end_date IS NULL OR end_date >= today)
 *   upcoming  — start_date > today, sorted nearest first
 *   completed — end_date < today, sorted newest first
 *
 * Drill-in (Edit) deep-links to the existing dashboard ?panel=assignlearner
 * panel where roster CRUD already lives.
 */
$_bucket = (string) $this->getData('bucket');
if (!in_array($_bucket, array('all', 'ongoing', 'upcoming', 'completed'), true)) {
    $_bucket = 'all';
}

$resource   = Mage::getSingleton('core/resource');
$read       = $resource->getConnection('core_read');
$runsTbl    = $resource->getTableName('course_runs');
$enrolTbl   = $resource->getTableName('course_run_enrolments');
$pVarchar   = $resource->getTableName('catalog_product_entity_varchar');
$pEntity    = $resource->getTableName('catalog_product_entity');
$invTbl     = $resource->getTableName('course_run_trainer_invitations');

$nameAttrId = (int) $read->fetchOne("
    SELECT a.attribute_id
      FROM " . $resource->getTableName('eav_attribute') . " a
      INNER JOIN " . $resource->getTableName('eav_entity_type') . " t ON t.entity_type_id = a.entity_type_id
     WHERE t.entity_type_code = 'catalog_product' AND a.attribute_code = 'name'
");

$today = Mage::getModel('core/date')->date('Y-m-d');

switch ($_bucket) {
    case 'ongoing':
        $_whereBucket = "cr.course_start_date <= '$today'
            AND (cr.course_end_date IS NULL OR cr.course_end_date >= '$today')";
        $_orderBy   = 'cr.course_start_date ASC, cr.course_start_time ASC';
        $_pageTitle = 'Ongoing Classes';
        $_emptyMsg  = 'No classes are currently ongoing.';
        break;
    case 'upcoming':
        $_whereBucket = "cr.course_start_date > '$today'";
        $_orderBy   = 'cr.course_start_date ASC, cr.course_start_time ASC';
        $_pageTitle = 'Upcoming Classes';
        $_emptyMsg  = 'No upcoming classes scheduled.';
        break;
    case 'completed':
        $_whereBucket = "cr.course_end_date < '$today'";
        $_orderBy   = 'cr.course_end_date DESC, cr.course_start_date DESC';
        $_pageTitle = 'Completed Classes';
        $_emptyMsg  = 'No completed classes found.';
        break;
    default:
        $_whereBucket = 'cr.course_start_date IS NOT NULL';
        $_orderBy   = 'cr.course_start_date DESC, cr.course_start_time DESC';
        $_pageTitle = 'All Classes';
        $_emptyMsg  = 'No classes found.';
        break;
}

// No Store View filter: class_ids use the uniform 'C' prefix on every site
// (one store per site), so every run in this DB belongs here.
$_whereStore    = '';

// Server-side pagination. Without this the query returned every
// course_runs row matching the bucket+store (often thousands on
// the SG store), each rendering as TWO <tr>s with full inline
// controls + per-row data attributes. The result was a multi-MB
// HTML payload that crashed the browser tab on slower hardware.
$_pageSize  = 50;
$_curPage   = max(1, (int) Mage::app()->getRequest()->getParam('page', 1));
$_totalRows = 0;
$_offset    = ($_curPage - 1) * $_pageSize;

$rows = array();
if ($nameAttrId) {
    // 1) COUNT first so the pager has a total. Use the same filters
    // as the data query — no joins needed for the count.
    $_totalRows = (int) $read->fetchOne("
        SELECT COUNT(*)
          FROM `$runsTbl` cr
         WHERE cr.course_start_date IS NOT NULL
           AND $_whereBucket
           $_whereStore
    ");

    // Clamp the requested page to the available range so a stale
    // bookmark from a deleted-class trim doesn't 404 the user into
    // an empty grid.
    $_totalPages = $_totalRows > 0 ? (int) ceil($_totalRows / $_pageSize) : 1;
    if ($_curPage > $_totalPages) {
        $_curPage = $_totalPages;
        $_offset  = ($_curPage - 1) * $_pageSize;
    }

    $rows = $read->fetchAll("
        SELECT cr.run_id, cr.class_id, cr.product_id,
               COALESCE(NULLIF(TRIM(pe.sku), ''), cr.course_sku) AS course_sku,
               cr.course_start_date, cr.course_end_date,
               cr.course_start_time, cr.course_end_time,
               cr.vacancy, cr.trainer_option_id, cr.trainer_user_id, cr.invitation_paused,
               cr.invitation_replies_blocked, cr.created_by,
               COALESCE(pn.value, '(deleted product)') AS course_title,
               COALESCE(en.enrolled, 0) AS enrolled,
               inv.status AS inv_status, inv.trainer_name AS inv_trainer_name
          FROM `$runsTbl` cr
          LEFT JOIN `$pEntity` pe
               ON pe.entity_id = cr.product_id
          LEFT JOIN `$pVarchar` pn
               ON pn.entity_id = cr.product_id
              AND pn.attribute_id = $nameAttrId
              AND pn.store_id = 0
          LEFT JOIN (
              SELECT run_id, COUNT(*) AS enrolled
                FROM `$enrolTbl`
               GROUP BY run_id
          ) en ON en.run_id = cr.run_id
          LEFT JOIN (
              SELECT i.run_id, i.status, i.trainer_name
                FROM `$invTbl` i
               INNER JOIN (
                   SELECT run_id, MAX(id) AS max_id FROM `$invTbl` GROUP BY run_id
               ) latest ON latest.run_id = i.run_id AND latest.max_id = i.id
          ) inv ON inv.run_id = cr.run_id
         WHERE cr.course_start_date IS NOT NULL
           AND $_whereBucket
           $_whereStore
         ORDER BY $_orderBy
         LIMIT $_pageSize OFFSET $_offset
    ");
}
$_totalPages = $_totalRows > 0 ? (int) ceil($_totalRows / $_pageSize) : 1;

$trainerMap = array();
try {
    $trainerRows = $read->fetchAll("
        SELECT eov.option_id, eov.value AS label
          FROM " . $resource->getTableName('eav_attribute_option_value') . " eov
         WHERE eov.store_id = 0
    ");
    foreach ($trainerRows as $tr) {
        $trainerMap[(int)$tr['option_id']] = $tr['label'];
    }
} catch (Exception $e) { /* non-fatal */ }

// Batch-load approved trainer lists per product for the invite dropdown.
$productTrainerMap = array(); // product_id => [{oid, name}, ...]
try {
    $trainersAttrId = (int) $read->fetchOne(
        "SELECT attribute_id FROM " . $resource->getTableName('eav_attribute')
      . " WHERE attribute_code = 'trainers' AND entity_type_id = 4"
    );
    if ($trainersAttrId && !empty($rows)) {
        $pids    = array_values(array_unique(array_map(function($r){ return (int)$r['product_id']; }, $rows)));
        $pidList = implode(',', $pids);
        $csvRows = $read->fetchAll(
            "SELECT entity_id, value FROM " . $resource->getTableName('catalog_product_entity_text')
          . " WHERE attribute_id = $trainersAttrId AND store_id = 0 AND entity_id IN ($pidList)"
        );
        foreach ($csvRows as $cr) {
            $oids = array_filter(array_map('intval', explode(',', (string)$cr['value'])));
            $list = array();
            foreach ($oids as $oid) {
                if (isset($trainerMap[$oid])) {
                    $list[] = array('oid' => $oid, 'name' => $trainerMap[$oid]);
                }
            }
            $productTrainerMap[(int)$cr['entity_id']] = $list;
        }
    }
} catch (Exception $e) { /* non-fatal */ }

// Phase 2 — account-first trainer resolution. A run's assigned trainer is
// resolved from the account pointer (trainer_user_id) first, then the legacy
// EAV pointer (trainer_option_id). Batch resolver = two queries, no N+1.
$runTrainerNames = array(); // run_id => trainer name
try {
    $runTrainerNames = Mage::helper('mmd_rolemanager/trainer')->resolveRunTrainerNames($rows);
} catch (Exception $e) { /* non-fatal */ }

// Account-based approved pool per product (mmd_product_trainer) for the
// invite dropdown — preferred over the legacy EAV list (hybrid fallback).
$productAccountMap = array(); // product_id => [{uid, name}, ...]
try {
    if (!empty($rows)) {
        $ptTbl   = $resource->getTableName('mmd_product_trainer');
        $auTbl   = $resource->getTableName('admin_user');
        $pids    = array_values(array_unique(array_map(function($r){ return (int)$r['product_id']; }, $rows)));
        $pidList = implode(',', $pids);
        $accRows = $read->fetchAll(
            "SELECT pt.product_id, pt.user_id,
                    TRIM(CONCAT(COALESCE(u.firstname,''),' ',COALESCE(u.lastname,''))) AS name, u.email
               FROM `$ptTbl` pt
               JOIN `$auTbl` u ON u.user_id = pt.user_id
              WHERE pt.product_id IN ($pidList)
              ORDER BY pt.product_id, pt.sort_order, pt.id"
        );
        foreach ($accRows as $ar) {
            $nm = trim((string)$ar['name']); if ($nm === '') $nm = (string)$ar['email'];
            $productAccountMap[(int)$ar['product_id']][] = array('uid' => (int)$ar['user_id'], 'name' => $nm);
        }
    }
} catch (Exception $e) { /* non-fatal */ }

