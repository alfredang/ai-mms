                        <div style="display:flex;align-items:center;gap:8px;">
                            <button id="cls-pause-btn-<?php echo (int)$r['run_id'] ?>"
                                    type="button"
                                    onclick="clsToggleFlag(<?php echo (int)$r['run_id'] ?>, 'invitation_paused', this)"
                                    data-value="<?php echo $isPaused ? '1' : '0' ?>"
                                    style="padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid <?php echo $isPaused ? 'rgba(245,158,11,.4)' : '#334155' ?>;background:<?php echo $isPaused ? 'rgba(245,158,11,.15)' : 'transparent' ?>;color:<?php echo $isPaused ? '#f59e0b' : '#64748b' ?>;">
                                <?php echo $isPaused ? 'Unpause Invite' : 'Pause Invite' ?>
                            </button>
                            <button id="cls-block-btn-<?php echo (int)$r['run_id'] ?>"
                                    type="button"
                                    onclick="clsToggleFlag(<?php echo (int)$r['run_id'] ?>, 'invitation_replies_blocked', this)"
                                    data-value="<?php echo $isBlocked ? '1' : '0' ?>"
                                    style="padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid <?php echo $isBlocked ? 'rgba(239,68,68,.4)' : '#334155' ?>;background:<?php echo $isBlocked ? 'rgba(239,68,68,.15)' : 'transparent' ?>;color:<?php echo $isBlocked ? '#f87171' : '#64748b' ?>;">
                                <?php echo $isBlocked ? 'Unblock Reply' : 'Block Reply' ?>
                            </button>
                        </div>
                    </div>
                </td>
            </tr>
        <?php endforeach; ?>
        <?php if (empty($rows)): ?>
            <tr><td colspan="12" style="padding:48px 12px;text-align:center;color:#64748b">
                <?php echo htmlspecialchars($_emptyMsg) ?>
            </td></tr>
        <?php endif; ?>
        </tbody>
    </table>
    </div>

    <?php
        // Server-rendered pagination. Each link preserves the current
        // bucket (?bucket=all|ongoing|upcoming|completed) and bumps
        // ?page=. Old client-side paginator (rm-pagination-summary /
        // -controls) hid rows in JS but still had every row in the
        // DOM — same browser-crash problem.
        $_pageBase = Mage::helper('adminhtml')->getUrl(
            '*/*/index',
            array('bucket' => $_bucket, '_query' => array())
        );
        $_pageBase = preg_replace('#[?&]page=\d+#i', '', $_pageBase);
        $_pageBase = rtrim($_pageBase, '?&');
        $_pageJoin = strpos($_pageBase, '?') === false ? '?' : '&';
        $_firstOfPage = $_totalRows > 0 ? (($_curPage - 1) * $_pageSize + 1) : 0;
        $_lastOfPage  = $_totalRows > 0 ? min($_curPage * $_pageSize, $_totalRows) : 0;
    ?>
    <div class="rm-pagination">
        <div class="rm-pagination-summary">
            <?php if ($_totalRows > 0): ?>
                Showing <?php echo $_firstOfPage ?>–<?php echo $_lastOfPage ?> of <?php echo number_format($_totalRows) ?>
            <?php else: ?>
                No classes
            <?php endif; ?>
        </div>
        <div class="rm-pagination-controls">
            <?php if ($_totalPages > 1): ?>
                <?php $_prev = max(1, $_curPage - 1); $_next = min($_totalPages, $_curPage + 1); ?>
                <a href="<?php echo $_pageBase . $_pageJoin . 'page=' . $_prev ?>"
                   class="rm-pagination-btn<?php echo $_curPage <= 1 ? ' disabled' : '' ?>"
                   <?php echo $_curPage <= 1 ? 'onclick="event.preventDefault()"' : '' ?>>&#8592; Prev</a>

                <?php
                    // Compact page list: 1, current-1, current, current+1, last, with ellipses.
                    $_toShow = array_unique(array_filter(
                        array(1, $_curPage - 1, $_curPage, $_curPage + 1, $_totalPages),
                        function($n) use ($_totalPages) { return $n >= 1 && $n <= $_totalPages; }
                    ));
                    sort($_toShow);
                    $_last = 0;
                    foreach ($_toShow as $_n):
                        if ($_last && ($_n - $_last) > 1): ?>
                            <span class="rm-pagination-ellipsis">…</span>
                        <?php endif; ?>
                        <a href="<?php echo $_pageBase . $_pageJoin . 'page=' . $_n ?>"
                           class="rm-pagination-btn<?php echo $_n === $_curPage ? ' active' : '' ?>"><?php echo $_n ?></a>
                    <?php $_last = $_n; endforeach; ?>

                <a href="<?php echo $_pageBase . $_pageJoin . 'page=' . $_next ?>"
                   class="rm-pagination-btn<?php echo $_curPage >= $_totalPages ? ' disabled' : '' ?>"
                   <?php echo $_curPage >= $_totalPages ? 'onclick="event.preventDefault()"' : '' ?>>Next &#8594;</a>
            <?php endif; ?>
        </div>
    </div>
</div>

<script type="text/javascript">
var CLS_SEND_INVITE_URL  = '<?php echo $this->jsQuoteEscape($_sendInviteUrl) ?>';
var CLS_UPDATE_FLAGS_URL = '<?php echo $this->jsQuoteEscape($_updateFlagsUrl) ?>';
var CLS_AUTO_INV_URL     = '<?php echo $this->jsQuoteEscape($_autoInviteUrl) ?>';
var CLS_WINDOW_URL       = '<?php echo $this->jsQuoteEscape($_autoWindowUrl) ?>';

// Save the auto-invite look-ahead window (days). Shares the spinner/result UI.
function autoInvWindowSet(inp) {
    var d = parseInt(inp.value, 10) || 30; if (d < 1) d = 1; if (d > 365) d = 365; inp.value = d;
    inp.disabled = true; autoInvStartSpin();
    var fd = new FormData(); fd.append('days', d); fd.append('form_key', window.FORM_KEY || '');
    fetch(CLS_WINDOW_URL, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(j){ inp.disabled = false; autoInvStopSpin(); autoInvShowResult(!!j.success, j.success ? ('Window: ' + j.days + ' days') : (j.message || 'Failed')); })
        .catch(function(){ inp.disabled = false; autoInvStopSpin(); autoInvShowResult(false, 'Network error'); });
}

var _autoInvSpin = null;
var _autoInvResultTimer = null;
function autoInvStartSpin() {
    var el = document.getElementById('auto-inv-spinner');
    if (!el) return;
    if (_autoInvResultTimer) { clearTimeout(_autoInvResultTimer); _autoInvResultTimer = null; }
    el.style.color = '#60a5fa';
    el.removeAttribute('title');
    var frames = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'];
    var i = 0;
    el.textContent = frames[0];
    _autoInvSpin = setInterval(function(){ i = (i + 1) % frames.length; el.textContent = frames[i]; }, 80);
}
function autoInvStopSpin() {
    if (_autoInvSpin) { clearInterval(_autoInvSpin); _autoInvSpin = null; }
}
function autoInvShowResult(ok, msg) {
    var el = document.getElementById('auto-inv-spinner');
    if (!el) return;
    el.textContent = ok ? '✓' : '✗';
    el.style.color = ok ? '#22c55e' : '#ef4444';
    if (msg) el.setAttribute('title', msg); else el.removeAttribute('title');
    _autoInvResultTimer = setTimeout(function(){
        el.textContent = '';
        el.style.color = '#60a5fa';
        el.removeAttribute('title');
        _autoInvResultTimer = null;
    }, 2500);
}

function autoInvSet(cb) {
    var val = cb.checked ? 1 : 0;
    // Hold the knob at its previous position until the server confirms — the
    // native checkbox already flipped on click, so revert the visual now and
    // only commit it on a successful response.
    cb.checked = (val === 0);
    if (val === 1 && !confirm('Enable automated trainer invitation emails?\n\nThe cron sweep will email the next eligible trainer for upcoming classes twice a week.')) {
        return; // cancelled — knob stays at previous state
    }
    cb.disabled = true;
    autoInvStartSpin();
    var fd = new FormData();
    fd.append('value', val);
    fd.append('form_key', window.FORM_KEY || '');
    fetch(CLS_AUTO_INV_URL, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(d){
            cb.disabled = false;
            autoInvStopSpin();
            if (!d.success) {
                autoInvShowResult(false, d.message || 'Failed to update'); // knob unchanged
                return;
            }
            var on = (d.value === 1);
            cb.checked = on; // commit the knob only on success
            cb.closest('.dcf-toggle-sw').setAttribute('title', on ? 'Automated invitations ON' : 'Automated invitations OFF');
            var banner = document.getElementById('auto-inv-banner');
            if (banner) {
                banner.style.borderColor = on ? 'rgba(34,197,94,.3)' : 'rgba(100,116,139,.25)';
                banner.style.background   = on ? 'rgba(34,197,94,.08)' : 'rgba(100,116,139,.06)';
            }
            autoInvShowResult(true);
        })
        .catch(function(){
            cb.disabled = false;
            autoInvStopSpin();
            autoInvShowResult(false, 'Network error'); // knob unchanged
        });
}

function clsToggleExpand(runId) {
    var row = document.getElementById('cls-expand-' + runId);
    if (!row) return;
    row.style.display = (row.style.display === 'none') ? '' : 'none';
}

function clsUpdateInviteBtn(runId) {
    var sel = document.getElementById('cls-sel-' + runId);
    var btn = document.getElementById('cls-invite-btn-' + runId);
    if (!sel || !btn) return;
    var firstName = sel.value ? sel.value.split(' ')[0] : '';
    btn.textContent = firstName ? ('Invite: ' + firstName + '…') : 'Invite Next';
}

function clsSendInvitation(runId, btn) {
    var sel = document.getElementById('cls-sel-' + runId);
    var statusEl = document.getElementById('cls-inv-status-' + runId);
    var orig = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    if (statusEl) statusEl.textContent = '';
    var fd = new FormData();
    fd.append('run_id', runId);
    fd.append('trainer_name', sel ? sel.value : '');
    fd.append('form_key', window.FORM_KEY || '');
    fetch(CLS_SEND_INVITE_URL, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            btn.disabled = false;
            btn.textContent = orig;
            if (statusEl) {
                statusEl.style.color = d.success ? '#10b981' : '#f87171';
                statusEl.textContent = (d.success ? '✓ ' : '✗ ') + (d.message || '');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = orig;
            if (statusEl) { statusEl.style.color = '#f87171'; statusEl.textContent = '✗ Network error'; }
        });
}

function clsToggleFlag(runId, flag, btn) {
    var cur = parseInt(btn.getAttribute('data-value') || '0', 10);
    var val = cur ? 0 : 1;
    btn.disabled = true;
    var fd = new FormData();
    fd.append('run_id', runId);
    fd.append('flag', flag);
    fd.append('value', val);
    fd.append('form_key', window.FORM_KEY || '');
    fetch(CLS_UPDATE_FLAGS_URL, { method: 'POST', body: fd, credentials: 'same-origin' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            btn.disabled = false;
            if (!d.success) return;
            btn.setAttribute('data-value', val);
            if (flag === 'invitation_paused') {
                btn.textContent      = val ? 'Unpause Invite' : 'Pause Invite';
                btn.style.background = val ? 'rgba(245,158,11,.15)' : 'transparent';
                btn.style.color      = val ? '#f59e0b' : '#64748b';
                btn.style.borderColor = val ? 'rgba(245,158,11,.4)' : '#334155';
            } else {
                btn.textContent      = val ? 'Unblock Reply' : 'Block Reply';
                btn.style.background = val ? 'rgba(239,68,68,.15)' : 'transparent';
                btn.style.color      = val ? '#f87171' : '#64748b';
                btn.style.borderColor = val ? 'rgba(239,68,68,.4)' : '#334155';
            }
        })
        .catch(function() { btn.disabled = false; });
}

// Search + state filter — only hides/shows rows on the CURRENT
// server-rendered page. With server-side pagination, the full
// dataset isn't in the DOM anymore, so cross-page search is a
// PHP-level concern. Acceptable trade-off: every page only has
// 50 rows now, so the user can flip through quickly. If/when
// cross-page search is needed, push `q=` into the SQL where
// clause alongside the pagination params.
function rmFilter() {
    var q  = (document.getElementById('rm-search') || {value: ''}).value.toLowerCase();
    var sf = (document.getElementById('rm-state-filter') || {value: ''}).value;
    var rows = document.querySelectorAll('.rm-row');
    for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var hay = (r.getAttribute('data-class-id') || '') + ' ' +
                  (r.getAttribute('data-sku') || '') + ' ' +
                  (r.getAttribute('data-title') || '');
        var matchQ = !q || hay.indexOf(q) >= 0;
        var matchS = !sf || r.getAttribute('data-state') === sf;
        var show = matchQ && matchS;
        r.style.display = show ? '' : 'none';
        // Keep expansion row in sync with its parent.
        var runId = r.getAttribute('data-run-id');
        if (runId) {
            var exp = document.getElementById('cls-expand-' + runId);
            if (exp && !show) exp.style.display = 'none';
        }
    }
}

// Initial pass picks up any state retained by the browser's
// back/forward cache (e.g. user typed in search then hit back).
// Clear browser-autofilled usernames from the search box first (Chrome
// ignores autocomplete=off on username-shaped fields); re-check twice
// because autofill can land after DOM ready.
(function() {
    function rmClearAutofill() {
        var s = document.getElementById('rm-search');
        if (s && s.value !== '') { s.value = ''; rmFilter(); }
    }
    rmClearAutofill();
    rmFilter();
    setTimeout(rmClearAutofill, 300);
    setTimeout(rmClearAutofill, 1000);
})();
</script>
