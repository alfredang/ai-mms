<?php
/**
 * Malaysia-aware sync — dry-run / audit report for one run (standalone, printable).
 * Rendered by MMD_RoleManager_Adminhtml_CoursesyncController::reportAction().
 *
 * @var Mage_Adminhtml_Block_Template $this
 */
$_svc  = Mage::getModel('mmd_rolemanager/sync_malaysiaSync');
$_run  = $_svc->getRun($this->getRunId());
$_rows = $_run ? $_svc->getChanges($_run['run_id']) : array();
$_sum  = $_run ? (json_decode((string) $_run['summary'], true) ?: array()) : array();
$_e    = function ($s) { return htmlspecialchars((string) $s, ENT_QUOTES, 'UTF-8'); };
$_show = function ($json) use ($_e) {
    $v = json_decode((string) $json, true);
    if (is_array($v) && array_key_exists(0, $v) && count($v) <= 2 && array_key_exists(2, $v)) {
        $v = $v[2] !== null ? $v[2] : $v[0];   // attr before value: Malaysia override, else default
    }
    if (is_array($v)) {
        $v = isset($v['attrs']['name']) ? $v['attrs']['name'] . ' — draft, fee RM' . number_format($v['price'], 0)
            : (isset($v['url_key']) ? ($v['name'] ?? $v['url_key']) . ' — new hidden category' : implode(', ', $v));
    }
    $t = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags(preg_replace('#<!--.*?-->#s', '', (string) $v)), ENT_QUOTES, 'UTF-8')));
    return $_e(mb_strlen($t) > 240 ? mb_substr($t, 0, 240) . '…' : $t);
};
$_kinds = array('create' => 'New', 'attr' => 'Field', 'categories' => 'Categories', 'redirect' => '301', 'redirect_flatten' => '301 re-point',
    'redirect_keep' => '301 (old category URL)', 'notice' => 'Review');
$_catNames = function ($json) use ($_e) {   // categories: before = {id: position}, after = [id, …]
    $v = (array) json_decode((string) $json, true);
    $ids = array_values($v) === $v ? $v : array_keys($v);
    $names = array();
    foreach ($ids as $id) {
        $names[] = Mage::getModel('catalog/category')->setStoreId(0)->load((int) $id)->getName() ?: '#' . $id;
    }
    return $_e(implode(', ', $names));
};
?><!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Malaysia sync report #<?php echo (int) ($_run['run_id'] ?? 0) ?></title>
<style>
body{font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#1f2937;margin:24px;}
h1{font-size:18px;margin:0 0 6px;} h2{font-size:14px;margin:18px 0 6px;}
table{border-collapse:collapse;width:100%;} th,td{border-bottom:1px solid #e5e7eb;padding:4px 6px;text-align:left;vertical-align:top;}
th{font-size:11px;text-transform:uppercase;color:#6b7280;} .muted{color:#6b7280;} .k-notice td{background:#fffbeb;}
.k-create td{background:#f0fdf4;} ul{margin:4px 0 0 18px;padding:0;} li{margin:2px 0;}
</style></head><body>
<?php if (!$_run): ?>
<p>Sync run not found.</p>
<?php else: ?>
<h1>Malaysia sync — <?php echo $_e($_run['op']) ?> — run #<?php echo (int) $_run['run_id'] ?> (<?php echo $_e(str_replace('_', ' ', $_run['status'])) ?>)</h1>
<div class="muted">
    Dry run <?php echo $_e($_run['planned_at'] . ' by ' . $_run['planned_by']) ?>
    <?php if ($_run['applied_at']): ?> · applied <?php echo $_e($_run['applied_at'] . ' by ' . $_run['applied_by']) ?><?php endif; ?>
    <?php if ($_run['rolled_back_at']): ?> · rolled back <?php echo $_e($_run['rolled_back_at'] . ' by ' . $_run['rolled_back_by']) ?><?php endif; ?>
    <?php if ($_run['scope']): ?> · course <?php echo $_e($_run['scope']) ?><?php endif; ?>
</div>
<p><?php echo $_e(implode(' · ', array_map(function ($k, $v) { return str_replace('_', ' ', $k) . ': ' . $v; }, array_keys($_sum), $_sum))) ?></p>

<h2>Sync rules (Malaysia)</h2>
<ul>
    <li>Copied from Singapore (master): course title, overview, outline, learning outcomes, prerequisites, audience, notes, duration, level, cover image, shared categories.</li>
    <li>Localised automatically: WSQ, SkillsFuture, SSG, UTAP, IBF, PSEA, SFEC, SWDA and Singapore regulator wording removed; Singapore links, addresses and company name replaced; Singapore funding sections removed. All courses are presented as HRD Corp claimable.</li>
    <li>Generated for Malaysia: page title (template "[Course] Training Malaysia | HRD Corp Claimable"), meta description (max 160 characters), keywords without Singapore terms, .com.my URL without "singapore" / "wsq" / "skillsfuture".</li>
    <li>Never changed: Malaysia prices, schedules and class dates (incl. "2 evenings" labels), trainers, delivery modes, course status, registration-only checkout and sponsorship fields. Singapore prices, GST, payment methods, addresses and contact details are never imported.</li>
    <li>A changed URL gets one-step permanent 301s from every old URL; older redirects to it are re-pointed (no chains).</li>
    <li>New Singapore courses are created as disabled drafts (Malaysia fee: RM1,100 per day, RM1,500 per day for certification courses) for review before publishing.</li>
    <li>Singapore-only categories (WSQ, SkillsFuture, IBF, UTAP, PSEA, SFEC) are skipped; new shared categories are created hidden for review.</li>
    <li>Nothing changes until an admin applies this dry run; every applied run is logged here with before/after values and can be rolled back.</li>
</ul>

<h2>Changes (<?php echo count($_rows) ?>)</h2>
<table>
    <tr><th>Course / category</th><th>Type</th><th>Field</th><th>Before (Malaysia now)</th><th>After</th><th>Outcome</th></tr>
    <?php foreach ($_rows as $_c): ?>
    <tr class="k-<?php echo $_e($_c['kind']) ?>">
        <td><?php echo $_e($_c['ref']) ?></td>
        <td><?php echo $_e($_kinds[$_c['kind']] ?? $_c['kind']) ?></td>
        <td class="muted"><?php echo $_e($_c['field']) ?></td>
        <?php if ($_c['kind'] === 'categories'): ?>
        <td class="muted"><?php echo $_catNames($_c['old_value']) ?></td>
        <td><?php echo $_catNames($_c['new_value']) ?></td>
        <?php else: ?>
        <td class="muted"><?php echo $_c['kind'] === 'notice' ? '' : ($_c['kind'] === 'redirect_keep' ? $_e(json_decode($_c['old_value'], true)['request_path'] ?? '') : $_show($_c['old_value'])) ?></td>
        <td><?php echo $_show($_c['new_value']) ?></td>
        <?php endif; ?>
        <td class="muted"><?php echo $_e($_c['outcome']) ?></td>
    </tr>
    <?php endforeach; ?>
</table>
<?php endif; ?>
</body></html>
