.mmd-cal-mini-day { display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; font-size:10.5px; color:var(--t4); border-radius:4px; text-decoration:none; }
a.mmd-cal-mini-day:hover { color:var(--t1); text-decoration:none; }
.mmd-cal-mini-day.has-events { color:var(--blue); font-weight:700; border:1px solid rgba(96,165,250,0.35); }
