.mmd-cal-mini-title:hover { color:var(--blue); text-decoration:none; }
.mmd-cal-mini table { width:100%; border-collapse:collapse; table-layout:fixed; }
.mmd-cal-mini th { font-size:9.5px; color:var(--t5); font-weight:600; text-align:center; padding:2px 0; }
