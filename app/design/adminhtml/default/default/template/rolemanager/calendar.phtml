</style>
<div class="mmd-cal-wrap">
    <h1 class="mmd-cal-title" style="margin:0 0 10px;"><?php echo $this->__($_pageTitle) ?></h1>

    <div class="mmd-cal-toolbar">
        <div class="mmd-cal-nav">
            <a class="mmd-cal-view-btn" href="<?php echo $_calUrl($_view, $_prev) ?>">&larr; Prev</a>
            <a class="mmd-cal-view-btn" href="<?php echo $_calUrl($_view, $_today) ?>">Today</a>
            <a class="mmd-cal-view-btn" href="<?php echo $_calUrl($_view, $_next) ?>">Next &rarr;</a>
            <span class="mmd-cal-label"><?php echo $this->escapeHtml($_label) ?></span>
        </div>
        <div class="mmd-cal-views">
            <?php foreach (array('day' => 'Day', 'month' => 'Month', 'year' => 'Year') as $_vk => $_vl): ?>
            <a class="mmd-cal-view-btn<?php echo ($_view === $_vk) ? ' active' : '' ?>" href="<?php echo $_calUrl($_vk, $_anchor) ?>"><?php echo $_vl ?></a>
            <?php endforeach; ?>
        </div>
    </div>

<?php if ($_view === 'month'): ?>
    <?php
    $_daysInMonth = (int) date('t', strtotime($_rangeStart));
    $_startDow    = ((int) date('N', strtotime($_rangeStart))) - 1; // Mon=0
    $_cells       = array();
    for ($i = 0; $i < $_startDow; $i++) $_cells[] = null;
    for ($d = 1; $d <= $_daysInMonth; $d++) $_cells[] = $d;
    while (count($_cells) % 7 !== 0) $_cells[] = null;
    ?>
    <table class="mmd-cal-grid">
        <thead>
            <tr><?php foreach (array('Mon','Tue','Wed','Thu','Fri','Sat','Sun') as $_dw): ?><th><?php echo $_dw ?></th><?php endforeach; ?></tr>
        </thead>
        <tbody>
        <?php foreach (array_chunk($_cells, 7) as $_week): ?>
            <tr>
            <?php foreach ($_week as $_d): ?>
                <?php if ($_d === null): ?>
                <td class="mmd-cal-cell-out"></td>
                <?php else:
                    $_date   = sprintf('%04d-%02d-%02d', $_aY, $_aM, $_d);
                    $_events = isset($eventsByDate[$_date]) ? $eventsByDate[$_date] : array();
                ?>
                <td class="<?php echo ($_date === $_today) ? 'mmd-cal-cell-today' : '' ?>">
                    <span class="mmd-cal-daynum"><?php echo $_d ?></span>
                    <?php foreach (array_slice($_events, 0, 3) as $r):
                        $_tip = $r['class_id'] . ' — ' . $r['course_title']
                              . ($_fmtTime($r) ? ' (' . $_fmtTime($r) . ')' : '')
                              . ($_mode === 'admin' && $r['trainer_name'] !== '' ? ' · ' . $r['trainer_name'] : '');
                    ?>
                    <a class="mmd-cal-chip" href="<?php echo $_calUrl('day', $_date) ?>" title="<?php echo $this->escapeHtml($_tip) ?>"><?php echo $this->escapeHtml($r['class_id'] . ' · ' . $r['course_title']) ?></a>
                    <?php endforeach; ?>
                    <?php if (count($_events) > 3): ?>
                    <a class="mmd-cal-more" href="<?php echo $_calUrl('day', $_date) ?>">+<?php echo count($_events) - 3 ?> more</a>
                    <?php endif; ?>
                </td>
                <?php endif; ?>
            <?php endforeach; ?>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
    <?php if (empty($eventsByDate)): ?>
    <div class="mmd-cal-empty">No confirmed classes in <?php echo $this->escapeHtml($_label) ?>.</div>
    <?php endif; ?>

<?php elseif ($_view === 'day'): ?>
    <?php
    $_events = isset($eventsByDate[$_anchor]) ? $eventsByDate[$_anchor] : array();
    $_cols   = 7 - (($_mode === 'trainer') ? 1 : 0) - (($_mode === 'learner') ? 1 : 0);
    ?>
    <table class="mm-table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Class ID</th>
                <th>Course</th>
                <th>Course Code</th>
                <?php if ($_mode !== 'trainer'): ?><th>Trainer</th><?php endif; ?>
                <?php if ($_mode !== 'learner'): ?><th class="num">Enrolled</th><?php endif; ?>
                <th>Dates</th>
            </tr>
        </thead>
        <tbody>
        <?php if (empty($_events)): ?>
            <tr><td colspan="<?php echo $_cols ?>" class="mm-table-empty">No confirmed classes on <?php echo $this->escapeHtml($_label) ?>.</td></tr>
        <?php else: foreach ($_events as $r):
            $_datesStr = date('d M Y', strtotime($r['course_start_date']));
            if (!empty($r['course_end_date']) && $r['course_end_date'] !== $r['course_start_date']) {
                $_datesStr .= ' – ' . date('d M Y', strtotime($r['course_end_date']));
            }
        ?>
            <tr>
                <td class="muted"><?php echo $this->escapeHtml($_fmtTime($r) ?: '—') ?></td>
                <td class="muted"><?php echo $this->escapeHtml($r['class_id']) ?></td>
                <td class="strong wrap"><?php echo $this->escapeHtml($r['course_title']) ?></td>
                <td class="muted"><?php echo $this->escapeHtml($r['course_sku']) ?></td>
                <?php if ($_mode !== 'trainer'): ?><td><?php echo $this->escapeHtml($r['trainer_name'] !== '' ? $r['trainer_name'] : '—') ?></td><?php endif; ?>
                <?php if ($_mode !== 'learner'): ?><td class="num"><?php echo (int)$r['enrolled'] ?></td><?php endif; ?>
                <td class="muted"><?php echo $this->escapeHtml($_datesStr) ?></td>
            </tr>
        <?php endforeach; endif; ?>
        </tbody>
    </table>

<?php else: /* year */ ?>
    <div class="mmd-cal-year">
        <?php for ($m = 1; $m <= 12; $m++):
            $_mStart = sprintf('%04d-%02d-01', $_aY, $m);
            $_mDays  = (int) date('t', strtotime($_mStart));
            $_mDow   = ((int) date('N', strtotime($_mStart))) - 1;
        ?>
        <div class="mmd-cal-mini">
            <a class="mmd-cal-mini-title" href="<?php echo $_calUrl('month', $_mStart) ?>"><?php echo date('F', strtotime($_mStart)) ?></a>
            <table>
                <thead>
                    <tr><?php foreach (array('M','T','W','T','F','S','S') as $_dw): ?><th><?php echo $_dw ?></th><?php endforeach; ?></tr>
                </thead>
                <tbody>
                <?php
                $_cells = array();
                for ($i = 0; $i < $_mDow; $i++) $_cells[] = null;
                for ($d = 1; $d <= $_mDays; $d++) $_cells[] = $d;
                while (count($_cells) % 7 !== 0) $_cells[] = null;
                foreach (array_chunk($_cells, 7) as $_week): ?>
                    <tr>
                    <?php foreach ($_week as $_d): ?>
                        <td>
                        <?php if ($_d !== null):
                            $_date = sprintf('%04d-%02d-%02d', $_aY, $m, $_d);
                            $_has  = !empty($eventsByDate[$_date]);
                            $_cls  = 'mmd-cal-mini-day' . ($_has ? ' has-events' : '') . (($_date === $_today) ? ' is-today' : '');
                        ?>
                            <?php if ($_has): ?>
                            <a class="<?php echo $_cls ?>" href="<?php echo $_calUrl('day', $_date) ?>" title="<?php echo count($eventsByDate[$_date]) ?> class<?php echo count($eventsByDate[$_date]) > 1 ? 'es' : '' ?>"><?php echo $_d ?></a>
                            <?php else: ?>
                            <span class="<?php echo $_cls ?>"><?php echo $_d ?></span>
                            <?php endif; ?>
                        <?php endif; ?>
                        </td>
                    <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <?php endfor; ?>
    </div>
    <?php if (empty($eventsByDate)): ?>
    <div class="mmd-cal-empty">No confirmed classes in <?php echo (int)$_aY ?>.</div>
    <?php endif; ?>
<?php endif; ?>
</div>
