<?php
/**
 * Class calendar — month (default) / day / year views over course_runs.
 *
 * Block data:
 *   mode — 'trainer' (own assigned classes) | 'learner' (own enrolled
 *          classes) | 'admin' (all trainers' classes)
 *
 * Invariants:
 *   - CONFIRMED classes only: a trainer is assigned (trainer_user_id or
 *     trainer_option_id set).
 *   - C-prefix course codes only — TGS-/M-/other SKUs never render here.
 *
 * URL params: ?view=month|day|year&date=YYYY-MM-DD (anchor date).
 */
$_mode = (string) $this->getData('mode');
if (!in_array($_mode, array('trainer', 'learner', 'admin'), true)) {
    $_mode = 'admin';
}

$_req  = Mage::app()->getRequest();
$_view = (string) $_req->getParam('view', 'month');
if (!in_array($_view, array('month', 'day', 'year'), true)) {
    $_view = 'month';
}

$_today  = Mage::getModel('core/date')->date('Y-m-d');
$_anchor = (string) $_req->getParam('date', $_today);
$_parts  = explode('-', $_anchor);
if (count($_parts) !== 3 || !checkdate((int)$_parts[1], (int)$_parts[2], (int)$_parts[0])) {
    $_anchor = $_today;
}
list($_aY, $_aM, $_aD) = array_map('intval', explode('-', $_anchor));

// Visible date range per view.
switch ($_view) {
    case 'day':
        $_rangeStart = $_rangeEnd = $_anchor;
        break;
    case 'year':
        $_rangeStart = sprintf('%04d-01-01', $_aY);
        $_rangeEnd   = sprintf('%04d-12-31', $_aY);
        break;
    default: // month
        $_rangeStart = sprintf('%04d-%02d-01', $_aY, $_aM);
        $_rangeEnd   = date('Y-m-t', strtotime($_rangeStart));
        break;
}

$resource  = Mage::getSingleton('core/resource');
$read      = $resource->getConnection('core_read');
$runsTbl   = $resource->getTableName('course_runs');
$enrolTbl  = $resource->getTableName('course_run_enrolments');
$pVarchar  = $resource->getTableName('catalog_product_entity_varchar');
$pEntity   = $resource->getTableName('catalog_product_entity');
$eavOptVal = $resource->getTableName('eav_attribute_option_value');
$auTbl     = $resource->getTableName('admin_user');

$nameAttrId = (int) $read->fetchOne("
    SELECT a.attribute_id
      FROM " . $resource->getTableName('eav_attribute') . " a
      INNER JOIN " . $resource->getTableName('eav_entity_type') . " t ON t.entity_type_id = a.entity_type_id
     WHERE t.entity_type_code = 'catalog_product' AND a.attribute_code = 'name'
");

// Learner scope: enrolment rows matching the signed-in user's email.
$_learnerWhere = '';
if ($_mode === 'learner') {
    $u = Mage::getSingleton('admin/session')->getUser();
    $_learnerEmail = $u ? strtolower(trim((string) $u->getEmail())) : '';
    $_learnerWhere = "AND EXISTS (
        SELECT 1 FROM `$enrolTbl` le
         WHERE le.run_id = cr.run_id
           AND LOWER(TRIM(le.learner_email)) = " . $read->quote($_learnerEmail) . "
    )";
}

$rows = array();
if ($nameAttrId) {
    $rows = $read->fetchAll("
        SELECT cr.run_id, cr.class_id, cr.product_id,
               COALESCE(NULLIF(TRIM(pe.sku), ''), cr.course_sku) AS course_sku,
               cr.course_start_date, cr.course_end_date,
               cr.course_start_time, cr.course_end_time,
               cr.trainer_option_id, cr.trainer_user_id,
               COALESCE(pn.value, '(deleted product)') AS course_title,
               COALESCE(en.enrolled, 0) AS enrolled,
               COALESCE(
                   NULLIF(TRIM(CONCAT(COALESCE(au.firstname,''),' ',COALESCE(au.lastname,''))), ''),
                   tov.value, ''
               ) AS trainer_name
          FROM `$runsTbl` cr
          LEFT JOIN `$pEntity` pe ON pe.entity_id = cr.product_id
          LEFT JOIN `$pVarchar` pn
               ON pn.entity_id = cr.product_id
              AND pn.attribute_id = $nameAttrId
              AND pn.store_id = 0
          LEFT JOIN (
              SELECT run_id, COUNT(*) AS enrolled FROM `$enrolTbl` GROUP BY run_id
          ) en ON en.run_id = cr.run_id
          LEFT JOIN `$auTbl` au ON au.user_id = cr.trainer_user_id
          LEFT JOIN `$eavOptVal` tov
               ON tov.option_id = cr.trainer_option_id AND tov.store_id = 0
         WHERE cr.course_start_date IS NOT NULL
           AND cr.course_start_date <= " . $read->quote($_rangeEnd) . "
           AND COALESCE(cr.course_end_date, cr.course_start_date) >= " . $read->quote($_rangeStart) . "
           AND (cr.trainer_user_id > 0 OR cr.trainer_option_id > 0)
           AND COALESCE(NULLIF(TRIM(pe.sku), ''), cr.course_sku) REGEXP '^C[0-9]'
           $_learnerWhere
         ORDER BY cr.course_start_date ASC, cr.course_start_time ASC
    ");
}

// Trainer scope: keep only runs assigned to the signed-in trainer —
// account pointer first, then legacy EAV email match (courses_trainers),
// then full-name fallback. Mirrors MMD_Attendance_Helper_Data::_filterToTrainer.
if ($_mode === 'trainer' && !empty($rows)) {
    $u     = Mage::getSingleton('admin/session')->getUser();
    $uid   = $u ? (int) $u->getId() : 0;
    $email = $u ? strtolower(trim((string) $u->getEmail())) : '';
    $name  = $u ? strtolower(trim($u->getFirstname() . ' ' . $u->getLastname())) : '';

    $myOptionIds = array();
    try {
        $ids = $read->fetchCol(
            "SELECT relation_id FROM " . $resource->getTableName('courses_trainers')
          . " WHERE LOWER(TRIM(email)) = ?",
            array($email)
        );
        foreach ($ids as $id) $myOptionIds[(int)$id] = true;
    } catch (Exception $e) { /* non-fatal */ }

    $rows = array_values(array_filter($rows, function ($r) use ($uid, $myOptionIds, $name) {
        $matchAccount = $uid > 0 && (int)$r['trainer_user_id'] === $uid;
        $matchEmail   = (int)$r['trainer_option_id'] > 0 && isset($myOptionIds[(int)$r['trainer_option_id']]);
        $matchName    = $name !== '' && strtolower(trim((string)$r['trainer_name'])) === $name;
        return $matchAccount || $matchEmail || $matchName;
    }));
}

// Expand each run onto every visible day it spans.
$eventsByDate = array(); // 'Y-m-d' => [row, ...]
foreach ($rows as $r) {
    $s = max((string)$r['course_start_date'], $_rangeStart);
    $e = min((string)($r['course_end_date'] ?: $r['course_start_date']), $_rangeEnd);
    $ts = strtotime($s);
    $te = strtotime($e);
    if ($ts === false || $te === false) continue;
    for ($t = $ts; $t <= $te; $t += 86400) {
        $eventsByDate[date('Y-m-d', $t)][] = $r;
    }
}

$_calUrl = function ($view, $date) {
    return Mage::helper('adminhtml')->getUrl('adminhtml/calendar/index', array('view' => $view, 'date' => $date));
};

// Prev / next anchors per view.
switch ($_view) {
    case 'day':
        $_prev = date('Y-m-d', strtotime($_anchor . ' -1 day'));
        $_next = date('Y-m-d', strtotime($_anchor . ' +1 day'));
        $_label = date('D, d M Y', strtotime($_anchor));
        break;
    case 'year':
        $_prev = sprintf('%04d-01-01', $_aY - 1);
        $_next = sprintf('%04d-01-01', $_aY + 1);
        $_label = sprintf('%04d', $_aY);
        break;
    default:
        $_prev = date('Y-m-d', strtotime($_rangeStart . ' -1 month'));
        $_next = date('Y-m-d', strtotime($_rangeStart . ' +1 month'));
        $_label = date('F Y', strtotime($_rangeStart));
        break;
}

$_pageTitle = ($_mode === 'admin') ? 'Training Calendar' : 'My Calendar';
$_fmtTime = function ($r) {
    if (empty($r['course_start_time'])) return '';
    $out = date('H:i', strtotime($r['course_start_time']));
    if (!empty($r['course_end_time'])) {
        $out .= '–' . date('H:i', strtotime($r['course_end_time']));
    }
    return $out;
};
?>
<style>
