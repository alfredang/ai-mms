    <script type="text/javascript">
    //<![CDATA[
    function $(id) { return document.getElementById(id); }

    function togglePw() {
        var inp = $('login');
        var open = $('pw-eye-open');
        var closed = $('pw-eye-closed');
        if (inp.type === 'password') {
            inp.type = 'text';
            open.style.display = 'none';
            closed.style.display = 'block';
        } else {
            inp.type = 'password';
            open.style.display = 'block';
            closed.style.display = 'none';
        }
    }

    function switchTab(tab) {
        var passwordForm = $('loginForm');
        var otpForm = $('otpForm');
        var otpEmail  = $('otp-email');
        var pwdEmail  = $('username');
        if (tab === 'otp') {
            if (pwdEmail && pwdEmail.value && otpEmail && !otpEmail.value) otpEmail.value = pwdEmail.value;
            passwordForm.classList.add('hidden');
            otpForm.classList.remove('hidden');
        } else {
            if (otpEmail && otpEmail.value && pwdEmail) pwdEmail.value = otpEmail.value;
            passwordForm.classList.remove('hidden');
            otpForm.classList.add('hidden');
            if (pwdEmail && pwdEmail.value) {
                var pwd = $('login');
                if (pwd) pwd.focus();
            }
        }
    }

    function sendOtp() {
        var email = $('otp-email').value.trim();
        if (!email) { alert('Please enter your email address'); return; }

        var btn = $('btn-send-otp');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $sendUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            btn.disabled = false;
            btn.innerHTML = 'Send OTP';
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success) {
                    $('otp-step-email').classList.add('hidden');
                    $('otp-step-verify').classList.remove('hidden');
                    var span = $('otp-sent-email');
                    span.textContent = email;
                    var input = $('otp-code');
                    if (input) { input.value = ''; input.focus(); }
                } else {
                    alert(resp.message || 'Failed to send OTP');
                }
            } catch(e) { alert('Error sending OTP. Please try again.'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Send OTP'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&form_key=<?php echo $formKey ?>');
    }

    function otpInput(el) {
        el.value = el.value.replace(/[^0-9]/g, '').slice(0, 6);
        if (el.value.length === 6) { verifyOtp(); }
    }

    function otpPaste(e) {
        var cd = e.clipboardData || window.clipboardData;
        if (!cd) { return; }
        var text = cd.getData('text') || '';
        var m = text.match(/\b(\d{6})\b/);
        var code = m ? m[1] : (text.replace(/[^0-9]/g, '').slice(0, 6));
        if (!code) { return; }
        e.preventDefault();
        var el = $('otp-code');
        el.value = code;
        if (code.length === 6) { verifyOtp(); }
    }

    function verifyOtp() {
        var otp = ($('otp-code').value || '').replace(/[^0-9]/g, '');
        if (otp.length < 6) { alert('Please enter the complete 6-digit OTP'); return; }

        var email = $('otp-email').value.trim();
        var btn = $('btn-verify-otp');
        btn.disabled = true;
        btn.innerHTML = 'Verifying...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $verifyUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success && resp.redirect) {
                    window.location.href = resp.redirect;
                } else {
                    btn.disabled = false;
                    btn.innerHTML = 'Verify &amp; Log In';
                    alert(resp.message || 'Verification failed');
                }
            } catch(e) { btn.disabled = false; btn.innerHTML = 'Verify &amp; Log In'; alert('Error verifying OTP'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Verify &amp; Log In'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp) + '&form_key=<?php echo $formKey ?>');
    }
    //]]>
    </script>
</body>
</html>
