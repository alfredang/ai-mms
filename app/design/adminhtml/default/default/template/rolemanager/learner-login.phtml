                        <input type="text" id="otp-code" class="otp-digit" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="______" oninput="otpInput(this)" onpaste="otpPaste(event)" onfocus="this.select()" aria-label="6-digit OTP code" />
                    </div>
                    <p class="otp-sent-msg" id="otp-sent-text">OTP has been sent to your email address</p>
                    <p class="otp-spam-hint">If you don&rsquo;t see the OTP email in your inbox, please check the spam/all emails.</p>
                    <button type="button" class="btn-otp" id="btn-verify-otp" onclick="verifyOtp()">Verify &amp; Log In</button>
                    <div class="otp-resend">
                        <a onclick="sendOtp()">Resend OTP</a>
                        <span class="otp-resend-sep">|</span>
                        <a onclick="switchTab('password')">Use Password</a>
                    </div>
                </div>
            </div>

            <div class="login-footer">
                Same email as your course-registration account.
                <a href="<?php echo htmlspecialchars($siteUrl) ?>" class="site-link"><?php echo htmlspecialchars($siteUrl) ?></a>
            </div>
        </div>
    </section>

    <p class="lp-powered">Powered by <a href="https://www.tertiaryinfotech.com/" target="_blank" rel="noopener"><?php $_dsv = Mage::app()->getDefaultStoreView(); echo $_dsv && $_dsv->getCode() === 'malaysia' ? 'Tertiary Infotech Sdn. Bhd.' : 'Tertiary Infotech Academy Pte Ltd'; ?></a></p>
</div>

    <script type="text/javascript">
    //<![CDATA[
    function $(id) { return document.getElementById(id); }

    function togglePw() {
        var inp = $('login');
        var open = $('pw-eye-open');
        var closed = $('pw-eye-closed');
        if (inp.type === 'password') {
            inp.type = 'text';
            open.style.display = 'none';
            closed.style.display = 'block';
        } else {
            inp.type = 'password';
            open.style.display = 'block';
            closed.style.display = 'none';
        }
    }

    function switchTab(tab) {
        var passwordForm = $('loginForm');
        var otpForm = $('otpForm');
        var otpEmail  = $('otp-email');
        var pwdEmail  = $('username');
        if (tab === 'otp') {
            if (pwdEmail && pwdEmail.value && otpEmail && !otpEmail.value) otpEmail.value = pwdEmail.value;
            passwordForm.classList.add('hidden');
            otpForm.classList.remove('hidden');
        } else {
            if (otpEmail && otpEmail.value && pwdEmail) pwdEmail.value = otpEmail.value;
            passwordForm.classList.remove('hidden');
            otpForm.classList.add('hidden');
            if (pwdEmail && pwdEmail.value) {
                var pwd = $('login');
                if (pwd) pwd.focus();
            }
        }
    }

    function sendOtp() {
        var email = $('otp-email').value.trim();
        if (!email) { alert('Please enter your email address'); return; }

        var btn = $('btn-send-otp');
        btn.disabled = true;
        btn.innerHTML = 'Sending...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $sendUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            btn.disabled = false;
            btn.innerHTML = 'Send OTP';
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success) {
                    $('otp-step-email').classList.add('hidden');
                    $('otp-step-verify').classList.remove('hidden');
                    var span = $('otp-sent-email');
                    span.textContent = email;
                    var input = $('otp-code');
                    if (input) { input.value = ''; input.focus(); }
                } else {
                    alert(resp.message || 'Failed to send OTP');
                }
            } catch(e) { alert('Error sending OTP. Please try again.'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Send OTP'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&form_key=<?php echo $formKey ?>');
    }

    function otpInput(el) {
        el.value = el.value.replace(/[^0-9]/g, '').slice(0, 6);
        if (el.value.length === 6) { verifyOtp(); }
    }

    function otpPaste(e) {
        var cd = e.clipboardData || window.clipboardData;
        if (!cd) { return; }
        var text = cd.getData('text') || '';
        var m = text.match(/\b(\d{6})\b/);
        var code = m ? m[1] : (text.replace(/[^0-9]/g, '').slice(0, 6));
        if (!code) { return; }
        e.preventDefault();
        var el = $('otp-code');
        el.value = code;
        if (code.length === 6) { verifyOtp(); }
    }

    function verifyOtp() {
        var otp = ($('otp-code').value || '').replace(/[^0-9]/g, '');
        if (otp.length < 6) { alert('Please enter the complete 6-digit OTP'); return; }

        var email = $('otp-email').value.trim();
        var btn = $('btn-verify-otp');
        btn.disabled = true;
        btn.innerHTML = 'Verifying...';

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '<?php echo $verifyUrl ?>');
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        xhr.onload = function() {
            try {
                var resp = JSON.parse(xhr.responseText);
                if (resp.success && resp.redirect) {
                    window.location.href = resp.redirect;
                } else {
                    btn.disabled = false;
                    btn.innerHTML = 'Verify &amp; Log In';
                    alert(resp.message || 'Verification failed');
                }
            } catch(e) { btn.disabled = false; btn.innerHTML = 'Verify &amp; Log In'; alert('Error verifying OTP'); }
        };
        xhr.onerror = function() { btn.disabled = false; btn.innerHTML = 'Verify &amp; Log In'; alert('Network error'); };
        xhr.send('email=' + encodeURIComponent(email) + '&otp=' + encodeURIComponent(otp) + '&form_key=<?php echo $formKey ?>');
    }

    // Registration (left column)
    (function () {
        var form = $('lp-reg-form');
        var err  = $('lp-reg-error');
        var btn  = $('lp-reg-submit');
        var done = $('lp-reg-done');
        var hint = $('lp-reg-hint');
        var code = $('lp-reg-class');
        var HINT_DEFAULT = hint.textContent;

        function showError(msg) { err.textContent = msg; err.hidden = false; }

        code.addEventListener('input', function () {
            code.value = code.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
        });
        Array.prototype.forEach.call(form.querySelectorAll('input[name="role"]'), function (r) {
            r.addEventListener('change', function () {
                hint.textContent = r.value === 'trainer'
                    ? 'Trainer accounts are activated after approval by our team.'
                    : HINT_DEFAULT;
            });
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            err.hidden = true;
            var name  = $('lp-reg-name').value.replace(/\s+/g, ' ').trim();
            var email = $('lp-reg-email').value.replace(/\s+/g, '');
            var cls   = code.value.trim();
            var role  = form.querySelector('input[name="role"]:checked').value;
            if (name.length < 2) { showError('Please enter your name.'); $('lp-reg-name').focus(); return; }
            if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { showError('Please enter a valid email address.'); $('lp-reg-email').focus(); return; }
            if (!/^C\d{6}$/.test(cls)) { showError('A Course Run ID looks like C004036. Please check the ID you were given.'); code.focus(); return; }

            btn.disabled = true;
            btn.textContent = 'Registering…';
            var xhr = new XMLHttpRequest();
            xhr.open('POST', '<?php echo $registerUrl ?>');
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onload = function () {
                btn.disabled = false;
                btn.textContent = 'Register';
                var resp;
                try { resp = JSON.parse(xhr.responseText); } catch (x) { showError('Something went wrong. Please try again.'); return; }
                if (resp.success) {
                    $('lp-reg-done-text').textContent = resp.message;
                    // Pre-fill the sign-in email so the learner can go straight to OTP.
                    if (!$('otp-email').value) { $('otp-email').value = email; }
                    form.hidden = true;
                    done.hidden = false;
                } else {
                    showError(resp.message || 'Registration failed. Please try again.');
                }
            };
            xhr.onerror = function () { btn.disabled = false; btn.textContent = 'Register'; showError('Network error. Please try again.'); };
            xhr.send([
                'name=' + encodeURIComponent(name),
                'email=' + encodeURIComponent(email),
                'class_code=' + encodeURIComponent(cls),
                'role=' + encodeURIComponent(role),
                'website=' + encodeURIComponent($('lp-reg-website').value),
                'form_key=<?php echo $formKey ?>'
            ].join('&'));
        });

        $('lp-reg-again').addEventListener('click', function () {
            form.reset();
            hint.textContent = HINT_DEFAULT;
            done.hidden = true;
            form.hidden = false;
            $('lp-reg-name').focus();
        });
    })();
    //]]>
    </script>
</body>
</html>
