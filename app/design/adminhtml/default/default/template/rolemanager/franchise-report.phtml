<script>
function feeFilter(){
    var st = document.getElementById('fee-filter-status').value, site = document.getElementById('fee-filter-site').value, q = (document.getElementById('fee-q').value||'').toLowerCase();
    document.querySelectorAll('.fee-row').forEach(function(r){
        var ok = (!st || r.getAttribute('data-status') === st) && (!site || r.getAttribute('data-site') === site) && (!q || r.getAttribute('data-q').indexOf(q) >= 0);
        r.style.display = ok ? '' : 'none';
    });
}
function feeRelease(btn){
    var tr = btn.closest('tr'); btn.disabled = true; btn.textContent = 'Releasing…';
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || ''); fd.append('id', tr.getAttribute('data-id'));
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('releaseCerts')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        var st = document.getElementById('fee-status'); st.style.display = 'block'; st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--red,#ff3b5c)'; st.textContent = d.message || '';
        setTimeout(function(){ location.reload(); }, 1800);
    }).catch(function(e){ btn.disabled = false; btn.textContent = 'Release'; alert('Network error: ' + e); });
}
function feeMark(btn){
    var tr = btn.closest('tr'), id = tr.getAttribute('data-id'), status = tr.getAttribute('data-status') === 'completed' ? 'pending' : 'completed';
    var note = status === 'completed' ? (window.prompt('Payment reference / note (optional):', tr.querySelector('.fee-note').textContent) || '') : '';
    btn.disabled = true;
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || ''); fd.append('id', id); fd.append('status', status); fd.append('note', note);
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('markFee')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        btn.disabled = false;
        if (!d.success) { alert(d.message || 'Update failed'); return; }
        var st = document.getElementById('fee-status'); st.style.display = 'block'; st.style.color = 'var(--green,#3df5a8)'; st.textContent = d.message || 'Updated.';
        setTimeout(function(){ location.reload(); }, d.message && d.message.length > 40 ? 2500 : 800);
    }).catch(function(e){ btn.disabled = false; alert('Network error: ' + e); });
}
</script>

