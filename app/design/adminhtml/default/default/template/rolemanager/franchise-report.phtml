<script>
function frFilter(){
    var from = document.getElementById('fr-date-from').value, to = document.getElementById('fr-date-to').value, q = (document.getElementById('fr-search').value||'').toLowerCase();
    var rows = document.querySelectorAll('.fr-row'), shown = 0;
    rows.forEach(function(r){ var d = r.getAttribute('data-start')||''; var ok = !(from && (!d || d < from)) && !(to && (!d || d > to)) && (!q || (r.getAttribute('data-search')||'').indexOf(q) >= 0); r.style.display = ok ? '' : 'none'; if (ok) shown++; });
    document.getElementById('fr-empty-filter').style.display = (rows.length && !shown) ? 'block' : 'none';
}
function frReset(){ ['fr-date-from','fr-date-to','fr-search'].forEach(function(id){ document.getElementById(id).value = ''; }); frFilter(); }
function frPullNow(btn){
    btn.disabled = true; btn.textContent = 'Pulling…';
    var st = document.getElementById('fr-status'); st.style.display = 'block'; st.style.color = 'var(--t4)'; st.textContent = 'Pulling completed classes from the partner sites…';
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('pull')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        btn.disabled = false; btn.textContent = 'Pull Now';
        if (d.success) { st.style.color = 'var(--green,#3df5a8)'; st.textContent = d.fetched > 0 ? ('Pulled ' + d.fetched + ' classes from ' + d.partners + ' partner(s), stored ' + d.upserted + '.') : ('Done — ' + d.partners + ' partner(s) contacted, no completed classes to pull yet.'); if (d.fetched > 0) setTimeout(function(){ location.reload(); }, 2000); }
        else { st.style.color = d.needs_config ? 'var(--yellow,#f5c451)' : 'var(--red,#ff3b5c)'; st.textContent = d.message || (d.error_msgs && d.error_msgs.join('; ')) || 'Pull failed'; }
    }).catch(function(e){ btn.disabled = false; btn.textContent = 'Pull Now'; st.style.color = 'var(--red,#ff3b5c)'; st.textContent = 'Network error: ' + e; });
}
</script>

