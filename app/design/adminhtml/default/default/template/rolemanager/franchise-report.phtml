<script>
function feeSave(cc){
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
    fd.append(cc + '_per_learner', document.getElementById('fee-' + cc + '-per').value); fd.append(cc + '_currency', document.getElementById('fee-' + cc + '-cur').value);
    var st = document.getElementById('fr-status'); st.style.display = 'block'; st.style.color = 'var(--t4)'; st.textContent = 'Saving fee…';
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('saveConfig')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--red,#ff3b5c)'; st.textContent = d.message || (d.success ? 'Saved.' : 'Save failed.');
        if (d.success) setTimeout(function(){ location.reload(); }, 1200);
    });
}
function certSave(cc){
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
    fd.append(cc + '_cert_mode', document.getElementById('cert-' + cc + '-mode').value);
    var st = document.getElementById('fr-status'); st.style.display = 'block'; st.style.color = 'var(--t4)'; st.textContent = 'Saving and pushing to the franchisee…';
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('saveConfig')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--red,#ff3b5c)'; st.textContent = d.message || (d.success ? 'Saved.' : 'Save failed.');
    });
}
function frSaveConfig(){
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
    ['my','gh'].forEach(function(cc){ fd.append(cc + '_url', document.getElementById('fr-' + cc + '-url').value.trim()); fd.append(cc + '_key', document.getElementById('fr-' + cc + '-key').value.trim()); });
    var st = document.getElementById('fr-status'); st.style.display = 'block'; st.textContent = 'Saving…';
    fetch('<?php echo $this->jsQuoteEscape($_frUrl('saveConfig')) ?>', { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--red,#ff3b5c)'; st.textContent = d.message || (d.success ? 'Saved.' : 'Save failed.');
        if (d.success) setTimeout(function(){ location.reload(); }, 1000);
    });
}
function frPull(btn, url){
    btn.disabled = true; var orig = btn.textContent; btn.textContent = 'Running…';
    var st = document.getElementById('fr-status'); st.style.display = 'block'; st.style.color = 'var(--t4)'; st.textContent = 'Contacting sites…';
    var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
    fetch(url, { method:'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
        btn.disabled = false; btn.textContent = orig;
        var lines = [];
        if (d.sites) Object.keys(d.sites).forEach(function(cc){ lines.push(cc + ': ' + d.sites[cc].classes + ' classes, ' + d.sites[cc].orders + ' registrations'); });
        if (d.fetched != null) lines.push('Fetched ' + d.fetched + ' completed classes from ' + d.partners + ' partner(s).');
        (d.error_msgs || []).forEach(function(m){ lines.push('✗ ' + m); });
        if (d.message) lines.push(d.message);
        st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--yellow,#f5c451)'; st.textContent = lines.join('\n') || 'Done.';
    }).catch(function(e){ btn.disabled = false; btn.textContent = orig; st.style.color = 'var(--red,#ff3b5c)'; st.textContent = 'Network error: ' + e; });
}
</script>

