          WHERE ordered_at >= DATE_SUB(CURDATE(), INTERVAL 13 MONTH)
            AND status NOT IN ('canceled','closed','fraud')
       GROUP BY source_country, DATE(ordered_at)
       ORDER BY d"
    );
}
