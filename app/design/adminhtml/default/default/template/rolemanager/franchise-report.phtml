<script>
function fmSync(op, btn, confirmMsg) {
    if (confirmMsg && !window.confirm(confirmMsg)) return;
    var boxes = document.querySelectorAll('.fm-cc-' + op + ':checked'), partners = [];
    for (var i = 0; i < boxes.length; i++) partners.push(boxes[i].value);
    var st = document.getElementById('fm-status-' + op); st.style.display = 'block';
    if (!partners.length) { st.style.color = 'var(--yellow,#f5c451)'; st.textContent = 'Select at least one franchisee site first.'; return; }
    btn.disabled = true; btn.textContent = 'Syncing…'; st.style.color = 'var(--t4)';
    st.textContent = 'Starting sync — a full sync can take several minutes per site, keep this page open…';
    var lines = [];
    function runNext(idx) {
        if (idx >= partners.length) { btn.disabled = false; btn.textContent = 'Sync Now'; return; }
        var cc = partners[idx]; lines.push(cc.toUpperCase() + ': syncing…'); st.textContent = lines.join('\n');
        var fd = new FormData(); fd.append('form_key', window.FORM_KEY || ''); fd.append('partner', cc); fd.append('op', op);
        fetch('<?php echo $this->jsQuoteEscape($_fmSyncUrl) ?>', { method:'POST', body:fd }).then(function(r){ return r.json(); }).then(function(d){
            if (d.success) {
                var bits = [];
                if (d.fetched != null) bits.push(d.fetched + ' fetched'); if (d.created != null) bits.push(d.created + ' created'); if (d.updated != null) bits.push(d.updated + ' updated'); if (d.disabled) bits.push(d.disabled + ' retired'); if (d.skipped != null) bits.push(d.skipped + ' skipped');
                lines[lines.length - 1] = cc.toUpperCase() + ': ✓ done — ' + bits.join(', ') + '.'; st.style.color = 'var(--green,#3df5a8)';
            } else { lines[lines.length - 1] = cc.toUpperCase() + ': ✗ ' + (d.message || d.error || (d.error_msgs && d.error_msgs.join('; ')) || 'sync failed'); st.style.color = 'var(--red,#ff3b5c)'; }
            st.textContent = lines.join('\n'); runNext(idx + 1);
        }).catch(function(e){ lines[lines.length - 1] = cc.toUpperCase() + ': ✗ network error — ' + e + ' (the sync may still be running on the partner; check its sync log)'; st.style.color = 'var(--red,#ff3b5c)'; st.textContent = lines.join('\n'); runNext(idx + 1); });
    }
    runNext(0);
}
</script>
