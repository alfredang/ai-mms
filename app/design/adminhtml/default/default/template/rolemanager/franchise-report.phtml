        "SELECT c.source_country, c.class_code, c.course_code, c.course_title, c.start_date, c.end_date,
                c.trainer_name, c.status, c.enrolled, c.attended, c.certs_issued,
                f.id AS fee_id, f.amount AS fee_amount, f.currency AS fee_currency, f.status AS fee_status,
                f.billable_learners
           FROM mmd_franchise_classes c
      LEFT JOIN mmd_franchise_class_fee f ON f.source_country = c.source_country AND f.class_code = c.class_code
