<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script>
var FC = {
    classes: <?php echo json_encode($_fcClasses) ?>,
    orders:  <?php echo json_encode($_fcOrders) ?>,
    sites:   <?php echo json_encode(array_map(function ($s) { return $s['flag'] . ' ' . $s['label']; }, $_frSites)) ?>,
    siteRole:<?php echo json_encode(array_map(function ($s) { return $s['role']; }, $_frSites)) ?>,
    fee:     <?php echo json_encode($_frFeeCfg) ?>,
    site: 'ALL', gran: 'month', charts: [], markUrl: '<?php echo $this->jsQuoteEscape($_fcMarkUrl) ?>'
};
(function(){
    var colors = { SG: '#60a5fa', MY: '#3df5a8', GH: '#f5c451' };
    var today = new Date(); today.setHours(0,0,0,0);
    function pad(n){ return n < 10 ? '0'+n : ''+n; }
    function iso(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }
    function parse(s){ if (!s) return null; var p = s.split('-'); return new Date(+p[0], +p[1]-1, +p[2]); }
    function monday(d){ var x = new Date(d); var day = (x.getDay()+6)%7; x.setDate(x.getDate()-day); x.setHours(0,0,0,0); return x; }
    function monthKey(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1); }
    function weekKey(d){ return iso(monday(d)); }
    function fmtMoney(n, cur){ return (cur||'') + ' ' + n.toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2}); }
    function siteOk(cc){ return FC.site === 'ALL' || FC.site === cc; }
    function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
    function periodStart(){ var m = +document.getElementById('fc-period').value; var d = new Date(today); d.setMonth(d.getMonth()-m+1); d.setDate(1); return d; }

    function buckets(){
        var start = periodStart(), out = [], labels = [];
        if (FC.gran === 'month') {
            var d = new Date(start);
            while (d <= today) { out.push(monthKey(d)); labels.push(d.toLocaleString(undefined,{month:'short',year:'2-digit'})); d.setMonth(d.getMonth()+1); }
        } else {
            var w = monday(start);
            while (w <= today) { out.push(iso(w)); labels.push(w.getDate()+' '+w.toLocaleString(undefined,{month:'short'})); w.setDate(w.getDate()+7); }
        }
        return { keys: out, labels: labels };
    }
    function keyOf(d){ return FC.gran === 'month' ? monthKey(d) : weekKey(d); }

    function series(rows, dateField, valueFn){
        var b = buckets(), idx = {}, data = {};
        for (var i = 0; i < b.keys.length; i++) idx[b.keys[i]] = i;
        ['SG','MY','GH'].forEach(function(cc){ data[cc] = b.keys.map(function(){ return 0; }); });
        var start = periodStart();
        rows.forEach(function(r){
            if (!siteOk(r.source_country)) return;
            var d = parse(r[dateField]); if (!d || d < start || d > today) return;
            var k = keyOf(d); if (!(k in idx)) return;
            if (!data[r.source_country]) return;
            data[r.source_country][idx[k]] += valueFn(r);
        });
        return { labels: b.labels, data: data };
    }
    // Prototype.js replaces Array.prototype.map with collect(), which passes only
    // (value, index) — Chart.js' default linear tick formatter expects the ticks
    // array as a 3rd argument and throws. A custom tick callback sidesteps it.
    function stacked(id, s, subId, subText){
        var el = document.getElementById(id); if (!el || typeof Chart === 'undefined') return;
        var ds = ['SG','MY','GH'].filter(siteOk).map(function(cc){ return { label: FC.sites[cc], data: s.data[cc], backgroundColor: colors[cc], barPercentage: .7 }; });
        var dark = document.documentElement.getAttribute('data-theme') !== 'light';
        var text = dark ? '#94a3b8' : '#475569', grid = dark ? 'rgba(148,163,184,.12)' : 'rgba(15,23,42,.08)';
        FC.charts.push(new Chart(el.getContext('2d'), { type: 'bar',
            data: { labels: s.labels, datasets: ds },
            options: { responsive: true, maintainAspectRatio: false, legend: { display: false },
                tooltips: { mode: 'index', intersect: false, backgroundColor: '#1f2937', titleFontColor: '#f8fafc', bodyFontColor: '#e2e8f0', borderColor: '#374151', borderWidth: 1, cornerRadius: 8 },
                scales: { xAxes: [{ stacked: true, ticks: { fontColor: text, fontSize: 10, maxRotation: 45 }, gridLines: { display: false } }],
                          yAxes: [{ stacked: true, ticks: { fontColor: text, fontSize: 11, beginAtZero: true, precision: 0, callback: function(v){ return Number(v).toLocaleString(); } }, gridLines: { color: grid } }] } } }));
        var sub = document.getElementById(subId); if (sub) sub.textContent = subText;
    }

    window.fcRender = function(){
        FC.charts.forEach(function(c){ try { c.destroy(); } catch(e){} }); FC.charts = [];
        var start = periodStart(), per = document.getElementById('fc-period').options[document.getElementById('fc-period').selectedIndex].text.toLowerCase();
        var granTxt = FC.gran === 'month' ? 'by month' : 'by week';

        // KPIs
        var learners = 0, orders = 0, classes = 0, pax = 0, certs = 0, fees = {}, feesN = 0, upcoming = 0;
        FC.orders.forEach(function(o){ var d = parse(o.d); if (siteOk(o.source_country) && d && d >= start) { learners += o.learners; orders += o.orders; } });
        FC.classes.forEach(function(c){
            if (!siteOk(c.source_country)) return;
            var d = parse(c.start_date); if (!d) return;
            if (d > today) { upcoming++; return; }
            if (d < start) return;
            classes++; pax += (c.attended || c.enrolled); certs += c.certs_issued;
            if (c.fee_id && c.fee_status === 'pending') { fees[c.fee_currency] = (fees[c.fee_currency]||0) + c.fee_amount; feesN++; }
        });
        document.getElementById('fc-kpi-learners').textContent = learners.toLocaleString();
        document.getElementById('fc-kpi-learners-sub').textContent = orders.toLocaleString() + ' registrations · ' + per;
        document.getElementById('fc-kpi-classes').textContent = classes.toLocaleString();
        document.getElementById('fc-kpi-classes-sub').textContent = pax.toLocaleString() + ' pax · ' + upcoming + ' upcoming';
        document.getElementById('fc-kpi-certs').textContent = certs.toLocaleString();
        document.getElementById('fc-kpi-certs-sub').textContent = per;
        var feeTxt = Object.keys(fees).map(function(k){ return fmtMoney(fees[k], k); }).join(' + ') || '0';
        document.getElementById('fc-kpi-fees').textContent = feeTxt;
        document.getElementById('fc-kpi-fees-sub').textContent = feesN + ' class' + (feesN === 1 ? '' : 'es') + ' awaiting payment';

        // Per-site cards (this week + period)
        var wk = monday(today), html = '';
        ['SG','MY','GH'].forEach(function(cc){
            if (!siteOk(cc)) return;
            var wkOrders = 0, wkLearners = 0, wkClasses = 0, pLearners = 0, pClasses = 0, pCerts = 0, pend = {}, paid = {};
            FC.orders.forEach(function(o){ if (o.source_country !== cc) return; var d = parse(o.d); if (!d) return; if (d >= wk) { wkOrders += o.orders; wkLearners += o.learners; } if (d >= start) pLearners += o.learners; });
            FC.classes.forEach(function(c){ if (c.source_country !== cc) return; var d = parse(c.start_date); if (!d) return;
                if (d >= wk && d < new Date(wk.getTime()+7*864e5)) wkClasses++;
                if (d >= start && d <= today) { pClasses++; pCerts += c.certs_issued; }
                if (c.fee_id) { var t = c.fee_status === 'completed' ? paid : pend; t[c.fee_currency] = (t[c.fee_currency]||0) + c.fee_amount; } });
            var feeCfg = FC.fee[cc], feeLine = cc === 'SG' ? 'Control site — no fee' : (feeCfg && feeCfg.per_learner > 0 ? (feeCfg.currency + ' ' + feeCfg.per_learner + ' per learner per class') : 'No franchise fee');
            var pendTxt = Object.keys(pend).map(function(k){ return fmtMoney(pend[k], k); }).join(' + ') || '—';
            var paidTxt = Object.keys(paid).map(function(k){ return fmtMoney(paid[k], k); }).join(' + ') || '—';
            html += '<div class="fr-site"><div class="fr-site-head"><span class="fr-site-name">' + FC.sites[cc] + '</span><span class="fr-site-role">' + FC.siteRole[cc] + '</span></div>'
                + '<div class="fr-site-grid">'
                + '<div><div class="fr-site-k">Sign-ups this week</div><div class="fr-site-v">' + wkOrders + '<small>' + wkLearners + ' learners</small></div></div>'
                + '<div><div class="fr-site-k">Classes this week</div><div class="fr-site-v">' + wkClasses + '</div></div>'
                + '<div><div class="fr-site-k">Learners · ' + per + '</div><div class="fr-site-v">' + pLearners.toLocaleString() + '</div></div>'
                + '<div><div class="fr-site-k">Classes · certs</div><div class="fr-site-v">' + pClasses + '<small>' + pCerts + ' certs</small></div></div>'
                + '<div><div class="fr-site-k">Fees pending</div><div class="fr-site-v" style="font-size:14px;color:' + (pendTxt === '—' ? 'var(--t4)' : 'var(--yellow,#f5c451)') + '">' + pendTxt + '</div></div>'
                + '<div><div class="fr-site-k">Fees collected</div><div class="fr-site-v" style="font-size:14px;color:' + (paidTxt === '—' ? 'var(--t4)' : 'var(--green,#3df5a8)') + '">' + paidTxt + '</div></div>'
                + '</div><div class="fr-meta" style="margin-top:8px;">' + feeLine + '</div></div>';
        });
        document.getElementById('fc-sites').innerHTML = html;

        // Charts
        stacked('fc-chart-learners', series(FC.orders, 'd', function(o){ return o.learners; }), 'fc-ch1-sub', per + ' · ' + granTxt);
        stacked('fc-chart-classes', series(FC.classes.filter(function(c){ var d = parse(c.start_date); return d && d <= today; }), 'start_date', function(){ return 1; }), 'fc-ch2-sub', per + ' · ' + granTxt);
        stacked('fc-chart-certs', series(FC.classes, 'end_date', function(c){ return c.certs_issued; }), 'fc-ch3-sub', per + ' · ' + granTxt);
        document.getElementById('fc-legend').innerHTML = ['SG','MY','GH'].filter(siteOk).map(function(cc){ return '<span><i style="background:' + colors[cc] + '"></i>' + FC.sites[cc] + '</span>'; }).join('');

        // Weekly table — last 8 weeks
        var rows = '';
        for (var w = 0; w < 8; w++) {
            var ws = new Date(wk.getTime() - w*7*864e5), we = new Date(ws.getTime() + 7*864e5);
            var label = ws.getDate() + ' ' + ws.toLocaleString(undefined,{month:'short'}) + ' – ' + new Date(we.getTime()-864e5).getDate() + ' ' + new Date(we.getTime()-864e5).toLocaleString(undefined,{month:'short'});
            ['SG','MY','GH'].forEach(function(cc){
                if (!siteOk(cc)) return;
                var o = 0, l = 0, cl = 0, px = 0, ce = 0, fe = {};
                FC.orders.forEach(function(r){ if (r.source_country !== cc) return; var d = parse(r.d); if (d && d >= ws && d < we) { o += r.orders; l += r.learners; } });
                FC.classes.forEach(function(c){ if (c.source_country !== cc) return; var d = parse(c.start_date); if (d && d >= ws && d < we) { cl++; px += (c.attended || c.enrolled); if (c.fee_id) fe[c.fee_currency] = (fe[c.fee_currency]||0) + c.fee_amount; }
                    var e = parse(c.end_date); if (e && e >= ws && e < we) ce += c.certs_issued; });
                var feTxt = Object.keys(fe).map(function(k){ return fmtMoney(fe[k], k); }).join(' + ') || '—';
                rows += '<tr><td class="muted">' + label + '</td><td><span class="fr-pill fr-pill-cc">' + cc + '</span></td><td class="fr-num">' + o + '</td><td class="fr-num strong">' + l + '</td><td class="fr-num">' + cl + '</td><td class="fr-num">' + px + '</td><td class="fr-num">' + ce + '</td><td class="fr-num">' + feTxt + '</td></tr>';
            });
        }
        document.querySelector('#fc-weekly tbody').innerHTML = rows || '<tr><td colspan="8" class="mm-table-empty">No activity yet.</td></tr>';
        fcRenderLedger();
    };

    window.fcRenderLedger = function(){
        var q = (document.getElementById('fc-class-q').value || '').toLowerCase(), st = document.getElementById('fc-class-status').value;
        var start = periodStart(), shown = 0, html = "", max = 100;
        FC.classes.forEach(function(c){
            if (!siteOk(c.source_country) || (st && c.status !== st)) return;
            var d = parse(c.start_date); if (d && d < start) return;
            if (q && (c.class_code + ' ' + c.course_code + ' ' + c.course_title + ' ' + c.trainer_name).toLowerCase().indexOf(q) < 0) return;
            shown++; if (shown > max) return;
            var stPill = c.status === 'completed' ? 'fr-pill-ok' : (c.status === 'confirmed' ? 'fr-pill-violet' : 'fr-pill-mute');
            var pay = '—';
            if (c.fee_id) {
                pay = (c.fee_status === 'completed' ? '<span class="fr-pill fr-pill-ok">Completed</span>' : '<span class="fr-pill fr-pill-warn">Pending</span>')
                    + ' <button type="button" class="mm-btn mm-btn-sm" onclick="fcMarkFee(' + c.fee_id + ', \'' + (c.fee_status === 'completed' ? 'pending' : 'completed') + '\', this)">' + (c.fee_status === 'completed' ? 'Undo' : 'Mark paid') + '</button>';
            }
            html += '<tr><td><span class="fr-pill fr-pill-cc">' + c.source_country + '</span></td><td class="fr-mono">' + esc(c.class_code) + '</td>'
                + '<td class="strong" title="' + esc(c.course_title) + '">' + esc(c.course_code) + ' · ' + esc(c.course_title) + '</td>'
                + '<td class="muted">' + esc(c.start_date) + (c.end_date && c.end_date !== c.start_date ? ' → ' + esc(c.end_date) : '') + '</td>'
                + '<td>' + esc(c.trainer_name || '—') + '</td><td><span class="fr-pill ' + stPill + '">' + c.status + '</span></td>'
                + '<td class="fr-num">' + c.enrolled + '</td><td class="fr-num">' + c.attended + '</td><td class="fr-num">' + c.certs_issued + '</td>'
                + '<td class="fr-num">' + (c.fee_id ? fmtMoney(c.fee_amount, c.fee_currency) : '—') + '</td><td>' + pay + '</td></tr>';
        });
        document.querySelector('#fc-ledger tbody').innerHTML = html || '<tr><td colspan="11" class="mm-table-empty">No classes match.</td></tr>';
        var more = document.getElementById('fc-ledger-more'); more.style.display = shown > max ? 'block' : 'none'; more.textContent = 'Showing ' + max + ' of ' + shown + ' classes — narrow the filters to see the rest.';
    };

    window.fcMarkFee = function(id, status, btn){
        btn.disabled = true;
        var fd = new FormData(); fd.append('form_key', window.FORM_KEY || ''); fd.append('id', id); fd.append('status', status);
        fetch(FC.markUrl, { method: 'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
            btn.disabled = false;
            if (!d.success) { alert(d.message || 'Update failed'); return; }
            FC.classes.forEach(function(c){ if (c.fee_id === id) c.fee_status = d.row.status; });
            fcRender();
        }).catch(function(e){ btn.disabled = false; alert('Network error: ' + e); });
    };

    window.fcPullNow = function(btn){
        btn.disabled = true; btn.textContent = 'Collecting…';
        var st = document.getElementById('fc-status'); st.style.display = 'block'; st.style.color = 'var(--t4)';
        st.textContent = 'Collecting from Singapore (local) and every connected franchisee…';
        var fd = new FormData(); fd.append('form_key', window.FORM_KEY || '');
        fetch('<?php echo $this->jsQuoteEscape($_frUrl('pullStats')) ?>', { method: 'POST', body: fd }).then(function(r){ return r.json(); }).then(function(d){
            btn.disabled = false; btn.textContent = 'Collect Now';
            var lines = [];
            Object.keys(d.sites || {}).forEach(function(cc){ lines.push(cc + ': ' + d.sites[cc].classes + ' classes, ' + d.sites[cc].orders + ' registrations'); });
            (d.error_msgs || []).forEach(function(m){ lines.push('✗ ' + m); });
            if (d.message) lines.push(d.message);
            st.style.color = d.success ? 'var(--green,#3df5a8)' : 'var(--yellow,#f5c451)';
            st.textContent = lines.join('\n') + (d.fees != null ? '\nFee ledger: ' + d.fees + ' billable classes.' : '');
            if (d.sites && Object.keys(d.sites).length) setTimeout(function(){ location.reload(); }, 2500);
        }).catch(function(e){ btn.disabled = false; btn.textContent = 'Collect Now'; st.style.color = 'var(--red,#ff3b5c)'; st.textContent = 'Network error: ' + e; });
    };

    function wireTabs(id, attr, prop){
        var box = document.getElementById(id); if (!box) return;
        box.addEventListener('click', function(e){
            var b = e.target.closest('button[' + attr + ']'); if (!b) return;
            box.querySelectorAll('button').forEach(function(x){ x.classList.remove('active'); });
            b.classList.add('active'); FC[prop] = b.getAttribute(attr); fcRender();
        });
    }
    wireTabs('fc-site-tabs', 'data-site', 'site');
    wireTabs('fc-gran-tabs', 'data-gran', 'gran');
    var tries = 0;
    (function boot(){ if (typeof Chart === 'undefined' && tries++ < 40) return setTimeout(boot, 150); fcRender(); })();
})();
</script>

