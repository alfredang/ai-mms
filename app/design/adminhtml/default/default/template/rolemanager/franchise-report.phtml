<script>
function frFilter() {
    var from = document.getElementById('fr-date-from').value;
    var to = document.getElementById('fr-date-to').value;
    var title = (document.getElementById('fr-title').value || '').toLowerCase();
    var q = (document.getElementById('fr-search').value || '').toLowerCase();
    var rows = document.querySelectorAll('.fr-row');
    var shown = 0;
    for (var i = 0; i < rows.length; i++) {
        var r = rows[i];
        var ok = true;
        var d = r.getAttribute('data-start') || '';
        if (from && (!d || d < from)) ok = false;
        if (ok && to && (!d || d > to)) ok = false;
        if (ok && title && (r.getAttribute('data-title') || '').indexOf(title) < 0) ok = false;
        if (ok && q && (r.getAttribute('data-search') || '').indexOf(q) < 0) ok = false;
        r.style.display = ok ? '' : 'none';
        if (ok) shown++;
    }
    var empty = document.getElementById('fr-empty-filter');
    if (empty) empty.style.display = (rows.length && !shown) ? 'block' : 'none';
}
function frReset() {
    document.getElementById('fr-date-from').value = '';
    document.getElementById('fr-date-to').value = '';
    document.getElementById('fr-title').value = '';
    document.getElementById('fr-search').value = '';
    frFilter();
}
function frPullNow(btn) {
    btn.disabled = true; btn.textContent = 'Pulling…';
    var st = document.getElementById('fr-status');
    st.style.display = 'block'; st.style.color = '#94a3b8';
    st.textContent = 'Pulling completed classes from the partner sites…';
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fetch('<?php echo $this->jsQuoteEscape($_frPullUrl) ?>', { method:'POST', body:fd })
        .then(function(r){ return r.json(); })
        .then(function(d){
            btn.disabled = false; btn.textContent = 'Pull Now';
            if (d.success) {
                st.style.color = '#22c55e';
                st.textContent = d.fetched > 0
                    ? ('Pulled ' + d.fetched + ' classes from ' + d.partners + ' partner(s), stored ' + d.upserted + '.')
                    : ('Done — ' + d.partners + ' partner(s) contacted, no completed classes to pull yet.');
                if (d.fetched > 0) setTimeout(function(){ location.reload(); }, 2000);
            } else if (d.needs_config) {
                // Setup state, not an error — neutral amber + open the settings.
                st.style.color = '#f59e0b';
                st.textContent = d.message || 'Add a partner URL and API key in Partner Connection Settings first.';
                var det = document.querySelector('.franchise-report-page details');
                if (det) det.open = true;
            } else {
                st.style.color = '#ef4444';
                st.textContent = 'Pull failed: ' + (d.message || (d.error_msgs && d.error_msgs.join('; ')) || 'unknown error');
            }
        })
        .catch(function(e){ btn.disabled = false; btn.textContent = 'Pull Now'; st.style.color = '#ef4444'; st.textContent = 'Network error: ' + e; });
}
function frSaveConfig() {
    var fd = new FormData();
    fd.append('form_key', window.FORM_KEY || '');
    fd.append('my_url', document.getElementById('fr-my-url').value.trim());
    fd.append('my_key', document.getElementById('fr-my-key').value.trim());
    fd.append('gh_url', document.getElementById('fr-gh-url').value.trim());
    fd.append('gh_key', document.getElementById('fr-gh-key').value.trim());
    fetch('<?php echo $this->jsQuoteEscape($_frCfgUrl) ?>', { method:'POST', body:fd })
        .then(function(r){ return r.json(); })
        .then(function(d){
            var st = document.getElementById('fr-status');
            st.style.display = 'block';
            st.style.color = d.success ? '#22c55e' : '#ef4444';
            st.textContent = d.message || (d.success ? 'Saved.' : 'Save failed.');
        });
}
</script>

