                    var bar = e.target.closest ? e.target.closest('.mmd-mkt-growth-bar') : null;
                    if(!bar) return;
                    tip.innerHTML = '<b>' + Number(bar.getAttribute('data-count')).toLocaleString() + '</b> subscribers &middot; ' + bar.getAttribute('data-date');
                    tip.style.display = 'block';
                    var wr = wrap.getBoundingClientRect(), br = bar.getBoundingClientRect();
                    var left = br.left - wr.left + br.width / 2;
                    left = Math.max(80, Math.min(wr.width - 80, left));
                    var top = br.top - wr.top - 32; if(top < 0) top = 0;
                    tip.style.left = left + 'px';
                    tip.style.top = top + 'px';
                });
                wrap.addEventListener('mouseleave', function(){ tip.style.display = 'none'; });
