    <script>
    (function(){
        function wire(id){
            var wrap = document.getElementById(id); if(!wrap) return;
            var tip = wrap.querySelector('.mmd-mkt-growth-tip');
            wrap.addEventListener('mouseover', function(e){
                var col = e.target.closest ? e.target.closest('.mmd-mkt-rate-col') : null;
                if(!col) return;
                tip.innerHTML = '<b></b><span></span>';
                tip.firstChild.textContent = col.getAttribute('data-rate') + '% ' + col.getAttribute('data-kind');
                tip.lastChild.textContent = ' · ' + col.getAttribute('data-name') + ' · ' + col.getAttribute('data-date');
                tip.style.display = 'block';
                var wr = wrap.getBoundingClientRect(), cr = col.getBoundingClientRect();
                var left = cr.left - wr.left + cr.width / 2;
                left = Math.max(80, Math.min(wr.width - 80, left));
                tip.style.left = left + 'px';
                tip.style.top = '0px';
            });
            wrap.addEventListener('mouseleave', function(){ tip.style.display = 'none'; });
        }
        wire('mmd-mkt-openrate');
        wire('mmd-mkt-clickrate');
    })();
    </script>
    <?php endif; ?>
    <?php endif; ?>


