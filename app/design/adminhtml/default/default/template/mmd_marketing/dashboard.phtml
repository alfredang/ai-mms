         current count, so we record one point/day and chart the series here. -->
    <?php $_gPoints = array(); foreach ($_mlGrowth as $_g) { $_gPoints[] = array('d' => $_g['date'], 'c' => (int)$_g['count']); } ?>
    <div class="mmd-mkt-chart-card">
        <div class="mmd-mkt-chart-head">MailerLite Subscriber Growth — Singapore (last 30 days)</div>
        <?php if (count($_gPoints) >= 2): ?>
            <canvas id="mmd-mkt-growth" height="150" style="width:100%;display:block;"></canvas>
            <div class="mmd-mkt-chart-foot">
                <span><?php echo htmlspecialchars($_gPoints[0]['d']) ?></span>
                <span><?php echo number_format($_gPoints[0]['c']) ?> → <b><?php echo number_format(end($_gPoints)['c']) ?></b> subscribers</span>
                <span><?php echo htmlspecialchars(end($_gPoints)['d']) ?></span>
            </div>
            <script>
            (function(){
                var pts = <?php echo json_encode($_gPoints) ?>;
                var cv = document.getElementById('mmd-mkt-growth'); if(!cv||!cv.getContext) return;
                function draw(){
                    var dpr = window.devicePixelRatio||1, W = cv.clientWidth, H = 150;
                    cv.width = W*dpr; cv.height = H*dpr; var x = cv.getContext('2d'); x.scale(dpr,dpr);
                    x.clearRect(0,0,W,H);
                    var vals = pts.map(function(p){return p.c;});
                    var mn = Math.min.apply(null,vals), mx = Math.max.apply(null,vals);
                    if(mx===mn){mx=mn+1;} var pad=10, gh=H-pad*2, gw=W-pad*2;
                    var xf=function(i){return pad + gw*(i/(pts.length-1));};
                    var yf=function(v){return pad + gh*(1-(v-mn)/(mx-mn));};
                    // area fill
                    x.beginPath(); x.moveTo(xf(0),yf(vals[0]));
                    for(var i=1;i<vals.length;i++) x.lineTo(xf(i),yf(vals[i]));
                    x.lineTo(xf(vals.length-1),H-pad); x.lineTo(xf(0),H-pad); x.closePath();
                    var grad=x.createLinearGradient(0,pad,0,H); grad.addColorStop(0,'rgba(34,211,238,.28)'); grad.addColorStop(1,'rgba(34,211,238,0)');
                    x.fillStyle=grad; x.fill();
                    // line
                    x.beginPath(); x.moveTo(xf(0),yf(vals[0]));
                    for(var j=1;j<vals.length;j++) x.lineTo(xf(j),yf(vals[j]));
                    x.strokeStyle='#22d3ee'; x.lineWidth=2; x.stroke();
                    // endpoint dot
                    x.beginPath(); x.arc(xf(vals.length-1),yf(vals[vals.length-1]),3.5,0,6.29); x.fillStyle='#22d3ee'; x.fill();
                }
                draw(); window.addEventListener('resize',draw);
            })();
            </script>
