<script>
var ATT_LOAD_URL   = '<?php echo $this->jsQuoteEscape($loadUrl) ?>';
var attCheckinUrls = {};    // session key -> signed public check-in link (QR target)
var ATT_SIG_URL = '<?php echo $this->jsQuoteEscape($sigUrl) ?>';
var ATT_TZ      = '<?php echo $this->jsQuoteEscape($siteTz) ?>';
var attSigs     = { learner: {}, trainer: {} };   // finger signatures from the apps (see loadAction)
var ATT_EXPORT_URL = '<?php echo $this->jsQuoteEscape(Mage::helper('adminhtml')->getUrl('adminhtml/attendance/export')) ?>';
var ATT_SAVE_URL   = '<?php echo $this->jsQuoteEscape($saveUrl) ?>';
var ATT_ADD_URL    = '<?php echo $this->jsQuoteEscape($addUrl) ?>';
var ATT_REMOVE_URL = '<?php echo $this->jsQuoteEscape($removeUrl) ?>';
var ATT_SEARCH_URL = '<?php echo $this->jsQuoteEscape($searchLearnersUrl) ?>'; // debounced server search (shared with Assign Learners)
var _attSearchTimer = null;
var _attChosenEmail = '';                          // email of a picked/known-existing learner
var _attEmailKnown  = { email: '', exists: false };// last email-field existence check
var ATT_FORM_KEY   = window.FORM_KEY || '';
var ATT_READONLY   = <?php echo $readonly ? 'true' : 'false' ?>;          // always false now — completed classes stay editable
var ATT_SHOW_KPIS  = <?php echo $isCompleted ? 'true' : 'false' ?>;        // Completed tab still shows the attendance-rate summary cards
var CERT_TOGGLE_URL = '<?php echo $this->jsQuoteEscape($certToggleUrl) ?>';
var ATT_IS_MY       = <?php echo $isMy ? 'true' : 'false' ?>;           // Malaysia: timetable + actual minutes
var ATT_TT_SAVE_URL = '<?php echo $this->jsQuoteEscape($ttSaveUrl) ?>';
var ATT_CONF_URL    = '<?php echo $this->jsQuoteEscape($confUrl) ?>';
var attConf = null, attCertRoster = [], attCanConfirm = false;   // MY: trainer confirmation panel
var attTimetable = null;     // MY: {sessions:[{key,label,date,start,end,break_minutes,training_minutes,confirmed}], confirmed, total_minutes}
var attRunId = 0;
var attRoster = [];          // [{learner_name, learner_email, is_walkin, att:{d1am:{p,r,m},…}}]
var attSessions = [];        // [{key:'d1am', day:1, ampm:'AM', date:'Y-m-d', label}]
var attActiveSess = '';      // key of the session being marked
var attSel = {};             // row-index -> true (bulk-selection state)

function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

// ── Take Attendance QR — learner scans -> public check-in form ──────────────
function attShowQr() {
    var url = attCheckinUrls[attActiveSess];
    if (!attRunId || !url) { alert('Select a class first.'); return; }
    var sess = attSessions.filter(function(s){ return s.key === attActiveSess; })[0];
    document.getElementById('att-qr-sess').textContent = sess ? sess.label : '';
    document.getElementById('att-qr-img').src =
        'https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=0&data=' + encodeURIComponent(url);
    document.getElementById('att-qr-url').value = url;
    document.getElementById('att-qr-modal').style.display = 'flex';
}
function attCopyQrUrl(btn) {
    var inp = document.getElementById('att-qr-url');
    var ok = false;
    try { inp.select(); inp.setSelectionRange(0, 99999); ok = document.execCommand('copy'); } catch (e) {}
    if (navigator.clipboard) { try { navigator.clipboard.writeText(inp.value); ok = true; } catch (e) {} }
    var orig = btn.textContent; btn.textContent = ok ? 'Copied!' : 'Copy failed';
    setTimeout(function(){ btn.textContent = orig; }, 1500);
}
document.getElementById('att-qr-modal').addEventListener('click', function(e){ if (e.target === this) this.style.display = 'none'; });

// Zoom: the same QR full screen, for a projector or the back of the room. Same full-screen
// layer as the Lesson quiz QR (.lsx-* in admin-dashboard.css). Esc, X or a click outside closes.
function attZoomQr() {
    var url = document.getElementById('att-qr-url').value;
    if (!url) return;
    var opener = document.activeElement, overflow = document.body.style.overflow;
    var layer = document.createElement('div');
    layer.className = 'admin-main lsx-layer lsx-dark att-qr-fs';
    layer.setAttribute('role', 'dialog');
    layer.setAttribute('aria-modal', 'true');
    layer.setAttribute('aria-label', 'Check-in QR code full screen');
    layer.style.zIndex = '10000';   // above the Take Attendance modal (.att-modal-bd is 9999)
    layer.innerHTML =
        '<button type="button" class="lsx-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>'
        + '<div class="lsx-qr">'
        +   '<h2 class="lsx-qr-name">' + esc(document.getElementById('att-qr-sess').textContent) + '</h2>'
        +   '<p class="lsx-qr-sub">Scan to check in &middot; no login needed</p>'
        +   '<div class="lsx-qr-img"><img alt="Check-in QR code" src="https://api.qrserver.com/v1/create-qr-code/?size=800x800&margin=0&data=' + encodeURIComponent(url) + '"></div>'
        +   '<p class="lsx-qr-link">' + esc(url) + '</p>'
        + '</div>';
    function close() {
        document.removeEventListener('keydown', onKey);
        document.body.style.overflow = overflow;
        if (layer.parentNode) layer.parentNode.removeChild(layer);
        if (opener && opener.focus) opener.focus();
    }
    function onKey(e) { if (e.key === 'Escape') { e.stopPropagation(); close(); } }
    layer.querySelector('.lsx-close').addEventListener('click', close);
    layer.addEventListener('mousedown', function(e){ if (e.target === layer) close(); });
    document.addEventListener('keydown', onKey);
    document.body.style.overflow = 'hidden';
    document.body.appendChild(layer);
    layer.querySelector('.lsx-close').focus();
}

// ── .xlsx download (saved attendance) ───────────────────────────────────────
var ATT_EXPORT_SIGNED_URL = '<?php echo $this->jsQuoteEscape(Mage::helper('adminhtml')->getUrl('adminhtml/attendance/exportSigned')) ?>';
function attDownloadSigned() {
    if (!attRunId) { alert('Select a class first.'); return; }
    var base = ATT_EXPORT_SIGNED_URL;
    if (base.charAt(base.length - 1) !== '/') { base += '/'; }
    window.location.href = base + 'run_id/' + attRunId + '/';
}
function attDownload(all) {
    if (!attRunId) { alert('Select a class first.'); return; }
    var sess = all ? 'all' : attActiveSess;
    if (!sess) { alert('Pick a session first.'); return; }
    var base = ATT_EXPORT_URL;
    if (base.charAt(base.length - 1) !== '/') { base += '/'; }
    window.location.href = base + 'run_id/' + attRunId + '/session/' + encodeURIComponent(sess) + '/';
}

// ── Certificate: auto-send fail-safe toggle (braille spinner + tick/cross) ────
var _certSpin = null, _certResultTimer = null;
function certSpinStart(){ var el=document.getElementById('cert-spinner'); if(!el)return; if(_certResultTimer){clearTimeout(_certResultTimer);_certResultTimer=null;} el.style.color='#60a5fa'; el.removeAttribute('title'); var f=['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'],i=0; el.textContent=f[0]; _certSpin=setInterval(function(){i=(i+1)%f.length;el.textContent=f[i];},80); }
function certSpinStop(){ if(_certSpin){clearInterval(_certSpin);_certSpin=null;} }
function certResult(ok,msg){ var el=document.getElementById('cert-spinner'); if(!el)return; el.textContent=ok?'✓':'✗'; el.style.color=ok?'#22c55e':'#ef4444'; if(msg)el.setAttribute('title',msg); _certResultTimer=setTimeout(function(){el.textContent='';el.style.color='#60a5fa';el.removeAttribute('title');_certResultTimer=null;},2500); }

function certToggle(cb) {
    var val = cb.checked ? 1 : 0;
    cb.checked = (val === 0); // hold until server confirms
    if (val === 1 && !confirm(ATT_IS_MY
        ? 'Enable automatic certificate emails?\n\nCertificates will be emailed once the trainer confirms the final attendance, to learners with at least 75% of the training hours.'
        : 'Enable automatic certificate emails?\n\nA daily sweep will email certificates to learners marked Present once their class has ended.')) return;
    cb.disabled = true; certSpinStart();
    var fd = new FormData(); fd.append('value', val); fd.append('form_key', ATT_FORM_KEY);
    fetch(CERT_TOGGLE_URL, { method:'POST', body:fd, credentials:'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(d){
            cb.disabled = false; certSpinStop();
            if (!d.success) { certResult(false, d.message || 'Failed'); return; }
            var on = (d.value === 1); cb.checked = on;
            cb.closest('.dcf-toggle-sw').setAttribute('title', on ? 'Auto-send ON' : 'Auto-send OFF');
            var b = document.getElementById('cert-banner');
            if (b) { b.style.borderColor = on?'rgba(34,197,94,.3)':'rgba(100,116,139,.25)'; b.style.background = on?'rgba(34,197,94,.08)':'rgba(100,116,139,.06)'; }
            certResult(true);
        })
        .catch(function(){ cb.disabled=false; certSpinStop(); certResult(false,'Network error'); });
}

function attSelectClass(runId) {
    attRunId = parseInt(runId, 10) || 0;
    attCheckinUrls = {};
    var card = document.getElementById('att-roster-card');
    var pills = document.getElementById('att-pills');
    if (!attRunId) { card.style.display = 'none'; pills.innerHTML = ''; return; }

    var opt = document.querySelector('#att-class option[value="' + attRunId + '"]');
    if (opt) {
        var start = opt.getAttribute('data-start'); var end = opt.getAttribute('data-end');
        var fmt = function(d){ if(!d) return '—'; var x=new Date(d); return isNaN(x)? d : x.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); };
        pills.innerHTML =
            '<span class="att-pill">Class ID <b>' + esc(opt.getAttribute('data-class-id')) + '</b></span>' +
            '<span class="att-pill">Code <b>' + esc(opt.getAttribute('data-sku')) + '</b></span>' +
            '<span class="att-pill">Start <b>' + fmt(start) + '</b></span>' +
            '<span class="att-pill">End <b>' + fmt(end) + '</b></span>' +
            (opt.getAttribute('data-trainer') ? '<span class="att-pill">Trainer <b>' + esc(opt.getAttribute('data-trainer')) + '</b></span>' : '');
    }

    fetch(ATT_LOAD_URL + '?run_id=' + attRunId, { credentials: 'same-origin' })
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (!d.success) { alert('Error: ' + (d.message || 'load failed')); return; }
            attRoster   = d.roster || [];
            attCheckinUrls = d.checkin_urls || {};
            attSigs = d.signatures || { learner: {}, trainer: {} };
            attSessions = d.sessions && d.sessions.length ? d.sessions : [{key:'d1am', day:1, ampm:'AM', date:'', label:'Day 1 · AM'}];
            attSel = {};
            attTimetable = d.timetable || null;
            var corr = document.getElementById('att-corr-wrap');
            if (corr) { corr.style.display = d.finished ? 'inline-flex' : 'none'; document.getElementById('att-corr-reason').value = ''; }
            attActiveSess = attDefaultSession();
            attConf = d.confirmation || null; attCertRoster = d.cert_roster || []; attCanConfirm = !!d.can_confirm;
            if (ATT_IS_MY) { attRenderTimetable(); attRenderConfirmation(); }
            attRenderSessTabs();
            attRender();
            card.style.display = '';
        })
        .catch(function(){ alert('Network error loading roster.'); });
}

// ── Malaysia: class timetable (attendance by training hours) ─────────────────
function attHm(t) { var m = /^(\d{1,2}):(\d{2})$/.exec(String(t || '')); return m ? (+m[1]) * 60 + (+m[2]) : null; }
function attFmtMin(n) { return Math.floor(n / 60) + 'h ' + String(n % 60).padStart(2, '0') + 'm'; }
// Training minutes for a timetable row from its current inputs (null = incomplete / invalid).
function attTtMinutes(s) {
    var a = attHm(s.start), b = attHm(s.end);
    var brk = (s.break_minutes === null || s.break_minutes === '') ? null : parseInt(s.break_minutes, 10);
    if (a === null || b === null || brk === null || isNaN(brk) || brk < 0) return null;
    var n = b - a - brk;
    return n > 0 ? n : null;
}
function attRenderTimetable() {
    var body = document.getElementById('att-tt-body');
    if (!body) return;
    var rows = attTimetable && attTimetable.sessions ? attTimetable.sessions : [];
    var html = '';
    rows.forEach(function(s, i) {
        var dis = ATT_READONLY ? ' disabled' : '';
        html += '<tr><td>' + esc(s.label) + '</td>'
            + '<td><input type="time" class="att-reason" value="' + esc(s.start) + '" oninput="attTtEdit(' + i + ',\'start\',this.value)"' + dis + '></td>'
            + '<td><input type="time" class="att-reason" value="' + esc(s.end) + '" oninput="attTtEdit(' + i + ',\'end\',this.value)"' + dis + '></td>'
            + '<td><input type="number" min="0" step="1" class="att-reason" placeholder="e.g. 60" value="' + (s.break_minutes === null ? '' : esc(s.break_minutes)) + '" oninput="attTtEdit(' + i + ',\'break_minutes\',this.value)"' + dis + '></td>'
            + '<td id="att-tt-min-' + i + '" style="color:var(--t4, #94a3b8);"></td></tr>';
    });
    body.innerHTML = html || '<tr><td colspan="5" class="att-empty">This class has no sessions.</td></tr>';
    rows.forEach(function(s, i) { attTtRowMinutes(i); });
    attTtStatus();
}
function attTtRowMinutes(i) {
    var s = attTimetable.sessions[i], el = document.getElementById('att-tt-min-' + i);
    if (!el) return;
    var n = attTtMinutes(s);
    el.textContent = n === null ? '— needs times and break' : attFmtMin(n) + (s.confirmed ? '' : ' (not confirmed)');
    el.style.color = n === null ? '#f59e0b' : (s.confirmed ? '#22c55e' : '#94a3b8');
}
function attTtStatus() {
    var el = document.getElementById('att-tt-status');
    if (!el || !attTimetable) return;
    var ok = attTimetable.confirmed;
    el.style.color = ok ? '#22c55e' : '#f59e0b';
    el.textContent = !ok
        ? '⚠ ' + (attTimetable.exception || 'Changes not confirmed yet') + ' · enter the times and breaks, then confirm; certificates for this class are on hold'
        : (attTimetable.source === 'standard'
            ? (attTimetable.kind === 'evening' ? '✓ Standard evening class (5:30–9:30 pm, 4 hours)' : '✓ Standard 7.5-hour day (9:30 am–6:00 pm, lunch excluded)')
                + ' · total training time ' + attFmtMin(attTimetable.total_minutes)
            : '✓ Timetable entered and confirmed · total training time ' + attFmtMin(attTimetable.total_minutes));
}
function attTtEdit(i, field, val) {
    var s = attTimetable.sessions[i];
    s[field] = val;
    s.confirmed = false;            // any edit needs re-confirming
    attTimetable.confirmed = false;
    attTtRowMinutes(i);
    attTtStatus();
}
function attSaveTimetable() {
    if (!attRunId || !attTimetable) return;
    var btn = document.getElementById('att-tt-btn');
    var st = document.getElementById('att-tt-save-status');
    btn.disabled = true; st.textContent = '';
    fetch(ATT_TT_SAVE_URL, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: attRunId, form_key: ATT_FORM_KEY, sessions: attTimetable.sessions.map(function(s) {
            return { key: s.key, start: s.start, end: s.end, break_minutes: s.break_minutes === null ? '' : String(s.break_minutes) };
        }) })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        btn.disabled = false;
        st.style.color = d.success ? '#22c55e' : '#f87171';
        st.textContent = (d.success ? '✓ ' : '✗ ') + (d.message || '');
        if (d.success) { attTimetable = d.timetable; attRenderTimetable(); attRender(); attRefreshConfirmation(); }
        setTimeout(function(){ st.textContent=''; }, d.success ? 3000 : 8000);
    })
    .catch(function(){ btn.disabled = false; st.style.color = '#f87171'; st.textContent = '✗ Network error'; });
}
// ── Malaysia: trainer attendance confirmation (certificates wait for it) ─────
function attFmtWhen(utc) {   // recorded_at is stored in UTC -> show Malaysia time
    var d = new Date(String(utc || '').replace(' ', 'T') + 'Z');
    return isNaN(d) ? String(utc || '') : d.toLocaleString('en-GB', { timeZone: 'Asia/Kuala_Lumpur', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function attRenderConfirmation() {
    var st = document.getElementById('att-conf-status');
    if (!st) return;
    var c = attConf || { status: 'none', below: [] };
    var ttOk = attTimetable && attTimetable.confirmed;
    if (c.status === 'confirmed') {
        st.style.color = '#22c55e';
        st.textContent = '✓ Final attendance confirmed by ' + (c.recorded_by || c.trainer_name || 'the trainer') + ' on ' + attFmtWhen(c.recorded_at)
            + ' · ' + c.below.length + ' learner(s) below 75% · certificates go to the others automatically';
    } else if (c.status === 'excluded') {
        st.style.color = '#94a3b8';
        st.textContent = '— Excluded from certificates' + (c.note ? ': ' + c.note : '');
    } else {
        st.style.color = '#f59e0b';
        st.textContent = c.status === 'reopened'
            ? '⚠ Attendance changed after it was confirmed as final · the trainer must confirm again; certificates for this class are on hold'
            : '⚠ Final attendance not confirmed yet · certificates for this class are on hold' + (ttOk ? '' : ' (set the class timetable first)');
    }
    var body = document.getElementById('att-conf-body'), html = '';
    attCertRoster.forEach(function(l) {
        var sent = l.cert_status === 'sent' || l.cert_status === 'issued';
        html += '<tr><td>' + esc(l.name) + '</td><td>' + esc(l.email) + '</td>'
            + '<td style="color:' + (l.meets ? '#22c55e' : '#f59e0b') + ';">' + (ttOk ? l.pct + '%' : '—') + '</td>'
            + '<td style="color:' + (sent ? '#22c55e' : (l.meets ? '#cbd5e1' : '#f59e0b')) + ';">'
            + (sent ? 'Sent' : (!ttOk ? '—' : (l.meets ? 'Qualifies (75% or more)' : 'Below 75%'))) + '</td></tr>';
    });
    body.innerHTML = html || '<tr><td colspan="4" class="att-empty">No learners in this class.</td></tr>';
    var form = document.getElementById('att-conf-form');
    form.style.display = (attCanConfirm && c.status !== 'confirmed' && c.status !== 'excluded') ? 'inline-flex' : 'none';
    document.getElementById('att-conf-save-status').textContent = '';
    document.getElementById('att-conf-tick').checked = false;
}
// Re-read the training-time percentages and the confirmation after attendance or the timetable is saved.
function attRefreshConfirmation(note) {
    fetch(ATT_LOAD_URL + '?run_id=' + attRunId, { credentials: 'same-origin' }).then(function(r){ return r.json(); }).then(function(x){
        if (!x.success) return;
        attConf = x.confirmation || null; attCertRoster = x.cert_roster || []; attRenderConfirmation();
        if (note) { var st = document.getElementById('att-conf-save-status'); st.style.color = '#22c55e'; st.textContent = '✓ ' + note; }
    });
}
function attRecordConfirmation() {
    var btn = document.getElementById('att-conf-btn'), st = document.getElementById('att-conf-save-status');
    btn.disabled = true; st.textContent = '';
    fetch(ATT_CONF_URL, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: attRunId, form_key: ATT_FORM_KEY, confirmed: document.getElementById('att-conf-tick').checked })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        btn.disabled = false;
        if (d.success) {
            attRefreshConfirmation(d.message);   // re-read the certificate status (sent) of each learner
            return;
        }
        st.style.color = '#f87171';
        st.textContent = '✗ ' + (d.message || '');
    })
    .catch(function(){ btn.disabled = false; st.style.color = '#f87171'; st.textContent = '✗ Network error'; });
}
// Confirmed training minutes of a session (null when the timetable isn't confirmed).
function attSessMax(key) {
    var n = null;
    if (attTimetable && attTimetable.sessions) attTimetable.sessions.forEach(function(s){ if (s.key === key && s.confirmed) n = s.training_minutes; });
    return n;
}
function attMinutes(i, val) { attCell(attRoster[i], attActiveSess).m = val; }

// Today's session if the class is running now (AM before 1pm), else the first.
function attDefaultSession() {
    var now = new Date();
    var today = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0');
    var ampm = now.getHours() < 13 ? 'AM' : 'PM';
    for (var i = 0; i < attSessions.length; i++) {
        if (attSessions[i].date === today && attSessions[i].ampm === ampm) return attSessions[i].key;
    }
    for (var j = 0; j < attSessions.length; j++) {
        if (attSessions[j].date === today) return attSessions[j].key;
    }
    return attSessions[0].key;
}

// The (p)resent/(r)eason cell of a learner for a session — materialised so
// edits stick on the roster object and survive session switches until save.
function attCell(r, sessKey) {
    if (!r.att || Array.isArray(r.att)) r.att = {};
    if (!r.att[sessKey]) r.att[sessKey] = { p: 0, r: '', m: '' };
    return r.att[sessKey];
}

function attRenderSessTabs() {
    var el = document.getElementById('att-sess-tabs');
    if (!el) return;
    var html = '';
    attSessions.forEach(function(s) {
        var active = s.key === attActiveSess;
        var marked = 0;
        attRoster.forEach(function(r){ if (r.att && r.att[s.key] && r.att[s.key].p) marked++; });
        html += '<button type="button" data-active="' + (active ? '1' : '0') + '" onclick="attSetSession(\'' + s.key + '\')" style="'
            + 'padding:6px 14px;border-radius:999px;font-size:12px;font-weight:600;cursor:pointer;'
            + '">' + esc(s.label)
            + (marked ? ' <span style="opacity:.8;">(' + marked + '✓)</span>' : '')
            + '</button>';
    });
    el.innerHTML = html;
    // Force the colors as !important inline styles — the admin dark-theme's
    // global button rules are !important and beat any plain inline style
    // (same trap + same fix as the .att-tab strip above).
    var isLight = (document.documentElement.getAttribute('data-theme') || 'dark') === 'light';
    el.querySelectorAll('button').forEach(function(b) {
        var active = b.getAttribute('data-active') === '1';
        b.style.setProperty('background', active ? '#2563eb' : 'transparent', 'important');
        b.style.setProperty('background-image', 'none', 'important');
        b.style.setProperty('border', '1px solid ' + (active ? '#2563eb' : (isLight ? '#cbd5e1' : '#334155')), 'important');
        b.style.setProperty('color', active ? '#ffffff' : (isLight ? '#475569' : '#94a3b8'), 'important');
        b.style.setProperty('box-shadow', 'none', 'important');
        b.style.setProperty('text-shadow', 'none', 'important');
        b.style.setProperty('text-transform', 'none', 'important');
    });
}

function attSetSession(key) {
    attActiveSess = key;
    attSel = {};
    var selAll = document.getElementById('att-sel-all');
    if (selAll) selAll.checked = false;
    attRenderSessTabs();
    attRender();
}

// ── Finger signatures from the TC LMS apps ───────────────────────────────────
function attSigWhen(utc) {   // signed_at is stored in UTC -> show the site's local time
    var d = new Date(String(utc || '').replace(' ', 'T') + 'Z');
    if (isNaN(d)) return String(utc || '');
    try { return d.toLocaleString('en-GB', { timeZone: ATT_TZ, day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
    catch (e) { return d.toLocaleString('en-GB'); }
}
function attSigSrc(id) { return ATT_SIG_URL + '?run_id=' + attRunId + '&id=' + encodeURIComponent(id); }
function attSigTile(id, who, at, by) {
    var cap = 'Signed by ' + who + ' on ' + attSigWhen(at) + (by ? ' (on ' + by + '\'s phone)' : '');
    return '<span class="att-sig" role="button" tabindex="0" title="' + esc(cap) + '"'
        + ' data-sig="' + esc(id) + '" data-cap="' + esc(cap) + '" onclick="attSigZoom(this)" onkeydown="if(event.key===\'Enter\'||event.key===\' \'){event.preventDefault();attSigZoom(this);}">'
        + '<img src="' + esc(attSigSrc(id)) + '" alt="Signature of ' + esc(who) + '" loading="lazy"></span>';
}
function attSigHtml(r) {
    var mine = (attSigs.learner || {})[String(r.learner_email || '').toLowerCase()] || {};
    var s = mine[attActiveSess];
    return s ? attSigTile(s.id, r.learner_name || r.learner_email, s.at, s.by) : '';
}
function attRenderTrainerSig() {
    var el = document.getElementById('att-trainer-sig');
    if (!el) return;
    var list = (attSigs.trainer || {})[attActiveSess] || [];
    var anyLearner = false;
    Object.keys(attSigs.learner || {}).forEach(function (e) { if ((attSigs.learner[e] || {})[attActiveSess]) anyLearner = true; });
    if (!list.length && !anyLearner) { el.innerHTML = ''; el.style.display = 'none'; return; }
    el.style.display = '';
    el.innerHTML = list.length
        ? '<span>Trainer signature:</span>' + list.map(function (t) {
              return '<span style="display:inline-flex;align-items:center;">' + esc(t.name || t.email) + attSigTile(t.id, t.name || t.email, t.at, '') + '</span>';
          }).join('')
        : '<span>The trainer has not signed this session in the app yet.</span>';
}
function attSigZoom(tile) {
    var opener = tile;
    var layer = document.createElement('div');
    layer.className = 'att-sig-layer';
    layer.setAttribute('role', 'dialog');
    layer.setAttribute('aria-modal', 'true');
    layer.setAttribute('aria-label', 'Signature');
    layer.innerHTML = '<div class="att-sig-box"><img src="' + esc(attSigSrc(tile.getAttribute('data-sig'))) + '" alt="Signature">'
        + '<div class="att-sig-cap">' + esc(tile.getAttribute('data-cap')) + '</div>'
        + '<div style="text-align:center;margin-top:12px;"><button type="button" class="att-btn att-btn-ghost" style="color:#0f172a !important;border-color:#cbd5e1 !important;">Close</button></div></div>';
    function close() { document.removeEventListener('keydown', onKey, true); layer.remove(); if (opener && opener.focus) opener.focus(); }
    function onKey(e) { if (e.key === 'Escape') { e.stopPropagation(); close(); } }
    layer.addEventListener('click', function (e) { if (e.target === layer || e.target.tagName === 'BUTTON') close(); });
    document.addEventListener('keydown', onKey, true);
    document.body.appendChild(layer);
    layer.querySelector('button').focus();
}

function attRender() {
    attRenderTrainerSig();
    var tb = document.getElementById('att-tbody');
    var html = '';
    if (!attRoster.length) {
        var cols = ATT_READONLY ? 5 : (ATT_IS_MY ? 8 : 7);
        document.getElementById('att-table').style.display = attRoster.length ? '' : 'none';
        document.getElementById('att-roster-card').querySelector('#att-kpis').style.display = 'none';
        tb.innerHTML = '<tr><td colspan="' + cols + '" class="att-empty">No learners enrolled' + (ATT_READONLY ? '' : '. Use “+ Add Learner”.') + '</td></tr>';
        attUpdateCounters();
        return;
    }
    document.getElementById('att-table').style.display = '';
    attRoster.forEach(function(r, i) {
        var cell = attCell(r, attActiveSess);
        var present = !!cell.p;
        var rowCls = r.is_walkin ? ' class="walkin"' : '';
        html += '<tr' + rowCls + ' data-idx="' + i + '">';
        if (!ATT_READONLY) {
            html += '<td><input type="checkbox" ' + (attSel[i] ? 'checked' : '') + ' onchange="attSelToggle(' + i + ', this.checked)" style="width:15px;height:15px;accent-color:#2563eb;cursor:pointer;"></td>';
        }
        html += '<td style="color:var(--t5, #64748b)">' + (i + 1) + '</td>'
            + '<td>' + esc(r.learner_name || '—') + (r.is_walkin ? '<span class="att-badge-walkin">Walk-in</span>' : '') + '</td>'
            + '<td style="color:var(--t4, #94a3b8);font-size:12px;">' + esc(r.learner_email)
            + (r.learner_phone ? '<div style="color:var(--t5, #64748b);font-size:11px;margin-top:2px;">' + esc(r.learner_phone) + '</div>' : '') + '</td>';
        if (ATT_READONLY) {
            html += '<td>' + (present
                ? '<span class="att-present-lbl" style="color:var(--green, #22c55e)">✓ Present</span>'
                : '<span class="att-present-lbl" style="color:var(--red-soft, #f87171)">✗ Absent</span>') + attSigHtml(r) + '</td>';
        } else {
            html += '<td>'
                + '<label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;">'
                + '<input type="checkbox" ' + (present ? 'checked' : '') + ' onchange="attToggle(' + i + ', this.checked)" style="width:16px;height:16px;accent-color:#22c55e;">'
                + '<span class="att-present-lbl" id="att-lbl-' + i + '" style="color:' + (present ? '#22c55e' : '#f87171') + '">' + (present ? 'Present' : 'Absent') + '</span>'
                + '</label>' + attSigHtml(r) + '</td>'
                + (ATT_IS_MY ? '<td><input type="number" min="1" step="1" class="att-reason" id="att-min-' + i + '" style="max-width:130px;' + (present ? '' : 'display:none;') + '"'
                    + ' placeholder="' + (attSessMax(attActiveSess) ? 'Full: ' + attSessMax(attActiveSess) + ' min' : 'Full session') + '"'
                    + ' value="' + esc(cell.m || '') + '" oninput="attMinutes(' + i + ', this.value)"></td>' : '')
                + '<td><input type="text" class="att-reason" id="att-reason-' + i + '" placeholder="Enter reason..." value="' + esc(cell.r) + '" oninput="attReason(' + i + ', this.value)"' + (present ? ' style="display:none;"' : '') + '></td>'
                + '<td>' + (r.is_walkin ? '<button type="button" class="att-btn att-btn-danger" style="padding:3px 8px;" onclick="attRemove(' + i + ')">Remove</button>' : '') + '</td>';
        }
        html += '</tr>';
    });
    document.getElementById('att-tbody').innerHTML = html;
    attUpdateCounters();
    attUpdateBulkButtons();
    if (ATT_SHOW_KPIS) attRenderKpis();
}

function attToggle(i, checked) {
    var cell = attCell(attRoster[i], attActiveSess);
    cell.p = checked ? 1 : 0;
    var lbl = document.getElementById('att-lbl-' + i);
    var reason = document.getElementById('att-reason-' + i);
    var mins = document.getElementById('att-min-' + i);
    if (mins) { mins.style.display = checked ? '' : 'none'; if (!checked) { mins.value = ''; cell.m = ''; } }
    if (lbl) { lbl.textContent = checked ? 'Present' : 'Absent'; lbl.style.color = checked ? '#22c55e' : '#f87171'; }
    if (reason) { reason.style.display = checked ? 'none' : ''; if (checked) { reason.value=''; cell.r=''; } }
    attUpdateCounters();
    attRenderSessTabs();
}
function attReason(i, val) { attCell(attRoster[i], attActiveSess).r = val; }

function attAllPresent() {
    attRoster.forEach(function(r){ var c = attCell(r, attActiveSess); c.p = 1; c.r = ''; });
    attRenderSessTabs();
    attRender();
}

// ── Multi-select + bulk marking ──────────────────────────────────────────────
function attSelToggle(i, checked) {
    if (checked) attSel[i] = true; else delete attSel[i];
    var selAll = document.getElementById('att-sel-all');
    if (selAll) selAll.checked = Object.keys(attSel).length === attRoster.length && attRoster.length > 0;
    attUpdateBulkButtons();
}
function attSelAll(checked) {
    attSel = {};
    if (checked) attRoster.forEach(function(_, i){ attSel[i] = true; });
    attRender();
}
function attUpdateBulkButtons() {
    var n = Object.keys(attSel).length;
    var bp = document.getElementById('att-bulk-present');
    var ba = document.getElementById('att-bulk-absent');
    if (bp) { bp.disabled = !n; bp.textContent = n ? 'Mark Present (' + n + ')' : 'Mark Present'; }
    if (ba) { ba.disabled = !n; ba.textContent = n ? 'Mark Absent (' + n + ')' : 'Mark Absent'; }
}
function attBulkMark(present) {
    Object.keys(attSel).forEach(function(i) {
        var r = attRoster[i];
        if (!r) return;
        var c = attCell(r, attActiveSess);
        c.p = present ? 1 : 0;
        if (present) c.r = '';
    });
    attRenderSessTabs();
    attRender();
}

function attUpdateCounters() {
    var p = 0; attRoster.forEach(function(r){ if (attCell(r, attActiveSess).p) p++; });
    document.getElementById('att-cnt-present').textContent = p;
    document.getElementById('att-cnt-absent').textContent = attRoster.length - p;
    document.getElementById('att-cnt-total').textContent = attRoster.length;
}

function attRenderKpis() {
    var kp = document.getElementById('att-kpis');
    var total = attRoster.length;
    var present = 0; attRoster.forEach(function(r){ if (attCell(r, attActiveSess).p) present++; });
    var pct = total ? Math.round((present / total) * 100) : 0;
    var col = pct >= 75 ? '#22c55e' : (pct >= 50 ? '#f59e0b' : '#f87171');
    var sess = null;
    attSessions.forEach(function(s){ if (s.key === attActiveSess) sess = s; });
    kp.innerHTML =
        '<div class="att-kpi"><div class="att-kpi-num" style="color:var(--t2, #e2e8f0)">' + total + '</div><div class="att-kpi-lbl">No. of Learners</div></div>' +
        '<div class="att-kpi"><div class="att-kpi-num" style="color:var(--green, #22c55e)">' + present + '</div><div class="att-kpi-lbl">Present' + (sess ? ' — ' + esc(sess.label) : '') + '</div></div>' +
        '<div class="att-kpi"><div class="att-kpi-num" style="color:' + col + '">' + pct + '%</div><div class="att-kpi-lbl">Attendance Rate</div></div>';
    kp.style.display = '';
}

function attSave() {
    var btn = document.getElementById('att-save-btn');
    var st = document.getElementById('att-save-status');
    btn.disabled = true; btn.textContent = 'Saving…'; st.textContent = '';
    // Flatten the full learner × session matrix — every session the trainer
    // touched (or the server already had) is saved in one call.
    var records = [];
    attRoster.forEach(function(r) {
        attSessions.forEach(function(s) {
            if (!r.att || Array.isArray(r.att) || !r.att[s.key]) return; // untouched cell — keep server state
            records.push({
                learner_email:     r.learner_email,
                learner_name:      r.learner_name,
                session_key:       s.key,
                is_present:        r.att[s.key].p ? 1 : 0,
                minutes_attended:  r.att[s.key].p ? (r.att[s.key].m || '') : '',
                reason_of_absence: r.att[s.key].r || ''
            });
        });
    });
    fetch(ATT_SAVE_URL, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: attRunId, form_key: ATT_FORM_KEY, records: records,
            correction_reason: (document.getElementById('att-corr-reason') || {}).value || '' })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        btn.disabled = false; btn.textContent = 'Save Attendance';
        if (d.success && d.corrections) { document.getElementById('att-corr-reason').value = ''; }
        st.style.color = d.success ? '#22c55e' : '#f87171';
        st.textContent = (d.success ? '✓ ' : '✗ ') + (d.message || '');
        setTimeout(function(){ st.textContent=''; }, d.reopened ? 8000 : 3000);
        if (d.success && ATT_IS_MY) attRefreshConfirmation();
    })
    .catch(function(){ btn.disabled=false; btn.textContent='Save Attendance'; st.style.color='#f87171'; st.textContent='✗ Network error'; });
}

function attHideAddResults() {
    var box = document.getElementById('att-add-results');
    if (box) box.style.display = 'none';
}

// Braille search spinner + tick/cross (mirrors the cert toggle's certSpin*).
var _attSpin = null, _attSpinResultTimer = null;
function attSpinStart() {
    var el = document.getElementById('att-search-spin'); if (!el) return;
    if (_attSpinResultTimer) { clearTimeout(_attSpinResultTimer); _attSpinResultTimer = null; }
    el.style.display = 'inline-block'; el.style.color = '#60a5fa';
    var f = ['⠋','⠙','⠹','⠸','⠼','⠴','⠦','⠧','⠇','⠏'], i = 0; el.textContent = f[0];
    if (_attSpin) clearInterval(_attSpin);
    _attSpin = setInterval(function(){ i = (i+1) % f.length; el.textContent = f[i]; }, 80);
}
function attSpinResult(ok) {
    var el = document.getElementById('att-search-spin'); if (!el) return;
    if (_attSpin) { clearInterval(_attSpin); _attSpin = null; }
    el.style.display = 'inline-block'; el.textContent = ok ? '✓' : '✗';
    el.style.color = ok ? '#22c55e' : '#ef4444';
    _attSpinResultTimer = setTimeout(function(){ el.textContent = ''; el.style.display = 'none'; }, 1500);
}
function attSpinClear() {
    var el = document.getElementById('att-search-spin'); if (!el) return;
    if (_attSpin) { clearInterval(_attSpin); _attSpin = null; }
    if (_attSpinResultTimer) { clearTimeout(_attSpinResultTimer); _attSpinResultTimer = null; }
    el.textContent = ''; el.style.display = 'none';
}

// Typing in name OR email triggers a DEBOUNCED server search (shared with the
// Assign Learners panel). Results show in a dropdown anchored under the active
// field. Searching the EMAIL field doubles as the existing-account check.
function attAddSearch(input) {
    var box = document.getElementById('att-add-results');
    if (!box) return;
    input.parentNode.appendChild(box); // anchor under the active field
    var spin = document.getElementById('att-search-spin');
    if (spin) input.parentNode.appendChild(spin); // move spinner into the active field
    var isEmail = (input.id === 'att-add-email');
    var q = (input.value || '').trim();
    // Manually editing the email away from a picked learner clears the pick.
    if (isEmail && q.toLowerCase() !== _attChosenEmail) _attChosenEmail = '';
    attUpdateAddState();

    if (_attSearchTimer) clearTimeout(_attSearchTimer);
    if (q.length < 2) { box.style.display = 'none'; attSpinClear(); return; }

    attSpinStart();
    _attSearchTimer = setTimeout(function() {
        fetch(ATT_SEARCH_URL + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
          .then(function(r){ return r.json(); })
          .then(function(j){
              var list = (j && j.success && j.learners) ? j.learners : [];
              attSpinResult(list.length > 0);
              // Email-field search confirms whether the exact email exists.
              if (isEmail) {
                  var ql = q.toLowerCase();
                  _attEmailKnown = {
                      email: ql,
                      exists: list.some(function(l){ return (l.email || '').toLowerCase() === ql; })
                  };
                  attUpdateAddState();
              }
              box.innerHTML = '';
              if (!list.length) {
                  var n = document.createElement('div');
                  n.style.cssText = 'padding:8px 10px;color:#64748b;font-size:12px;';
                  n.textContent = 'No matches';
                  box.appendChild(n);
                  box.style.display = 'block';
                  return;
              }
              list.forEach(function(l) {
                  var d = document.createElement('div');
                  d.style.cssText = 'padding:8px 10px;cursor:pointer;font-size:12px;border-bottom:1px solid #1e293b;';
                  d.onmouseover = function(){ d.style.background = '#1e293b'; };
                  d.onmouseout  = function(){ d.style.background = 'transparent'; };
                  d.innerHTML = '<span style="color:var(--t2, #e2e8f0);">' + esc(l.name) + '</span> <span style="color:var(--t5, #64748b);">' + esc(l.email) + '</span>';
                  d.onmousedown = function(e){ e.preventDefault(); attPickLearner(l.email, l.name); };
                  box.appendChild(d);
              });
              box.style.display = 'block';
          })
          .catch(function(){ attSpinResult(false); box.style.display = 'none'; });
    }, 200);
}

function attPickLearner(email, name) {
    document.getElementById('att-add-name').value  = name || '';
    document.getElementById('att-add-email').value = email || '';
    _attChosenEmail = (email || '').toLowerCase();
    attHideAddResults();
    attUpdateAddState();
}

// Existing if the learner was picked from the list, or the email-field search
// confirmed an exact match. Otherwise (email present) it's a new account.
function attUpdateAddState() {
    var email  = (document.getElementById('att-add-email').value || '').trim().toLowerCase();
    var note   = document.getElementById('att-add-note');
    var status = document.getElementById('att-add-status');
    var btn    = document.getElementById('att-add-btn');
    var existing = !!email && (email === _attChosenEmail || (_attEmailKnown.email === email && _attEmailKnown.exists));
    if (existing) {
        status.style.display = 'block'; status.style.color = '#22c55e';
        status.textContent = '✓ Existing learner — they will be enrolled into this class (no new account created).';
        if (note) note.textContent = 'This learner already exists. They will be added to this class roster.';
        btn.textContent = 'Add to Class';
    } else if (email) {
        status.style.display = 'block'; status.style.color = '#f59e0b';
        status.textContent = '⚠ No existing learner with this email — submitting will CREATE a new learner account with the name + email above.';
        if (note) note.textContent = 'No match found. A new learner account will be created and added to this class.';
        btn.textContent = 'Create & Add Learner';
    } else {
        status.style.display = 'none';
        if (note) note.textContent = 'Type a name or email. If the learner already exists, pick them from the list; otherwise a new learner account will be created and added to this class.';
        btn.textContent = 'Add Learner';
    }
}

function attOpenAdd() {
    document.getElementById('att-add-name').value = '';
    document.getElementById('att-add-email').value = '';
    document.getElementById('att-add-err').style.display = 'none';
    _attChosenEmail = '';
    _attEmailKnown  = { email: '', exists: false };
    attHideAddResults();
    attUpdateAddState();
    document.getElementById('att-add-modal').style.display = 'flex';
}
document.getElementById('att-add-modal').addEventListener('click', function(e){ if (e.target === this) this.style.display='none'; });
// Dismiss the autocomplete dropdown when clicking outside the inputs/list.
document.addEventListener('click', function(e){
    var box = document.getElementById('att-add-results');
    if (!box || box.style.display === 'none') return;
    if (e.target.id === 'att-add-name' || e.target.id === 'att-add-email' || box.contains(e.target)) return;
    box.style.display = 'none';
});

function attAddLearner() {
    var name = document.getElementById('att-add-name').value.trim();
    var email = document.getElementById('att-add-email').value.trim();
    var err = document.getElementById('att-add-err');
    if (!name || !email) { err.textContent = 'Name and email are required.'; err.style.display='block'; return; }
    if (email.indexOf('@') < 0) { err.textContent = 'Please enter a valid email address.'; err.style.display='block'; return; }
    var btn = document.getElementById('att-add-btn');
    btn.disabled = true; btn.textContent = 'Adding…';
    fetch(ATT_ADD_URL, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: attRunId, full_name: name, email: email, form_key: ATT_FORM_KEY })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        btn.disabled = false; btn.textContent = 'Add Learner';
        if (!d.success) { err.textContent = d.message || 'Failed to add.'; err.style.display='block'; return; }
        document.getElementById('att-add-modal').style.display = 'none';
        attSelectClass(attRunId); // reload roster
    })
    .catch(function(){ btn.disabled=false; btn.textContent='Add Learner'; err.textContent='Network error.'; err.style.display='block'; });
}

function attRemove(i) {
    var r = attRoster[i];
    if (!r || !confirm('Remove walk-in ' + (r.learner_name || r.learner_email) + ' from this class?')) return;
    fetch(ATT_REMOVE_URL, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ run_id: attRunId, learner_email: r.learner_email, form_key: ATT_FORM_KEY })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (!d.success) { alert('Error: ' + (d.message || 'remove failed')); return; }
        attSelectClass(attRunId);
    })
    .catch(function(){ alert('Network error.'); });
}

// Deep-link / preselect
(function(){
    var sel = document.getElementById('att-class');
    if (sel && sel.value) attSelectClass(sel.value);
})();
</script>
