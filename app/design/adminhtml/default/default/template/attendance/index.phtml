<?php
/** @var MMD_Attendance_Helper_Data $h */
$h        = Mage::helper('mmd_attendance');
$req      = Mage::app()->getRequest();
$bucket      = $req->getParam('bucket') === 'completed' ? 'completed' : 'active';
$preRun      = (int) $req->getParam('run_id');
$isCompleted = ($bucket === 'completed');
// Past classes are NO LONGER locked — trainers routinely mark/correct
// attendance at end-of-day or the next morning, so completed classes stay
// fully editable (matches LMS edit-anytime). The Completed tab still shows
// the attendance-rate KPI summary on top of the editable roster.
$readonly    = false;

$classes  = $h->getClassList($bucket);

// Focused mode — opened from a class detail page / card with ?run_id=N.
// The trainer already picked the class there, so the page must go straight
// to that class's learner roster instead of asking them to choose again.
// The bucket / store / trainer filters of getClassList() can hide the run
// (wrong bucket, trainer-mapping gap) — inject it so the preselect + auto-
// load always work, and swap the dropdown for a static class summary.
$preRunRow = null;
if ($preRun > 0) {
    foreach ($classes as $c) {
        if ((int)$c['run_id'] === $preRun) { $preRunRow = $c; break; }
    }
    if (!$preRunRow && ($preRunRow = $h->getClassRow($preRun))) {
        array_unshift($classes, $preRunRow);
    }
}

// Back to Class — focused mode was entered from the class detail page
// (View Course card), so offer the way back to that exact class: the same
// dashboard URL the My Classes cards use (course_id + run query param).
$backUrl = '';
if ($preRunRow && !empty($preRunRow['product_id'])) {
    $backUrl = Mage::helper('adminhtml')->getUrl('adminhtml/dashboard', array(
        'course_id' => (int) $preRunRow['product_id'],
        '_query'    => array('run' => $preRun),
    ));
}

$loadUrl   = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/load');
$saveUrl   = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/save');
$addUrl    = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/addLearner');
$removeUrl = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/removeLearner');
$searchLearnersUrl = Mage::helper('adminhtml')->getUrl('adminhtml/coursesave/searchLearners');
$activeUrl = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/index', array('bucket' => 'active'));
$compUrl   = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/index', array('bucket' => 'completed'));
// Malaysia: class timetable + actual minutes (attendance by training hours).
$isMy        = $h->isMalaysiaSite();
$ttSaveUrl   = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/saveTimetable');
$confUrl     = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/recordConfirmation');
// Finger signatures from the TC LMS apps (image endpoint + the site's timezone for "signed at").
$sigUrl      = Mage::helper('adminhtml')->getUrl('adminhtml/attendance/signature');
$siteTz      = (string) Mage::getStoreConfig('general/locale/timezone') ?: 'Asia/Singapore';

// Certificate controls
$certToggleUrl = Mage::helper('adminhtml')->getUrl('adminhtml/certificate/setAutoEnabled');
$certHelper    = Mage::helper('mmd_certificate');
$certAutoOn    = $certHelper->isAutoEnabled();
$certCanToggle = Mage::helper('mmd_rolemanager')->isRoleAllowed(array('admin', 'training_provider', 'developer'));
?>
