<?xml version="1.0"?>
<!--
  MMD_Blog — CMS-style blog posts as lead magnets.

  Frontend:  /blog (list), /blog/<url_key> (post via custom slug router),
             /blog/tag/<tag> (filter by Magento tag), /blog/index/rate (AJAX star rating).
  Admin:     Marketing sidebar -> Blog Posts (adminhtml/blog) — grid + CMS-page-style
             editor with WYSIWYG, SEO meta, tags (reuses the Magento `tag` table),
             hero image upload to Cloudflare R2 (mmd_courseimage/r2 helper).
  Cron:      Daily 09:00 propose — writes a lead-magnet post for the next
             unblogged top-selling course via Claude (SG: WSQ/TGS- only) and
             emails the managers for approval; an approval books the next free
             Monday/Thursday 09:00 publish slot (2 posts/week). Every 10 min
             publishDue flips due posts live + shares to LinkedIn & Facebook.
             Partner sites (auto_publish=1) keep the legacy immediate-publish
             behaviour.

  Every post is a lead magnet: the view template always renders a course sign-up
  CTA (related_skus) with the WSQ funding / SkillsFuture Credit hook.
-->
<config>
    <modules>
        <MMD_Blog>
            <version>1.0.0</version>
        </MMD_Blog>
    </modules>

    <global>
        <helpers>
            <mmd_blog>
                <class>MMD_Blog_Helper</class>
            </mmd_blog>
        </helpers>
        <blocks>
            <mmd_blog>
                <class>MMD_Blog_Block</class>
            </mmd_blog>
        </blocks>
        <models>
            <mmd_blog>
                <class>MMD_Blog_Model</class>
                <resourceModel>mmd_blog_resource</resourceModel>
            </mmd_blog>
            <mmd_blog_resource>
                <class>MMD_Blog_Model_Resource</class>
                <entities>
                    <post>
                        <table>mmd_blog_post</table>
                    </post>
                </entities>
            </mmd_blog_resource>
        </models>
        <resources>
            <mmd_blog_write><connection><use>core_write</use></connection></mmd_blog_write>
            <mmd_blog_read><connection><use>core_read</use></connection></mmd_blog_read>
        </resources>
        <!-- Slug router: maps /blog/<url_key> and /blog/tag/<name> onto
             blog/index/view|tag. Registered the Mage_Cms way (global event
             observer — NOT <frontend>, the front controller init fires before
             the frontend event area loads). -->
        <events>
            <controller_front_init_routers>
                <observers>
                    <mmd_blog>
                        <class>MMD_Blog_Controller_Router</class>
                        <method>initControllerRouters</method>
                    </mmd_blog>
                </observers>
            </controller_front_init_routers>
        </events>
    </global>

    <frontend>
        <routers>
            <mmd_blog>
                <use>standard</use>
                <args>
                    <module>MMD_Blog</module>
                    <frontName>blog</frontName>
                </args>
            </mmd_blog>
        </routers>
        <layout>
            <updates>
                <mmd_blog>
                    <file>mmd_blog.xml</file>
                </mmd_blog>
            </updates>
        </layout>
    </frontend>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <mmd_blog before="Mage_Adminhtml">MMD_Blog_Adminhtml</mmd_blog>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>

    <default>
        <mmd_blog>
            <autoblog>
                <enabled>1</enabled>
                <!-- 1 = cron-created posts go live immediately (legacy / partner
                     sites); 0 = manager review + Mon/Thu publish scheduling
                     (migration 450 sets 0 on the SG instance only) -->
                <auto_publish>1</auto_publish>
                <!-- 1 = share newly published posts on LinkedIn (env keys or the
                     shared mmd_marketing/linkedin/* credentials) -->
                <linkedin_enabled>1</linkedin_enabled>
                <!-- 1 = share newly published posts on the Facebook page
                     (mmd_marketing/facebook/* credentials; skips when unset) -->
                <facebook_enabled>1</facebook_enabled>
            </autoblog>
        </mmd_blog>
    </default>

    <crontab>
        <jobs>
            <!-- Daily 09:00 (container tz = Asia/Singapore) — propose the next
                 lead-magnet post. Review flow (SG): paces itself to 2 posts/week
                 via the Mon/Thu slot check, reminds a silent reviewer once after
                 24h, expires a 5-day-old pending post. Legacy flow (partners):
                 the "one post per 5 days" guard applies. No-ops safely when
                 disabled or when Claude credentials are missing. -->
            <mmd_blog_autoblog>
                <schedule><cron_expr>0 9 * * *</cron_expr></schedule>
                <run><model>mmd_blog/cron_autoblog::run</model></run>
            </mmd_blog_autoblog>
            <!-- Every 10 min — publish approved posts whose Monday/Thursday
                 09:00 slot has arrived, then share once to LinkedIn + Facebook. -->
            <mmd_blog_publish_due>
                <schedule><cron_expr>*/10 * * * *</cron_expr></schedule>
                <run><model>mmd_blog/cron_autoblog::publishDue</model></run>
            </mmd_blog_publish_due>
        </jobs>
    </crontab>
</config>
