<?xml version="1.0"?>
<config>
    <modules>
        <MMD_RoleManager>
            <version>1.3.0</version>
        </MMD_RoleManager>
    </modules>

    <global>
        <models>
            <mmd_rolemanager>
                <class>MMD_RoleManager_Model</class>
                <resourceModel>mmd_rolemanager_mysql4</resourceModel>
            </mmd_rolemanager>
            <mmd_rolemanager_mysql4>
                <class>MMD_RoleManager_Model_Mysql4</class>
                <entities>
                    <role_map>
                        <table>mmd_user_role_map</table>
                    </role_map>
                </entities>
            </mmd_rolemanager_mysql4>
            <!-- WYSIWYG plugin path overrides — OpenMage core points at
                 tinymce/plugins/openmage*.js paths that don't exist; we
                 redirect to the legacy tiny_mce/plugins/magento*.js paths
                 that do. Without this, every WYSIWYG editor 404s on plugin
                 load and silently fails to attach. -->
            <core>
                <rewrite>
                    <variable_config>MMD_RoleManager_Model_Wysiwyg_VariableConfig</variable_config>
                </rewrite>
            </core>
            <widget>
                <rewrite>
                    <widget_config>MMD_RoleManager_Model_Wysiwyg_WidgetConfig</widget_config>
                </rewrite>
            </widget>
        </models>

        <blocks>
            <mmd_rolemanager>
                <class>MMD_RoleManager_Block</class>
            </mmd_rolemanager>
            <adminhtml>
                <rewrite>
                    <page_menu>MMD_RoleManager_Block_Page_Menu</page_menu>
                </rewrite>
            </adminhtml>
        </blocks>

        <helpers>
            <mmd_rolemanager>
                <class>MMD_RoleManager_Helper</class>
            </mmd_rolemanager>
        </helpers>

        <resources>
            <mmd_rolemanager_setup>
                <setup>
                    <module>MMD_RoleManager</module>
                </setup>
                <connection>
                    <use>core_setup</use>
                </connection>
            </mmd_rolemanager_setup>
            <mmd_rolemanager_write>
                <connection>
                    <use>core_write</use>
                </connection>
            </mmd_rolemanager_write>
            <mmd_rolemanager_read>
                <connection>
                    <use>core_read</use>
                </connection>
            </mmd_rolemanager_read>
        </resources>

        <events>
            <admin_session_user_login_success>
                <observers>
                    <mmd_rolemanager_login>
                        <class>mmd_rolemanager/observer</class>
                        <method>onAdminLogin</method>
                    </mmd_rolemanager_login>
                </observers>
            </admin_session_user_login_success>
            <controller_action_predispatch>
                <observers>
                    <mmd_rolemanager_predispatch>
                        <class>mmd_rolemanager/observer</class>
                        <method>onPredispatch</method>
                    </mmd_rolemanager_predispatch>
                    <!-- Same mechanism as MMD_OtpLogin::allowOtpAction — lets the
                         public /learnerlogin form + POST through the core admin
                         auth observer without a logged-in session. -->
                    <mmd_rolemanager_learnerlogin_public>
                        <class>mmd_rolemanager/observer</class>
                        <method>allowLearnerloginAction</method>
                    </mmd_rolemanager_learnerlogin_public>
                </observers>
            </controller_action_predispatch>
            <!-- Clear the force-password-change flag once the user saves a
                 new password on their own account. -->
            <admin_user_save_after>
                <observers>
                    <mmd_rolemanager_force_pw_clear>
                        <class>mmd_rolemanager/observer</class>
                        <method>onAdminUserSaveAfter</method>
                    </mmd_rolemanager_force_pw_clear>
                </observers>
            </admin_user_save_after>
            <cms_wysiwyg_config_prepare>
                <observers>
                    <mmd_rolemanager_wysiwyg>
                        <class>mmd_rolemanager/observer</class>
                        <method>onWysiwygConfigPrepare</method>
                    </mmd_rolemanager_wysiwyg>
                </observers>
            </cms_wysiwyg_config_prepare>
            <!-- One store per site: strip Store/Website columns from every
                 admin grid (fires only for adminhtml template blocks). -->
            <adminhtml_block_html_before>
                <observers>
                    <mmd_rolemanager_grid_store_columns>
                        <class>mmd_rolemanager/observer</class>
                        <method>removeStoreColumnsFromAdminGrids</method>
                    </mmd_rolemanager_grid_store_columns>
                </observers>
            </adminhtml_block_html_before>
        </events>
    </global>

    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <MMD_RoleManager before="Mage_Adminhtml">MMD_RoleManager_Adminhtml</MMD_RoleManager>
                    </modules>
                </args>
            </adminhtml>
            <!-- LMS login — /lmslogin on every site (SG/MY/GH), for the
                 learner, trainer, developer and marketing roles (admin and
                 Super Admin sign in at /adminlogin, which accepts ALL roles).
                 Registered as an ADMIN router (not frontend) so the resulting
                 session is the same adminhtml session the dashboard uses;
                 a frontend-area login would land in the 'frontend' session
                 cookie and be invisible to the admin frontName. Learners
                 authenticate with their storefront email+password (AccountSync
                 keeps admin_user.password identical to the customer hash) or
                 via OTP; staff LMS roles use their dashboard credentials/OTP.
                 A user with several LMS roles goes through role selection. -->
            <lmslogin>
                <use>admin</use>
                <args>
                    <module>MMD_RoleManager</module>
                    <frontName>lmslogin</frontName>
                </args>
            </lmslogin>
            <!-- Legacy alias — /learnerlogin predates /lmslogin and is kept so
                 old bookmarks/emails keep working. Same controller. -->
            <learnerlogin>
                <use>admin</use>
                <args>
                    <module>MMD_RoleManager</module>
                    <frontName>learnerlogin</frontName>
                </args>
            </learnerlogin>
        </routers>
    </admin>

    <!-- Public frontend route for trainer invitation accept/decline.
         URL: /trainer_invite/respond?token=<hex>&action=accept|decline
         No session or login required — token is the authentication. -->
    <frontend>
        <routers>
            <mmd_rolemanager_trainer>
                <use>standard</use>
                <args>
                    <module>MMD_RoleManager</module>
                    <frontName>trainer_invite</frontName>
                </args>
            </mmd_rolemanager_trainer>
        </routers>
    </frontend>

    <adminhtml>
        <layout>
            <updates>
                <mmd_rolemanager>
                    <file>rolemanager.xml</file>
                </mmd_rolemanager>
            </updates>
        </layout>
    </adminhtml>

    <!-- Class formation cron — backend-only worker that materialises
         course_runs + course_run_enrolments from sales_flat_order. Runs
         every minute. Reads sales tables only; never written by storefront
         code paths. See Model/Cron/ClassFormation.php for the full
         frontend-invariant contract. -->
    <crontab>
        <jobs>
            <mmd_rolemanager_class_formation>
                <schedule><cron_expr>* * * * *</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_classFormation::run</model></run>
            </mmd_rolemanager_class_formation>
            <!-- Trainer invitation auto-sweep — Mon & Thu at 10:00 SGT.
                 Finds upcoming classes (within 30 days) with enrolled learners
                 but no trainer and no pending invitation, then sends the next
                 eligible trainer an invitation email. -->
            <mmd_rolemanager_trainer_invitation>
                <schedule><cron_expr>0 10 * * 1,4</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_trainerInvitation::run</model></run>
            </mmd_rolemanager_trainer_invitation>
            <!-- Daily trainer import from LMS — fail-safe gated by
                 mmd/trainer_import/auto_enabled (absent = OFF). 03:30 SGT. -->
            <mmd_rolemanager_trainer_import>
                <schedule><cron_expr>30 3 * * *</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_trainerImport::run</model></run>
            </mmd_rolemanager_trainer_import>
            <!-- NOTE: course sync from SG is MANUAL ONLY (admin "Sync All" /
                 "Sync One" buttons on country instances) — the daily auto-sync
                 cron was removed 2026-07-06 by owner decision. Partner fees,
                 schedules and trainer info are partner-owned; syncs happen
                 only when a human decides. -->
            <!-- Daily maintenance sweep — 02:00 SGT. Verifies the one-store-
                 per-site topology invariant (2026-07-06 blank-admin incident
                 guard), garbage-collects expired core_session rows, prunes old
                 var/report files, and publishes /media/health.json so external
                 monitoring needs no DB access. Runs identically on every
                 instance (SG + franchise partners). -->
            <mmd_rolemanager_daily_maintenance>
                <schedule><cron_expr>0 2 * * *</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_maintenance::run</model></run>
            </mmd_rolemanager_daily_maintenance>
            <!-- Daily category-ordering sweep — 01:00 (Magento cron runs on the
                 container clock, which is UTC). Re-applies the hard listing
                 rule in every category: WSQ (TGS-) first, then non-WSQ (C-)
                 alphabetically, then partner/other. The order is data-derived,
                 so adding/renaming/recategorising a course silently breaks it;
                 this sweep self-heals that within a day instead of needing a
                 fresh reorder migration each time. Same rule as migration 601.
                 Kill switch: mmd/category_ordering/enabled = 0. -->
            <mmd_rolemanager_category_ordering>
                <schedule><cron_expr>0 1 * * *</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_categoryOrdering::run</model></run>
            </mmd_rolemanager_category_ordering>
            <!-- Weekly franchise completed-classes pull — Sunday 10:00 SGT.
                 SG-only (country instances skip); no-op until partner URL+key
                 are configured in mmd/franchise_report/*. -->
            <mmd_rolemanager_franchise_classes_pull>
                <schedule><cron_expr>0 10 * * 0</cron_expr></schedule>
                <run><model>mmd_rolemanager/cron_franchiseClassesPull::run</model></run>
            </mmd_rolemanager_franchise_classes_pull>
        </jobs>
    </crontab>
</config>
