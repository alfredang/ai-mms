<?xml version="1.0"?>
<!--
    MMD_MobileApi — JSON API for the native learner apps (TC LMS SG / MY / GH).

    Same code on every site: each app talks to its own country's storefront
    (www.tertiarycourses.com.sg / .com.my / .com.gh), which answers from its
    own database. Non-WSQ (C-prefix) classes only.

    Routes (frontend, frontName "mobileapi"):
      GET  /mobileapi/site                     site name, currency, contacts
      GET  /mobileapi/catalog                  public non-WSQ course catalog
      POST /mobileapi/auth/password            email + password -> token
      POST /mobileapi/auth/otpsend             email the learner a login code
      POST /mobileapi/auth/otpverify           email + code -> token
      GET  /mobileapi/auth/googlestart         admin sign-in with Google (one allowed account); returns to the app's URL scheme
      POST /mobileapi/auth/googleexchange      single-use code + verifier -> token
      GET  /mobileapi/auth/me                  the signed-in learner
      POST /mobileapi/auth/logout              revoke this token
      POST /mobileapi/auth/delete              delete the learner's login account
      GET  /mobileapi/learner/classes          current / upcoming / past classes
      GET  /mobileapi/learner/class?run_id=    one class: sessions, materials, survey, certificate
      POST /mobileapi/learner/attendance       self-mark the current session
      GET  /mobileapi/learner/survey?run_id=   in-house survey questions
      POST /mobileapi/learner/survey           submit the survey
      GET  /mobileapi/learner/quiz?quiz_id=&run_id=   a lesson quiz (questions, latest score)
      POST /mobileapi/learner/quiz             submit the quiz answers (scored and recorded)
      GET  /mobileapi/learner/certificates     issued certificates
      GET  /mobileapi/learner/billing          registrations and payment status
      GET  /mobileapi/profile                  own name, phone, appearance, roles
      POST /mobileapi/profile                  change name, phone, appearance
      GET  /mobileapi/trainer/classes          classes the trainer teaches (non-WSQ only)
      GET  /mobileapi/trainer/class?run_id=    one class: sessions, roster, courseware, check-in link
      POST /mobileapi/trainer/attendance       mark a session's attendance
      POST /mobileapi/trainer/announcement     post ({run_id, message}) or delete ({run_id, delete_id}) a class announcement
      GET  /mobileapi/support                  the academy's contacts for the Support tab
      POST /mobileapi/support                  email {subject, message} to the academy
      GET  /mobileapi/trainer/payouts          completed payouts (read from the LMS/TMS bridge)
      GET  /mobileapi/trainer/hours            training hours delivered, per class and month
      GET  /mobileapi/trainer/certifications   the trainer's certifications (shared with the web My Profile)
      POST /mobileapi/trainer/certifications   replace the list
      GET  /mobileapi/profile/avatar           own profile picture (JPEG)
      POST /mobileapi/profile/avatar           set or remove the picture
      GET  /mobileapi/staff/dashboard?role=    cards and lists for a staff role the account holds
                                               (admin, marketing, developer, franchise_admin)
      GET  /mobileapi/staff/classes?role=admin[&from=&to=]  admin home (KPIs, current, upcoming) or a calendar range
      GET  /mobileapi/staff/courses?role=developer          every WSQ / non-WSQ course with funding validity

    Auth: "Authorization: Bearer <token>" from /auth/password or /auth/otpverify.
-->
<config>
    <modules>
        <MMD_MobileApi>
            <version>1.0.0</version>
        </MMD_MobileApi>
    </modules>

    <global>
        <helpers>
            <mmd_mobileapi>
                <class>MMD_MobileApi_Helper</class>
            </mmd_mobileapi>
        </helpers>
        <models>
            <mmd_mobileapi>
                <class>MMD_MobileApi_Model</class>
            </mmd_mobileapi>
        </models>
    </global>

    <crontab>
        <jobs>
            <!-- Catalog cache lives 3 h; rebuild every 2 h so it never goes cold. -->
            <mmd_mobileapi_warm_catalog>
                <schedule><cron_expr>20 */2 * * *</cron_expr></schedule>
                <run><model>mmd_mobileapi/cron::warmCatalog</model></run>
            </mmd_mobileapi_warm_catalog>
        </jobs>
    </crontab>

    <frontend>
        <routers>
            <mmd_mobileapi>
                <use>standard</use>
                <args>
                    <module>MMD_MobileApi</module>
                    <frontName>mobileapi</frontName>
                </args>
            </mmd_mobileapi>
        </routers>
    </frontend>

    <default>
        <mmd_mobileapi>
            <general>
                <!-- App Review sign-in: a real storefront account whose
                     email is listed here gets SAMPLE data only — it never
                     sees or writes rosters, attendance, reviews or orders.
                     Comma-separated. The password lives only in the
                     customer account (never in this repo). -->
                <demo_emails>appreview@tertiarycourses.com.sg</demo_emails>
            </general>
        </mmd_mobileapi>
    </default>
</config>
