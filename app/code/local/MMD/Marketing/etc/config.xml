<?xml version="1.0"?>
<!--
  MMD_Marketing — admin-only Marketing Dashboard.

  Hosts the marketing-flavoured widgets that previously lived on the master
  admin dashboard (Most Popular Courses, Top Revenue Courses, Latest Search
  Terms, Top Popular Search Terms). Future home for MailerLite KPIs once an
  API key is configured.

  Route: /<adminFrontName>/mmd_marketing/dashboard
-->
<config>
    <modules>
        <MMD_Marketing>
            <version>1.0.0</version>
        </MMD_Marketing>
    </modules>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <mmd_marketing after="Mage_Adminhtml">MMD_Marketing_Adminhtml</mmd_marketing>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <adminhtml>
        <layout>
            <updates>
                <mmd_marketing>
                    <file>mmd_marketing.xml</file>
                </mmd_marketing>
            </updates>
        </layout>
    </adminhtml>
    <global>
        <helpers>
            <mmd_marketing>
                <class>MMD_Marketing_Helper</class>
            </mmd_marketing>
        </helpers>
        <blocks>
            <mmd_marketing>
                <class>MMD_Marketing_Block</class>
            </mmd_marketing>
        </blocks>
        <models>
            <mmd_marketing>
                <class>MMD_Marketing_Model</class>
            </mmd_marketing>
        </models>
    </global>

    <!-- Public (no-login) route for the reviewer Approve / Request-changes links
         in the review email. Authorisation is the signed token in the URL. -->
    <frontend>
        <routers>
            <mmd_marketing>
                <use>standard</use>
                <args>
                    <module>MMD_Marketing</module>
                    <frontName>newsletter-review</frontName>
                </args>
            </mmd_marketing>
        </routers>
    </frontend>

    <!-- Cron: SG-only autonomous flyer pipeline. Everything is gated by
         mmd_marketing/newsletter/blast_enabled (default OFF) so these jobs are
         inert on every instance until the SG admin toggles the feature on. -->
    <crontab>
        <jobs>
            <!-- Mon &amp; Thu 10:00 — design a flyer for a popular upcoming class
                 (next 2-3 weeks) and send it to the managers for approval. -->
            <mmd_marketing_flyer_propose>
                <schedule><cron_expr>0 10 * * 1,4</cron_expr></schedule>
                <run><model>mmd_marketing/cron_flyer::propose</model></run>
            </mmd_marketing_flyer_propose>
            <!-- Hourly — after a manager requests changes, re-issue the freshly
                 regenerated design for review, and expire stale proposals. Cheap
                 no-op when nothing is pending. -->
            <mmd_marketing_flyer_followup>
                <schedule><cron_expr>15 * * * *</cron_expr></schedule>
                <run><model>mmd_marketing/cron_flyer::followUp</model></run>
            </mmd_marketing_flyer_followup>
            <!-- Every 10 min — safety net behind the MailerLite campaign.sent
                 webhook: mark blasted campaigns (stage "Blasted"), cache their
                 stats for the dashboard, fire the once-only LinkedIn post. -->
            <mmd_marketing_flyer_syncblasts>
                <schedule><cron_expr>*/10 * * * *</cron_expr></schedule>
                <run><model>mmd_marketing/cron_flyer::syncBlasts</model></run>
            </mmd_marketing_flyer_syncblasts>
            <!-- Daily 04:00 — push new order emails into this site's own
                 MailerLite subscriber group. Every parameter (API key, group,
                 store, on/off) is a Company Setting so each franchisee points
                 it at their own list; inert until they enable it. Addresses
                 that already unsubscribed are never re-added. -->
            <mmd_marketing_subscriber_sync>
                <schedule><cron_expr>0 4 * * *</cron_expr></schedule>
                <run><model>mmd_marketing/cron_subscribersync::run</model></run>
            </mmd_marketing_subscriber_sync>
            <!-- Daily 07:00 — watchdog three hours after the sync. The sync
                 alerting on its own errors can't catch the job never running
                 at all, so something outside it has to notice the silence.
                 Also verifies against the MailerLite API that the newest order
                 email really is in the group. Emails the reviewers on trouble. -->
            <mmd_marketing_subscriber_sync_watchdog>
                <schedule><cron_expr>0 7 * * *</cron_expr></schedule>
                <run><model>mmd_marketing/cron_subscribersync::watchdog</model></run>
            </mmd_marketing_subscriber_sync_watchdog>
            <!-- 28th of each month, 03:00 — rebuild the reconstructed months
                 behind the dashboard subscriber-growth chart. Daily snapshots
                 only start 2026-07-13, so earlier months are derived from
                 subscriber signup dates: a ~36-page API walk (~40s) that must
                 never run inside a page render. The 28th is the last day every
                 month has, so this fires 12x a year including February. -->
            <mmd_marketing_subscriber_history>
                <schedule><cron_expr>0 3 28 * *</cron_expr></schedule>
                <run><model>mmd_marketing/cron_subscriberhistory::run</model></run>
            </mmd_marketing_subscriber_history>
        </jobs>
    </crontab>
</config>
