<?xml version="1.0"?>
<config>
    <modules>
        <MMD_FeedbackForm>
            <version>2.0.0</version>
        </MMD_FeedbackForm>
    </modules>

    <global>
        <helpers>
            <mmd_feedbackform>
                <class>MMD_FeedbackForm_Helper</class>
            </mmd_feedbackform>
        </helpers>
    </global>

    <!-- Public frontend: /feedback/respond?run_id=X — saves as a Magento product review -->
    <frontend>
        <routers>
            <mmd_feedbackform_frontend>
                <use>standard</use>
                <args>
                    <module>MMD_FeedbackForm</module>
                    <frontName>feedback</frontName>
                </args>
            </mmd_feedbackform_frontend>
        </routers>
    </frontend>
</config>
